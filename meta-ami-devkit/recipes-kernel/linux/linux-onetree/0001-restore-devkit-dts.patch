 		pwms = <&pwm_tach 11 40000 0>;	/* Target freq:25 kHz */
 		cooling-min-state = <0>;
 		cooling-max-state = <3>;
@@ -270,15 +275,13 @@
 	pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
 		     &pinctrl_pwm2_default &pinctrl_pwm3_default
