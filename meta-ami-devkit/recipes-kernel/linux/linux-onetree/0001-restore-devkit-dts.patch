Subject: [PATCH] Restore AMI DevKit wiring on the current AST2600 DTS

Port the original AMI board memory, peripheral placement and power GPIO
configuration to the current bindings. Release PWM and SPI pin selections
that conflict with the power GPIOs, retaining the current 64 MiB layout.

Upstream-Status: Inappropriate [DevKit hardware configuration]

--- a/dts-evb-ast2600/aspeed-ast2600-evb.dts
+++ b/dts-evb-ast2600/aspeed-ast2600-evb.dts
@@ -24,7 +24,7 @@
 
 	memory@80000000 {
 		device_type = "memory";
-		reg = <0x80000000 0x80000000>;
+		reg = <0x80000000 0x40000000>;
 	};
 
 	reserved-memory {
@@ -185,6 +185,7 @@
 
 	fan7: pwm-fan7 {
 		compatible = "pwm-fan";
+		status = "disabled";
 		pwms = <&pwm_tach 7 40000 0>;	/* Target freq:25 kHz */
 		cooling-min-state = <0>;
 		cooling-max-state = <3>;
@@ -194,6 +195,7 @@
 
 	fan8: pwm-fan8 {
 		compatible = "pwm-fan";
+		status = "disabled";
 		pwms = <&pwm_tach 8 40000 0>;	/* Target freq:25 kHz */
 		cooling-min-state = <0>;
 		cooling-max-state = <3>;
@@ -203,6 +205,7 @@
 
 	fan9: pwm-fan9 {
