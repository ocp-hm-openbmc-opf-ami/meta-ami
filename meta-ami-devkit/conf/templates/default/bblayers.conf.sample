# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "16"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

# meta-intel-openbmc has a config file that needs to be overridden
BBMASK = "/meta-intel-openbmc/meta-common/recipes-phosphor/ipmi/phosphor-ipmi-ipmb"
BBMASK += "/meta-core/meta-common/recipes-intel/images/intel-platforms.bb"
BBMASK += "/meta-core/meta-egs/recipes-intel/images/intel-platforms.bbappend"
BBMASK += "/meta-ami/meta-common/recipes-ami/images/intel-platforms.bbappend"
BBMASK += "/meta-ami/meta-common/recipes-network/network/static-mac-addr.bbappend"
BBMASK += "/meta-ami/meta-intel/recipes-intel/emmc-enable/emmc-enable.bbappend"
BBMASK += "${@bb.utils.contains('ENABLE_COMMUNITY_MCTP_KERNEL_MODE', '1', ' meta-ami/meta-common/recipes-phosphor/libmctp/libmctp_%.bbappend meta-ami/meta-evb/meta-evb-aspeed/meta-evb-ast2600/recipes-phosphor/libmctp/libmctp_%.bbappend', '', d)}"

# Same layer set as evb-ast2600, plus the DevKit integration layer.
BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/meta-ami \
  ##OEROOT##/meta-ami/meta-ami-devkit \
  ##OEROOT##/meta-ami/meta-evb \
  ##OEROOT##/meta-ami/meta-evb/meta-evb-aspeed \
  ##OEROOT##/meta-ami/meta-evb/meta-evb-aspeed/meta-evb-ast2600 \
  ##OEROOT##/meta-openembedded/meta-oe \
  ##OEROOT##/meta-openembedded/meta-networking \
  ##OEROOT##/meta-openembedded/meta-perl \
  ##OEROOT##/meta-openembedded/meta-python \
  ##OEROOT##/meta-phosphor \
  ##OEROOT##/meta-aspeed \
  ##OEROOT##/meta-core \
  ##OEROOT##/meta-intel-openbmc \
  ##OEROOT##/meta-core/meta-common \
  ##OEROOT##/meta-core/meta-ast2600 \
  ##OEROOT##/meta-security \
  "
