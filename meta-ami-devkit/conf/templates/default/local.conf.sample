MACHINE ??= "ami-devkit"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_rpm"
IMAGE_FSTYPES += "mtd-static mtd-static-tar mtd-static-alltar"
INITRAMFS_IMAGE = "obmc-phosphor-initramfs"
INITRAMFS_FSTYPES = "cpio.xz"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
ERROR_QA:remove = " patch-status license-checksum buildpaths "
WARN_QA:append = " patch-status license-checksum buildpaths "
EXTRA_IMAGE_FEATURES += "allow-empty-password allow-root-login"
EXTRA_IMAGE_FEATURES:remove = "debug-tweaks"
EXTRA_IMAGE_FEATURES:remove = "obmc-bmcweb"
IMAGE_FEATURES:remove = "obmc-bmc-state-mgmt obmc-bmcweb obmc-chassis-mgmt obmc-devtools obmc-fan-control obmc-fan-mgmt obmc-flash-mgmt obmc-host-ctl obmc-host-ipmi obmc-chassis-state-mgmt obmc-host-state-mgmt obmc-inventory obmc-leds obmc-logging-mgmt obmc-remote-logging-mgmt obmc-net-ipmi obmc-sensors obmc-software obmc-system-mgmt obmc-user-mgmt obmc-user-mgmt-ldap obmc-debug-collector obmc-network-mgmt obmc-settings-mgmt"
MACHINEOVERRIDES =. "openbmc:"
ENABLE_COMMUNITY_MCTP_KERNEL_MODE = "1"
require conf/machine/include/${MACHINE}-layout.inc