 .../dts/freescale/imx91-11x11-evk-bmc.dts     |  45 +++++++
 .../freescale/imx93-11x11-evk-bmc-host.dts    |  57 ++++++++
 .../freescale/imx93-11x11-frdm-bmc-mctp.dts   | 101 +++++++++++++++
 .../dts/freescale/imx93-11x11-frdm-bmc.dts    | 122 ++++++++++++++++++
 net/mctp/Kconfig                              |   2 +-
 6 files changed, 331 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/boot/dts/freescale/imx91-11x11-evk-bmc.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-11x11-evk-bmc-host.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc-mctp.dts
