--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -490,7 +490,9 @@ dtb-$(CONFIG_ARCH_MXC) += imx93-11x11-evk.dtb \
 			  imx93-11x11-evk-ld.dtb \
 			  imx93-11x11-evk-iw612-otbr.dtb \
 			  imx93-11x11-evk-rpmsg.dtb \
-			  imx93-11x11-evk-8mic-reve.dtb
+			  imx93-11x11-evk-8mic-reve.dtb \
+			  imx93-11x11-evk-bmc-host.dtb \
+			  imx93-11x11-frdm-bmc.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx93-11x11-frdm.dtb imx93-11x11-frdm-8mic-reve.dtb \
 			  imx93-11x11-frdm-aud-hat.dtb imx93-11x11-frdm-ld.dtb \
@@ -515,7 +517,8 @@ dtb-$(CONFIG_ARCH_MXC) += imx91-11x11-evk.dtb \
 			  imx91-11x11-evk-i2c-spi-slave.dtb \
 			  imx91-11x11-evk-i3c.dtb \
 			  imx91-11x11-evk-usbwifi.dtb \
-			  imx91-11x11-evk-8mic-reve.dtb
+			  imx91-11x11-evk-8mic-reve.dtb \
+			  imx91-11x11-evk-bmc.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx91-11x11-frdm-imx91s.dtb \
 			  imx91-11x11-frdm-imx91s-aud-hat.dtb \
diff --git a/arch/arm64/boot/dts/freescale/imx91-11x11-evk-bmc.dts b/arch/arm64/boot/dts/freescale/imx91-11x11-evk-bmc.dts
new file mode 100644
index 000000000000..1b1d6bf47622
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx91-11x11-evk-bmc.dts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+#include "imx91-11x11-evk.dts"
+
+&lpuart3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart3>;
+	status = "okay";
+};
+
+&lpi2c5 {
+#address-cells = <1>;
+#size-cells = <0>;
+        clock-frequency = <400000>;
+        pinctrl-names = "default", "sleep";
+        pinctrl-0 = <&pinctrl_lpi2c5>;
+        pinctrl-1 = <&pinctrl_lpi2c5>;
+        status = "okay";
+
+        sensor@48 {
+                compatible = "nxp,pct2075";
+                reg = <0x48>;
+        };
+};
+
+&iomuxc {
+/* uart test port2: J1001: Pin8--TX Pin10--RX */
+	pinctrl_uart3: uart3grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO14__LPUART3_TX		0x31e
+			MX91_PAD_GPIO_IO15__LPUART3_RX		0x31e
+		>;
+	};
+
+/* sensor port: J1001: Pin27--SDA Pin28-SCL */
+        pinctrl_lpi2c5: lpi2c5grp {
+                 fsl,pins = <
+                          MX91_PAD_GPIO_IO00__LPI2C5_SDA        0x40000b9e
+                          MX91_PAD_GPIO_IO01__LPI2C5_SCL        0x40000b9e
+                 >;
+        };
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-evk-bmc-host.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-evk-bmc-host.dts
