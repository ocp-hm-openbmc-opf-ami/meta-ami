MACHINE ??= "evb-imx93"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_ipk"
SANITY_TESTED_DISTROS:append ?= " *"
EXTRA_IMAGE_FEATURES ?= "allow-root-login"
IMAGE_FEATURES:remove = "debug-tweaks"
IMAGE_INSTALL:append = " net-tools curl lmsensors phosphor-hwmon openipmi ipmitool dbus-sensors socat git entity-manager"
IMX_MIRROR ?= "https://www.nxp.com/lgfiles/NMG/MAD/YOCTO/"

# FIXME: set this to avoid changing all the recipes that use it
FSL_MIRROR ?= "${IMX_MIRROR}"

MIRRORS += " \
${IMX_MIRROR}   http://download.ossystems.com.br/bsp/freescale/source/ \n \
"
ACCEPT_FSL_EULA = "1"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

ERROR_QA:remove = " patch-status"
WARN_QA:append = " patch-status"

# Mask ASPEED/Intel-specific bbappends that have no base recipes in NXP builds
BBMASK:append = " meta-core/meta-common/recipes-bsp/u-boot/u-boot-aspeed-sdk "
BBMASK:append = " meta-core/meta-common/recipes-core/host-error-monitor "
BBMASK:append = " meta-core/meta-common/recipes-core/ipmi/intel-ipmi-oem "
BBMASK:append = " meta-core/meta-common/recipes-intel/images/intel-platforms "
BBMASK:append = " meta-core/meta-common/recipes-intel/pfr/pfr-manager "
BBMASK:append = " meta-core/meta-common/recipes-security/sssd "
# Broad masks — prevent all Intel kernel/BSP recipes from building
BBMASK:append = " meta-core/meta-common/recipes-kernel/ "
BBMASK:append = " meta-core/meta-common/recipes-bsp/ "
BBMASK:append = " meta-core/meta-common/recipes-intel/packagegroups "
BBMASK:append = " meta-ami/meta-common/recipes-bsp/u-boot/u-boot-aspeed-sdk "
BBMASK:append = " meta-ami/meta-common/recipes-bsp/u-boot/u-boot-fw-utils-aspeed-sdk "
BBMASK:append = " meta-ami/meta-common/recipes-ami/images/intel-platforms "
BBMASK:append = " meta-ami/meta-common/recipes-core/host-error-monitor "
BBMASK:append = " meta-ami/meta-common/recipes-network/network/static-mac-addr "
BBMASK:append = " meta-ami/meta-common/recipes-phosphor/ipmi/intel-ipmi-oem "
BBMASK:append = " meta-ami/meta-common/recipes-security/google-authenticator-libpam "
BBMASK:append = " meta-ami/meta-common/recipes-graphics/obmc-ikvm/obmc-ikvm "

# Limit bmcweb parallel compilation to avoid OOM kills (redfish.cpp is very large)
PARALLEL_MAKE:pn-bmcweb = "-j 2"