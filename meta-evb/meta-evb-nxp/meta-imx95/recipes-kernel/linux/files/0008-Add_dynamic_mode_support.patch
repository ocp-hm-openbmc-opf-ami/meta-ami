From afb24f4a6072838a9d6f0af93435c16ed5fbf445 Mon Sep 17 00:00:00 2001
From: Shreyash Damanwala <shreyash.damanwala@nxp.com>
Date: Tue, 14 Apr 2026 14:03:29 +0530
Subject: [PATCH] Add_dynamic_mode_support

Upstream-Status: Pending
---
 drivers/pci/endpoint/functions/pci-epf-test.c | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/pci/endpoint/functions/pci-epf-test.c b/drivers/pci/endpoint/functions/pci-epf-test.c
index ff8d9975fc06..a5bf30c52a44 100644
--- a/drivers/pci/endpoint/functions/pci-epf-test.c
+++ b/drivers/pci/endpoint/functions/pci-epf-test.c
@@ -46,6 +46,8 @@ static struct pci_epf_test *global_epf_test;
 #define COMMAND_COPY			BIT(5)
 #define COMMAND_START_STREAM      BIT(6)
 #define COMMAND_STOP_STREAM       BIT(7)
+#define COMMAND_CHANGE_RESOLUTION BIT(8)
+

 #define STATUS_READ_SUCCESS		BIT(0)
 #define STATUS_READ_FAIL		BIT(1)
@@ -95,6 +97,8 @@ struct pci_epf_test_reg {
 	u32	irq_number;
 	u32	flags;
 	u32	start;
+	u32	height;
+	u32	width;
 } __packed;

 static struct pci_epf_header test_header = {
@@ -910,6 +914,26 @@ static void pci_epf_test_cmd_handler(struct work_struct *work)
 		fb_offset = 0;
 		pci_epf_test_raise_irq(epf_test, reg);
 		break;
+	case COMMAND_CHANGE_RESOLUTION:
+		char *envp[4];
+		char res_str[32];
+
+		u32 width = reg->width;
+		u32 height = reg->height;
+
+		dev_info(dev, "Resolution change: %ux%u\n", width, height);
+
+		/* prepare env variables */
+		snprintf(res_str, sizeof(res_str), "RESOLUTION=%ux%u", width, height);
+
+		envp[0] = "EVENT=RESOLUTION_CHANGE";
+		envp[1] = res_str;
+		envp[2] = NULL;
+
+		/* send uevent */
+		kobject_uevent_env(&dev->kobj, KOBJ_CHANGE, envp);
+		pci_epf_test_raise_irq(epf_test, reg);
+		break;
 	default:
 		dev_err(dev, "Invalid command 0x%x\n", command);
 		break;
--
 2.34.1
