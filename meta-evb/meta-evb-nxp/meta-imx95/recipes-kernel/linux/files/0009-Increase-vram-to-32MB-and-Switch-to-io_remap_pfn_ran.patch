From d7023dccf2f498d2af8ded56be4885e189b79ed8 Mon Sep 17 00:00:00 2001
From: Shreyash Damanwala <shreyash.damanwala@nxp.com>
Date: Wed, 15 Apr 2026 16:39:26 +0530
Subject: [PATCH] Increase vram to 32MB and Switch to io_remap_pfn_range for
correct framebuffer mmap handling

Upstream-Status: Pending
---
 arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts | 2 +-
 drivers/pci/endpoint/functions/pci-epf-test.c     | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
index ed4587003262..b624c5fbb3a9 100644
--- a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
@@ -115,7 +115,7 @@ rsc_table: rsc-table@88220000 {
 		};

 		vram: vram@9E000000 {
-			reg = <0 0x9E000000 0 0x01000000>; /* 16MB */
+			reg = <0 0x9E000000 0 0x02000000>; /* 32MB */
 			no-map;
 		};

diff --git a/drivers/pci/endpoint/functions/pci-epf-test.c b/drivers/pci/endpoint/functions/pci-epf-test.c
index a5bf30c52a44..931526f5d23c 100644
--- a/drivers/pci/endpoint/functions/pci-epf-test.c
+++ b/drivers/pci/endpoint/functions/pci-epf-test.c
@@ -108,7 +108,7 @@ static struct pci_epf_header test_header = {
 	.interrupt_pin	= PCI_INTERRUPT_INTA,
 };

-static size_t bar_size[] = { 512, 512, 16777216, 16384, 4194304, 1048576};
+static size_t bar_size[] = { 512, 512, 33554432, 16384, 4194304, 1048576};

 static void pci_epf_test_dma_callback(void *param)
 {
@@ -1239,7 +1239,7 @@ static int stream_mmap_pci(struct file *filp, struct vm_area_struct *vma)
     // write-combined for framebuffer
     vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);

-    return remap_pfn_range(vma,
+    return io_remap_pfn_range(vma,
                            vma->vm_start,
                            phys >> PAGE_SHIFT,
                            vma->vm_end - vma->vm_start,
--
 2.34.1
