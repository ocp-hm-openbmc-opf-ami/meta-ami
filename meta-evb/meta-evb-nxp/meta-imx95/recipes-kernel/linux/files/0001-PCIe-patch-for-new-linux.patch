From 373db930bd54c4bec0985082b6b07606097afbf8 Mon Sep 17 00:00:00 2001
From: Riddhi Parekh <riddhi.parekh@nxp.com>
Date: Tue, 24 Feb 2026 11:31:17 +0530
Subject: [PATCH 1/5] PCIe patch for new linux

Upstream-Status: Pending
Signed-off-by: Riddhi Parekh <riddhi.parekh@nxp.com>
---
 .../freescale/imx95-19x19-evk-pcie1-ep.dtso   |  1 +
 drivers/pci/controller/dwc/pci-imx6.c         | 37 +++++++++++++++----
 2 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx95-19x19-evk-pcie1-ep.dtso b/arch/arm64/boot/dts/freescale/imx95-19x19-evk-pcie1-ep.dtso
index a8e3bbc53894..f42262e3dbb8 100644
--- a/arch/arm64/boot/dts/freescale/imx95-19x19-evk-pcie1-ep.dtso
+++ b/arch/arm64/boot/dts/freescale/imx95-19x19-evk-pcie1-ep.dtso
@@ -19,4 +19,5 @@ &pcie1_ep {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_pcie1>;
 	status = "okay";
+	ext-refclk;
 };
diff --git a/drivers/pci/controller/dwc/pci-imx6.c b/drivers/pci/controller/dwc/pci-imx6.c
index 8314af752bba..4c6e0bd457d3 100644
--- a/drivers/pci/controller/dwc/pci-imx6.c
+++ b/drivers/pci/controller/dwc/pci-imx6.c
@@ -606,12 +606,14 @@ static int imx95_pcie_wait_for_phy_pll_lock(struct imx_pcie *imx_pcie)
 				     val & IMX95_PCIE_PHY_MPLL_STATE,
 				     PHY_PLL_LOCK_WAIT_USLEEP_MAX,
 				     PHY_PLL_LOCK_WAIT_TIMEOUT)) {
-		dev_err(dev, "PCIe PLL lock timeout\n");
+		// dev_err(dev, "PCIe PLL lock timeout\n");
+		dev_err(dev, "PCIe PLL lock timeout 0x%x\n", val);
 		imx_pcie->pll_locked = false;
 		return -ETIMEDOUT;
 	}

 	imx_pcie->pll_locked = true;
+	dev_err(dev, "PCIe PLL locked 0x%x\n", val);
 	return 0;
 }

@@ -1203,8 +1205,20 @@ static int imx_pcie_host_init(struct dw_pcie_rp *pp)
 		}
 	}

+	if (imx_pcie->drvdata->mode == DW_PCIE_EP_TYPE) {
+		if ((imx95_pcie_wait_for_phy_pll_lock(imx_pcie)) < 0) {
+			ret = imx_pcie_deassert_core_reset(imx_pcie);
+			if (ret < 0) {
+				dev_err(dev, "pcie deassert core reset failed: %d\n", ret);
+				goto err_phy_off;
+			}
+			ret = -EPROBE_DEFER;
+			goto err_phy_off;
+		}
+	}
+
 	/* Make sure that PCIe LTSSM is cleared */
-	imx_pcie_ltssm_disable(dev);
+	//imx_pcie_ltssm_disable(dev);

 	ret = imx_pcie_deassert_core_reset(imx_pcie);
 	if (ret < 0) {
@@ -1416,10 +1430,11 @@ static int imx_add_pcie_ep(struct imx_pcie *imx_pcie,
 	struct dw_pcie_rp *pp = &pci->pp;
 	struct device *dev = pci->dev;

-	imx_pcie_host_init(pp);
+	if (imx_pcie_host_init(pp) == -EPROBE_DEFER)
+		return -EPROBE_DEFER;

 	/* Make sure that PCIe LTSSM is cleared */
-	imx_pcie_ltssm_disable(dev);
+	//imx_pcie_ltssm_disable(dev);

 	ep = &pci->ep;
 	ep->ops = &pcie_ep_ops;
@@ -1447,6 +1462,7 @@ static int imx_add_pcie_ep(struct imx_pcie *imx_pcie,

 	pci_epc_init_notify(ep->epc);

+	imx_pcie_ltssm_enable(dev);
 	return 0;
 }

@@ -1888,8 +1904,13 @@ static int imx_pcie_probe(struct platform_device *pdev)
 	for (i = 0; i < imx_pcie->num_clks; i++) {
 		if (strncmp(imx_pcie->clks[i].id, "ext-ref", 7) == 0)
 			imx_pcie->enable_ext_refclk = true;
-		else
-			imx_pcie->enable_ext_refclk = false;
+		else {
+			imx_pcie->enable_ext_refclk = of_property_read_bool(pdev->dev.of_node, "ext-refclk");
+			if (imx_pcie->enable_ext_refclk)
+				dev_err(dev, "external ref clk enable\n");
+			else
+				dev_err(dev, "external ref clk disable\n");
+		}
 	}

 	if (imx_check_flag(imx_pcie, IMX_PCIE_FLAG_HAS_PHYDRV)) {
@@ -2010,8 +2031,8 @@ static int imx_pcie_probe(struct platform_device *pdev)

 	if (imx_pcie->drvdata->mode == DW_PCIE_EP_TYPE) {
 		ret = imx_add_pcie_ep(imx_pcie, pdev);
-		if (ret < 0)
-			return ret;
+		if (ret == -EPROBE_DEFER)
+			return dev_err_probe(dev, -EPROBE_DEFER, "ext clk 100MHZ not avail\n");
 	} else {
 		pci->pp.use_atu_msg = true;
 		ret = dw_pcie_host_init(&pci->pp);
--
 2.34.1
