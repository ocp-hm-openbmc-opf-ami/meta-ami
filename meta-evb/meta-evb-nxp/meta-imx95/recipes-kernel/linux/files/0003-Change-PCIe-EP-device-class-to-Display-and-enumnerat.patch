From 70edefaa346906450fc7198caf89554a0d5fdde5 Mon Sep 17 00:00:00 2001
From: Riddhi Parekh <riddhi.parekh@nxp.com>
Date: Tue, 24 Feb 2026 15:11:50 +0530
Subject: [PATCH 3/5] Change PCIe EP device class to Display and enumnerate it
 as a VGA device

Upstream-Status: Pending
Signed-off-by: Riddhi Parekh <riddhi.parekh@nxp.com>
---
 arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts | 4 ++++
 drivers/base/dd.c                                 | 1 +
 drivers/gpu/drm/imx/dpu95/dpu95-crtc.c            | 2 ++
 drivers/gpu/drm/imx/dpu95/dpu95-kms.c             | 2 ++
 drivers/pci/controller/dwc/pci-imx6.c             | 2 +-
 drivers/pci/endpoint/functions/pci-epf-test.c     | 8 ++++----
 include/linux/pci_ids.h                           | 1 +
 7 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
index ab7bd4fdaadf..f7b5b6afe70a 100644
--- a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
@@ -1351,3 +1351,7 @@ &vpuctrl {
 	boot = <&vpu_boot>;
 	sram = <&sram1>;
 };
+
+&mali {
+	status = "okay";
+};
diff --git a/drivers/base/dd.c b/drivers/base/dd.c
index b2e326cdf1e1..e1835671f92f 100644
--- a/drivers/base/dd.c
+++ b/drivers/base/dd.c
@@ -243,6 +243,7 @@ static int deferred_devs_show(struct seq_file *s, void *data)
 			   curr->deferred_probe_reason ?: "\n");

 	mutex_unlock(&deferred_probe_mutex);
+	driver_deferred_probe_trigger();

 	return 0;
 }
diff --git a/drivers/gpu/drm/imx/dpu95/dpu95-crtc.c b/drivers/gpu/drm/imx/dpu95/dpu95-crtc.c
index 110a246ed220..d38bd48541ca 100644
--- a/drivers/gpu/drm/imx/dpu95/dpu95-crtc.c
+++ b/drivers/gpu/drm/imx/dpu95/dpu95-crtc.c
@@ -687,6 +687,8 @@ int dpu95_crtc_init(struct dpu95_drm_device *dpu_drm,
 			stream_id, ret);
 		return ret;
 	}
+	drm_err(drm, " DRM_PLANE_TYPE_PRIMARY failed to init primary plane for stream%d: %d\n",
+		stream_id, ret);

 	drm_crtc_helper_add(crtc, &dpu95_helper_funcs);

diff --git a/drivers/gpu/drm/imx/dpu95/dpu95-kms.c b/drivers/gpu/drm/imx/dpu95/dpu95-kms.c
index d0f32e95330c..dd7570a4936f 100644
--- a/drivers/gpu/drm/imx/dpu95/dpu95-kms.c
+++ b/drivers/gpu/drm/imx/dpu95/dpu95-kms.c
@@ -620,6 +620,8 @@ int dpu95_kms_prepare(struct dpu95_drm_device *dpu_drm)
 				i, ret);
 			return ret;
 		}
+			drm_err(drm, "init overlay plane%d: %d\n",
+				i, ret);
 	}

 	ret = drm_vblank_init(drm, DPU95_CRTCS);
diff --git a/drivers/pci/controller/dwc/pci-imx6.c b/drivers/pci/controller/dwc/pci-imx6.c
index 4c6e0bd457d3..4a29d17c0d9f 100644
--- a/drivers/pci/controller/dwc/pci-imx6.c
+++ b/drivers/pci/controller/dwc/pci-imx6.c
@@ -2413,7 +2413,7 @@ static void imx_pcie_quirk(struct pci_dev *dev)
 	}
 }
 DECLARE_PCI_FIXUP_CLASS_HEADER(PCI_VENDOR_ID_SYNOPSYS, 0xabcd,
-			PCI_CLASS_BRIDGE_PCI, 8, imx_pcie_quirk);
+			PCI_CLASS_DISPLAY_VGA, 8, imx_pcie_quirk);

 static int __init imx_pcie_init(void)
 {
diff --git a/drivers/pci/endpoint/functions/pci-epf-test.c b/drivers/pci/endpoint/functions/pci-epf-test.c
index 3766f613b6ef..4a4b178859c1 100644
--- a/drivers/pci/endpoint/functions/pci-epf-test.c
+++ b/drivers/pci/endpoint/functions/pci-epf-test.c
@@ -84,9 +84,9 @@ struct pci_epf_test_reg {
 } __packed;

 static struct pci_epf_header test_header = {
-	.vendorid	= PCI_ANY_ID,
-	.deviceid	= PCI_ANY_ID,
-	.baseclass_code = PCI_CLASS_OTHERS,
+	.vendorid	= 0x1131,
+	.deviceid	= 0x0000,
+	.baseclass_code = PCI_BASE_CLASS_DISPLAY,
 	.interrupt_pin	= PCI_INTERRUPT_INTA,
 };

@@ -439,7 +439,7 @@ static void pci_epf_test_read(struct pci_epf_test *epf_test,

 	info = registered_fb[0];
 	fb_ptr = info->screen_base;
-	//printk("Screen Size 0x%lx 0x%x\n", info->screen_size, reg->size);
+	//printk("Screen Size 0x%lx 0x%x 0x%lx\n", info->screen_size, reg->size, fb_offset);

 	src_addr = pci_epc_mem_alloc_addr(epc, &phys_addr, reg->size);
 	if (!src_addr) {
diff --git a/include/linux/pci_ids.h b/include/linux/pci_ids.h
index 59568da82e6e..b4f6e8004461 100644
--- a/include/linux/pci_ids.h
+++ b/include/linux/pci_ids.h
@@ -1556,6 +1556,7 @@
 #define PCI_VENDOR_ID_PHILIPS		0x1131
 /* NXP has two vendor IDs, the other one is 0x1957 */
 #define PCI_VENDOR_ID_NXP2		PCI_VENDOR_ID_PHILIPS
+#define PCI_DEVICE_ID_NXP2		0x0000
 #define PCI_DEVICE_ID_PHILIPS_SAA7146	0x7146
 #define PCI_DEVICE_ID_PHILIPS_SAA9730	0x9730
 #define PCI_DEVICE_ID_NXP2_NETC_RCEC	0xe001
--
 2.34.1
