Subject: [PATCH] certificate: validate chain key length on imx95
Upstream-Status: Inappropriate [downstream chain installation]

The chain installation calls a validator absent from this patch series.
Validate the key without relying on the incompatible certificate error patch.

diff --git a/x509_utils.hpp b/x509_utils.hpp
--- a/x509_utils.hpp
+++ b/x509_utils.hpp
@@ -31,5 +31,8 @@
 void validateCertificateStartDate(X509& cert);
 
+/** @brief Validates certificate public key length and type. */
+void validateCertificateKeyLength(X509& cert);
+
 /**
  * @brief Validates the certificate against the trusted certificates store and
  * throws error if certificate is not valid
diff --git a/x509_utils.cpp b/x509_utils.cpp
--- a/x509_utils.cpp
+++ b/x509_utils.cpp
@@ -144,5 +144,23 @@
 }
 
+void validateCertificateKeyLength(X509& cert)
+{
+    std::unique_ptr<EVP_PKEY, decltype(&::EVP_PKEY_free)> key(
+        X509_get_pubkey(&cert), ::EVP_PKEY_free);
+    if (!key)
+    {
+        elog<InvalidCertificate>(Reason("Failed to get public key info"));
+    }
+    const int bits = EVP_PKEY_bits(key.get());
+    const int type = EVP_PKEY_base_id(key.get());
+    if ((type == EVP_PKEY_RSA && (bits < 2048 || bits > 4096)) ||
+        (type == EVP_PKEY_EC && (bits < 224 || bits > 521)) ||
+        (type != EVP_PKEY_RSA && type != EVP_PKEY_EC))
+    {
+        elog<InvalidCertificate>(Reason("Invalid key length certificate"));
+    }
+}
+
 void validateCertificateAgainstStore(X509_STORE& x509Store, X509& cert)
 {
     int errCode = X509_V_OK;
