[Unit]
Description=BMC State Change (Every Boot)
After=xyz.openbmc_project.State.BMC.service xyz.openbmc_project.State.Host@0.service
Requires=xyz.openbmc_project.State.BMC.service xyz.openbmc_project.State.Host@0.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Commands from state_change.sh
ExecStart=/bin/busctl set-property xyz.openbmc_project.State.BMC /xyz/openbmc_project/state/bmc0 xyz.openbmc_project.State.BMC CurrentBMCState s "xyz.openbmc_project.State.BMC.BMCState.Ready"
ExecStart=/bin/busctl set-property xyz.openbmc_project.State.Host /xyz/openbmc_project/state/host0 xyz.openbmc_project.State.Host RequestedHostTransition s "xyz.openbmc_project.State.Host.Transition.On"

[Install]
WantedBy=multi-user.target
