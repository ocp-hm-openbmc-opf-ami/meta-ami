{
    "entries": [
        {
            "trigger": {
                "service": "xyz.openbmc_project.State.Host",
                "interface": "xyz.openbmc_project.State.Host",
                "property": "RequestedHostTransition",
                "value": "xyz.openbmc_project.State.Host.Transition.Reboot"
            },
            "actions": [
                {
                    "command": "/usr/bin/host_reboot.sh"
                }
            ]
        },
        {
            "trigger": {
                "service": "xyz.openbmc_project.State.Host",
                "interface": "xyz.openbmc_project.State.Host",
                "property": "RequestedHostTransition",
                "value": "xyz.openbmc_project.State.Host.Transition.On"
            },
            "actions": [
                {
                    "command": "/usr/bin/poweron.sh"
                }
            ]
        },
        {
            "trigger": {
                "service": "xyz.openbmc_project.State.Host",
                "interface": "xyz.openbmc_project.State.Host",
                "property": "RequestedHostTransition",
                "value": "xyz.openbmc_project.State.Host.Transition.Off"
            },
            "actions": [
                {
                    "command": "/usr/bin/poweroff.sh"
                }
            ]
        }

    ]
 }