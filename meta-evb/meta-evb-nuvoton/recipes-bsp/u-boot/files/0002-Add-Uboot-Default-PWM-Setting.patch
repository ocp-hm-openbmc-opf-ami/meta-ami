From 703df59c04016c186cce0ac3bf78ae02468179dc Mon Sep 17 00:00:00 2001
From: santhoshs <santhoshs@ami.com>
Date: Thu, 17 Apr 2025 16:38:00 +0000
Subject: [PATCH] Add-Uboot-Default-PWM-Setting

Upstream-Status: Inappropriate [AMI: configuration and driver changes]
Signed-off-by: santhoshs <santhoshs@ami.com>
---
 board/nuvoton/arbel_evb/Kconfig          | 10 ++++++++++
 board/nuvoton/arbel_evb/arbel_evb.c      |  4 ++++
 board/nuvoton/arbel_evb/common_faninit.h | 22 ++++++++++++++++++++++
 3 files changed, 36 insertions(+)
 create mode 100644 board/nuvoton/arbel_evb/common_faninit.h

diff --git a/board/nuvoton/arbel_evb/Kconfig b/board/nuvoton/arbel_evb/Kconfig
index ed1c1ad8ee..dafb54b7c5 100644
--- a/board/nuvoton/arbel_evb/Kconfig
+++ b/board/nuvoton/arbel_evb/Kconfig
@@ -15,5 +15,15 @@ config SYS_MEM_TOP_HIDE
 	help
 	  Reserve memory for ECC/GFX/OPTEE/TIP/CP.
 
+config SYS_DEFAULT_PWM
+	bool "Support default PWM setting"
+	default n
+
+config SYS_DEFAULT_PWM_VALUE
+	hex "Set default PWM value"
+	default 0xC0
+	help
+		Set default pwm to uboot. value = pwm*2.56
+
 source "board/nuvoton/common/Kconfig"
 endif
diff --git a/board/nuvoton/arbel_evb/arbel_evb.c b/board/nuvoton/arbel_evb/arbel_evb.c
index 65bacd9416..cd37462ddd 100644
--- a/board/nuvoton/arbel_evb/arbel_evb.c
+++ b/board/nuvoton/arbel_evb/arbel_evb.c
@@ -9,6 +9,10 @@
 #include <linux/bitfield.h>
 #include <asm/arch/gcr.h>
 #include "../common/common.h"
+ 
+#ifdef CONFIG_SYS_DEFAULT_PWM
+#include "common_faninit.h"
+#endif
 
 #define NPCM_CLK_BA	0xF0801000
 #define CLKSEL		0x4
diff --git a/board/nuvoton/arbel_evb/common_faninit.h b/board/nuvoton/arbel_evb/common_faninit.h
new file mode 100644
index 0000000000..8753b59b90
--- /dev/null
+++ b/board/nuvoton/arbel_evb/common_faninit.h
@@ -0,0 +1,22 @@
+#ifndef _COMMON_FANINIT_H
+#define _COMMON_FANINIT_H
+
+#define MAX31790_OFFSET_LEN		1
+
+#ifndef CONFIG_SYS_DEFAULT_PWM_VALUE
+#define CONFIG_SYS_DEFAULT_PWM_VALUE	0xC0 // 75% duty 192/256
+
+#endif
+#define CONFIG_TEST 0x87
+enum {
+	MAX31790_REG_PWM1OUT = 0x40,
+	MAX31790_REG_PWM2OUT = 0x42,
+	MAX31790_REG_PWM3OUT = 0x44,
+	MAX31790_REG_PWM4OUT = 0x46,
+	MAX31790_REG_PWM5OUT = 0x48,
+	MAX31790_REG_PWM6OUT = 0x4A,
+};
+
+void arbel_fan_init(void);
+
+#endif /* _COMMON_FANINIT_H */
-- 
2.34.1

