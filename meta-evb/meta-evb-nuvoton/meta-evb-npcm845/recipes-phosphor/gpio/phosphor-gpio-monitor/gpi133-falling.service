[Unit]
Description=Advance numctl display on GPI133 falling edge

[Service]
Type=oneshot
# Counter persists in /var/lib/gpi133-count; missing/empty -> 00, wraps 99 -> 00.
ExecStart=/bin/sh -c 'f=/var/lib/gpi133-count; n=$(cat "$f" 2>/dev/null); [ -n "$n" ] || n=0; n=$(( (10#$n + 1) %% 100 )); v=$(printf "%%02d" "$n"); numctl "$v"; echo "$v" > "$f"'
