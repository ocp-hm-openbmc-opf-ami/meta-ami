#!/bin/sh
#
# ledctl - drive an LED GPIO high/low via sysfs
#
#   ledctl <color> <value>
#     color: g (gpio522), y (gpio533), r (gpio534), b (gpio535)
#     value: 0 (off) or 1 (on)
#

set -eu

usage() {
        echo "Usage: ledctl <g|y|r|b> <0|1>" >&2
        exit 1
}

[ $# -eq 2 ] || usage

case "$1" in
        g) gpio=522 ;;
        y) gpio=533 ;;
        r) gpio=534 ;;
        b) gpio=535 ;;
        *)
                echo "ledctl: invalid color '$1'" >&2
                usage
                ;;
esac

case "$2" in
        0|1) val="$2" ;;
        *)
                echo "ledctl: invalid value '$2'" >&2
                usage
                ;;
esac

[ -d /sys/class/gpio/gpio$gpio ] || echo "$gpio" > /sys/class/gpio/export
echo out > /sys/class/gpio/gpio$gpio/direction
echo "$val" > /sys/class/gpio/gpio$gpio/value
