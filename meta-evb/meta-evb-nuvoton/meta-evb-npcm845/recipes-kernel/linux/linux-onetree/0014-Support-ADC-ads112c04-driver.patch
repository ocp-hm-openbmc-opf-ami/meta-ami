From 72a1ef1b4063d87484b7bfa4bd91c2828cfedaad Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 12:47:48 +0530
Subject: [PATCH] Support ADC ads112c04 driver

Add ADC ads112c04 driver patch

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/iio/adc/Kconfig                    |  13 +
 drivers/iio/adc/Makefile                   |   1 +
 drivers/iio/adc/ti-ads112c04.c             | 611 +++++++++++++++++++++
 include/linux/platform_data/ti-ads112c04.h |  24 +
 4 files changed, 649 insertions(+)
 create mode 100644 drivers/iio/adc/ti-ads112c04.c
 create mode 100644 include/linux/platform_data/ti-ads112c04.h

diff --git a/drivers/iio/adc/Kconfig b/drivers/iio/adc/Kconfig
index faebf026caad..f15cd4a3edbf 100644
--- a/drivers/iio/adc/Kconfig
+++ b/drivers/iio/adc/Kconfig
@@ -1270,6 +1270,19 @@ config TI_ADS1100
 	  This driver can also be built as a module. If so, the module will be
 	  called ti-ads1100.
 
+config TI_ADS112C04
+	tristate "Texas Instruments ADS112C04 ADC"
+	depends on I2C
+	select REGMAP_I2C
+	select IIO_BUFFER
+	select IIO_TRIGGERED_BUFFER
+	help
+	  If you say yes here you get support for Texas Instruments ADS112C04
+	  ADC chip.
+
+	  This driver can also be built as a module. If so, the module will be
+	  called ti-ads112c04.
+
 config TI_ADS7950
 	tristate "Texas Instruments ADS7950 ADC driver"
 	depends on SPI && GPIOLIB
diff --git a/drivers/iio/adc/Makefile b/drivers/iio/adc/Makefile
index a684cf7141ae..8b7db2aa7190 100644
--- a/drivers/iio/adc/Makefile
+++ b/drivers/iio/adc/Makefile
@@ -111,6 +111,7 @@ obj-$(CONFIG_TI_ADC108S102) += ti-adc108s102.o
 obj-$(CONFIG_TI_ADC128S052) += ti-adc128s052.o
 obj-$(CONFIG_TI_ADC161S626) += ti-adc161s626.o
 obj-$(CONFIG_TI_ADS1015) += ti-ads1015.o
+obj-$(CONFIG_TI_ADS112C04) += ti-ads112c04.o
 obj-$(CONFIG_TI_ADS1100) += ti-ads1100.o
 obj-$(CONFIG_TI_ADS7924) += ti-ads7924.o
 obj-$(CONFIG_TI_ADS7950) += ti-ads7950.o
diff --git a/drivers/iio/adc/ti-ads112c04.c b/drivers/iio/adc/ti-ads112c04.c
new file mode 100644
index 000000000000..c21d7e2968a1
--- /dev/null
+++ b/drivers/iio/adc/ti-ads112c04.c
@@ -0,0 +1,611 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ADS112C04 - Texas Instruments Analog-to-Digital Converter
+ *
+ * Copyright 2022 Quanta Compter Inc. Eddie.Lu@QuantaTw.com
+ *
+ */
+
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/init.h>
+#include <linux/irq.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+#include <linux/pm_runtime.h>
+#include <linux/mutex.h>
+#include <linux/delay.h>
+
+#include <linux/platform_data/ti-ads112c04.h>
+
+#include <linux/iio/iio.h>
+#include <linux/iio/types.h>
+#include <linux/iio/sysfs.h>
+#include <linux/iio/events.h>
+#include <linux/iio/buffer.h>
+#include <linux/iio/triggered_buffer.h>
+#include <linux/iio/trigger_consumer.h>
+
+#define ADS112C04_DRV_NAME "ads112c04"
+
+#define ADS112C04_CFG_MOD_SHIFT	3
+#define ADS112C04_CFG_TS_SHIFT	0
+
+#define ADS112C04_CFG_GAIN_SHIFT	1
+#define ADS112C04_CFG_MUX_SHIFT	4
+#define ADS112C04_CFG_DR_SHIFT	5
+
+#define ADS112C04_CFG_MOD_MASK	BIT(3)
+#define ADS112C04_CFG_TS_MASK	BIT(0)
+#define ADS112C04_CFG_GAIN_MASK	GENMASK(3, 1)
+#define ADS112C04_CFG_MUX_MASK	GENMASK(7, 4)
+#define ADS112C04_CFG_DR_MASK	GENMASK(7, 5)
+
+#define WREG_CONF0_REG	0x40
+#define WREG_CONF1_REG	0x44
+#define WREG_CONF2_REG	0x48
+#define WREG_CONF3_REG	0x4C
+
+#define CMD_WREG	0x40
+#define CMD_RREG	0x20
+#define CMD_START_SYNC	0x08
+#define CMD_RDATA	0x10
+
+#define CONFIG0_ADDRESS	((uint8_t) 0x00)
+#define CONFIG0_PGA_BYPASS_YES_DISABLED	((uint8_t) 0x01)
+
+#define CONFIG1_ADDRESS	((uint8_t) 0x01)
+#define CONFIG1_VREF_EXT	((uint8_t) 0x02)
+
+#define CONFIG2_ADDRESS	((uint8_t) 0x02)
+#define CONFIG2_IDAC_1000u	((uint8_t) 0x06)
+#define CONFIG2_DRDY_NEW	((uint8_t) 0x80)
+
+#define CONFIG3_ADDRESS	((uint8_t) 0x03)
+#define CONFIG3_I1MUX_AIN3	((uint8_t) 0x80)
+
+
+/* device operating modes */
+#define ADS112C04_CONTINUOUS	1
+#define ADS112C04_SINGLESHOT	0
+
+#define ADS112C04_DEFAULT_GAIN		0
+#define ADS112C04_DEFAULT_DATA_RATE	0
+
+enum chip_ids {
+	ADS112C04,
+};
+
+enum ads112c04_channels {
+	ADS112C04_AIN0_AIN1 = 0,
+	ADS112C04_AIN0_AIN2,
+	ADS112C04_AIN0_AIN3,
+	ADS112C04_AIN1_AIN0,
+	ADS112C04_AIN1_AIN2,
+	ADS112C04_AIN1_AIN3,
+	ADS112C04_AIN2_AIN3,
+	ADS112C04_AIN3_AIN2,
+	ADS112C04_AIN0,
+	ADS112C04_AIN1,
+	ADS112C04_AIN2,
+	ADS112C04_AIN3,
+};
+
+static const unsigned int ads112c04_data_rate[] = {
+	20, 45, 90, 175, 330, 600, 1000
+};
+
+/*
+ * Translation from PGA bits to full-scale positive and negative input voltage
+ * range in mV
+ */
+static int ads112c04_fullscale_range[] = {
+	2048, 1024, 512, 256, 128, 64, 32, 16
+};
+
+#define ADS112C04_V_CHAN(_chan, _addr) {				\
+	.type = IIO_VOLTAGE,					\
+	.indexed = 1,						\
+	.address = _addr,					\
+	.channel = _chan,					\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |		\
+				BIT(IIO_CHAN_INFO_SCALE) |	\
+				BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
+	.scan_index = _addr,					\
+	.scan_type = {						\
+		.sign = 's',					\
+		.realbits = 16,					\
+		.storagebits = 16,				\
+		.shift = 0,					\
+		.endianness = IIO_CPU,				\
+	},							\
+	.datasheet_name = "AIN"#_chan,				\
+}
+
+#define ADS112C04_V_DIFF_CHAN(_chan, _chan2, _addr) {		\
+	.type = IIO_VOLTAGE,					\
+	.differential = 1,					\
+	.indexed = 1,						\
+	.address = _addr,					\
+	.channel = _chan,					\
+	.channel2 = _chan2,					\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |		\
+				BIT(IIO_CHAN_INFO_SCALE) |	\
+				BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
+	.scan_index = _addr,					\
+	.scan_type = {						\
+		.sign = 's',					\
+		.realbits = 16,					\
+		.storagebits = 16,				\
+		.shift = 0,					\
+		.endianness = IIO_CPU,				\
+	},							\
+	.datasheet_name = "AIN"#_chan"-AIN"#_chan2,		\
+}
+
+struct ads112c04_data {
+	struct regmap *regmap;
+	/*
+	 * Protects ADC ops, e.g: concurrent sysfs/buffered
+	 * data reads, configuration updates
+	 */
+	struct mutex lock;
+	struct ads112c04_channel_data channel_data[ADS112C04_CHANNELS];
+
+	unsigned int *data_rate;
+	/*
+	 * Set to true when the ADC is switched to the continuous-conversion
+	 * mode and exits from a power-down state.  This flag is used to avoid
+	 * getting the stale result from the conversion register.
+	 */
+	bool conv_invalid;
+	struct i2c_client *i2c;
+};
+
+static bool ads112c04_is_writeable_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case WREG_CONF0_REG:
+	case WREG_CONF1_REG:
+	case WREG_CONF2_REG:
+	case WREG_CONF3_REG:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static const struct regmap_config ads112c04_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = WREG_CONF3_REG,
+	.writeable_reg = ads112c04_is_writeable_reg,
+};
+
+static const struct iio_chan_spec ads112c04_channels[] = {
+	ADS112C04_V_DIFF_CHAN(0, 1, ADS112C04_AIN0_AIN1), //0
+	ADS112C04_V_DIFF_CHAN(0, 2, ADS112C04_AIN0_AIN2), //1
+	ADS112C04_V_DIFF_CHAN(0, 3, ADS112C04_AIN0_AIN3), //2
+	ADS112C04_V_DIFF_CHAN(1, 0, ADS112C04_AIN1_AIN0), //3
+	ADS112C04_V_DIFF_CHAN(1, 2, ADS112C04_AIN1_AIN2), //4
+	ADS112C04_V_DIFF_CHAN(1, 3, ADS112C04_AIN1_AIN3), //5
+	ADS112C04_V_DIFF_CHAN(2, 3, ADS112C04_AIN2_AIN3), //6
+	ADS112C04_V_DIFF_CHAN(3, 2, ADS112C04_AIN3_AIN2), //7
+	ADS112C04_V_CHAN(0, ADS112C04_AIN0), //8
+	ADS112C04_V_CHAN(1, ADS112C04_AIN1), //9
+	ADS112C04_V_CHAN(2, ADS112C04_AIN2), //10
+	ADS112C04_V_CHAN(3, ADS112C04_AIN3), //11
+};
+
+static
+int ads112c04_get_adc_result(struct ads112c04_data *data, int chan, int *val)
+{
+	int ret, gain, dr, dr_old, conv_time;
+	unsigned int old, mask, cfg;
+	char reg = 0;
+
+	if (chan < 0 || chan >= ADS112C04_CHANNELS)
+		return -EINVAL;
+
+	reg = CMD_RREG | (CONFIG0_ADDRESS << 2); //0x20
+	ret = regmap_read(data->regmap, reg, &old);
+	if (ret)
+		return ret;
+
+	gain = data->channel_data[chan].gain;
+	mask = ADS112C04_CFG_MUX_MASK | ADS112C04_CFG_GAIN_MASK;
+	cfg = chan << ADS112C04_CFG_MUX_SHIFT | gain << ADS112C04_CFG_GAIN_SHIFT;
+
+	cfg = (old & ~mask) | (cfg & mask);
+	if (old != cfg) {
+		reg = CMD_WREG | (CONFIG0_ADDRESS << 2); //0x40
+		ret = regmap_write(data->regmap, reg, cfg);
+		if (ret)
+			return ret;
+		data->conv_invalid = true;
+	}
+
+	reg = CMD_RREG | (CONFIG1_ADDRESS << 2); //0x24
+	ret = regmap_read(data->regmap, reg, &old);
+	if (ret)
+		return ret;
+
+	dr = data->channel_data[chan].data_rate;
+	mask = ADS112C04_CFG_DR_MASK;
+	cfg = dr << ADS112C04_CFG_DR_SHIFT;
+
+	cfg = (old & ~mask) | (cfg & mask);
+	if (old != cfg) {
+		reg = CMD_WREG | (CONFIG1_ADDRESS << 2); //0x44
+		ret = regmap_write(data->regmap, reg, cfg);
+		if (ret)
+			return ret;
+		data->conv_invalid = true;
+	}
+
+	if (data->conv_invalid) {
+		dr_old = (old & ADS112C04_CFG_DR_MASK) >> ADS112C04_CFG_DR_SHIFT;
+		conv_time = DIV_ROUND_UP(USEC_PER_SEC, data->data_rate[dr_old]);
+		conv_time += DIV_ROUND_UP(USEC_PER_SEC, data->data_rate[dr]);
+		conv_time += conv_time / 10; /* 10% internal clock inaccuracy */
+		usleep_range(conv_time, conv_time + 1);
+		data->conv_invalid = false;
+	}
+
+	reg = CMD_RREG | (CONFIG0_ADDRESS << 2); //0x20
+	return regmap_read(data->regmap, reg, val);
+}
+
+static int ads112c04_set_scale(struct ads112c04_data *data,
+			     struct iio_chan_spec const *chan,
+			     int scale, int uscale)
+{
+	int i;
+	int fullscale = div_s64((scale * 1000000LL + uscale) <<
+				(chan->scan_type.realbits - 1), 1000000);
+
+	for (i = 0; i < ARRAY_SIZE(ads112c04_fullscale_range); i++) {
+		if (ads112c04_fullscale_range[i] == fullscale) {
+			data->channel_data[chan->address].gain = i;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int ads112c04_set_data_rate(struct ads112c04_data *data, int chan, int rate)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ads112c04_data_rate); i++) {
+		if (data->data_rate[i] == rate) {
+			data->channel_data[chan].data_rate = i;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int ads112c04_read_raw(struct iio_dev *indio_dev,
+			    struct iio_chan_spec const *chan, int *val,
+			    int *val2, long mask)
+{
+	int ret, idx;
+	struct ads112c04_data *data = iio_priv(indio_dev);
+	int reg_val;
+	int swap_val;
+	char reg = 0;
+
+	mutex_lock(&data->lock);
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		ret = iio_device_claim_direct_mode(indio_dev);
+		if (ret)
+			break;
+
+		ret = ads112c04_get_adc_result(data, chan->address, val);
+		if (ret < 0)
+			goto release_direct;
+
+		/*Check if the DRDY bit conversion result is OK*/
+		reg = CMD_RREG | (CONFIG2_ADDRESS << 2); //0x28
+		regmap_read(data->regmap, reg, &reg_val);
+		reg_val = reg_val & CONFIG2_DRDY_NEW;
+		if (reg_val != CONFIG2_DRDY_NEW)
+			goto release_direct;
+
+		/*Read data command*/
+		swap_val = i2c_smbus_read_word_swapped(data->i2c, CMD_RDATA);
+		if (swap_val < 0)
+			return swap_val;
+
+		*val = swap_val;
+
+		ret = IIO_VAL_INT;
+release_direct:
+		iio_device_release_direct_mode(indio_dev);
+		break;
+	case IIO_CHAN_INFO_SCALE:
+		idx = data->channel_data[chan->address].gain;
+		*val = ads112c04_fullscale_range[idx];
+		*val2 = chan->scan_type.realbits - 1;
+		ret = IIO_VAL_INT;
+		break;
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		idx = data->channel_data[chan->address].data_rate;
+		*val = data->data_rate[idx];
+		ret = IIO_VAL_INT;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&data->lock);
+
+	return ret;
+}
+
+static int ads112c04_write_raw(struct iio_dev *indio_dev,
+			     struct iio_chan_spec const *chan, int val,
+			     int val2, long mask)
+{
+	struct ads112c04_data *data = iio_priv(indio_dev);
+	int ret;
+
+	mutex_lock(&data->lock);
+	switch (mask) {
+	case IIO_CHAN_INFO_SCALE:
+		ret = ads112c04_set_scale(data, chan, val, val2);
+		break;
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		ret = ads112c04_set_data_rate(data, chan->address, val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&data->lock);
+
+	return ret;
+}
+
+static IIO_CONST_ATTR_NAMED(ads112c04_scale_available, scale_available,
+	"1 2 4 8 16 32 64 128");
+
+static IIO_CONST_ATTR_NAMED(ads112c04_sampling_frequency_available,
+	sampling_frequency_available, "20 45 90 175 330 600 1000");
+
+static struct attribute *ads112c04_attributes[] = {
+	&iio_const_attr_ads112c04_scale_available.dev_attr.attr,
+	&iio_const_attr_ads112c04_sampling_frequency_available.dev_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group ads112c04_attribute_group = {
+	.attrs = ads112c04_attributes,
+};
+
+
+static const struct iio_info ads112c04_info = {
+	.read_raw	= ads112c04_read_raw,
+	.write_raw	= ads112c04_write_raw,
+	.attrs          = &ads112c04_attribute_group,
+};
+
+
+#ifdef CONFIG_OF
+static int ads112c04_get_channels_config_of(struct i2c_client *client)
+{
+	struct iio_dev *indio_dev = i2c_get_clientdata(client);
+	struct ads112c04_data *data = iio_priv(indio_dev);
+	struct device_node *node;
+
+	if (!client->dev.of_node ||
+	    !of_get_next_child(client->dev.of_node, NULL))
+		return -EINVAL;
+
+	for_each_child_of_node(client->dev.of_node, node) {
+		u32 pval;
+		unsigned int channel;
+		unsigned int gain = ADS112C04_DEFAULT_GAIN;
+		unsigned int data_rate = ADS112C04_DEFAULT_DATA_RATE;
+
+		if (of_property_read_u32(node, "reg", &pval)) {
+			dev_err(&client->dev, "invalid reg on %pOF\n",
+				node);
+			continue;
+		}
+
+		channel = pval;
+		if (channel >= ADS112C04_CHANNELS) {
+			dev_err(&client->dev,
+				"invalid channel index %d on %pOF\n",
+				channel, node);
+			continue;
+		}
+
+		if (!of_property_read_u32(node, "ti,gain", &pval)) {
+			gain = pval;
+			if (gain > 7) {
+				dev_err(&client->dev, "invalid gain on %pOF\n",
+					node);
+				of_node_put(node);
+				return -EINVAL;
+			}
+		}
+
+		if (!of_property_read_u32(node, "ti,datarate", &pval)) {
+			data_rate = pval;
+			if (data_rate > 7) {
+				dev_err(&client->dev,
+					"invalid data_rate on %pOF\n",
+					node);
+				of_node_put(node);
+				return -EINVAL;
+			}
+		}
+
+		data->channel_data[channel].gain = gain;
+		data->channel_data[channel].data_rate = data_rate;
+	}
+
+	return 0;
+}
+#endif
+
+static void ads112c04_get_channels_config(struct i2c_client *client)
+{
+	unsigned int k;
+
+	struct iio_dev *indio_dev = i2c_get_clientdata(client);
+	struct ads112c04_data *data = iio_priv(indio_dev);
+	struct ads112c04_platform_data *pdata = dev_get_platdata(&client->dev);
+
+	/* prefer platform data */
+	if (pdata) {
+		memcpy(data->channel_data, pdata->channel_data,
+		       sizeof(data->channel_data));
+		return;
+	}
+
+#ifdef CONFIG_OF
+	if (!ads112c04_get_channels_config_of(client))
+		return;
+#endif
+	/* fallback on default configuration */
+	for (k = 0; k < ADS112C04_CHANNELS; ++k) {
+		data->channel_data[k].gain = ADS112C04_DEFAULT_GAIN;
+		data->channel_data[k].data_rate = ADS112C04_DEFAULT_DATA_RATE;
+	}
+}
+
+static int ads112c04_set_conv_mode(struct ads112c04_data *data, int mode)
+{
+	char reg = CMD_WREG | (CONFIG1_ADDRESS << 2); //0x44
+
+	return regmap_update_bits(data->regmap, reg,
+				  ADS112C04_CFG_MOD_MASK,
+				  mode << ADS112C04_CFG_MOD_SHIFT);
+}
+
+static int ads112c04_probe(struct i2c_client *client)
+{
+	struct iio_dev *indio_dev;
+	struct ads112c04_data *data;
+	int ret;
+	enum chip_ids chip;
+
+	char reg = 0;
+
+	indio_dev = devm_iio_device_alloc(&client->dev, sizeof(*data));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	data = iio_priv(indio_dev);
+	i2c_set_clientdata(client, indio_dev);
+	data->i2c = client;
+	mutex_init(&data->lock);
+
+	indio_dev->dev.parent = &client->dev;
+	indio_dev->dev.of_node = client->dev.of_node;
+	indio_dev->name = ADS112C04_DRV_NAME;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+
+	if (client->dev.of_node)
+		chip = (enum chip_ids)of_device_get_match_data(&client->dev);
+
+	switch (chip) {
+	case ADS112C04:
+		indio_dev->channels = ads112c04_channels;
+		indio_dev->num_channels = ARRAY_SIZE(ads112c04_channels);
+		indio_dev->info = &ads112c04_info;
+		data->data_rate = (unsigned int *) &ads112c04_data_rate;
+		break;
+	}
+
+	/* we need to keep this ABI the same as used by hwmon ADS112C04 driver */
+	ads112c04_get_channels_config(client);
+
+	data->regmap = devm_regmap_init_i2c(client, &ads112c04_regmap_config);
+	if (IS_ERR(data->regmap)) {
+		dev_err(&client->dev, "Failed to allocate register map\n");
+		return PTR_ERR(data->regmap);
+	}
+
+	ret = ads112c04_set_conv_mode(data, ADS112C04_CONTINUOUS);
+	if (ret)
+		return ret;
+
+	/*VREF setting*/
+	int reg_val = 0;
+
+	reg = CMD_RREG | (CONFIG1_ADDRESS << 2); //0x24
+	regmap_read(data->regmap, reg, &reg_val);
+	reg_val = reg_val | CONFIG1_VREF_EXT; //0x02
+	reg = CMD_WREG | (CONFIG1_ADDRESS << 2); //0x44
+	i2c_smbus_write_byte_data(data->i2c, reg, reg_val);
+
+
+	data->conv_invalid = true;
+
+	/*Start or restart conversions command*/
+	i2c_smbus_write_byte(data->i2c, CMD_START_SYNC);
+
+	ret = iio_device_register(indio_dev);
+	if (ret < 0) {
+		dev_err(&client->dev, "Failed to register IIO device\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void ads112c04_remove(struct i2c_client *client)
+{
+	struct iio_dev *indio_dev = i2c_get_clientdata(client);
+	struct ads112c04_data *data = iio_priv(indio_dev);
+	int val;
+
+	iio_device_unregister(indio_dev);
+
+	pm_runtime_disable(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+	pm_runtime_put_noidle(&client->dev);
+
+	/* power down single shot mode */
+	val = ads112c04_set_conv_mode(data, ADS112C04_SINGLESHOT);
+}
+
+static const struct i2c_device_id ads112c04_id[] = {
+	{"ads112c04", ADS112C04},
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, ads112c04_id);
+
+static const struct of_device_id ads112c04_of_match[] = {
+	{
+		.compatible = "ti,ads112c04",
+		.data = (void *)ADS112C04
+	},
+	{}
+};
+MODULE_DEVICE_TABLE(of, ads112c04_of_match);
+
+static struct i2c_driver ads112c04_driver = {
+	.driver = {
+		.name = ADS112C04_DRV_NAME,
+		.of_match_table = ads112c04_of_match,
+	},
+	.probe	= ads112c04_probe,
+	.remove		= ads112c04_remove,
+	.id_table	= ads112c04_id,
+};
+
+module_i2c_driver(ads112c04_driver);
+
+MODULE_AUTHOR("Eddie Lu <Eddie.Lu@QuantaTw.com>");
+MODULE_DESCRIPTION("Texas Instruments ADS112C04 ADC driver");
+MODULE_LICENSE("GPL");
