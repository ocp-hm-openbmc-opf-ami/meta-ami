From 86372f4217af871812b54941584ccccf5870b8b0 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Fri, 19 Sep 2025 10:12:06 +0530
Subject: [PATCH] hw/i2c:nuvoton: expose bus timeout as device tree property

Exposed the I2C bus timeout and retries as a device tree property to allow for
fine tuning the max time allowed per I2C transaction.

Signed-off-by: saikumaru <saikumaru@ami.com>
Upstream-Status: Backport [Nuvoton SDK/ASPEED SDK migration (git commit cb052d637)]
---
 drivers/i2c/busses/i2c-npcm7xx.c | 23 ++++++++++++++---------
 1 file changed, 14 insertions(+), 9 deletions(-)

diff --git a/drivers/i2c/busses/i2c-npcm7xx.c b/drivers/i2c/busses/i2c-npcm7xx.c
index 8396a14596b6..08c39eb81b62 100644
--- a/drivers/i2c/busses/i2c-npcm7xx.c
+++ b/drivers/i2c/busses/i2c-npcm7xx.c
@@ -2405,7 +2405,7 @@ static int npcm_i2c_master_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
 		return -EINVAL;
 	}
 
-	time_left = jiffies + bus->adap.timeout / bus->adap.retries + 1;
+	time_left = jiffies + bus->adap.timeout + 1;
 	do {
 		/*
 		 * we must clear slave address immediately when the bus is not
@@ -2475,7 +2475,7 @@ static int npcm_i2c_master_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
 		 * 9: bits per transaction (including the ack/nack)
 		 */
 		timeout_usec = (2 * 9 * USEC_PER_SEC / bus->bus_freq) * (2 + nread + nwrite);
-		timeout = max_t(unsigned long, bus->adap.timeout / bus->adap.retries,
+		timeout = max_t(unsigned long, bus->adap.timeout,
 				usecs_to_jiffies(timeout_usec));
 		time_left = wait_for_completion_timeout(&bus->cmd_complete,
 							timeout);
@@ -2617,6 +2617,8 @@ static int npcm_i2c_probe_bus(struct platform_device *pdev)
 	struct clk *i2c_clk;
 	int irq;
 	int ret;
+	int bus_timeout;
+	int bus_retries;
 
 	bus = devm_kzalloc(&pdev->dev, sizeof(*bus), GFP_KERNEL);
 	if (!bus)
@@ -2654,13 +2656,6 @@ static int npcm_i2c_probe_bus(struct platform_device *pdev)
 
 	adap = &bus->adap;
 	adap->owner = THIS_MODULE;
-	adap->retries = 3;
-	/*
-	 * The users want to connect a lot of masters on the same bus.
-	 * This timeout is used to determine the time it takes to take bus ownership.
-	 * The transactions are very long, so waiting 35ms is not enough.
-	 */
-	adap->timeout = 2 * HZ;
 	adap->algo = &npcm_i2c_algo;
 	adap->quirks = &npcm_i2c_quirks;
 	adap->algo_data = bus;
@@ -2668,6 +2663,16 @@ static int npcm_i2c_probe_bus(struct platform_device *pdev)
 	adap->dev.of_node = pdev->dev.of_node;
 	adap->nr = pdev->id;
 
+	ret = of_property_read_s32(pdev->dev.of_node,
+				   "bus-timeout-ms", &bus_timeout);
+	// default is 2 seconds (HZ == # of jiffies per second)
+	adap->timeout = (ret < 0) ? 2 * HZ : msecs_to_jiffies(bus_timeout);
+
+	ret = of_property_read_s32(pdev->dev.of_node,
+				   "bus-retries", &bus_retries);
+	adap->retries = (ret < 0) ? 3 : bus_retries;
+
+
 	irq = platform_get_irq(pdev, 0);
 	if (irq < 0)
 		return irq;
-- 
