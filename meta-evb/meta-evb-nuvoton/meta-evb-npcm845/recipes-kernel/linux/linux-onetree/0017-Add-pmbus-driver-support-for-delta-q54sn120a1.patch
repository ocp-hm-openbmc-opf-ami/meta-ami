From 9429b81bf6e4fcec4a7a464364c9b6952a84b940 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 14:57:40 +0530
Subject: [PATCH] Add pmbus driver support for delta q54sn120a1

Add pmbus driver support for delta q54sn120a1

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/Kconfig      | 10 +++++
 drivers/hwmon/pmbus/Makefile     |  1 +
 drivers/hwmon/pmbus/q54sn120a1.c | 77 ++++++++++++++++++++++++++++++++
 3 files changed, 88 insertions(+)
 create mode 100644 drivers/hwmon/pmbus/q54sn120a1.c

diff --git a/drivers/hwmon/pmbus/Kconfig b/drivers/hwmon/pmbus/Kconfig
index c244294cb90d..2eb87b4ba4c9 100644
--- a/drivers/hwmon/pmbus/Kconfig
+++ b/drivers/hwmon/pmbus/Kconfig
@@ -457,6 +457,16 @@ config SENSORS_Q54SJ108A2
 	  This driver can also be built as a module. If so, the module will
 	  be called q54sj108a2.
 
+config SENSORS_Q54SN120A1
+	tristate "Delta Power Brick Q54SN120A1"
+	help
+	  If you say yes here you get hardware monitoring support for Delta
+	  Q54SN120A1.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called q54sn120a1.
+
+
 config SENSORS_STPDDC60
 	tristate "ST STPDDC60"
 	help
diff --git a/drivers/hwmon/pmbus/Makefile b/drivers/hwmon/pmbus/Makefile
index 0aebfc02243e..499740d10748 100644
--- a/drivers/hwmon/pmbus/Makefile
+++ b/drivers/hwmon/pmbus/Makefile
@@ -45,6 +45,7 @@ obj-$(CONFIG_SENSORS_PLI1209BC)	+= pli1209bc.o
 obj-$(CONFIG_SENSORS_PM6764TR)	+= pm6764tr.o
 obj-$(CONFIG_SENSORS_PXE1610)	+= pxe1610.o
 obj-$(CONFIG_SENSORS_Q54SJ108A2)	+= q54sj108a2.o
+obj-$(CONFIG_SENSORS_Q54SN120A1)	+= q54sn120a1.o
 obj-$(CONFIG_SENSORS_STPDDC60)	+= stpddc60.o
 obj-$(CONFIG_SENSORS_TDA38640)	+= tda38640.o
 obj-$(CONFIG_SENSORS_TPS25990)	+= tps25990.o
diff --git a/drivers/hwmon/pmbus/q54sn120a1.c b/drivers/hwmon/pmbus/q54sn120a1.c
new file mode 100644
index 000000000000..03ff0f75196e
--- /dev/null
+++ b/drivers/hwmon/pmbus/q54sn120a1.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Driver for the DELTA q54sn120a1
+ */
+
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pmbus.h>
+#include "pmbus.h"
+
+
+static struct pmbus_driver_info q54sn120a1_info = {
+	.pages = 1,
+	.format[PSC_VOLTAGE_IN] = linear,
+	.format[PSC_VOLTAGE_OUT] = linear,
+	.format[PSC_TEMPERATURE] = linear,
+	.format[PSC_CURRENT_OUT] = linear,
+	.func[0] = PMBUS_HAVE_VIN | PMBUS_HAVE_STATUS_INPUT
+		| PMBUS_HAVE_TEMP | PMBUS_HAVE_STATUS_TEMP
+		| PMBUS_HAVE_VOUT | PMBUS_HAVE_STATUS_VOUT
+		| PMBUS_HAVE_IOUT | PMBUS_HAVE_STATUS_IOUT,
+};
+
+static int q54sn120a1_probe(struct i2c_client *client)
+{
+	int ret;
+	u8 block_buffer[I2C_SMBUS_BLOCK_MAX];
+	struct pmbus_driver_info *pmbus_info;
+
+	ret = i2c_smbus_read_block_data(client, PMBUS_MFR_ID, block_buffer);
+	if (ret < 0) {
+		dev_err(&client->dev, "Failed to read Manufacturer ID\n");
+		return ret;
+	} else if (ret != 5 || strncmp(block_buffer, "DELTA", strlen("DELTA"))) {
+		dev_info(&client->dev, "Found %s chip\n", client->name);
+	} else {
+		dev_err(&client->dev, "%s probe failed\n", client->name);
+		return -ENODEV;
+	}
+
+	pmbus_info = devm_kzalloc(&client->dev, sizeof(*pmbus_info), GFP_KERNEL);
+	if (!pmbus_info)
+		return -ENOMEM;
+
+	memcpy(pmbus_info, &q54sn120a1_info, sizeof(struct pmbus_driver_info));
+
+	return pmbus_do_probe(client, pmbus_info);
+}
+
+static const struct i2c_device_id q54sn120a1_id[] = {
+	{ "q54sn120a1", 0 },
+	{ },
+};
+MODULE_DEVICE_TABLE(i2c, q54sn120a1_id);
+
+static const struct of_device_id q54sn120a1_of_match[] = {
+	{ .compatible = "delta,q54sn120a1" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, q54sn120a1_of_match);
+
+static struct i2c_driver q54sn120a1_driver = {
+	.driver = {
+		.name = "q54sn120a1",
+		.of_match_table = q54sn120a1_of_match,
+	},
+	.probe_new	= q54sn120a1_probe,
+	.id_table	= q54sn120a1_id,
+};
+
+module_i2c_driver(q54sn120a1_driver);
+
+MODULE_AUTHOR("Alan Kuo <Alan_Kuo@quantatw.com>");
+MODULE_DESCRIPTION("delta q54sn120a1 driver");
+MODULE_LICENSE("GPL");
+
-- 
2.47.1

