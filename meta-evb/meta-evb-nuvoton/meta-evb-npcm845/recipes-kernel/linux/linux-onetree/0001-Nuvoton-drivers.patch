-	u32 mask, val;
-
-	mask = cp == 0 ? GENMASK(1, 0) : GENMASK(3, 2);
-
-	switch (ldo_volt) {
-	case 1000000:
-		val = 0x00;
-		break;
-	case 1100000:
-		val = 0x01;
-		break;
-	case 1200000:
-		val = 0x02;
-		break;
-	case 1800000:
-		val = 0x03;
-		break;
-	default:
-		return -EINVAL;
-	};
-
-	val = cp == 0 ? val : val << 2;
-
-	return regmap_update_bits(hub->regmap, HUB_REG_LDO_CONF, mask, val);
-}
