-		return -EIO;
-	}
-
-	hub->hub_pin_sel_id = CP_SEL_PIN_INPUT_CODE_GET(reg_val);
-	hub->hub_pin_cp1_id = CP_SDA1_SCL1_PINS_CODE_GET(reg_val);
