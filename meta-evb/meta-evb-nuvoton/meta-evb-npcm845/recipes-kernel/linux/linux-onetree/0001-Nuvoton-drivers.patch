-static const struct i3c_hub_devdata *i3c_hub_find_device(u16 part_id)
-{
-	unsigned int i;
-
-	for (i = 0; i < ARRAY_SIZE(i3c_hub_devs); i++) {
-		const struct i3c_hub_devdata *d = &i3c_hub_devs[i];
-
-		if (d->part_id == part_id)
-			return d;
-	}
-
-	return NULL;
