From 2b972acf7157e423ca99d8be9e797831c9b5737f Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 11:14:08 +0530
Subject: [PATCH] Modify driver hwmon pmbus isl68137 Add sensor support

Modify driver to support ISL68137 chip.

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/isl68137.c | 62 ++++++++++++++++++++++++++++++++--
 1 file changed, 60 insertions(+), 2 deletions(-)

diff --git a/drivers/hwmon/pmbus/isl68137.c b/drivers/hwmon/pmbus/isl68137.c
index 7e53fb1d5ea3..b00343a18c59 100644
--- a/drivers/hwmon/pmbus/isl68137.c
+++ b/drivers/hwmon/pmbus/isl68137.c
@@ -15,6 +15,7 @@
 #include <linux/module.h>
 #include <linux/string.h>
 #include <linux/sysfs.h>
+#include <linux/of_device.h>
 
 #include "pmbus.h"
 
@@ -223,13 +224,21 @@ static struct pmbus_driver_info raa_dmpvr_info = {
 static int isl68137_probe(struct i2c_client *client)
 {
 	struct pmbus_driver_info *info;
+	struct device *dev = &client->dev;
+	int data;
+
 
 	info = devm_kzalloc(&client->dev, sizeof(*info), GFP_KERNEL);
 	if (!info)
 		return -ENOMEM;
 	memcpy(info, &raa_dmpvr_info, sizeof(*info));
 
-	switch (i2c_match_id(raa_dmpvr_id, client)->driver_data) {
+	if (dev->of_node)
+		data = (enum variants)of_device_get_match_data(dev);
+	else
+		data = i2c_match_id(raa_dmpvr_id, client)->driver_data;
+
+	switch (data) {
 	case raa_dmpvr1_2rail:
 		info->pages = 2;
 		info->R[PSC_VOLTAGE_IN] = 3;
@@ -313,16 +322,65 @@ static const struct i2c_device_id raa_dmpvr_id[] = {
 	{"raa228228", raa_dmpvr2_2rail_nontc},
 	{"raa229001", raa_dmpvr2_2rail},
 	{"raa229004", raa_dmpvr2_2rail},
+	{"raa229126", raa_dmpvr2_2rail},
 	{}
 };
 
 MODULE_DEVICE_TABLE(i2c, raa_dmpvr_id);
 
+static const struct of_device_id __maybe_unused isl68137_of_match[] = {
+	{.compatible = "isl68137", .data = (void *)raa_dmpvr1_2rail,},
+	{.compatible = "isl68220", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl68221", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl68222", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl68223", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl68224", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl68225", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl68226", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl68227", .data = (void *)raa_dmpvr2_1rail,},
+	{.compatible = "isl68229", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl68233", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl68239", .data = (void *)raa_dmpvr2_3rail,},
+
+	{.compatible = "isl69222", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69223", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl69224", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69225", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69227", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl69228", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl69234", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69236", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69239", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl69242", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69243", .data = (void *)raa_dmpvr2_1rail,},
+	{.compatible = "isl69247", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69248", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69254", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69255", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69256", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69259", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69260", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69268", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "isl69269", .data = (void *)raa_dmpvr2_3rail,},
+	{.compatible = "isl69298", .data = (void *)raa_dmpvr2_2rail,},
+
+	{.compatible = "raa228000", .data = (void *)raa_dmpvr2_hv,},
+	{.compatible = "raa228004", .data = (void *)raa_dmpvr2_hv,},
+	{.compatible = "raa228006", .data = (void *)raa_dmpvr2_hv,},
+	{.compatible = "raa228228", .data = (void *)raa_dmpvr2_2rail_nontc,},
+	{.compatible = "raa229001", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "raa229004", .data = (void *)raa_dmpvr2_2rail,},
+	{.compatible = "raa229126", .data = (void *)raa_dmpvr2_2rail,},
+	{}
+};
+MODULE_DEVICE_TABLE(of, isl68137_of_match);
+
 /* This is the driver that will be inserted */
 static struct i2c_driver isl68137_driver = {
 	.driver = {
 		   .name = "isl68137",
-		   },
+		   .of_match_table = isl68137_of_match,
+	},
 	.probe = isl68137_probe,
 	.id_table = raa_dmpvr_id,
 };
