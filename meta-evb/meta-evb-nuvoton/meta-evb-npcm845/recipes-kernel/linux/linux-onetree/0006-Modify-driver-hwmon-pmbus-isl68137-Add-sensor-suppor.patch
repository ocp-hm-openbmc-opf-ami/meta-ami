From 2b972acf7157e423ca99d8be9e797831c9b5737f Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 11:14:08 +0530
Subject: [PATCH] Modify driver hwmon pmbus isl68137 Add sensor support

Modify driver to support ISL68137 chip.

Signed-off-by: saikumaru <saikumaru@ami.com>
Upstream-Status: Backport [Nuvoton SDK/ASPEED SDK migration (git commit cb052d637)]
---
 drivers/hwmon/pmbus/isl68137.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/drivers/hwmon/pmbus/isl68137.c b/drivers/hwmon/pmbus/isl68137.c
index ab54184b4878..fa59489328f9 100644
--- a/drivers/hwmon/pmbus/isl68137.c
+++ b/drivers/hwmon/pmbus/isl68137.c
@@ -16,6 +16,7 @@
 #include <linux/of.h>
 #include <linux/string.h>
 #include <linux/sysfs.h>
+#include <linux/of_device.h>
 
 #include "pmbus.h"
 
@@ -373,7 +374,7 @@ static int isl68137_probe(struct i2c_client *client)
 	struct device *dev = &client->dev;
 	struct pmbus_driver_info *info;
 	struct isl68137_data *data;
-	int i, err;
+	int i, err, dat;
 
 	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
 	if (!data)
@@ -391,7 +392,12 @@ static int isl68137_probe(struct i2c_client *client)
 	memcpy(&data->info, &raa_dmpvr_info, sizeof(data->info));
 	info = &data->info;
 
-	switch (i2c_match_id(raa_dmpvr_id, client)->driver_data) {
+	if (dev->of_node)
+		dat = (enum variants)of_device_get_match_data(dev);
+	else
+		dat = i2c_match_id(raa_dmpvr_id, client)->driver_data;
+
+	switch (dat) {
 	case raa_dmpvr1_2rail:
 		info->pages = 2;
 		info->R[PSC_VOLTAGE_IN] = 3;
@@ -488,6 +494,7 @@ static const struct i2c_device_id raa_dmpvr_id[] = {
 	{"raa229001", raa_dmpvr2_2rail},
 	{"raa229004", raa_dmpvr2_2rail},
 	{"raa229621", raa_dmpvr2_2rail},
+	{"raa229126", raa_dmpvr2_2rail},
 	{}
 };
 
