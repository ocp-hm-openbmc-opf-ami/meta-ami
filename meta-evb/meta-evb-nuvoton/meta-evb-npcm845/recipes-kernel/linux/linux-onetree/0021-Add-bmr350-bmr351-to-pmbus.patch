From b5c17b1ea5f0bd6d46ad8fa9048316176854f0d7 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 15:22:29 +0530
Subject: [PATCH] Add bmr350, bmr351 to pmbus

Add bmr350, bmr351 to pmbus

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/pmbus.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/hwmon/pmbus/pmbus.c b/drivers/hwmon/pmbus/pmbus.c
index 87136d9b17d0..deffcb4cb56a 100644
--- a/drivers/hwmon/pmbus/pmbus.c
+++ b/drivers/hwmon/pmbus/pmbus.c
@@ -231,6 +231,8 @@ static const struct i2c_device_id pmbus_id[] = {
 	{"bmr480", (kernel_ulong_t)&pmbus_info_one_status},
 	{"bmr490", (kernel_ulong_t)&pmbus_info_one_status},
 	{"bmr491", (kernel_ulong_t)&pmbus_info_one_status},
+	{"bmr350", (kernel_ulong_t)&pmbus_info_one_status},
+	{"bmr351", (kernel_ulong_t)&pmbus_info_one_status},
 	{"bmr492", (kernel_ulong_t)&pmbus_info_one},
 	{"dps460", (kernel_ulong_t)&pmbus_info_one_skip},
 	{"dps650ab", (kernel_ulong_t)&pmbus_info_one_skip},
@@ -269,6 +271,8 @@ static const struct of_device_id __maybe_unused pmbus_of_match[] = {
 	{.compatible = "bmr480", .data = &pmbus_info_one_status,},
 	{.compatible = "bmr490", .data = &pmbus_info_one_status,},
 	{.compatible = "bmr491", .data = &pmbus_info_one_status,},
+	{.compatible = "bmr350", .data = &pmbus_info_one_status,},
+	{.compatible = "bmr351", .data = &pmbus_info_one_status,},
 	{.compatible = "bmr492", .data = &pmbus_info_one,},
 	{.compatible = "dps460", .data = &pmbus_info_one_skip,},
 	{.compatible = "dps650ab", .data = &pmbus_info_one_skip,},
-- 
