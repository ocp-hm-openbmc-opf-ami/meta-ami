From 14585027815d49353a20bc29697261c6829cb55e Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 15:18:07 +0530
Subject: [PATCH] Add to hwmon for support TPS25990A and TPS546D24A to pmbus
 driver

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/pmbus.c      | 7 ++++++-
 drivers/hwmon/pmbus/pmbus_core.c | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/drivers/hwmon/pmbus/pmbus.c b/drivers/hwmon/pmbus/pmbus.c
index 114986268bf9..87136d9b17d0 100644
--- a/drivers/hwmon/pmbus/pmbus.c
+++ b/drivers/hwmon/pmbus/pmbus.c
@@ -124,7 +124,7 @@ static int pmbus_identify(struct i2c_client *client,
 
 		vout_mode = pmbus_read_byte_data(client, 0, PMBUS_VOUT_MODE);
 		if (vout_mode >= 0 && vout_mode != 0xff) {
-			switch (vout_mode >> 5) {
+			switch ((vout_mode >> 5) & 0x3) {
 			case 0:
 				break;
 			case 1:
@@ -249,6 +249,8 @@ static const struct i2c_device_id pmbus_id[] = {
 	{"tps544b25", (kernel_ulong_t)&pmbus_info_one},
 	{"tps544c20", (kernel_ulong_t)&pmbus_info_one},
 	{"tps544c25", (kernel_ulong_t)&pmbus_info_one},
+	{"tps546d24a", (kernel_ulong_t)&pmbus_info_one},
+	{"tps25990a", (kernel_ulong_t)&pmbus_info_one},
 	{"udt020", (kernel_ulong_t)&pmbus_info_one},
 	{}
 };
@@ -285,6 +287,9 @@ static const struct of_device_id __maybe_unused pmbus_of_match[] = {
 	{.compatible = "tps544b25", .data = &pmbus_info_one,},
 	{.compatible = "tps544c20", .data = &pmbus_info_one,},
 	{.compatible = "tps544c25", .data = &pmbus_info_one,},
+	{.compatible = "tps546d24a", .data = &pmbus_info_one,},
+	{.compatible = "tps25990a", .data = &pmbus_info_one,},
+
 	{.compatible = "udt020", .data = &pmbus_info_one,},
 	{}
 };
diff --git a/drivers/hwmon/pmbus/pmbus_core.c b/drivers/hwmon/pmbus/pmbus_core.c
index 97712bb2b1f9..d276d8ef8ead 100644
--- a/drivers/hwmon/pmbus/pmbus_core.c
+++ b/drivers/hwmon/pmbus/pmbus_core.c
@@ -2536,7 +2536,7 @@ static int pmbus_identify_common(struct i2c_client *client,
 		 * Not all chips support the VOUT_MODE command,
 		 * so a failure to read it is not an error.
 		 */
-		switch (vout_mode >> 5) {
+		switch ((vout_mode >> 5) & 0x3) {
 		case 0:	/* linear mode      */
 			if (data->info->format[PSC_VOLTAGE_OUT] != linear)
 				return -ENODEV;
-- 
2.47.1

