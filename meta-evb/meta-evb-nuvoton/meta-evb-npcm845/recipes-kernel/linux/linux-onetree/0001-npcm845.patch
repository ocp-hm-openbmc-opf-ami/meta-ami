diff --git a/drivers/i3c/Kconfig b/drivers/i3c/Kconfig
index 5816a03effbc..fe6093cd4973 100644
--- a/drivers/i3c/Kconfig
+++ b/drivers/i3c/Kconfig
@@ -21,6 +21,8 @@ menuconfig I3C
 
