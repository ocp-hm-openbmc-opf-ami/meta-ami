From 2c4636fc57a0c35b0b4ced5e723912ddfcdf6224 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 15:36:44 +0530
Subject: [PATCH] Add pmbus driver for Delta Power Brick

Add pmbus driver for Delta E54SW12072 and U50SU4P180

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/Kconfig      |  9 ++++++
 drivers/hwmon/pmbus/Makefile     |  1 +
 drivers/hwmon/pmbus/e54sw12072.c | 55 ++++++++++++++++++++++++++++++++
 3 files changed, 65 insertions(+)
 create mode 100644 drivers/hwmon/pmbus/e54sw12072.c

diff --git a/drivers/hwmon/pmbus/Kconfig b/drivers/hwmon/pmbus/Kconfig
index 2eb87b4ba4c9..e50543e3375c 100644
--- a/drivers/hwmon/pmbus/Kconfig
+++ b/drivers/hwmon/pmbus/Kconfig
@@ -610,4 +610,13 @@ config SENSORS_ZL6100
 	  This driver can also be built as a module. If so, the module will
 	  be called zl6100.
 
+config SENSORS_E54SW12072
+	tristate "Delta Power Brick DC/DC Converter"
+	help
+	  If you say yes here you get hardware monitoring support for Delta
+	  Power Brick DC/DC Converter, such as E54SW12072 and U50SU4P180.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called e54sw12072.
+
 endif # PMBUS
diff --git a/drivers/hwmon/pmbus/Makefile b/drivers/hwmon/pmbus/Makefile
index 499740d10748..a36f05617cf9 100644
--- a/drivers/hwmon/pmbus/Makefile
+++ b/drivers/hwmon/pmbus/Makefile
@@ -60,4 +60,5 @@ obj-$(CONFIG_SENSORS_XDPE122)	+= xdpe12284.o
 obj-$(CONFIG_SENSORS_XDPE152)	+= xdpe152c4.o
 obj-$(CONFIG_SENSORS_ZL6100)	+= zl6100.o
 obj-$(CONFIG_SENSORS_PIM4328)	+= pim4328.o
+obj-$(CONFIG_SENSORS_E54SW12072)	+= e54sw12072.o
 obj-$(CONFIG_SENSORS_CRPS)	+= crps.o
diff --git a/drivers/hwmon/pmbus/e54sw12072.c b/drivers/hwmon/pmbus/e54sw12072.c
new file mode 100644
index 000000000000..a1e139f5dadf
--- /dev/null
+++ b/drivers/hwmon/pmbus/e54sw12072.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Driver for Delta Power Brick DC/DC Converter
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include "pmbus.h"
+
+static struct pmbus_driver_info e54sw12072_info = {
+	.pages = 1,
+
+	.format[PSC_VOLTAGE_IN] = linear,
+	.format[PSC_VOLTAGE_OUT] = linear,
+	.format[PSC_CURRENT_OUT] = linear,
+	.format[PSC_TEMPERATURE] = linear,
+
+	.func[0] = PMBUS_HAVE_VIN | PMBUS_HAVE_VOUT |
+			PMBUS_HAVE_IOUT | PMBUS_HAVE_TEMP |
+			PMBUS_HAVE_STATUS_VOUT | PMBUS_HAVE_STATUS_IOUT |
+			PMBUS_HAVE_STATUS_INPUT,
+};
+
+static int e54sw12072_probe(struct i2c_client *client)
+{
+	if (!i2c_check_functionality(client->adapter,
+					I2C_FUNC_SMBUS_BYTE_DATA |
+					I2C_FUNC_SMBUS_WORD_DATA))
+		return -ENODEV;
+
+	return pmbus_do_probe(client, &e54sw12072_info);
+}
+
+static const struct of_device_id __maybe_unused e54sw12072_of_match[] = {
+	{ .compatible = "delta,e54sw12072", },
+	{ .compatible = "delta,u50su4p180",}
+};
+
+MODULE_DEVICE_TABLE(of, e54sw12072_of_match);
+
+static struct i2c_driver e54sw12072_driver = {
+	.driver = {
+			.name = "e54sw12072",
+			.of_match_table = of_match_ptr(e54sw12072_of_match),
+	},
+	.probe_new = e54sw12072_probe,
+};
+
+module_i2c_driver(e54sw12072_driver);
+
+MODULE_AUTHOR("Bob Chen <bob.chen@quantatw.com>");
+MODULE_DESCRIPTION("PMBus driver for Delta E54SW12072");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS(PMBUS);
-- 
2.47.1

