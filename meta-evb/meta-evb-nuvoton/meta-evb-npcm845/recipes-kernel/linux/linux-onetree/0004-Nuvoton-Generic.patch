 		if (!blk_queue_skip_tagset_quiesce(q))
 			blk_mq_quiesce_queue_nowait(q);
 	}
-	rcu_read_unlock();
+	mutex_unlock(&set->tag_list_lock);
 
 	blk_mq_wait_quiesce_done(set);
 }
@@ -294,12 +294,12 @@ void blk_mq_unquiesce_tagset(struct blk_mq_tag_set *set)
 {
