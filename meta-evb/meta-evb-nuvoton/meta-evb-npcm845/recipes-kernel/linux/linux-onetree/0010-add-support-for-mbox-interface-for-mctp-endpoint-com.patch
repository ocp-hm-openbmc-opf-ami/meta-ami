diff --git a/drivers/soc/nuvoton/npcm-cerberus-mctp.c b/drivers/soc/nuvoton/npcm-cerberus-mctp.c
new file mode 100644
index 000000000000..affa7446073e
--- /dev/null
+++ b/drivers/soc/nuvoton/npcm-cerberus-mctp.c
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2022, Microsoft Corporation
+/*
+ * This driver provides DSP0237-type MCTP-over-i2c transport binding for
+ * a cerberus MCTP endpoint communication.
+ */
+
+#define pr_fmt(fmt) "cerberus-mctp-mbox: " fmt
+
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mailbox_client.h>
+#include <linux/of_device.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/if_arp.h>
+#include <linux/i2c.h>
+#include <net/mctp.h>
+
+#define CREATE_TRACE_POINTS
+#include "trace-mctp-mbox.h"
+
+/* byte_count is limited to u8 */
+#define MCTP_I2C_MAXBLOCK 255
+/* One byte is taken by source_slave */
+#define MCTP_I2C_MAXMTU (MCTP_I2C_MAXBLOCK - 1)
+#define MCTP_I2C_MINMTU (64 + 4)
+/* Allow space for dest_address, command, byte_count, data, PEC */
+#define MCTP_I2C_BUFSZ (3 + MCTP_I2C_MAXBLOCK + 1)
+
+#define MCTP_I2C_COMMANDCODE 0x0f
+
+/* Sufficient for 64kB at min mtu */
+#define MCTP_I2C_TX_QUEUE_LEN 1100
+
+/*
+ * Define the staging buffer size in bytes.
+ * Size should be <= Read or Write shmem window size and >= MCTP_I2C_BUFSZ
+ */
+#define MCTP_MBOX_BUFSZ 2048
+
+#if MCTP_MBOX_BUFSZ < MCTP_I2C_BUFSZ
+#error "Invalid staging buf size"
+#endif
+
+/**
+ * struct chan_shmem - mbx channel's shmem info
+ *
+ * @off: IO memory offset address of shmem
+ * @size: Size of the shmem region
+ */
+struct mbx_shmem {
+	u8 __iomem *off;
+	size_t size;
+};
+
+/* struct mctp_cerberus_dev- The private cerberus netdev structure
+ *
+ * @ndev: Reference to netdev structure
+ * @pdev: Reference to platform device
+ * @lladdr : Local mctp endoint addr
+ * @cl: Cerberus mbox client info
+ * @chan: Mailbox channel info
+ * @rd_win: Mailbox shmem read window
+ * @wr_win: Mailbox shmem write window
+ * @tx_work: Work struct for outbound pkt transfer
+ * @rx_scratch: Staging buf for incoming packets
+ * @tx_scratch: Staging buf for out going packets
+ */
+struct mctp_cerberus_dev {
+	struct net_device *ndev;
+	struct platform_device *pdev;
+	u8 lladdr;
+	struct mbox_client cl;
+	struct mbox_chan *chan;
+	struct mbx_shmem rd_win;
+	struct mbx_shmem wr_win;
+	spinlock_t lock;
+	struct work_struct tx_work;
+	u8 rx_scratch[MCTP_MBOX_BUFSZ];
+	u8 tx_scratch[MCTP_MBOX_BUFSZ];
+};
+
+/* Header on the wire. */
+struct mctp_i2c_hdr {
+	u8 dest_slave;
+	u8 command;
+	/* Count of bytes following byte_count, excluding PEC */
+	u8 byte_count;
+	u8 source_slave;
+};
+
+static size_t mctp_cerberus_get_packet_len(struct mctp_i2c_hdr *hdr)
+{
+	return hdr->byte_count + offsetof(struct mctp_i2c_hdr, source_slave);
+}
+
+static void mctp_mbox_tx_work(struct work_struct *work)
+{
+	struct mctp_cerberus_dev *cdev =
+		container_of(work, struct mctp_cerberus_dev, tx_work);
+	unsigned long flags;
+	struct net_device *ndev = cdev->ndev;
+
+	/* Ring the doorbell (Blocking call) and wait for the data
+	 * to be received by TIP.
+	 */
+	mbox_send_message(cdev->chan, cdev->wr_win.off);
+
+	netif_wake_queue(ndev);
+}
+
+static netdev_tx_t mctp_cerberus_start_xmit(struct sk_buff *skb,
+					    struct net_device *ndev)
+{
+	struct mctp_cerberus_dev *cdev = netdev_priv(ndev);
+	struct platform_device *pdev = cdev->pdev;
+	struct device *dev = &pdev->dev;
+	struct mctp_i2c_hdr *hdr;
+	unsigned long flags;
+	u8 *pecp;
+
+	netif_stop_queue(ndev);
+
+	hdr = (struct mctp_i2c_hdr *)skb_mac_header(skb);
+
+	if (skb->len != mctp_cerberus_get_packet_len(hdr)) {
+		ndev->stats.tx_errors++;
+		ndev->stats.tx_dropped++;
+		dev_warn_ratelimited(dev, "Bad tx length %z vs skb len %u\n",
+				     mctp_cerberus_get_packet_len(hdr),
+				     skb->len);
+		goto out;
+	}
+
+	if ((skb->len + 1) > cdev->wr_win.size) {
+		ndev->stats.tx_errors++;
+		ndev->stats.tx_aborted_errors++;
+		dev_warn_ratelimited(dev,
+			"(tx length + PEC) %u overrun the wr shmem window size %z\n",
+			skb->len + 1, cdev->wr_win.size);
+		goto out;
+		skb_put(skb, 1);
+	} else {
+		skb_copy_bits(skb, 0, cdev->tx_scratch, skb->len);
+		hdr = (void *)cdev->tx_scratch;
+	}
+
+	/* Add PEC at the end */
+	pecp = (void *)hdr + mctp_cerberus_get_packet_len(hdr);
+	*pecp = i2c_smbus_pec(0, (u8 *)hdr, mctp_cerberus_get_packet_len(hdr));
+
+	/*
+	 * Copy from byte2 to end of the packet + PEC to write shmem
+	 * (command byte + byte_count byte + hdr->byte_count bytes + PEC Byte)
+	 * 	= (1 + 1 + byte_count + 1)
+	 */
+	memcpy_toio(cdev->wr_win.off, (void *)&hdr->command,
+		    mctp_cerberus_get_packet_len(hdr));
+
+	if (trace_mctp_mbox_tx_enabled())
+		trace_mctp_mbox_tx(dev, &hdr->command,
+				   mctp_cerberus_get_packet_len(hdr));
+
+	schedule_work(&cdev->tx_work);
+
+	ndev->stats.tx_bytes += skb->len;
+	ndev->stats.tx_packets++;
+
+out:
+	kfree_skb(skb);
+	return NETDEV_TX_OK;
+}
+
+static void mctp_cerberus_uninit(struct net_device *ndev)
+{
+	struct mctp_cerberus_dev *cdev = netdev_priv(ndev);
+	struct platform_device *pdev = cdev->pdev;
+	struct device *dev = &pdev->dev;
+
+	cancel_work_sync(&cdev->tx_work);
+}
+
+static int mctp_cerberus_header_create(struct sk_buff *skb,
+				       struct net_device *ndev,
+				       unsigned short type, const void *daddr,
+				       const void *saddr, unsigned int len)
+{
+	struct mctp_i2c_hdr *hdr;
+	struct mctp_hdr *mhdr;
+	u8 lldst, llsrc;
+
+	if (len > MCTP_I2C_MAXMTU)
+		return -EMSGSIZE;
+
+	lldst = *((u8 *)daddr);
+	llsrc = *((u8 *)saddr);
+
+	skb_push(skb, sizeof(struct mctp_i2c_hdr));
+	skb_reset_mac_header(skb);
+	hdr = (void *)skb_mac_header(skb);
+	mhdr = mctp_hdr(skb);
+	hdr->dest_slave = (lldst << 1) & 0xff;
+	hdr->command = MCTP_I2C_COMMANDCODE;
+	hdr->byte_count = len + 1;
+	hdr->source_slave = ((llsrc << 1) & 0xff) | 0x01;
+	mhdr->ver = 0x01;
+
+	return sizeof(struct mctp_i2c_hdr);
+}
+
+static const struct net_device_ops mctp_cerberus_netdev_ops = {
+	.ndo_start_xmit = mctp_cerberus_start_xmit,
+	.ndo_uninit = mctp_cerberus_uninit,
+};
+
+static const struct header_ops mctp_cerberus_header_ops = {
+	.create = mctp_cerberus_header_create,
+};
+
+static void mctp_mbox_cerberus_setup(struct net_device *ndev)
+{
+	ndev->type = ARPHRD_MCTP;
+
+	ndev->mtu = MCTP_I2C_MAXMTU;
+	ndev->min_mtu = MCTP_I2C_MINMTU;
+	ndev->max_mtu = MCTP_I2C_MAXMTU;
+	ndev->tx_queue_len = MCTP_I2C_TX_QUEUE_LEN;
+
+	ndev->hard_header_len = sizeof(struct mctp_i2c_hdr);
+	ndev->addr_len = 1;
+
+	ndev->netdev_ops = &mctp_cerberus_netdev_ops;
+	ndev->header_ops = &mctp_cerberus_header_ops;
+}
+
+/*
+ * Callback handler for data received from Cerberus.
+ *
+ * @cl: mailbox client
+ * @msg: message from cerberus (not used)
+ */
+static void mctp_mbox_cerberus_rx(struct mbox_client *cl, void *msg)
+{
+	struct mctp_cerberus_dev *cdev = dev_get_drvdata(cl->dev);
+	struct net_device *ndev = cdev->ndev;
+	struct device *dev = &cdev->pdev->dev;
+	struct sk_buff *skb;
+	struct mctp_skb_cb *cb;
+	size_t packet_len = 0;
+	struct mctp_i2c_hdr *hdr;
+	u8 recv_pec, calc_pec;
+	int status;
+
+	cdev->rx_scratch[0] = cdev->lladdr << 1;
+	memcpy_fromio(cdev->rx_scratch + 1, cdev->rd_win.off,
+		      cdev->rd_win.size);
+
+	hdr = (struct mctp_i2c_hdr *)cdev->rx_scratch;
+
+	/* Invalid packet format. Drop the packet */
+	if (hdr->command != MCTP_I2C_COMMANDCODE) {
+		ndev->stats.rx_dropped++;
+		dev_err(dev,
+			"Invalid command code in resp pkt %x, should be %x\n",
+			hdr->command, MCTP_I2C_COMMANDCODE);
+		return;
+	}
+
+	packet_len =
+		hdr->byte_count + offsetof(struct mctp_i2c_hdr, source_slave);
+
+	/* Packet length may have overrun the shmem size */
+	if (packet_len >= cdev->rd_win.size) {
+		ndev->stats.rx_over_errors++;
+		dev_err(dev, "Invalid packet len %d, should be < %d \n",
+			packet_len, cdev->rd_win.size);
+		return;
+	}
+
+	/* Check for CRC error */
+	recv_pec = cdev->rx_scratch[packet_len];
+	calc_pec = i2c_smbus_pec(0, cdev->rx_scratch, packet_len);
+	if (recv_pec != calc_pec) {
+		dev_err(dev, "Invalid PEC recv_pec %d, calc_pec %d \n",
+			recv_pec, calc_pec);
+		ndev->stats.rx_crc_errors++;
+		return;
+	}
+
+	/* Allocate the skb */
+	skb = netdev_alloc_skb(ndev, packet_len);
+	if (!skb) {
+		ndev->stats.rx_dropped++;
+		return;
+	}
+
+	if (trace_mctp_mbox_rx_enabled())
+		trace_mctp_mbox_rx(dev, cdev->rx_scratch, packet_len);
+
+	skb->protocol = htons(ETH_P_MCTP);
+	skb_put_data(skb, cdev->rx_scratch, packet_len);
+	skb_reset_mac_header(skb);
+	skb_pull(skb, sizeof(struct mctp_i2c_hdr));
+	skb_reset_network_header(skb);
+
+	cb = __mctp_cb(skb);
+	cb->halen = 1;
+	cb->haddr[0] = hdr->source_slave >> 1;
+
+	/* Put the frame into the input queue and signal the higher layer */
+	status = netif_rx(skb);
+	if (status == NET_RX_SUCCESS) {
+		ndev->stats.rx_packets++;
+		ndev->stats.rx_bytes += packet_len;
+	} else {
+		ndev->stats.rx_dropped++;
+	}
+}
+
+static struct mctp_cerberus_dev *
+mctp_mbox_cerberus_dev_init(struct platform_device *pdev,
+			    struct net_device *ndev)
+{
+	int ret;
+	struct mctp_cerberus_dev *cdev = netdev_priv(ndev);
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct device_node *mctp_np;
+	struct resource res;
+	struct device_node *shmem;
+	resource_size_t shmem_size;
+	u8 __iomem *off;
+	u32 lladdr = 0;
+
+	/* Extract the shmem information from the device node */
+	shmem = of_parse_phandle(np, "shmem", 0);
+	ret = of_address_to_resource(shmem, 0, &res);
+	of_node_put(shmem);
+	if (ret) {
+		dev_err(dev, "Failed to get shared mem resource on %pOF\n", np);
+		return ERR_PTR(ret);
+	}
+
+	shmem_size = resource_size(&res);
+	off = devm_ioremap_resource(dev, &res);
+	if (IS_ERR(off)) {
+		dev_err(dev, "device mem io remap failed\n");
+		return ERR_CAST(off);
+	}
+
+	/* top half for write and bottom half for read */
+	cdev->wr_win.off = off;
+	cdev->wr_win.size = shmem_size >> 1;
+	cdev->rd_win.off = off + cdev->wr_win.size;
+	cdev->rd_win.size = shmem_size - cdev->wr_win.size;
+
+	if (unlikely(cdev->rd_win.size != cdev->wr_win.size)) {
+		dev_err(dev,
+			"Read shmem size is not same as Write shmem size\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	if (unlikely(cdev->rd_win.size < MCTP_MBOX_BUFSZ)) {
+		dev_err(dev, "Staging buf size is greater than the shmem area\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	/* Get local (BMC) mctp endpoint addr from mctp child node */
+	mctp_np = of_get_child_by_name(np, "mctp");
+	if (mctp_np) {
+		ret = of_property_read_u32(mctp_np, "reg", &lladdr);
+		if (ret)
+			dev_warn(dev, "can't find local mctp endpoint addr on %pOF\n", np);
+	}
+	cdev->lladdr = lladdr & 0xff;
+
+	/* set up and request mailbox channel */
+	cdev->cl.dev = dev;
+	cdev->cl.rx_callback = mctp_mbox_cerberus_rx; /* read non-blocking */
+	cdev->cl.tx_done = NULL;
+	cdev->cl.tx_block = true; /* write blocking */
+	cdev->cl.tx_tout = 500; /* msec */
+	cdev->chan = mbox_request_channel_byname(&cdev->cl, "cerberus");
+	if (IS_ERR(cdev->chan)) {
+		dev_err(dev, "mbox channel request failed\n");
+		return ERR_CAST(cdev->chan);
+	}
+
+	spin_lock_init(&cdev->lock);
+	INIT_WORK(&cdev->tx_work, mctp_mbox_tx_work);
+
+	cdev->ndev = ndev;
+	cdev->pdev = pdev;
+	return cdev;
+
+err:
+	return ERR_PTR(ret);
+}
+
+static int cerberus_probe(struct platform_device *pdev)
+{
+	int ret = 0;
+	struct mctp_cerberus_dev *cdev = NULL;
+	struct device *dev = &pdev->dev;
+	struct net_device *ndev;
+
+	/* Allocate the network device */
+	ndev = alloc_netdev(sizeof(struct mctp_cerberus_dev), "mctpmbox%d",
+			    NET_NAME_ENUM, mctp_mbox_cerberus_setup);
+	if (!ndev) {
+		dev_err(dev, "alloc netdev failed\n");
+		return -ENOMEM;
+	}
+
+	/* Initialize the cerberus device structure */
+	cdev = mctp_mbox_cerberus_dev_init(pdev, ndev);
+	if (IS_ERR(cdev)) {
+		ret = PTR_ERR(cdev);
+		cdev = NULL;
+		goto free_ndev;
+	}
+
+	/* Set local mctp endpoint device addr */
+	dev_addr_set(ndev, &cdev->lladdr);
+
+	platform_set_drvdata(pdev, cdev);
+
+	ret = register_netdev(ndev);
+	if (ret)
+		goto free_ndev;
+
+	dev_info(dev,
+		 "Cerberus MCTP network device over mailbox initialized\n");
+
+	return 0;
+
+free_ndev:
+	free_netdev(ndev);
+	return ret;
+}
+
+static int cerberus_remove(struct platform_device *pdev)
+{
+	struct mctp_cerberus_dev *cdev = platform_get_drvdata(pdev);
+	struct device *dev = &pdev->dev;
+	struct net_device *ndev = cdev->ndev;
+
+	unregister_netdev(ndev);
+	free_netdev(ndev);
+	dev_info(dev, "Cerberus MCTP network device over mailbox removed\n");
+
+	return 0;
+}
+
+static const struct of_device_id cerberus_ids[] = {
+	{
+		.compatible = "nuvoton,mctp-mbox-controller",
+	},
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cerberus_ids);
+
+static struct platform_driver cerberus_mctp_mbox_driver = {
+	.probe    =  cerberus_probe,
+	.remove   =  cerberus_remove,
+	.driver   = {
+		.name  = "cerberus",
+		.of_match_table = cerberus_ids,
+		.owner = THIS_MODULE,
+	},
+};
+
+module_platform_driver(cerberus_mctp_mbox_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Parvathi Bhogaraju <pbhogaraju@microsoft.com>");
+MODULE_DESCRIPTION("Cerberus MCTP device over mailbox");
+
diff --git a/drivers/soc/nuvoton/trace-mctp-mbox.h b/drivers/soc/nuvoton/trace-mctp-mbox.h
new file mode 100644
index 000000000000..0de3b16780bf
--- /dev/null
+++ b/drivers/soc/nuvoton/trace-mctp-mbox.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* TIP mbox transfer tracepoints */
+
+#if !defined(_TRACE_MCTP_MBOX_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_MCTP_MBOX_H
+
+#include <linux/tracepoint.h>
+
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM mctp_mbox
+
+
+TRACE_EVENT(mctp_mbox_tx,
+    TP_PROTO(struct device *dev, const __u8 *msg, int len),
+
+    TP_ARGS(dev, msg, len),
+
+    TP_STRUCT__entry(
+        __string(devname, dev_name(dev))
+        __field(int, tx_len)
+        __dynamic_array(__u8, tx_msg, len)),
+
+    TP_fast_assign(
+        __assign_str(devname, dev_name(dev));
+        __entry->tx_len = len;
+        memcpy(__get_dynamic_array(tx_msg), msg, len);),
+
+    TP_printk("%s: TX(%d bytes) [%*phD]", __get_str(devname), __entry->tx_len,
+        __entry->tx_len, __get_dynamic_array(tx_msg))
+);
+
+TRACE_EVENT(mctp_mbox_rx,
+    TP_PROTO(struct device *dev, const __u8 *msg, int len),
+
+    TP_ARGS(dev, msg, len),
+
+    TP_STRUCT__entry(
+        __string(devname, dev_name(dev))
+        __field(int, rx_len)
+        __dynamic_array(__u8, rx_msg, len)),
+
+    TP_fast_assign(
+        __assign_str(devname, dev_name(dev));
+        __entry->rx_len = len;
+        memcpy(__get_dynamic_array(rx_msg), msg, len);),
+
+    TP_printk("%s: RX(%d bytes) [%*phD]", __get_str(devname), __entry->rx_len,
+        __entry->rx_len, __get_dynamic_array(rx_msg))
+);
+
+
+#endif /* _TRACE_MCTP_MBOX_H */
+
+#undef TRACE_INCLUDE_PATH
+#undef TRACE_INCLUDE_FILE
+
+#define TRACE_INCLUDE_PATH .
+#define TRACE_INCLUDE_FILE trace-mctp-mbox
+
