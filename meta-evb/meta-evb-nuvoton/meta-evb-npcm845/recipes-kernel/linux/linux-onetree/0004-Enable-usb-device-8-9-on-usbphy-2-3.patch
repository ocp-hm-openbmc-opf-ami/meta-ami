From 884f959bc03efb24ed2c11370a9af2fb6b8d4544 Mon Sep 17 00:00:00 2001
From: owenkuo <owenkuo@ami.com>
Date: Thu, 21 Aug 2025 11:03:44 +0800
Subject: [PATCH] enable-usb-device-8-9-on-usbphy-2-3

---
 drivers/usb/chipidea/ci_hdrc_npcm.c | 36 ++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/chipidea/ci_hdrc_npcm.c b/drivers/usb/chipidea/ci_hdrc_npcm.c
index e4a191e02ceb..20e045a15bae 100644
--- a/drivers/usb/chipidea/ci_hdrc_npcm.c
+++ b/drivers/usb/chipidea/ci_hdrc_npcm.c
@@ -9,9 +9,16 @@
 #include <linux/io.h>
 #include <linux/reset-controller.h>
 #include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/mfd/syscon.h>
 
 #include "ci.h"
 
+#define INTCR3_OFFSET			0x9C
+
+#define NPCM845_INTCR3_USBPHY3SW		GENMASK(15, 14)
+#define NPCM845_INTCR3_USBPHY2SW		GENMASK(13, 12)
+
 struct npcm_udc_data {
 	struct platform_device	*ci;
 	struct clk		*core_clk;
@@ -37,10 +44,12 @@ static int npcm_udc_notify_event(struct ci_hdrc *ci, unsigned event)
 
 static int npcm_udc_probe(struct platform_device *pdev)
 {
-	int ret;
+	int ret, udc_id;
+	struct regmap *gcr_regmap;
 	struct npcm_udc_data *ci;
 	struct platform_device *plat_ci;
 	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
 
 	ci = devm_kzalloc(&pdev->dev, sizeof(*ci), GFP_KERNEL);
 	if (!ci)
@@ -62,6 +71,31 @@ static int npcm_udc_probe(struct platform_device *pdev)
 	ci->pdata.phy_mode = USBPHY_INTERFACE_MODE_UTMI;
 	ci->pdata.notify_event = npcm_udc_notify_event;
 
+	udc_id = of_alias_get_id(np, "udc");
+	if (udc_id == 9) {
+		gcr_regmap = syscon_regmap_lookup_by_phandle(np,
+							     "nuvoton,sysgcr");
+		if (IS_ERR(gcr_regmap)) {
+			dev_err(dev, "Failed to find nuvoton,sysgcr\n");
+			return IS_ERR(gcr_regmap);
+		}
+		regmap_update_bits(gcr_regmap, INTCR3_OFFSET,
+				   NPCM845_INTCR3_USBPHY2SW,
+				   NPCM845_INTCR3_USBPHY2SW);
+	}
+
+	if (udc_id == 8 && of_device_is_compatible(np, "nuvoton,npcm845-udc")) {
+		gcr_regmap = syscon_regmap_lookup_by_phandle(np,
+							     "nuvoton,sysgcr");
+		if (IS_ERR(gcr_regmap)) {
+			dev_err(dev, "Failed to find nuvoton,sysgcr\n");
+			return IS_ERR(gcr_regmap);
+		}
+		regmap_update_bits(gcr_regmap, INTCR3_OFFSET,
+				   NPCM845_INTCR3_USBPHY3SW,
+				   NPCM845_INTCR3_USBPHY3SW);
+	}
+
 	plat_ci = ci_hdrc_add_device(dev, pdev->resource, pdev->num_resources,
 				     &ci->pdata);
 	if (IS_ERR(plat_ci)) {
-- 
2.34.1

