-	skb = alloc_skb(sizeof(*ll_hdr) + sizeof(hdr) + 4, GFP_KERNEL);
-	skb->dev = dev->ndev;
-	__mctp_cb(skb);
-
-	skb_reserve(skb, sizeof(*ll_hdr));
-
-	memcpy(skb_put(skb, sizeof(hdr)), &hdr, sizeof(hdr));
-	buf = skb_put(skb, 4);
