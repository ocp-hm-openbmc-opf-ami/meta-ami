-	/* we should hold the only reference to both skbs */
-	KUNIT_EXPECT_EQ(test, refcount_read(&skbs[0]->users), 1);
-	kfree_skb(skbs[0]);
-
-	KUNIT_EXPECT_EQ(test, refcount_read(&skbs[1]->users), 1);
-	kfree_skb(skbs[1]);
-
-	__mctp_route_test_fini(test, dev, &dst, &tpq, sock);
