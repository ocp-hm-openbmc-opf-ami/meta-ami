From 4f56a1e9f14fc5a1bb8edca4f8424446cc1dfbc9 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 11:24:00 +0530
Subject: [PATCH] Add XDPE152x temprature config

Make temperature sensor source of XDPE152x configurable.

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/xdpe152c4.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/hwmon/pmbus/xdpe152c4.c b/drivers/hwmon/pmbus/xdpe152c4.c
index 235e6b41ae4c..097e38b611af 100644
--- a/drivers/hwmon/pmbus/xdpe152c4.c
+++ b/drivers/hwmon/pmbus/xdpe152c4.c
@@ -13,6 +13,11 @@
 #include "pmbus.h"
 
 #define XDPE152_PAGE_NUM 2
+#define XDPE152_MFR_SELECT_TEMPERATURE_SENSOR 0xcc
+#define XDPE152_PAGE_CMD 0x00
+#define XDPE152_PAGE_ZERO 0x00
+#define XDPE152_PAGE_ONE 0x01
+
 
 static struct pmbus_driver_info xdpe152_info = {
 	.pages = XDPE152_PAGE_NUM,
@@ -34,6 +39,27 @@ static struct pmbus_driver_info xdpe152_info = {
 static int xdpe152_probe(struct i2c_client *client)
 {
 	struct pmbus_driver_info *info;
+	u8 select_temp_sensor_p0;
+	u8 select_temp_sensor_p1;
+	int ret;
+
+	if (of_property_read_u8(client->dev.of_node, "select-temp-sensor-p0", &select_temp_sensor_p0) == 0) {
+		ret = i2c_smbus_write_byte_data(client, XDPE152_PAGE_CMD, XDPE152_PAGE_ZERO);
+		if (ret)
+			goto err;
+		ret = i2c_smbus_write_byte_data(client, XDPE152_MFR_SELECT_TEMPERATURE_SENSOR, select_temp_sensor_p0);
+		if (ret)
+			goto err;
+	}
+
+	if (of_property_read_u8(client->dev.of_node, "select-temp-sensor-p1", &select_temp_sensor_p1) == 0) {
+		ret = i2c_smbus_write_byte_data(client, XDPE152_PAGE_CMD, XDPE152_PAGE_ONE);
+		if (ret)
+			goto err;
+		ret = i2c_smbus_write_byte_data(client, XDPE152_MFR_SELECT_TEMPERATURE_SENSOR, select_temp_sensor_p1);
+		if (ret)
+			goto err;
+	}
 
 	info = devm_kmemdup(&client->dev, &xdpe152_info, sizeof(*info),
 			    GFP_KERNEL);
@@ -41,6 +67,10 @@ static int xdpe152_probe(struct i2c_client *client)
 		return -ENOMEM;
 
 	return pmbus_do_probe(client, info);
+err:
+	dev_err(&client->dev, "Set MFR_SELECT_TEMPERATURE_SENSOR register failed\n");
+	return ret;
+
 }
 
 static const struct i2c_device_id xdpe152_id[] = {
-- 
