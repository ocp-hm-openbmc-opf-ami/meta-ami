From 5ab7b4540d7fd6a654eba3e0cc5134555a508c73 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 9 Sep 2025 15:27:26 +0530
Subject: [PATCH] Support PSU hwmon pmbus driver raa228926 to isl68137

Add PSU raa228926 driver patch.

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/hwmon/pmbus/isl68137.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/hwmon/pmbus/isl68137.c b/drivers/hwmon/pmbus/isl68137.c
index 109aad4871dc..a52778957211 100644
--- a/drivers/hwmon/pmbus/isl68137.c
+++ b/drivers/hwmon/pmbus/isl68137.c
@@ -60,6 +60,7 @@ enum chips {
 	raa228004,
 	raa228006,
 	raa228228,
+	raa228926,
 	raa229001,
 	raa229004,
 };
@@ -320,6 +321,7 @@ static const struct i2c_device_id raa_dmpvr_id[] = {
 	{"raa228004", raa_dmpvr2_hv},
 	{"raa228006", raa_dmpvr2_hv},
 	{"raa228228", raa_dmpvr2_2rail_nontc},
+	{"raa228926", raa_dmpvr2_2rail_nontc},
 	{"raa229001", raa_dmpvr2_2rail},
 	{"raa229004", raa_dmpvr2_2rail},
 	{"raa229126", raa_dmpvr2_2rail},
@@ -369,6 +371,7 @@ static const struct of_device_id __maybe_unused isl68137_of_match[] = {
 	{.compatible = "raa228004", .data = (void *)raa_dmpvr2_hv,},
 	{.compatible = "raa228006", .data = (void *)raa_dmpvr2_hv,},
 	{.compatible = "raa228228", .data = (void *)raa_dmpvr2_2rail_nontc,},
+	{.compatible = "raa228926", .data = (void *)raa_dmpvr2_2rail_nontc,},
 	{.compatible = "raa229001", .data = (void *)raa_dmpvr2_2rail,},
 	{.compatible = "raa229004", .data = (void *)raa_dmpvr2_2rail,},
 	{.compatible = "raa229126", .data = (void *)raa_dmpvr2_2rail,},
-- 
