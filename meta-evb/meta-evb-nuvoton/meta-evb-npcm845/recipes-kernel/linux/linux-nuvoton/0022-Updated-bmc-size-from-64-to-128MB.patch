Date: Fri, 29 Nov 2024 14:27:52 +0530
Subject: [PATCH] Updated bmc size from 64 to 128MB

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
index 8e682767139b..c685e48a4d02 100644
--- a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
+++ b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
@@ -202,7 +202,7 @@ partitions@80000000 {
 			#size-cells = <1>;
 			bmc@0 {
 				label = "bmc";
-				reg = <0x00000000 0x04000000>;
+				reg = <0x00000000 0x08000000>;
 				};
 			u-boot@0 {
 				label = "u-boot";
