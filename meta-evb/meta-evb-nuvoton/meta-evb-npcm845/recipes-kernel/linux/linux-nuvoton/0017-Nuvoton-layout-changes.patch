From efed896d63afb4c469ca06ebba5a45edb6781975 Mon Sep 17 00:00:00 2001
From: Amrun Nisha R <amrunnishar@ami.com>
Date: Thu, 10 Oct 2024 12:05:20 +0530
Subject: [PATCH] Nuvoton layout changes

Signed-off-by: Amrun Nisha R <amrunnishar@ami.com>
---
 arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
index 83dddb78d079..2e1765d174c5 100644
--- a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
+++ b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
@@ -203,15 +203,15 @@ u-boot-env@3c0000 {
 				};
 			kernel@200000 {
 				label = "kernel";
-				reg = <0x00400000 0x00800000>;
+				reg = <0x00400000 0x01130000>;
 				};
 			rofs@c00000 {
 				label = "rofs";
-				reg = <0x00C00000 0x03000000>;
+				reg = <0x01530000 0x04300000>;
 				};
 			rwfs@3c00000 {
 				label = "rwfs";
-				reg = <0x3C00000 0x400000>;
+				reg = <0x05830000 0x1300000>;
 				};
 		};
 	};
