MACHINE ??= "evb-npcm845"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_ipk"
SANITY_TESTED_DISTROS:append ?= " *"
IMAGE_FEATURES:remove = "debug-tweaks"
EXTRA_IMAGE_FEATURES += "allow-empty-password allow-root-login post-install-logging"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

BAD_RECOMMENDATIONS += "phosphor-settings-manager"

ERROR_QA:remove = " patch-status license-checksum buildpaths "
WARN_QA:append = " patch-status license-checksum buildpaths "
#added to fix build issue
EXTRA_IMAGE_FEATURES:remove = " onetree-2fa"

EXTRA_IMAGE_FEATURES:append = " onetree-network-bonding-support"

IMAGE_INSTALL:append = " libmctp"
#include the flash layout, which includes Flash Partition Offset
require conf/machine/include/${MACHINE}-layout.inc
