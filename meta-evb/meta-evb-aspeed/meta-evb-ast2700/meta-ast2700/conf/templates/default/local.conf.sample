#MACHINE ??= "ast2700-default"
#MACHINE ??= "ast2700-default-ncsi"
#MACHINE ??= "ast2700-default-ast1700-evb"
#MACHINE ??= "ast2700-default-ast1700-evb-cdr"
#MACHINE ??= "ast2700-emmc"
#MACHINE ??= "ast2700-ufs"
#MACHINE ??= "ast2700-abr"
MACHINE ??= "ast2700-a0-default"
#MACHINE ??= "ast2700-a0-default-ncsi"
#MACHINE ??= "ast2700-a0-default-ast1700-evb"
#MACHINE ??= "ast2700-a0-emmc"
#MACHINE ??= "ast2700-a0-abr"

DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_rpm"
SANITY_TESTED_DISTROS:append ?= " *"
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"
INHERIT += "extrausers"
EXTRA_USERS_PARAMS = " \
  usermod -p '\$1\$UGMqyqdG\$FZiylVFmRRfl9Z0Ue8G7e/' root; \
  "

# Change time zone to local time from UTC for applying localtime
# in kernel build time.
TZ = '/etc/localtime'

BAD_RECOMMENDATIONS += "phosphor-settings-manager"

# Enable spi-nor-ecc.inc if BMC flash model support ECC mode.
#require conf/machine/include/spi-nor-ecc.inc



ERROR_QA:remove = " patch-fuzz "
WARN_QA:remove = " patch-fuzz "

#added to fix build issue
IMAGE_INSTALL:remove = " google-authenticator-libpam web-two-factor-authentication"
#SignedImage
NON_PFR_UPDATE_FEATURES:append = " image-sign"
#JavaViewerSinging

#Network Bonding Support
EXTRA_IMAGE_FEATURES:append = " onetree-network-bonding-support"
