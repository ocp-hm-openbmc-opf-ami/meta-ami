From 74dba865233ea2a0acacd3a2c712d15da1c08e32 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Wed, 21 Aug 2024 18:41:14 +0530
Subject: [PATCH] Add write public key in image support

---
 arch/arm64/boot/dts/aspeed/aspeed-flash-layout-128.dtsi | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-flash-layout-128.dtsi b/arch/arm64/boot/dts/aspeed/aspeed-flash-layout-128.dtsi
index ccaa66a978e3..b08fed223b36 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-flash-layout-128.dtsi
+++ b/arch/arm64/boot/dts/aspeed/aspeed-flash-layout-128.dtsi
@@ -26,7 +26,12 @@ rofs@b20000 {
 	};
 
 	rwfs@6000000 {
-		reg = <0x6000000 0x2000000>; // 32MB
+		reg = <0x6000000 0x1FF0000>; // 32MB
 		label = "rwfs";
 	};
+
+	reserved@7ff0000 {
+		reg = <0x7ff0000 0x10000>; // 64KB
+                label = "reserved";
+        };
 };
