[Unit]
Description=MCTP PCIe demultiplexer daemon
Wants=mctp-pcie-demux.socket
Upholds=mctp-pcie-ctrl.service
ConditionPathExists=/dev/aspeed-mctp0

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutSec=45
Environment=MCTP_PCIE_DEMUX_EXEC_START=null
EnvironmentFile=/usr/share/mctp/mctp
ExecStart=/usr/bin/mctp-demux-daemon $MCTP_PCIE_DEMUX_EXEC_START
SyslogIdentifier=mctp-pcie-demux
