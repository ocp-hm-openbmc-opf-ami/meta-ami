From 289a18a18e100c0ec839c8cac5c973f916f250c1 Mon Sep 17 00:00:00 2001
From: Neal Liu <neal_liu@aspeedtech.com>
Date: Thu, 4 Jun 2026 13:56:00 +0800
Subject: [PATCH 4/4] cmd: aspeed: otp: add OEM binary data key type support
 for AST2700

- Expand OTP_KH_KEY_TYPE mask from 0x7 to 0x3f to cover the full
  6-bit key type field (bits 4~9) used by OEM types
- Add OEM_DATA enum value; OEM types are encoded as (oem_type+1) << 3,
  yielding 6-bit values 0x08~0x38 for oem_type0 through oem_type6
- Register seven OEM_DATA entries in both a1 and a2 key type tables
- Print 0x30 bytes of key data when key type is OEM_DATA

Upstream-Status: Backport [SDK v11.03 migration]
Signed-off-by: Neal Liu <neal_liu@aspeedtech.com>
Change-Id: I0467ff9202af658316ea69d8136bc77b66e681bb
Signed-off-by: rupeshs <rupeshs@ami.com>
---
 cmd/aspeed/otp_ast2700.c      |  4 +++-
 cmd/aspeed/otp_info_ast2700.h | 33 ++++++++++++++++++++++++---------
 2 files changed, 27 insertions(+), 10 deletions(-)

diff --git a/cmd/aspeed/otp_ast2700.c b/cmd/aspeed/otp_ast2700.c
index 64aa57fb0e..7f7a0b56a0 100644
--- a/cmd/aspeed/otp_ast2700.c
+++ b/cmd/aspeed/otp_ast2700.c
@@ -167,7 +167,7 @@ enum otp_status {
 /* OTP key header format */
 #define OTP_KH_NUM			80
 #define OTP_KH_KEY_ID(kh)		((kh) & 0xf)
-#define OTP_KH_KEY_TYPE(kh)		(((kh) >> 4) & 0x7)
+#define OTP_KH_KEY_TYPE(kh)		(((kh) >> 4) & 0x3f)	/* bits 4~9: SOC types 1~6, OEM types 0x08~0x38 */
 #define OTP_KH_LAST(kh)			(((kh) >> 15) & 0x1)
 #define OTP_KH_OFFSET(kh)		(((kh) >> 16) & 0xfff)
 
@@ -1279,6 +1279,8 @@ static int _otp_print_key(u32 header, u32 offset, u8 *data)
 
 	} else if (key_info.key_type == SOC_VAULT || key_info.key_type == SOC_VAULT_SEED) {
 		buf_print(&data[key_offset], 0x20);
+	} else if (key_info.key_type == OEM_DATA) {
+		buf_print(&data[key_offset], 0x30);
 	}
 
 	return 0;
diff --git a/cmd/aspeed/otp_info_ast2700.h b/cmd/aspeed/otp_info_ast2700.h
index a6264c0eaf..6db19d05be 100644
--- a/cmd/aspeed/otp_info_ast2700.h
+++ b/cmd/aspeed/otp_info_ast2700.h
@@ -53,21 +53,36 @@ enum KeyType {
 	CAL_OWN_PUB_HASH = 4,
 	SOC_VAULT = 5,
 	SOC_VAULT_SEED = 6,
+	OEM_DATA = 7,	/* bits 4~6 = 0, bits 7~9 = oem_type+1; 6-bit value = (oem_type+1) << 3 */
 };
 
 static const struct otpkey_type a1_key_type[] = {
-	{1, SOC_ECDSA_PUB,     "ECDSA384 as SoC OEM DSS public key"},
-	{2, SOC_LMS_PUB,       "LMS as SoC OEM DSS public key"},
-	{3, CAL_MANU_PUB_HASH, "Manufacture public key hash for Caliptra"},
-	{4, CAL_OWN_PUB_HASH,  "Owner public key hash for Caliptra"},
-	{5, SOC_VAULT,         "AES-256 as secret vault key"},
-	{6, SOC_VAULT_SEED,    "AES-256 as secret vault key seed"},
+	{1,    SOC_ECDSA_PUB,     "ECDSA384 as SoC OEM DSS public key"},
+	{2,    SOC_LMS_PUB,       "LMS as SoC OEM DSS public key"},
+	{3,    CAL_MANU_PUB_HASH, "Manufacture public key hash for Caliptra"},
+	{4,    CAL_OWN_PUB_HASH,  "Owner public key hash for Caliptra"},
+	{5,    SOC_VAULT,         "AES-256 as secret vault key"},
+	{6,    SOC_VAULT_SEED,    "AES-256 as secret vault key seed"},
+	{0x08, OEM_DATA,          "OEM binary data (oem_type0)"},
+	{0x10, OEM_DATA,          "OEM binary data (oem_type1)"},
+	{0x18, OEM_DATA,          "OEM binary data (oem_type2)"},
+	{0x20, OEM_DATA,          "OEM binary data (oem_type3)"},
+	{0x28, OEM_DATA,          "OEM binary data (oem_type4)"},
+	{0x30, OEM_DATA,          "OEM binary data (oem_type5)"},
+	{0x38, OEM_DATA,          "OEM binary data (oem_type6)"},
 };
 
 static const struct otpkey_type a2_key_type[] = {
-	{4, CAL_OWN_PUB_HASH,  "Owner public key hash for Caliptra"},
-	{5, SOC_VAULT,         "AES-256 as secret vault key"},
-	{6, SOC_VAULT_SEED,    "AES-256 as secret vault key seed"},
+	{4,    CAL_OWN_PUB_HASH,  "Owner public key hash for Caliptra"},
+	{5,    SOC_VAULT,         "AES-256 as secret vault key"},
+	{6,    SOC_VAULT_SEED,    "AES-256 as secret vault key seed"},
+	{0x08, OEM_DATA,          "OEM binary data (oem_type0)"},
+	{0x10, OEM_DATA,          "OEM binary data (oem_type1)"},
+	{0x18, OEM_DATA,          "OEM binary data (oem_type2)"},
+	{0x20, OEM_DATA,          "OEM binary data (oem_type3)"},
+	{0x28, OEM_DATA,          "OEM binary data (oem_type4)"},
+	{0x30, OEM_DATA,          "OEM binary data (oem_type5)"},
+	{0x38, OEM_DATA,          "OEM binary data (oem_type6)"},
 };
 
 static const struct otprbp_info a1_rbp_info[] = {
