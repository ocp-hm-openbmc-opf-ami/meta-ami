-		info_cb.strap_ext_info = a0_strap_ext_info;
-		info_cb.strap_ext_info_len = ARRAY_SIZE(a0_strap_ext_info);
+		printf("Chip: AST2700-A0 is deprecated\n");
 		break;
 	case OTP_AST2700_A1:
 		printf("Chip: AST2700-A1\n");
