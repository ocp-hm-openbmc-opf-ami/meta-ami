From 4fb80ce0b7dcca461bf34db5d9d153db6dd4431f Mon Sep 17 00:00:00 2001
From: Subraja M <subrajam@ami.com>
Date: Thu, 13 Nov 2025 15:30:49 +0530
Subject: [PATCH] Network Driver: Aspeed SDK 908 Migration

Signed-off-by: Subraja M <subrajam@ami.com>
---
 arch/arm/dts/ast2700.dtsi                     | 10 ++++++
 arch/arm/mach-aspeed/ast2700/Kconfig          |  8 -----
 arch/arm/mach-aspeed/ast2700/Makefile         |  1 -
 arch/arm/mach-aspeed/ast2700/board_common.c   |  3 +-
 .../include/asm/arch-ast2700/scu_ast2700.h    |  2 ++
 drivers/clk/aspeed/Makefile                   |  1 +
 drivers/clk/aspeed/clk_ast2700.c              |  9 +++---
 .../ast2700 => drivers/clk/aspeed}/mac.c      | 31 +++++++++++++++++--
 drivers/net/ftgmac100.c                       |  3 --
 drivers/phy/aspeed/aspeed-sgmii.c             |  5 +++
 10 files changed, 52 insertions(+), 21 deletions(-)
 rename {arch/arm/mach-aspeed/ast2700 => drivers/clk/aspeed}/mac.c (93%)

diff --git a/arch/arm/dts/ast2700.dtsi b/arch/arm/dts/ast2700.dtsi
index ac8c4ec8be..f7987277bd 100644
--- a/arch/arm/dts/ast2700.dtsi
+++ b/arch/arm/dts/ast2700.dtsi
@@ -1189,11 +1189,21 @@
 		groups = "RMII0";
 	};
 
+        pinctrl_rmii0_rclko_default: rmii0-rclko-default {
+                function = "RMII0RCLKO";
+                groups = "RMII0RCLKO";
+        };
+
 	pinctrl_rmii1_default: rmii1_default {
 		function = "RMII1";
 		groups = "RMII1";
 	};
 
+        pinctrl_rmii1_rclko_default: rmii1-rclko-default {
+                function = "RMII1RCLKO";
+                groups = "RMII1RCLKO";
+        };
+
 	pinctrl_sgmii_default: sgmii_default {
 		function = "SGMII";
 		groups = "SGMII";
diff --git a/arch/arm/mach-aspeed/ast2700/Kconfig b/arch/arm/mach-aspeed/ast2700/Kconfig
index 8343ebb638..75c158140b 100644
--- a/arch/arm/mach-aspeed/ast2700/Kconfig
+++ b/arch/arm/mach-aspeed/ast2700/Kconfig
@@ -33,14 +33,6 @@ config TARGET_AST2700_DCSCM
 
 endchoice
 
-config AST2700_RGMII_CLIBRATION
-	bool "AST2700-RGMII-CLIBRATION"
-	depends on ASPEED_AST2700
-	default y
-	help
-	  RGMII CLIBRATION is automatically to find the tx/rx edge/center of
-	  RGMII.
-
 source "board/aspeed/evb_ast2700/Kconfig"
 source "board/aspeed/ast2700_dcscm/Kconfig"
 
diff --git a/arch/arm/mach-aspeed/ast2700/Makefile b/arch/arm/mach-aspeed/ast2700/Makefile
index 54327ce553..c4b7d9b74e 100644
--- a/arch/arm/mach-aspeed/ast2700/Makefile
+++ b/arch/arm/mach-aspeed/ast2700/Makefile
@@ -1,3 +1,2 @@
 obj-y   += lowlevel_init.o board_common.o arm64-mmu.o platform.o spi.o clk.o scu_info.o
 obj-$(CONFIG_DISPLAY_CPUINFO) += cpu-info.o
-obj-$(CONFIG_AST2700_RGMII_CLIBRATION) += mac.o
diff --git a/arch/arm/mach-aspeed/ast2700/board_common.c b/arch/arm/mach-aspeed/ast2700/board_common.c
index a4a980e8c1..0305fa3d2c 100644
--- a/arch/arm/mach-aspeed/ast2700/board_common.c
+++ b/arch/arm/mach-aspeed/ast2700/board_common.c
@@ -71,9 +71,8 @@ int board_init(void)
 	int ret;
 
 	ahbc_init();
-	if (IS_ENABLED(CONFIG_AST2700_RGMII_CLIBRATION))
-		aspeed_rgmii_init();
 
+	aspeed_rgmii_init();
 	regulators_enable_boot_on(0);
 
 	/*
diff --git a/arch/riscv/include/asm/arch-ast2700/scu_ast2700.h b/arch/riscv/include/asm/arch-ast2700/scu_ast2700.h
index f8da8830d7..82adc22430 100644
--- a/arch/riscv/include/asm/arch-ast2700/scu_ast2700.h
+++ b/arch/riscv/include/asm/arch-ast2700/scu_ast2700.h
@@ -512,5 +512,7 @@ struct ast2700_scu1 {
 	uint32_t io_driving8;	/* 0x4e0 */
 };
 
+static inline void aspeed_rgmii_init(void) {}
+
 #endif
 #endif
diff --git a/drivers/clk/aspeed/Makefile b/drivers/clk/aspeed/Makefile
index a0ac2775d1..0041970d88 100644
--- a/drivers/clk/aspeed/Makefile
+++ b/drivers/clk/aspeed/Makefile
@@ -5,4 +5,5 @@
 
 obj-$(CONFIG_ASPEED_AST2500) += clk_ast2500.o
 obj-$(CONFIG_ASPEED_AST2600) += clk_ast2600.o
+obj-$(CONFIG_ASPEED_AST2700) += mac.o
 obj-$(CONFIG_CLK_AST2700) += clk_ast2700.o
diff --git a/drivers/clk/aspeed/clk_ast2700.c b/drivers/clk/aspeed/clk_ast2700.c
index 1a4ac50580..526e50e971 100644
--- a/drivers/clk/aspeed/clk_ast2700.c
+++ b/drivers/clk/aspeed/clk_ast2700.c
@@ -907,10 +907,11 @@ static int ast2700_clk1_init(struct udevice *dev)
 	u32 reg[3];
 
 	if (scu->chip_id1 & SCU_HW_REVISION_ID) {
-		if ((readl(&scu->mac_delay) & GENMASK(25, 0)) == 0)
-			reg[0] = MAC01_DEF_DELAY_1G_A1;
-		else
-			reg[0] = readl(&scu->mac_delay) & GENMASK(25, 0);
+               if ((readl(&scu->mac_delay) & GENMASK(25, 0)) == 0) {
+                       /* Run RGMII calibration */
+                       aspeed_rgmii_init();
+               }
+               reg[0] = readl(&scu->mac_delay) & GENMASK(25, 0);
 	}
 	reg[1] = MAC01_DEF_DELAY_100M;
 	reg[2] = MAC01_DEF_DELAY_10M;
diff --git a/arch/arm/mach-aspeed/ast2700/mac.c b/drivers/clk/aspeed/mac.c
similarity index 93%
rename from arch/arm/mach-aspeed/ast2700/mac.c
rename to drivers/clk/aspeed/mac.c
index 6d765bff4b..9926a52d1f 100644
--- a/arch/arm/mach-aspeed/ast2700/mac.c
+++ b/drivers/clk/aspeed/mac.c
@@ -6,8 +6,7 @@
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
 #include <linux/iopoll.h>
-#include <asm/arch-aspeed/platform.h>
-#include <asm/arch-aspeed/scu_ast2700.h>
+#include <asm/arch/scu_ast2700.h>
 #include <asm/global_data.h>
 #include <common.h>
 #include <fdt_support.h>
@@ -78,6 +77,11 @@ DECLARE_GLOBAL_DATA_PTR;
 #define SCU_FREQ_COUNTER_MASK	GENMASK(29, 16)
 #define SCU_FREQ_COUNTER(x)	FIELD_GET(SCU_FREQ_COUNTER_MASK, x)
 
+#define SCU_MULTI_CTRL18       0x444   /* GPIO Group R */
+#define SCU_MULTI_CTRL19       0x448   /* GPIO Group S */
+#define SCU_MULTI_CTRL20       0x44C   /* GPIO Group T */
+#define SCU_MULTI_CTRL21       0x450   /* GPIO Group U */
+
 #ifndef DMA_ALIGNED
 #define DMA_ALIGNED __aligned(CONFIG_SYS_CACHELINE_SIZE)
 #endif
@@ -230,6 +234,21 @@ void mac_set_loopback(u32 index, bool enable)
 	writel(fear, base + FEAR);
 }
 
+static void mac_rgmii_pin(u32 index)
+{
+       void *scu = (void *)ASPEED_IO_SCU_BASE;
+
+       if (index) {
+               /* Configure MAC1 pin to GPIO */
+               writel(0, scu + SCU_MULTI_CTRL20);
+               clrsetbits_le32(scu + SCU_MULTI_CTRL21, GENMASK(14, 0), 0);
+       } else {
+               /* Configure MAC0 pin to GPIO */
+               writel(0, scu + SCU_MULTI_CTRL18);
+               clrsetbits_le32(scu + SCU_MULTI_CTRL19, GENMASK(14, 0), 0);
+       }
+}
+
 static void mac_init(u32 index)
 {
 	void *base;
@@ -240,6 +259,7 @@ static void mac_init(u32 index)
 	else
 		base = (void *)ASPEED_IO_MAC0_BASE;
 
+	mac_rgmii_pin(index);
 	mac_reset_deassert(index);
 	mac_clk_enable(index);
 
@@ -450,6 +470,8 @@ static const char *get_mac_phy_mode(u32 index)
 		printf("Node at path '%s' not found\n", target_path);
 		return NULL;
 	}
+        if (strcmp("okay", (const char *)fdt_getprop(fdt, nodeoffset, "status", NULL)) != 0)
+                return NULL;
 
 	return fdt_getprop(fdt, nodeoffset, "phy-mode", NULL);
 }
@@ -499,6 +521,10 @@ static void find_rgmii_delay(u32 index)
 	const char *phy_mode;
 	u8 result[32];
 
+        phy_mode = get_mac_phy_mode(index);
+        if (!phy_mode)
+                return;
+
 	average_delay = cal_delay32_ring(31);
 	if (average_delay == 0)
 		return;
@@ -521,7 +547,6 @@ static void find_rgmii_delay(u32 index)
 	rx_edge = find_rx_center(result) + 1;
 	rx_center = rx_edge + 2000 / average_delay;
 
-	phy_mode = get_mac_phy_mode(index);
 	if (phy_mode) {
 		printf(" %d: %s ", index, phy_mode);
 		if (strcmp(phy_mode, "rgmii-rxid") == 0) {
diff --git a/drivers/net/ftgmac100.c b/drivers/net/ftgmac100.c
index 81d5391ccf..50b9ae6cf8 100644
--- a/drivers/net/ftgmac100.c
+++ b/drivers/net/ftgmac100.c
@@ -227,9 +227,6 @@ static int ftgmac100_phy_adjust_link(struct ftgmac100_data *priv)
 	/* update MII config into maccr */
 	writel(maccr, &ftgmac100->maccr);
 
-	if (phydev->interface == PHY_INTERFACE_MODE_SGMII)
-		generic_phy_set_speed(&priv->sgmii, phydev->speed);
-
 	return 0;
 }
 
diff --git a/drivers/phy/aspeed/aspeed-sgmii.c b/drivers/phy/aspeed/aspeed-sgmii.c
index 915a4eaf89..4e843517de 100644
--- a/drivers/phy/aspeed/aspeed-sgmii.c
+++ b/drivers/phy/aspeed/aspeed-sgmii.c
@@ -18,6 +18,7 @@
 #include <linux/bitfield.h>
 
 #define SGMII_CFG			0x00
+#define SGMII_LINK_TIMER                0x08
 #define SGMII_NWAY_ACK			0x0c
 #define SGMII_PHY_CFG1			0x18
 #define SGMII_PHY_PIPE_CTL		0x20
@@ -65,6 +66,8 @@ static int aspeed_sgmii_phy_init(struct phy *phy)
 	writel(SGMII_CFG_AN_ENABLE, sgmii->regs + SGMII_CFG);
 	writel(0x0c, sgmii->regs + SGMII_FIFO_DELAY_THREHOLD);
 	writel(SGMII_PCTL_TX_NO_DEEMPH, sgmii->regs + SGMII_PHY_PIPE_CTL);
+        /* Set link timer for Nway state change */
+        writel(0x100, sgmii->regs + SGMII_LINK_TIMER);
 	/* Bit 0 always sets to 1 in ACK message */
 	writel(0x1, sgmii->regs + SGMII_NWAY_ACK);
 	writel(SGMII_MODE_ENABLE, sgmii->regs + SGMII_MODE);
@@ -102,6 +105,8 @@ int aspeed_sgmii_set_speed(struct phy *phy, int speed)
 	writel(reg, sgmii->regs + SGMII_CFG);
 	writel(0x0c, sgmii->regs + SGMII_FIFO_DELAY_THREHOLD);
 	writel(SGMII_PCTL_TX_NO_DEEMPH, sgmii->regs + SGMII_PHY_PIPE_CTL);
+        /* Set link timer for Nway state change */
+        writel(0x100, sgmii->regs + SGMII_LINK_TIMER);
 	/* Bit 0 always sets to 1 in ACK message */
 	writel(0x1, sgmii->regs + SGMII_NWAY_ACK);
 	writel(SGMII_MODE_ENABLE | SGMII_MODE_USE_LOCAL_CONFIG, sgmii->regs + SGMII_MODE);
-- 
2.51.0

