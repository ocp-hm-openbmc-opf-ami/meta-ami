From cfbfa975a7fb2a8d290c5c15d665ba6f87c363b2 Mon Sep 17 00:00:00 2001
From: Jacky Chou <jacky_chou@aspeedtech.com>
Date: Thu, 14 Aug 2025 15:49:48 +0800
Subject: [PATCH 06/32] board: ibex_ast2700: Enable MSI and INTA on bridge

Signed-off-by: Jacky Chou <jacky_chou@aspeedtech.com>
Change-Id: Iaf0ccd7cc329d8ad01b275c8622751309ae05210
(cherry picked from commit b31b8f8f645863f2f645f3d7ddcda108ec0dc9aa)
Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 arch/riscv/include/asm/arch-ast2700/pci_ast2700.h |  5 +++++
 board/aspeed/ibex_ast2700/ibex_ast2700.c          | 15 +++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/arch/riscv/include/asm/arch-ast2700/pci_ast2700.h b/arch/riscv/include/asm/arch-ast2700/pci_ast2700.h
index 4a62956d52..dead075850 100644
--- a/arch/riscv/include/asm/arch-ast2700/pci_ast2700.h
+++ b/arch/riscv/include/asm/arch-ast2700/pci_ast2700.h
@@ -6,11 +6,16 @@
 #define _ASM_ARCH_PCI_AST2700_H
 
 #define ASPEED_PLDA1_BASE		0x12c15000
+#define ASPEED_PLDA1_MSI_CAP		(ASPEED_PLDA1_BASE + 0x10)
 #define ASPEED_PLDA1_PRESET0		(ASPEED_PLDA1_BASE + 0xb0)
 #define ASPEED_PLDA1_PRESET1		(ASPEED_PLDA1_BASE + 0xb4)
 
 #define ASPEED_PLDA2_BASE		0x12c15800
+#define ASPEED_PLDA2_MSI_CAP		(ASPEED_PLDA2_BASE + 0x10)
 #define ASPEED_PLDA2_PRESET0		(ASPEED_PLDA2_BASE + 0xb0)
 #define ASPEED_PLDA2_PRESET1		(ASPEED_PLDA2_BASE + 0xb4)
 
+#define ASPEED_PLDA3_BASE		0x14c1c000
+#define ASPEED_PLDA3_MSI_CAP		(ASPEED_PLDA3_BASE + 0x10)
+
 #endif
diff --git a/board/aspeed/ibex_ast2700/ibex_ast2700.c b/board/aspeed/ibex_ast2700/ibex_ast2700.c
index 3c031db87b..d9ea9e3c26 100644
--- a/board/aspeed/ibex_ast2700/ibex_ast2700.c
+++ b/board/aspeed/ibex_ast2700/ibex_ast2700.c
@@ -171,6 +171,11 @@ static int pci_init(void)
 		writel(0x12600000, (void *)ASPEED_PLDA2_PRESET0);
 		writel(0x00012600, (void *)ASPEED_PLDA2_PRESET1);
 
+		// Enable Bridge2 MSI
+		clrbits_le32((void *)ASPEED_PLDA2_MSI_CAP, BIT(3));
+		// Set Bridge2 INTA
+		clrsetbits_le32((void *)ASPEED_PLDA2_MSI_CAP, GENMASK(2, 0), 0x1);
+
 		// clk/reset for e2m
 		setbits_le32(&scu->clkgate_clr, SCU_CPU_CLKGATE1_E2M1);
 		mdelay(10);
@@ -181,6 +186,16 @@ static int pci_init(void)
 	writel(0x12600000, (void *)ASPEED_PLDA1_PRESET0);
 	writel(0x00012600, (void *)ASPEED_PLDA1_PRESET1);
 
+	// Enable Bridge1 MSI
+	clrbits_le32((void *)ASPEED_PLDA1_MSI_CAP, BIT(3));
+	// Set Bridge1 INTA
+	clrsetbits_le32((void *)ASPEED_PLDA1_MSI_CAP, GENMASK(2, 0), 0x1);
+
+	// Enable Bridge3 MSI
+	clrbits_le32((void *)ASPEED_PLDA3_MSI_CAP, BIT(3));
+	// Set Bridge3 INTA
+	clrsetbits_le32((void *)ASPEED_PLDA3_MSI_CAP, GENMASK(2, 0), 0x1);
+
 	// clk/reset for e2m
 	setbits_le32(&scu->clkgate_clr, SCU_CPU_CLKGATE1_E2M0);
 	mdelay(10);
-- 
2.34.1

