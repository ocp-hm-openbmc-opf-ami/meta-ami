From 05b9b5e7ee45df936251b8bed96c64f05af2ff3b Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Wed, 30 Jul 2025 17:41:46 +0530
Subject: [PATCH] adding Fieldmode to enable failure when signature validation
 fails and Save env variables before autoboot

---
 common/main.c                 | 1 +
 include/configs/evb_ast2700.h | 1 +
 2 files changed, 2 insertions(+)

diff --git a/common/main.c b/common/main.c
index 7c70de2e59..b258a3b54b 100644
--- a/common/main.c
+++ b/common/main.c
@@ -65,6 +65,7 @@ void main_loop(void)
 	if (cli_process_fdt(&s))
 		cli_secure_boot_cmd(s);
 
+	env_save();
 	autoboot_command(s);
 
 	cli_loop();
diff --git a/include/configs/evb_ast2700.h b/include/configs/evb_ast2700.h
index 1aa595783c..3cd5cea207 100644
--- a/include/configs/evb_ast2700.h
+++ b/include/configs/evb_ast2700.h
@@ -26,5 +26,6 @@
 	"bootb=setenv bootpart 3; setenv rootfs rofs-b; run setmmcargs; ext4load mmc 0:${bootpart} ${loadaddr} fitImage && bootm ${loadaddr}; echo Error loading kernel FIT image\0"	\
 	"bootmmc=if test \"${bootside}\" = \"b\"; then run bootb; run boota; else run boota; run bootb; fi\0"	\
 	"verify=yes\0"	\
+	"fieldmode=true\0" \
 	""
 #endif	/* __CONFIG_H */
-- 
2.34.1

