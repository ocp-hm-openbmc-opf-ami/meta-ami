From 3a3edad2c38d9042c7aeb77ffbecede73fd708f6 Mon Sep 17 00:00:00 2001
From: Cool Lee <cool_lee@aspeedtech.com>
Date: Fri, 21 Nov 2025 14:05:17 +0800
Subject: [PATCH] dts: ast2700-ibex-reserved-mem: mmbi align to 64MB

Signed-off-by: Cool Lee <cool_lee@aspeedtech.com>
Change-Id: I660467b5d3102eb5a5653e0b54c399d4fdc55a52
(cherry picked from commit 869d6b68725882c216d123aa7d11931215a0d971)
Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 arch/riscv/dts/ast2700-ibex-reserved-mem.dtsi | 55 +++++++------------
 1 file changed, 19 insertions(+), 36 deletions(-)

diff --git a/arch/riscv/dts/ast2700-ibex-reserved-mem.dtsi b/arch/riscv/dts/ast2700-ibex-reserved-mem.dtsi
index 2804c3c61895..e227528aeebb 100644
--- a/arch/riscv/dts/ast2700-ibex-reserved-mem.dtsi
+++ b/arch/riscv/dts/ast2700-ibex-reserved-mem.dtsi
@@ -3,52 +3,34 @@
 /* AST2700 reserved memories with no-map property */
 
 #if DUAL_NODE
-espi1_mmbi_memory: espi1-mmbi-memory@93800000 {
-	reg = <0x93800000 0x4000000>;
+espi1_mmbi_memory: espi1-mmbi-memory@418000000 {
+	reg = <0x4 0x18000000 0x0 0x4000000>;
 	no-map;
 	bootph-all;
 };
 
-#if EDAF_128MB
-// This area used for eDAF DDR mode even in MIX mode or HW mode(enabled in SPL)
-edaf1: edaf1-memory@97800000 {
-	reg = <0x97800000 0x8000000>;
-	no-map;
-	bootph-all;
-};
-#else
-edaf1: edaf1-memory@9b800000 {
-	reg = <0x9b800000 0x4000000>;
+edaf1: edaf1-memory@41c000000 {
+	reg = <0x4 0x1c000000 0x0 0x4000000>;
 	no-map;
 	bootph-all;
 };
 #endif
-#endif
 
-#if EDAF_128MB
-// This area used for eDAF DDR mode even in MIX mode or HW mode(enabled in SPL)
-edaf0: eadf0-memory@49f800000 {
-	reg = <0x9f800000 0x8000000>;
+edaf0: eadf0-memory@428000000 {
+	reg = <0x4 0x28000000 0x0 0x4000000>;
 	no-map;
 	bootph-all;
 };
-#else
-edaf0: eadf0-memory@a3800000 {
-	reg = <0xa3800000 0x4000000>;
-	no-map;
-	bootph-all;
-};
-#endif
 
-espi0_mmbi_memory: espi0-mmbi-memory@a7800000 {
-	reg = <0xa7800000 0x4000000>;
+espi0_mmbi_memory: espi0-mmbi-memory@424000000 {
+	reg = <0x4 0x24000000 0x0 0x4000000>;
 	no-map;
 	bootph-all;
 };
 
 #if PCIE0_EP
-bmc_dev0_memory: bmc-dev0-memory@ab800000 {
-	reg = <0xab800000 0x100000>;
+bmc_dev0_memory: bmc-dev0-memory@423800000 {
+	reg = <0x4 0x23800000 0x0 0x100000>;
 	no-map;
 	bootph-all;
 };
@@ -57,18 +39,19 @@ xdma_memory0: xdma0 {
 	size = <0x0 0x00100000>;
 	compatible = "shared-dma-pool";
 	no-map;
+	bootph-all;
 };
 
-pcie0_mmbi0_memory: pcie0-mmbi0-memory@aba00000 {
-	reg = <0xaba00000 0x200000>;
+pcie0_mmbi0_memory: pcie0-mmbi0-memory@423a00000 {
+	reg = <0x4 0x23a00000 0x0 0x200000>;
 	no-map;
 	bootph-all;
 };
 #endif
 
 #if PCIE1_EP
-bmc_dev1_memory: bmc-dev1-memory@ab900000 {
-	reg = <0xab900000 0x100000>;
+bmc_dev1_memory: bmc-dev1-memory@423900000 {
+	reg = <0x4 0x23900000 0x0 0x100000>;
 	no-map;
 	bootph-all;
 };
@@ -80,15 +63,15 @@ xdma_memory1: xdma1 {
 	bootph-all;
 };
 
-pcie1_mmbi4_memory: pcie1-mmbi4-memory@abc00000 {
-	reg = <0xabc00000 0x200000>;
+pcie1_mmbi4_memory: pcie1-mmbi4-memory@423c00000 {
+	reg = <0x4 0x23c00000 0x0 0x200000>;
 	no-map;
 	bootph-all;
 };
 #endif
 
-pcie2_mmbi0_memory: pcie2-mmbi0-memory@abe00000 {
-	reg = <0xabe00000 0x200000>;
+pcie2_mmbi0_memory: pcie2-mmbi0-memory@423e00000 {
+	reg = <0x4 0x23e00000 0x0 0x200000>;
 	no-map;
 	bootph-all;
 };
-- 
2.34.1

