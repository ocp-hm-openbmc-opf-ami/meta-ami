From e48918b2821df07c23525ff619100c2d2346ecee Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Tue, 21 Oct 2025 17:50:24 +0530
Subject: [PATCH] Add hw failsafe bootsupport for ast2700

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 arch/arm/mach-aspeed/ast2700/board_common.c | 5 +++++
 common/autoboot.c                           | 7 +++++++
 2 files changed, 12 insertions(+)

diff --git a/arch/arm/mach-aspeed/ast2700/board_common.c b/arch/arm/mach-aspeed/ast2700/board_common.c
index a4a980e8c1..829957e6e3 100644
--- a/arch/arm/mach-aspeed/ast2700/board_common.c
+++ b/arch/arm/mach-aspeed/ast2700/board_common.c
@@ -89,5 +89,10 @@ int board_init(void)
 			break;
 	}
 
+	writel((readl(0x14C02030) | 0x1), 0x14C02030);//enable ABR mode
+	writel((readl(0x14c3740c) | 0x1), 0x14c3740c);//enable FMC WDT
+	writel(0x23A9F65B, 0x14c37404);//10 min WDT time out
+	writel(0x4755, 0x14c37408);//reload timer value
+
 	return 0;
 }
diff --git a/common/autoboot.c b/common/autoboot.c
index 5d331991c1..1098327883 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -488,6 +488,13 @@ void autoboot_command(const char *s)
 {
 	debug("### main_loop: bootcmd=\"%s\"\n", s ? s : "<UNDEFINED>");
 
+	writel((readl(0x14c3740c) & 0xFFFE), 0x14c3740c);//disable FMC_WDT2
+	if (!(readl(0x14c3744c) & 0x10))
+	{
+		writel(0xEA000000, 0x14c3744c);//clear boot source
+	}
+	writel((readl(0x14c3740c) | 0x1), 0x14c3740c);//enable FMC_WDT2
+
 	if (s && (stored_bootdelay == -2 ||
 		 (stored_bootdelay != -1 && !abortboot(stored_bootdelay)))) {
 		bool lock;
-- 
2.47.1

