 #define SCU_CPU_VGA_FUNC_DAC_OUTPUT		GENMASK(11, 10)
 #define SCU_CPU_VGA_FUNC_DP_OUTPUT		GENMASK(9, 8)
@@ -274,7 +280,7 @@ struct ast2700_scu0 {
 	uint32_t pinmux2;		/* 0x404 */
 	uint32_t pinmux3;		/* 0x408 */
 	uint32_t rsv_0x40c;		/* 0x40C */
