+#define SCU_CPU_RST2_USBB_PHY3			BIT(4)
+#define SCU_CPU_RST2_USBB_VHUB1			BIT(3)
+#define SCU_CPU_RST2_USBA_XHCI			BIT(2)
+#define SCU_CPU_RST2_USBA_PHY3			BIT(1)
