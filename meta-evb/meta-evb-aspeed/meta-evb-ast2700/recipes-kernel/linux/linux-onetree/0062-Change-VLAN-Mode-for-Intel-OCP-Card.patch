From 117489ed2c48b39f33d96ee334f516054a9d629b Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Thu, 15 May 2025 20:37:10 +0800
Subject: [PATCH] Change VLAN Mode for Intel OCP Card

---
 net/ncsi/ncsi-manage.c | 5 ++++-
 net/ncsi/internal.h | 2 +-
 2 file changed, 5 insertions(+), 2 deletion(-)

diff --git a/net/ncsi/internal.h b/net/ncsi/internal.h
index 67063f4b008c..b8c3eb40ee74 100644
--- a/net/ncsi/internal.h
+++ b/net/ncsi/internal.h
@@ -47,7 +47,7 @@ enum {
 	NCSI_CAP_AEN_MASK                = 0x07,
 	NCSI_CAP_VLAN_ONLY               = 0x01, /* Filter VLAN packet only  */
 	NCSI_CAP_VLAN_NO                 = 0x02, /* Filter VLAN and non-VLAN */
-	NCSI_CAP_VLAN_ANY                = 0x04, /* Filter Any-and-non-VLAN  */
+	NCSI_CAP_VLAN_ANY                = 0x03, /* Filter Any-and-non-VLAN  */
 	NCSI_CAP_VLAN_MASK               = 0x07
 };
 
diff --git a/net/ncsi/ncsi-manage.c b/net/ncsi/ncsi-manage.c
index 2d798e234fd8..32f848b9b705 100644
--- a/net/ncsi/ncsi-manage.c
+++ b/net/ncsi/ncsi-manage.c
@@ -1104,7 +1104,10 @@ static void ncsi_configure_channel(struct ncsi_dev_priv *ndp)
 				nca.type = NCSI_PKT_CMD_DV;
 			} else {
 				nca.type = NCSI_PKT_CMD_EV;
-				nca.bytes[3] = NCSI_CAP_VLAN_NO;
+				if (nc->version.mf_id == NCSI_OEM_MFR_INTEL_ID)
+					nca.bytes[3] = NCSI_CAP_VLAN_ANY;
+				else
+					nca.bytes[3] = NCSI_CAP_VLAN_NO;
 			}
 			nd->state = ncsi_dev_state_config_sma;
 		} else if (nd->state == ncsi_dev_state_config_sma) {
-- 
2.34.1

