From 2d3858e5c49f87e6dca1b2276d5a20ebe0304d90 Mon Sep 17 00:00:00 2001
From: mickhuang <mickhuang@ami.com>
Date: Wed, 13 Aug 2025 14:38:46 +0800
Subject: [PATCH] Add-PowerSaveMode-Support-for-AST2700-PortA

---
 drivers/usb/gadget/udc/aspeed-vhub/core.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/gadget/udc/aspeed-vhub/core.c b/drivers/usb/gadget/udc/aspeed-vhub/core.c
index 9c674bd0fa38..8d95e9bf3de5 100644
--- a/drivers/usb/gadget/udc/aspeed-vhub/core.c
+++ b/drivers/usb/gadget/udc/aspeed-vhub/core.c
@@ -328,7 +328,16 @@ static void ast_vhub_remove(struct platform_device *pdev)
 		return;
 
 	/* Unexpose vHub upstream control to SYSFS*/
-	ami_core_sysfs_unregister(vhub);
+	const struct device_node *np = pdev->dev.of_node;
+	if (of_device_is_compatible(np, "aspeed,ast2700-usb-vhuba0") ||
+		of_device_is_compatible(np, "aspeed,ast2700-usb-vhuba1")) {
+		/*
+		* TODO: Currently only supports PortA (vhuba0/vhuba1).
+		* Need refactor to support full AST2700 ports (A/B/C/D)
+		* and backward compatibility with AST2600.
+		*/
+		ami_core_sysfs_unregister(vhub);
+	}
 
 	/* Remove devices */
 	for (i = 0; i < vhub->max_ports; i++)
@@ -519,7 +528,16 @@ static int ast_vhub_probe(struct platform_device *pdev)
 		 vhub->force_usb1 ? 1 : 2);
 
 	/* Expose vHub upstream control to SYSFS*/
-	ami_core_sysfs_register(vhub);
+	if (of_device_is_compatible(np, "aspeed,ast2700-usb-vhuba0") ||
+		of_device_is_compatible(np, "aspeed,ast2700-usb-vhuba1")) {
+
+		/*
+		* TODO: Currently only supports PortA (vhuba0/vhuba1).
+		* Need refactor to support full AST2700 ports (A/B/C/D)
+		* and backward compatibility with AST2600.
+		*/
+		ami_core_sysfs_register(vhub);
+	}
 
 	return 0;
  err:
-- 
2.34.1
