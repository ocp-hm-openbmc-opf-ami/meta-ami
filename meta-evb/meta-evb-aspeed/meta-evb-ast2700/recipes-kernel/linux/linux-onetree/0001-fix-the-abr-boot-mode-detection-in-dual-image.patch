From b10384d2c80c92088edb41bebe83768f4e633363 Mon Sep 17 00:00:00 2001
From: Vasanthakumar K <vasanthakumark@ami.com>
Date: Wed, 19 Aug 2026 18:16:14 +0530
Subject: [PATCH]  fix the abr boot mode detection in dual image

Upstream-Status: Inappropriate [AMI specific change]

Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 drivers/spi/spi-aspeed-smc.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/drivers/spi/spi-aspeed-smc.c b/drivers/spi/spi-aspeed-smc.c
index fee9a1d75e41..d48d352e3a0a 100644
--- a/drivers/spi/spi-aspeed-smc.c
+++ b/drivers/spi/spi-aspeed-smc.c
@@ -276,6 +276,13 @@ static ssize_t abr_bootmode_show(struct device *dev,
 				sysfs_emit(buf, "error\n");
 }
 
+static struct aspeed_spi *aspeed_spi_get_drvdata(struct device *dev)
+{
+	struct spi_controller *ctlr = dev_get_drvdata(dev);
+
+	return spi_controller_get_devdata(ctlr);
+}
+
 static inline ssize_t _access_primary_show(void __iomem *regs,
 					   struct device_attribute *attr,
 					   char *buf)
@@ -355,7 +362,7 @@ static inline ssize_t _current_boot_show(void __iomem *regs,
 static ssize_t access_primary_show(struct device *dev,
 				   struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_primary_show(aspi->regs, attr, buf);
 }
@@ -364,7 +371,7 @@ static ssize_t access_primary_store(struct device *dev,
 				    struct device_attribute *attr,
 				    const char *buf, size_t size)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_primary_store(aspi->regs, attr, buf, size);
 }
@@ -372,7 +379,7 @@ static ssize_t access_primary_store(struct device *dev,
 static ssize_t access_backup_show(struct device *dev,
 				  struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_backup_show(aspi->regs, attr, buf);
 }
@@ -381,7 +388,7 @@ static ssize_t access_backup_store(struct device *dev,
 				   struct device_attribute *attr,
 				   const char *buf, size_t size)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_backup_store(aspi->regs, attr, buf, size);
 }
@@ -389,7 +396,7 @@ static ssize_t access_backup_store(struct device *dev,
 static ssize_t current_boot_show(struct device *dev,
 				  struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _current_boot_show(aspi->regs, attr, buf);
 }
