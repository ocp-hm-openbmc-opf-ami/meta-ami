From 0ad89ab42cf4f15d56c239032c940197ce87ae90 Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Tue, 23 Jul 2024 13:21:20 +0800
Subject: [PATCH] Update 2700 DTS File for NCSI

---
 arch/arm64/boot/dts/aspeed/ast2700-ncsi.dts | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/aspeed/ast2700-ncsi.dts b/arch/arm64/boot/dts/aspeed/ast2700-ncsi.dts
index 10ef4b0d6a49..81175111f73b 100644
--- a/arch/arm64/boot/dts/aspeed/ast2700-ncsi.dts
+++ b/arch/arm64/boot/dts/aspeed/ast2700-ncsi.dts
@@ -8,8 +8,14 @@ / {
 	model = "AST2700-NCSI";
 };
 
-&sgpios {
-	status = "disabled";
+&mac0 {
+        status = "okay";
+
+        phy-mode = "rmii";
+        use-ncsi;
+
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_rmii0_default>;
 };
 
 &mac1 {
