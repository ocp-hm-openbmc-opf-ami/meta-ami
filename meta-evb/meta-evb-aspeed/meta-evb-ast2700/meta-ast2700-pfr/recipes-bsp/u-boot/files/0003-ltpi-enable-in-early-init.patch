From bd65b5c2ad60f9fbfad260b9622f7d20be4c1bc6 Mon Sep 17 00:00:00 2001
From: desmondwu <desmondwu@ami.com>
Date: Tue, 3 Jun 2025 14:22:06 +0800
Subject: [PATCH] ltpi early init support

---
 board/aspeed/ast2700_dcscm/ast2700_dcscm.c |  5 ++
 cmd/aspeed/ltpi/ltpi-v2.c                  | 71 +++++++++++++++++++++-
 2 files changed, 75 insertions(+), 1 deletion(-)

diff --git a/board/aspeed/ast2700_dcscm/ast2700_dcscm.c b/board/aspeed/ast2700_dcscm/ast2700_dcscm.c
index 945462ea5d..ceff1c75d3 100644
--- a/board/aspeed/ast2700_dcscm/ast2700_dcscm.c
+++ b/board/aspeed/ast2700_dcscm/ast2700_dcscm.c
@@ -6,8 +6,13 @@
 
 #define ASPEED_SCU_CPU_BASE           0x12c02000
 
+extern int ltpi_enable(int bus_number);
+
 int board_early_init_f(void)
 {
+	if (IS_ENABLED(CONFIG_AST2700_CMD_LTPI_V2)) {
+		ltpi_enable(0);	
+	}		
 	if (IS_ENABLED(CONFIG_AVENUE_CITY_CRB)) {
 		// Testing AST2700 DCSCM AvenueCity Video.
 		// Disable e2m for pcie device.
diff --git a/cmd/aspeed/ltpi/ltpi-v2.c b/cmd/aspeed/ltpi/ltpi-v2.c
index a2a554ce40..49323392a9 100644
--- a/cmd/aspeed/ltpi/ltpi-v2.c
+++ b/cmd/aspeed/ltpi/ltpi-v2.c
@@ -174,7 +174,44 @@ struct ltpi_priv {
 	int ad_timeout;
 };
 
-static struct ltpi_priv ltpi_data[2];
+static struct ltpi_priv ltpi_data[2] = {
+    {
+        .index = 0,
+        .bootstage = NULL,
+        .base = LTPI_REG,
+        .phy_base = LTPI_REG + 0x200,
+        .top_base = LTPI_REG + 0x800,
+        .gpio_base = LTPI_REG + 0xc00,
+        .reset = {
+            .regs_assert = SCU1_RSTCTL2,
+            .regs_deassert = SCU1_RSTCTL2_CLR,
+            .bit_mask = SCU1_RSTCTL2_LTPI0,
+        },
+        .clk_ctrl = {
+            .regs_gate = SCU1_CLKGATE2,
+            .regs_ungate = SCU1_CLKGATE2_CLR,
+            .bit_mask = SCU1_CLKGATE2_LTPI0_TX,
+        },
+    },
+    {
+        .index = 1,
+        .bootstage = NULL,
+        .base = LTPI_REG + 0x1000,
+        .phy_base = LTPI_REG + 0x1200,
+        .top_base = LTPI_REG + 0x1800,
+        .gpio_base = LTPI_REG + 0x1c00,
+        .reset = {
+            .regs_assert = SCU1_RSTCTL2,
+            .regs_deassert = SCU1_RSTCTL2_CLR,
+            .bit_mask = SCU1_RSTCTL2_LTPI1,
+        },
+        .clk_ctrl = {
+            .regs_gate = SCU1_CLKGATE2,
+            .regs_ungate = SCU1_CLKGATE2_CLR,
+            .bit_mask = SCU1_CLKGATE2_LTPI1_TX,
+        },
+    }
+};
 
 /**
  * @brief Count the number of leading zeros of a uint16_t
@@ -1076,5 +1113,37 @@ static char ltpi_help_text[] = {
 	"-r <rx link-speed count in AD-align>, default 0\n"
 	"-s, Display current link status\n"
 };
+extern int ltpi_enable(int bus_number)
+{
+	struct rom_context rc;
+	struct bootstage_t sts;	
+	int opt, speed = 0, mode = 0;
 
+	ltpi_data[0].ad_timeout = ADVERTISE_TIMEOUT_US;
+	ltpi_data[1].ad_timeout = ADVERTISE_TIMEOUT_US;
+	ltpi_data[0].clk_inverse = 0x0;
+	ltpi_data[1].clk_inverse = 0x0;
+	ltpi_data[0].io_driving = 0x2;
+	ltpi_data[1].io_driving = 0x2;
+	ltpi_data[0].crc_format = 0x0;
+	ltpi_data[1].crc_format = 0x0;
+	ltpi_data[0].link_speed_frm_rx_cnt = 0;
+	ltpi_data[1].link_speed_frm_rx_cnt = 0;
+
+	
+    /* Set pin strap according to the command argument */
+    writel(0xf, (void *)SCU1_HWSTRAP1 + 0x4);
+    setbits_le32((void *)SCU1_HWSTRAP1, SCU1_HWSTRAP1_LTPI0_EN);
+
+    /* Set otp strap according to the command argument */
+    ltpi_data[0].otp_speed_cap = LTPI_SP_CAP_ASPEED_SUPPORTED & ~speed;
+    ltpi_data[0].otp_ddr_dis = !!(speed & LTPI_SP_CAP_DDR);
+    ltpi_data[1].otp_speed_cap = LTPI_SP_CAP_ASPEED_SUPPORTED & ~speed;
+    ltpi_data[1].otp_ddr_dis = !!(speed & LTPI_SP_CAP_DDR);	
+
+	sts = ltpi_init(&rc);
+	if (sts.errno & LTPI_STATUS_EXIT)
+		return -1;	
+	return 0;
+}
 U_BOOT_CMD(ltpi, 11, 0, do_ltpi, "ASPEED LTPI commands", ltpi_help_text);
-- 
