{
    "sdcard": {
        "DEVICE_NAME": "/dev/mmcblk0",
        "CLEAN_PARTS": [
            "/dev/mmcblk0p3"
        ],
        "PARTITION_COUNT": "6"
    },
    "partitions": [
        {
            "name": "rwfs",
            "fs_type": "ext4",
            "mnt_path": "/run/initramfs/rw",
            "size_mb": "100"
        },
        {
            "name": "sensor-reader",
            "fs_type": "ext4",
            "mnt_path": "/etc/sensor-reader",
            "size_mb": "512"
        },
        {
            "name": "FWIMAGE",
            "fs_type": "vfat",
            "mnt_path": "/tmp/images",
            "size_mb": "512"
        },
        {
            "name": "SEL",
            "fs_type": "ext4",
            "mnt_path": "/etc/extlog",
            "size_mb": "20"
        },
        {
            "name": "LMEDIA",
            "fs_type": "ext4",
            "mnt_path": "/tmp/lmedia",
            "size_mb": "1024"
        },
        {
            "name": "recovery",
            "fs_type": "ext4",
            "mnt_path": "/mnt/recovery",
            "size_mb": "512"
        }
    ]
}