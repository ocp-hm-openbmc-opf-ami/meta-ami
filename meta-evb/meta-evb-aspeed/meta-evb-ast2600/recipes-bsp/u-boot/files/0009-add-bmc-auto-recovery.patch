diff --git a/oem/ami/ami_bmc_recovery.c b/oem/ami/ami_bmc_recovery.c
new file mode 100644
index 0000000000..f29505275b
--- /dev/null
+++ b/oem/ami/ami_bmc_recovery.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ami_bmc_recovery.c - BMC auto-recovery with eMMC primary and TFTP fallback
+ */
+#include <common.h>
+#include <command.h>
+#include <environment.h>
+#include <net.h>
+#include <linux/delay.h>
+#include <linux/stringify.h>
+#include "ami_bmc_recovery.h"
+
+#define RECOVERY_LOAD_ADDR      0x83000000UL
+#define RECOVERY_SPI_OFFSET     0x0
+
+
+static int need_recovery(void)
+{
+	unsigned int current_retry, retry_limit;
+
+	current_retry = simple_strtoul(env_get("recovery_current_bootretry") ?: "0", NULL, 10);
+	retry_limit = simple_strtoul(env_get("recovery_max_bootretry") ?:
+		__stringify(CONFIG_RECOVERY_MAX_BOOTRETRY), NULL, 10);
+
+	/* only count this boot attempt if the limit is not already exceeded */
+	if (retry_limit > 0 && current_retry <= retry_limit) {
+		current_retry++;
+		env_set("recovery_current_bootretry", simple_itoa(current_retry));
+		env_save();
+		printf("AUTO-RECOVERY: Normal boot retry count=%u (limit=%u)\n",
+		       current_retry, retry_limit);
+		if (current_retry > retry_limit) {
+			printf("AUTO-RECOVERY: Auto-recovery triggered (recovery_current_bootretry=%u > recovery_max_bootretry=%u)\n",
+			       current_retry, retry_limit);
+			return 1;
+		}
+	} else if (retry_limit > 0 && current_retry > retry_limit) {
+		printf("AUTO-RECOVERY: Auto-recovery triggered (recovery_current_bootretry=%u > recovery_max_bootretry=%u)\n",
+		       current_retry, retry_limit);
+		return 1;
+	}
+
+	return 0;
+}
+
+static int SPI_Flash(ulong load_addr)
+{
+	char sf_cmd[96];
+	const char *img_size;
+
+	if (run_command("sf probe 0", 0) != 0) {
+		printf("AUTO-RECOVERY: SPI probe failed\n");
+		return -1;
+	}
+
+	img_size = env_get("filesize");
+	if (!img_size || !img_size[0]) {
+		printf("AUTO-RECOVERY: invalid image size from filesize env\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: flashing filesize=%s to offset 0x%lx\n",
+	       img_size, RECOVERY_SPI_OFFSET);
+
+	snprintf(sf_cmd, sizeof(sf_cmd),
+		 "sf update 0x%lx 0x%lx ${filesize}",
+		 load_addr, RECOVERY_SPI_OFFSET);
+	if (run_command(sf_cmd, 0) != 0) {
+		printf("AUTO-RECOVERY: sf update failed\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: flash complete\n");
+	return 0;
+}
+
+static int recovery_from_emmc(void)
+{
+	unsigned int retry, retry_max;
+	const char *img_name;
+	unsigned int mmc_dev, mmc_part;
+	char cmd[192];
+	env_set("recovery_last_source", "mmc");
+
+	img_name = (env_get("recovery_bootfile") && env_get("recovery_bootfile")[0]) ?
+		env_get("recovery_bootfile") : CONFIG_RECOVERY_BOOTFILE;
+	retry_max = simple_strtoul(env_get("recovery_retry") ?:
+		__stringify(CONFIG_RECOVERY_RETRY), NULL, 10);
+	mmc_dev = simple_strtoul(env_get("recovery_mmc_dev") ?:
+		__stringify(CONFIG_RECOVERY_MMC_DEV), NULL, 10);
+	mmc_part = simple_strtoul(env_get("recovery_mmc_part") ?: __stringify(CONFIG_RECOVERY_MMC_PART), NULL, 10);
+
+	if (!img_name[0]) {
+		printf("AUTO-RECOVERY: recovery_bootfile is empty\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: loading %s from ext4 mmc %u:%u\n",
+	       img_name, mmc_dev, mmc_part);
+
+	for (retry = 0; retry < retry_max; retry++) {
+		printf("AUTO-RECOVERY: eMMC attempt %u/%u: ext4load mmc %u:%u 0x%lx /%s\n",
+		       retry + 1, retry_max, mmc_dev, mmc_part,
+		       RECOVERY_LOAD_ADDR, img_name);
+
+		/*
+		 * Use ext4load to read the image from the ext4-formatted
+		 * recovery partition (mount point /mnt/recovery on Linux).
+		 */
+		snprintf(cmd, sizeof(cmd),
+			 "mmc dev %d && mmc rescan && ext4load mmc %d:%d 0x%lx /%s",
+			 mmc_dev, mmc_dev, mmc_part,
+			 RECOVERY_LOAD_ADDR, img_name);
+
+		if (run_command(cmd, 0) != 0) {
+			printf("AUTO-RECOVERY: ext4load failed on mmc %u:%u attempt %u\n",
+			       mmc_dev, mmc_part, retry + 1);
+			continue;
+		}
+
+		printf("AUTO-RECOVERY: eMMC load completed, filesize=%s\n",
+		       env_get("filesize"));
+
+		printf("AUTO-RECOVERY: Flashing SPI-ROM\n");
+		if (SPI_Flash(RECOVERY_LOAD_ADDR) == 0) {
+			return 0;
+		}
+	}
+
+	printf("AUTO-RECOVERY: eMMC recovery failed after %u attempts\n", retry_max);
+	return -1;
+}
+
+static int recovery_from_tftp(void)
+{
+	const char *tftp_ip, *img_name;
+	char cmd[128];
+	unsigned int retry, retry_max;
+	env_set("recovery_last_source", "tftp");
+
+	tftp_ip = env_get("recovery_tftp_ip");
+	img_name = (env_get("recovery_bootfile") && env_get("recovery_bootfile")[0]) ?
+		env_get("recovery_bootfile") : CONFIG_RECOVERY_BOOTFILE;
+	retry_max = simple_strtoul(env_get("recovery_retry") ?: __stringify(CONFIG_RECOVERY_RETRY), NULL, 10);
+
+	if (!img_name || !img_name[0]) {
+		printf("AUTO-RECOVERY: recovery_bootfile is not configured\n");
+		return -1;
+	}
+	if (!tftp_ip || !tftp_ip[0] || !strcmp(tftp_ip, "0.0.0.0")) {
+		printf("AUTO-RECOVERY: recovery_tftp_ip is not configured\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: Downloading %s from TFTP server %s\n", img_name, tftp_ip);
+
+	snprintf(cmd, sizeof(cmd), "tftp 0x%lx %s:%s",
+		 RECOVERY_LOAD_ADDR, tftp_ip, img_name);
+
+	if (net_loop(DHCP) < 0) {
+		printf("AUTO-RECOVERY: DHCP failed\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: TFTP target re-applied after DHCP: server=%s file=%s\n",
+	       tftp_ip, img_name);
+
+	for (retry = 0; retry < retry_max; retry++) {
+		if (retry > 0) {
+			printf("AUTO-RECOVERY: retrying TFTP (%u/%u) after link settle delay\n",
+			       retry + 1, retry_max);
+			mdelay(3000);
+		}
+
+		if (run_command(cmd, 0) == 0)
+			break;
+
+		printf("AUTO-RECOVERY: TFTP download attempt %u failed\n", retry + 1);
+	}
+
+	if (retry == retry_max) {
+		printf("AUTO-RECOVERY: TFTP download failed\n");
+		return -1;
+	}
+
+	printf("AUTO-RECOVERY: TFTP download completed, filesize=%s\n",
+	       env_get("filesize"));
+
+	printf("AUTO-RECOVERY: Flashing SPI-ROM\n");
+	if (SPI_Flash(RECOVERY_LOAD_ADDR) == 0) {
+		return 0;
+	}
+
+	printf("AUTO-RECOVERY: TFTP recovery failed after %u attempts\n", retry);
+	return -1;
+}
+
+int ami_bmc_recovery_check(void)
+{
+	const char *mode;
+
+	mode = env_get("recovery_mode_selection") ?: "auto";
+
+	if (strcmp(mode, "auto") && strcmp(mode, "mmc") && strcmp(mode, "tftp")) {
+		printf("AUTO-RECOVERY: invalid recovery_mode_selection=%s - going to manual recovery\n", mode);
+		return -1;
+	}
+
+	if (!need_recovery()) {
+		return 0;
+	}
+
+	printf("AUTO-RECOVERY: recovery triggered (recovery_mode_selection=%s)\n", mode);
+	printf("\n*** AUTO-RECOVERY TRIGGERED ***\n");
+
+	if (!strcmp(mode, "mmc")) {
+		/* forced eMMC-only */
+		if (recovery_from_emmc() == 0) {
+			printf("AUTO-RECOVERY: eMMC recovery succeeded - resetting\n");
+			goto recovery_done;
+		}
+		printf("AUTO-RECOVERY: FATAL - eMMC recovery failed\n");
+	} else if (!strcmp(mode, "tftp")) {
+		/* forced TFTP-only */
+		if (recovery_from_tftp() == 0) {
+			printf("AUTO-RECOVERY: TFTP recovery succeeded - resetting\n");
+			goto recovery_done;
+		}
+		printf("AUTO-RECOVERY: FATAL - TFTP recovery failed\n");
+	} else if (!strcmp(mode, "auto")) {
+		const char *last = env_get("recovery_last_source") ?: "none";
+
+		if (!strcmp(last, "none")) {
+			/* no prior attempt this cycle, try eMMC first */
+			if (recovery_from_emmc() == 0) {
+				printf("AUTO-RECOVERY: eMMC recovery succeeded - resetting\n");
+				goto recovery_done;
+			}
+			printf("AUTO-RECOVERY: eMMC recovery failed, will try TFTP next cycle\n");
+		} else if (!strcmp(last, "mmc")) {
+			/* eMMC was already tried, fall back to TFTP */
+			if (recovery_from_tftp() == 0) {
+				printf("AUTO-RECOVERY: TFTP recovery succeeded - resetting\n");
+				goto recovery_done;
+			}
+			printf("AUTO-RECOVERY: FATAL - both eMMC and TFTP recovery failed\n");
+		} else {
+			printf("AUTO-RECOVERY: FATAL - unexpected recovery_last_source=%s\n", last);
+		}
+	}
+
+	printf("AUTO-RECOVERY: Manual flashing is required; dropping to U-Boot prompt\n");
+	return -1;
+
+recovery_done:
+	env_set("recovery_current_bootretry", "0");
+	env_save();
+
+	do_reset(NULL, 0, 0, NULL);
+      return 1;
+}
