 }
 
+#ifdef CONFIG_BMC_AUTO_RECOVERY
+void aspeed_disable_hw_abr(void)
+{
+	u32 val;
+
+	if (!(readl(ASPEED_HW_STRAP2) & BIT(11)))
+		return; /* ABR already disabled */
+
+	/* Clear WDT2 timeout status (BIT(4)) and disable WDT2 (BIT(0)) */
+	val = readl(ASPEED_FMC_WDT2);
+	writel(val & ~(BIT(4) | BIT(0)), ASPEED_FMC_WDT2);
+
+	/* Clear ABR enable bit in HW_STRAP2 */
+	writel(readl(ASPEED_HW_STRAP2) & ~BIT(11), ASPEED_HW_STRAP2);
+
+	printf("HW ABR: disabled - software auto-recovery (bmc_auto_recovery) is active\n");
+}
+#endif
+
 void aspeed_print_2nd_wdt_mode(void)
 {
 	/* ABR enable */
