 oem/ami/ami_bmc_recovery.h |   8 ++
 include/env_default.h      |  13 ++
 arch/arm/include/asm/arch-aspeed/aspeed_scu_info.h |   3 +
 arch/arm/mach-aspeed/cpuinfo.c                     |   3 +
