From 3f04def23d77f49d47ae6c5dc977aafd02d51077 Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Tue, 1 Apr 2025 10:39:04 +0800
Subject: [PATCH] Update DTS File for Uboot: Enable NCSI on MAC3 and Disable MAC2
Upstream-Status: Inappropriate [NCSI specific]

---
 arch/arm/dts/ast2600-evb.dts | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/arch/arm/dts/ast2600-evb.dts b/arch/arm/dts/ast2600-evb.dts
index 98865d0bc3..8e6d8c9369 100644
--- a/arch/arm/dts/ast2600-evb.dts
+++ b/arch/arm/dts/ast2600-evb.dts
@@ -106,7 +106,7 @@
 };
 
 &mac2 {
-	status = "okay";
+	status = "disabled";
 	phy-mode = "rgmii-id";
 	phy-handle = <&ethphy2>;
 	pinctrl-names = "default";
@@ -118,10 +118,11 @@
 
 &mac3 {
 	status = "okay";
-	phy-mode = "rgmii-id";
-	phy-handle = <&ethphy3>;
+	phy-mode = "NC-SI";
+	use-ncsi;
 	pinctrl-names = "default";
-	pinctrl-0 = <&pinctrl_rgmii4_default>;
+	pinctrl-0 = <&pinctrl_rmii4_default>;
+	/delete-property/phy-handle;
 
 	rx-internal-delay-ps = <0>;
 	tx-internal-delay-ps = <0>;
-- 
2.43.0

