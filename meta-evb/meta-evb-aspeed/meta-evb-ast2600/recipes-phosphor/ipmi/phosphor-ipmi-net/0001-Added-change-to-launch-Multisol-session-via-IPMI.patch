+#include "config.h"
 #include <vector>
 
+#ifdef MULTI_SOL
+#define MAX_PAYLOAD_INSTANCE 4
+#else
+#define MAX_PAYLOAD_INSTANCE 1
+#endif
+
+
+
 namespace sol
 {
 
diff --git a/meson.build b/meson.build
index 0e449d4..2edd93f 100644
--- a/meson.build
+++ b/meson.build
@@ -15,6 +15,7 @@ project(
 conf_data = configuration_data()
 conf_data.set('RMCP_PING', get_option('rmcp_ping').allowed())
 conf_data.set('PAM_AUTHENTICATE', get_option('pam_authenticate').allowed())
+conf_data.set('MULTI_SOL', get_option('multi_sol').allowed())
 
 configure_file(output: 'config.h', configuration: conf_data)
 
diff --git a/meson.options b/meson.options
index 6f9cbaa..a2f8dc7 100644
