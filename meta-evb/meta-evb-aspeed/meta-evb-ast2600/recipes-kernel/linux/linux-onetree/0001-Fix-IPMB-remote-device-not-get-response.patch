From 4ef7a46a0c0d3b87648ff76816bb52ea83d65950 Mon Sep 17 00:00:00 2001
From: jasshsu <jasshsu@ami.com>
Date: Thu, 25 Sep 2025 15:51:05 +0800
Subject: [PATCH] Fix IPMB remote device can't get the ipmitool command
 response

---
 drivers/char/ipmi/ipmb_dev_int.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/char/ipmi/ipmb_dev_int.c b/drivers/char/ipmi/ipmb_dev_int.c
index 937189191512..5211362d9a07 100644
--- a/drivers/char/ipmi/ipmb_dev_int.c
+++ b/drivers/char/ipmi/ipmb_dev_int.c
@@ -330,8 +330,12 @@ static int ipmb_probe(struct i2c_client *client)
 	if (ret)
 		return ret;
 
-	ipmb_dev->is_i2c_protocol
-		= device_property_read_bool(&client->dev, "i2c-protocol");
+	#if 1 /* FIXME: Quick fix. Need to add parsing code for ipmb_id instead */
+    	ipmb_dev->is_i2c_protocol = true;
+	#else
+    	ipmb_dev->is_i2c_protocol
+        	= device_property_read_bool(&client->dev, "i2c-protocol");
+	#endif
 
 	ipmb_dev->client = client;
 	i2c_set_clientdata(client, ipmb_dev);
-- 
2.34.1

