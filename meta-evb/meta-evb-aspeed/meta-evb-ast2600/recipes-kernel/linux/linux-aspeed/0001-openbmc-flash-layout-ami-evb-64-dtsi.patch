From b07a079279f755016f50daaaefd971ebfeee92a3 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Mon, 4 Nov 2024 18:49:28 +0530
Subject: [PATCH] openbmc-flash-layout-ami-evb-64-dtsi

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    |  2 +-
 .../openbmc-flash-layout-ami-evb-64.dtsi      | 40 +++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 4d687e222de9..609882bf259b 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -192,7 +192,7 @@ flash@0 {
 		label = "bmc";
 		spi-rx-bus-width = <4>;
 		spi-max-frequency = <50000000>;
-#include "openbmc-flash-layout-64.dtsi"
+#include "openbmc-flash-layout-ami-evb-64.dtsi"
 	};
 	flash@1 {
 		status = "okay";
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64.dtsi
new file mode 100644
index 000000000000..4138a1203e50
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64.dtsi
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2020 Bytedance.
+ */
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0xe0000>; // 896KB
+		label = "u-boot";
+	};
+
+	u-boot-env@e0000 {
+		reg = <0xe0000 0x20000>; // 128KB
+		label = "u-boot-env";
+	};
+
+	kernel@100000 {
+		reg = <0x100000 0x900000>; // 9MB
+		label = "kernel";
+	};
+
+	rofs@a00000 {
+		reg = <0xa00000 0x2D00000>; // 45MB
+		label = "rofs";
+	};
+
+	rwfs@3700000 {
+		reg = <0x3700000 0x8f0000>; // 9MB
+		label = "rwfs";
+	};
+
+    reserved@3ff0000 {
+        reg = <0x3ff0000 0x10000>; // 64kb
+        label = "reserved";
+    };
+};
-- 
2.45.2

