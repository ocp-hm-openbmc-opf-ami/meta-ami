From 322afe2677c774cb8f789ddab9145618e9e5d3c4 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Fri, 8 Nov 2024 12:13:29 +0530
Subject: [PATCH] Enabled UART driver to EVB

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    | 30 +++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index b03c6f8daccb..db87bc3b8513 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -10,9 +10,14 @@ / {
 	model = "AST2600 EVB";
 	compatible = "aspeed,ast2600-evb", "aspeed,ast2600";
 
-	aliases {
-		serial4 = &uart5;
-	};
+       aliases {
+              serial0 = &uart1;
+              serial1 = &uart2;
+              serial2 = &uart3;
+              serial3 = &uart4;
+              serial4 = &uart5;
+      };
+
 
 	chosen {
 		bootargs = "console=ttyS4,115200n8";
@@ -228,9 +233,24 @@ spidev@2 {
 	};
 };
 
+&uart1 {
+        status = "okay";
+};
+
+&uart2 {
+        status = "okay";
+};
+
+&uart3 {
+        status = "okay";
+};
+
+&uart4 {
+        status = "okay";
+};
+
 &uart5 {
-	// Workaround for A0
-	compatible = "snps,dw-apb-uart";
+        status = "okay";
 };
 
 &i2c0 {
-- 
