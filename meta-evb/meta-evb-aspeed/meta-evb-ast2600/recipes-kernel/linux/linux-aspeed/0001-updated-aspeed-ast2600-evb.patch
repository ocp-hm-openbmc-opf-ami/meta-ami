From 9923cd19514cb471bf7fef9b73c4fd1714917335 Mon Sep 17 00:00:00 2001
From: shamim ali <ashamim@ami.com>
Date: Tue, 17 Dec 2024 17:50:07 +0530
Subject: [PATCH] updated aspeed ast2600 evb

Signed-off-by: shamim ali <ashamim@ami.com>
---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    | 186 +++++++++++++++++-
 1 file changed, 184 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 56129977eebe..e351e5770207 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -87,6 +87,91 @@ vccq_sdhci1: regulator-vccq-sdhci1 {
 		states = <3300000 1>,
 			 <1800000 0>;
 	};
+	
+	iio-hwmon {
+        compatible = "iio-hwmon";
+        io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
+                        <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
+                        <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
+                        <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
+       };
+};
+
+&syscon {
+        uart-clock-high-speed;
+        status = "okay";
+
+               mac0-clk-delay = <0x10 0x0a
+                                 0x10 0x10
+                                 0x10 0x10>;
+               mac1-clk-delay = <0x10 0x0a
+                                 0x10 0x10
+                                 0x10 0x10>;
+               mac2-clk-delay = <0x08 0x04
+                                 0x08 0x04
+                                 0x08 0x04>;
+               mac3-clk-delay = <0x08 0x04
+                                 0x08 0x04
+                                 0x08 0x04>;
+};
+
+&pwm_tacho {
+        status = "okay";
+        #pwm-cells = <3>;
+        aspeed,pwm-outputs = <7>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_tach0_default
+                        &pinctrl_pwm1_default &pinctrl_tach1_default
+                        &pinctrl_pwm2_default &pinctrl_tach2_default
+                        &pinctrl_pwm3_default &pinctrl_tach3_default
+                        &pinctrl_pwm4_default &pinctrl_tach4_default
+                        &pinctrl_pwm5_default &pinctrl_tach5_default
+                        &pinctrl_pwm12g1_default &pinctrl_tach6_default
+                        &pinctrl_pwm13g1_default &pinctrl_tach7_default
+                        &pinctrl_pwm14g1_default &pinctrl_tach8_default
+                        &pinctrl_pwm15g1_default &pinctrl_tach9_default
+                        &pinctrl_pwm7_default>;
+
+        fan@0 {
+                reg = <0x00>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x00>;
+        };
+        fan@1 {
+                reg = <0x01>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x01>;
+        };
+        fan@2 {
+                reg = <0x02>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x02>;
+        };
+        fan@3 {
+                reg = <0x03>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x03>;
+        };
+        fan@4 {
+                reg = <0x04>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x04>;
+        };
+        fan@5 {
+                reg = <0x05>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x05>;
+        };
+        fan@6 {
+                reg = <0x0c>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x06>;
+        };
+        fan@7 {
+                reg = <0x0d>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x07>;
+        };
+        fan@8 {
+                reg = <0x0e>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x08>;
+        };
+        fan@9 {
+                reg = <0x0f>;
+                aspeed,fan-tach-ch = /bits/ 8 <0x09>;
+        };
 };
 
 &mdio0 {
@@ -286,6 +371,19 @@ imx3102_0: i3cmux@f,4cc31020000 {
         JESD300_SPD_I3C_MODE(0, 1, 51);
 };
 
+&i3c2 {
+       status = "okay";
+    i3c_0: mipi_i3c@0,7ec05031000 {
+       compatible = "i3c-ibi-mqueue";
+       reg = <0x0 0x7ec 0x05031000>;
+       };
+};
+
+&i3c1 {
+       status = "okay";
+       secondary;
+};
+
 &i3c4 {
         initial-role = "target";
         pid = <0x000007ec 0x05034000>;
@@ -455,6 +553,10 @@ &sgpiom0 {
 	ngpios = <128>;
 };
 
+&sgpiom1 {
+       status = "okay";
+};
+
 &gpio0 {
     status = "okay";
     gpio-line-names =
@@ -482,7 +584,7 @@ &gpio0 {
     /*V0-V7*/       "NMI_OUT","RESET_BUTTON","NMI_BUTTON","POWER_BUTTON","PS_PWROK","POST_COMPLETE","POWER_OUT","RESET_OUT",
     /*W0-W7*/       "ID_BUTTON","SIO_S5","SIO_ONCONTROL","","","","","",
     /*X0-X7*/       "","","","","","","","",
-    /*Y0-Y7*/       "","","","","","","","",
+    /*Y0-Y7*/       "","TEST_INTR","","","","","","",
     /*Z0-Z7*/       "","","","","","","","";
 };
 
@@ -507,7 +609,6 @@ &lpc_reset {
 
 };
 
-
 &lpc {
     status = "okay";
 };
@@ -526,3 +627,84 @@ &lpc_snoop {
         snoop-ports = <0x80>;
         status = "okay";
 };
+
+&rng {
+        status = "okay";
+};
+
+&mctp {
+    status = "okay";
+};
+
+&peci0 {
+    status = "okay";
+};
+
+&lpc {
+    status = "okay";
+};
+
+&adc0 {
+    status = "okay";
+
+    aspeed,int-vref-microvolt = <2500000>;
+
+    /*If you want to set external reference voltage(i.e. not 1.2V or 2.5V).
+      You should add vref-supply property as below and set the microvolt
+      value at vdd_adc_vref node.*/
+    //vref-supply = <&vdd_adc_vref>;
+
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
+               &pinctrl_adc2_default &pinctrl_adc3_default
+               &pinctrl_adc4_default &pinctrl_adc5_default
+               &pinctrl_adc6_default &pinctrl_adc7_default>;
+};
+
+&adc1 {
+    status = "okay";
+
+    aspeed,int-vref-microvolt = <2500000>;
+
+    /*If you want to set external reference voltage(i.e. not 1.2V or 2.5V).
+      You should add vref-supply property as below and set the microvolt
+      value at vdd_adc_vref node.*/
+    //vref-supply = <&vdd_adc_vref>;
+
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
+               &pinctrl_adc10_default &pinctrl_adc11_default
+               &pinctrl_adc12_default &pinctrl_adc13_default
+               &pinctrl_adc14_default &pinctrl_adc15_default>;
+};
+
+&spi2 {
+       spi-dma-write;
+       low-spi-clk-write;
+       pinctrl-names = "default";
+       pinctrl-0 = <&pinctrl_spi2_default &pinctrl_spi2cs1_default
+                               &pinctrl_spi2cs2_default &pinctrl_qspi2_default>;
+       status = "okay";
+
+       flash@0 {
+               status = "okay";
+               m25p,fast-read;
+               label = "spi2:0";
+               spi-max-frequency = <50000000>;
+               spi-tx-bus-width = <4>;
+               spi-rx-bus-width = <4>;
+       };
+
+      spidev@0 {
+               status = "okay";
+       };
+
+       spidev@1 {
+               status = "okay";
+       };
+
+       spidev@2 {
+               status = "okay";
+       };
+};
+
-- 
2.34.1

