From 098157b82e4cfd18993f68f8dc99dd75afb69bcd Mon Sep 17 00:00:00 2001
From: Vasanthakumar K <vasanthakumark@ami.com>
Date: Fri, 30 Aug 2024 11:46:11 +0530
Subject: [PATCH] Added-w25q01jvfim-Winbond-SPI

Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 arch/arm/boot/dts/aspeed-ast2600-evb.dts | 3 ++-
 drivers/mtd/spi-nor/winbond.c            | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
index bdeba984fd2f..9335429bf2c1 100644
--- a/arch/arm/boot/dts/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
@@ -361,7 +361,8 @@ flash@0 {
 		status = "okay";
 		m25p,fast-read;
 		label = "bmc";
-		spi-rx-bus-width = <4>;
+		spi-rx-bus-width = <2>;
+		spi-tx-bus-width = <2>;
 		spi-max-frequency = <50000000>;
 #include "openbmc-flash-layout-ami-evb-64.dtsi"
 	};
diff --git a/drivers/mtd/spi-nor/winbond.c b/drivers/mtd/spi-nor/winbond.c
index d17bed321199..55a6b1fcbb8b 100644
--- a/drivers/mtd/spi-nor/winbond.c
+++ b/drivers/mtd/spi-nor/winbond.c
@@ -142,6 +142,8 @@ static const struct flash_info winbond_nor_parts[] = {
 			      SPI_NOR_QUAD_READ) },
 	{ "w25q01jvq", INFO(0xef4021, 0, 64 * 1024, 2048)
 		PARSE_SFDP },
+	{ "w25q01jvfim", INFO(0xef7021, 0, 64 * 1024, 2048)
+		PARSE_SFDP },
 };
 
