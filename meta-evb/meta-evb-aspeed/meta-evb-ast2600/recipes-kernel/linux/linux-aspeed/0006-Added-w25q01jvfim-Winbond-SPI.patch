From 7b8b21ad498e2f321d7945a0efe0cba21fe50c76 Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Wed, 11 Dec 2024 22:55:22 +0530
Subject: [PATCH] Added-w25q01jvfim-Winbond-SPI

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts | 3 ++-
 drivers/mtd/spi-nor/winbond.c                   | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 3998caa2b3a5..751408f8dcbb 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -195,7 +195,8 @@ flash@0 {
 		status = "okay";
 		m25p,fast-read;
 		label = "bmc";
-		spi-rx-bus-width = <4>;
+		spi-rx-bus-width = <2>;
+		spi-tx-bus-width = <2>;
 		spi-max-frequency = <50000000>;
 #include "openbmc-flash-layout-ami-evb-64.dtsi"
 	};
diff --git a/drivers/mtd/spi-nor/winbond.c b/drivers/mtd/spi-nor/winbond.c
index 5aed8718c19e..573b18acde47 100644
--- a/drivers/mtd/spi-nor/winbond.c
+++ b/drivers/mtd/spi-nor/winbond.c
@@ -145,7 +145,9 @@ static const struct flash_info winbond_nor_parts[] = {
 			      SPI_NOR_QUAD_READ) },
 	{ "w25q01jvq", INFO(0xef4021, 0, 64 * 1024, 2048)
 		PARSE_SFDP },
-        { "w25q02jv", INFO(0xef7022, 0, 64 * 1024, 4096)
+	{ "w25q01jvfim", INFO(0xef7021, 0, 64 * 1024, 2048)
+               PARSE_SFDP },
+	 { "w25q02jv", INFO(0xef7022, 0, 64 * 1024, 4096)
                 PARSE_SFDP },
 };
 
