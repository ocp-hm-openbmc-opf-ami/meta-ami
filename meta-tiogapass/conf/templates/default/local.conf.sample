MACHINE ??= "tiogapass"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_rpm"
SANITY_TESTED_DISTROS:append ?= " RedHatEnterpriseWorkstation-6.*"
EXTRA_IMAGE_FEATURES = "validation-unsecure"
IMAGE_FEATURES:remove = "debug-tweaks"
EXTRA_IMAGE_FEATURES += "allow-empty-password allow-root-login post-install-logging"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

IMAGE_FSTYPES += "cpio.${INITRAMFS_CTYPE}.fitImage mtd-static-norootfs"

IMAGE_FSTYPES += "squashfs-xz"
INITRAMFS_FSTYPES = "squashfs-xz"
EXTRA_IMAGECMD:squashfs-xz:append = "-processors ${BB_NUMBER_THREADS} -b 262144 -Xdict-size 100% -Xbcj arm"

KERNEL_CLASSES ?= "kernel-fitimage"
KERNEL_IMAGETYPES ?= "fitImage"
KERNEL_EXTRA_ARGS += "LOADADDR=${UBOOT_ENTRYPOINT}"

UBOOT_SUFFIX ?= "bin"

MACHINEOVERRIDES =. "openbmc:"

INITRAMFS_CTYPE ?= "xz"
INITRAMFS_FSTYPES = "cpio.${INITRAMFS_CTYPE}"
INITRAMFS_IMAGE = "obmc-phosphor-initramfs"

# Add license files to rootfs (/usr/share/common-licenses):
COPY_LIC_MANIFEST = "1"

ERROR_QA:remove = " patch-status license-checksum buildpaths "
WARN_QA:append = " patch-status license-checksum buildpaths "

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

FULL_OPTIMIZATION = "-Os -pipe ${DEBUG_LEVELFLAG}"

IMAGE_LINGUAS = ""
