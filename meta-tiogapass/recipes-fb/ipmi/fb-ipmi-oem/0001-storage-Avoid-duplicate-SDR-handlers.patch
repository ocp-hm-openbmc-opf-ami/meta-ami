From: Mahalakshmi Kailasam <mahalakshmik@ami.com>
Date: Fri, 11 Sep 2026 12:02:00 +0000
Subject: [PATCH] storage: Leave FRU and SDR commands to dynamic provider

phosphor-ipmi-host's dynamic sensor provider generates FRU locator records
and owns the standard FRU and SDR commands on TiogaPass. fb-ipmi-oem also
registers legacy handlers for those commands, making the selected
implementation depend on provider load order.

Mixing the dynamic provider's FRU locator IDs with the Facebook provider's
independent FRU ID map advertises FRU ID 1 but returns not found when it is
read. Leave the complete FRU and SDR command family to the dynamic provider.

Signed-off-by: Mahalakshmi Kailasam <mahalakshmik@ami.com>
---
 src/storagecommands.cpp | 34 ----------------------------------
 1 file changed, 34 deletions(-)

diff --git a/src/storagecommands.cpp b/src/storagecommands.cpp
--- a/src/storagecommands.cpp
+++ b/src/storagecommands.cpp
@@ -35,7 +35,6 @@ namespace ipmi
 
 namespace storage
 {
-void registerStorageFunctions() __attribute__((constructor));
 
 constexpr static const size_t maxMessageSize = 64;
 constexpr static const size_t maxFruSdrNameSize = 16;
@@ -1002,37 +1001,4 @@ ipmi_ret_t ipmiStorageGetFRUInvAreaInfo(
     return ipmi::ccSuccess;
 }
 
-void registerStorageFunctions()
-{
-    // <Get FRU Inventory Area Info>
-    ipmiPrintAndRegister(
-        ipmi::netFnStorage,
-        static_cast<ipmi_cmd_t>(IPMINetfnStorageCmds::ipmiCmdGetFRUInvAreaInfo),
-        NULL, ipmiStorageGetFRUInvAreaInfo, PRIVILEGE_OPERATOR);
-
-    // <READ FRU Data>
-    ipmiPrintAndRegister(
-        ipmi::netFnStorage,
-        static_cast<ipmi_cmd_t>(IPMINetfnStorageCmds::ipmiCmdReadFRUData), NULL,
-        ipmiStorageReadFRUData, PRIVILEGE_OPERATOR);
-
-    // <WRITE FRU Data>
-    ipmiPrintAndRegister(
-        ipmi::netFnStorage,
-        static_cast<ipmi_cmd_t>(IPMINetfnStorageCmds::ipmiCmdWriteFRUData),
-        NULL, ipmiStorageWriteFRUData, PRIVILEGE_OPERATOR);
-
-    // <Reserve SDR Repo>
-    ipmiPrintAndRegister(
-        ipmi::netFnStorage,
-        static_cast<ipmi_cmd_t>(IPMINetfnStorageCmds::ipmiCmdReserveSDR),
-        nullptr, ipmiStorageReserveSDR, PRIVILEGE_USER);
-
-    // <Get Sdr>
-    ipmiPrintAndRegister(
-        ipmi::netFnStorage,
-        static_cast<ipmi_cmd_t>(IPMINetfnStorageCmds::ipmiCmdGetSDR), nullptr,
-        ipmiStorageGetSDR, PRIVILEGE_USER);
-    return;
-}
 } // namespace storage
-- 
