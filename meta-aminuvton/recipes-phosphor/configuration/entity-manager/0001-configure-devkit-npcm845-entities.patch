Subject: [PATCH] Activate the NPCM845 board sensors for the DevKit

Retain the Nuvoton fan identities and channel indexes. A fixed DevKit
configuration must not depend on the EVB EEPROM product string.

Upstream-Status: Inappropriate [DevKit configuration]

--- a/npcm8xx_evb.json
+++ b/npcm8xx_evb.json
@@ -464,13 +464,11 @@
         }
     ],
-    "Name": "EVB_ARBEL_NUVOTON",
-    "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'NUVOTON-ARBEL-EVB'})",
+    "Name": "AMI_DevKit_NPCM845",
+    "Probe": "TRUE",
     "Type": "Board",
     "xyz.openbmc_project.Inventory.Decorator.Asset": {
-        "Manufacturer": "$BOARD_MANUFACTURER",
-        "Model": "$BOARD_PRODUCT_NAME",
-        "PartNumber": "$BOARD_PART_NUMBER",
-        "SerialNumber": "$BOARD_SERIAL_NUMBER"
+        "Manufacturer": "AMI",
+        "Model": "DevKit NPCM845"
     },
     "xyz.openbmc_project.Inventory.Item.System": {}
 }
