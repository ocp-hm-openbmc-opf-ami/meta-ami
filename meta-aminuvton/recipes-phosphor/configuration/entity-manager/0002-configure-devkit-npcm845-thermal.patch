Subject: [PATCH] Activate DevKit thermal control for all four fan sensors

Preserve the baseline thermal policy and extend its fan control to Fan4.
Use the same unconditional probe as the fixed DevKit board configuration.

Upstream-Status: Inappropriate [DevKit configuration]

--- a/Nuvoton-thermal.json
+++ b/Nuvoton-thermal.json
@@ -79,6 +79,32 @@
             ]
         },
         {
+            "Class": "fan",
+            "FFGainCoefficient": 1.0,
+            "FFOffCoefficient": 0.0,
+            "ICoefficient": 0.0,
+            "ILimitMax": 0.0,
+            "ILimitMin": 0.0,
+            "Inputs": [
+                "Fan4"
+            ],
+            "Name": "Fan4",
+            "NegativeHysteresis": 0.0,
+            "OutLimitMax": 100.0,
+            "OutLimitMin": 40.0,
+            "Outputs": [
+                "Pwm 4"
+            ],
+            "PCoefficient": 0.0,
+            "PositiveHysteresis": 0.0,
+            "SlewNeg": 0.0,
+            "SlewPos": 0.0,
+            "Type": "Pid",
+            "Zones": [
+                "Zone 1"
+            ]
+        },
+        {
             "Class": "temp",
             "Inputs": [
                "EVB_Temp"
@@ -118,3 +144,3 @@
     "Name": "Zone Configuration",
-    "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'NUVOTON-ARBEL-EVB'})",
+    "Probe": "TRUE",
     "Type" :"Zone"
