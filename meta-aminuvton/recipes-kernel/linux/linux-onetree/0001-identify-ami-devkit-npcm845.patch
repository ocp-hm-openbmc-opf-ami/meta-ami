Subject: [PATCH] Configure AMI DevKit NPCM845 peripherals

Retain the six NPCM845 power GPIOs and existing IPMB buses. Place the
DevKit ADT7490 on I2C5, whose primary pins do not overlap those interfaces.
Select every tach pin declared by the existing eight dual-tach fan nodes.

Upstream-Status: Inappropriate [AMI DevKit hardware configuration]

--- a/nuvoton-npcm845-evb.dts
+++ b/nuvoton-npcm845-evb.dts
@@ -9,3 +9,3 @@
 / {
-	model = "Nuvoton npcm845 Development Board (Device Tree)";
+	model = "AMI DevKit NPCM845";
 	compatible = "nuvoton,npcm845-evb", "nuvoton,npcm845";
@@ -40,6 +40,7 @@
 		i2c2 = &i2c2;
 		i2c3 = &i2c3;
 		i2c4 = &i2c4;
+		i2c5 = &i2c5;
 		i2c6 = &i2c6;
 		i2c11 = &i2c11;
 		i3c0 = &i3c0;
@@ -228,7 +229,7 @@
         status = "okay";
         gpio0: gpio@f0010000 {
         gpio-line-names =
-            "POWER_OUT","PS_PWROK","RESET_OUT","POST_COMPLETE","POWER_BUTTON","RESET_BUTTON","NMI_OUT","",
+            "POWER_OUT","PS_PWROK","RESET_OUT","POST_COMPLETE","POWER_BUTTON","RESET_BUTTON","","",
             "","","","","","","","",
             "","","","","","","","",
             "","","","","","","","";
@@ -481,7 +482,11 @@
 		&fanin0_pins &fanin1_pins
 		&fanin2_pins &fanin3_pins
 		&fanin4_pins &fanin5_pins
-		&fanin6_pins &fanin7_pins>;
+		&fanin6_pins &fanin7_pins
+		&fanin8_pins &fanin9_pins
+		&fanin10_pins &fanin11_pins
+		&fanin12_pins &fanin13_pins
+		&fanin14_pins &fanin15_pins>;
 	#address-cells = <1>;
 	#size-cells = <0>;
 	fan@0 {
@@ -596,6 +601,19 @@
+&i2c5 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&smb5_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	temp@2e {
+		compatible = "adi,adt7490";
+		reg = <0x2e>;
+	};
+};
+
 &i2c6 {
 	status = "okay";
 	#address-cells = <1>;
 	#size-cells = <0>;
 	tmp100@48 {
 		compatible = "tmp100";

