diff --git a/auth-client.c b/auth-client.c
index 9995202..037d886 100644
--- a/auth-client.c
+++ b/auth-client.c
@@ -50,7 +50,7 @@
 #include <string.h>
 #include <strings.h>
 #include <ctype.h>
-
+#include <stdio.h>
 #include <missing.h>
 
 #include "auth-client.h"
@@ -168,6 +168,46 @@ load_client_plugin (const char *name)
   return info;
 }
 
+static const struct auth_client_plugin *
+load_xoauth2_client_plugin(const char *name)
+{
+  void *module = NULL;
+  char *plugin = NULL;
+  const struct auth_client_plugin *info = NULL;
+
+  assert(name != NULL);
+
+  /* Try searching for a plugin. */
+  plugin = plugin_name(name);
+  if (plugin == NULL) {
+    return NULL;
+  }
+  module = dlopen(plugin, RTLD_LAZY);
+  free(plugin);
+  if (module == NULL) {
+    return NULL;
+  }
+
+  info = dlsym(module, "sasl_xoauth2_client");
+  if (info == NULL) {
+    dlclose(module);
+    return NULL;
+  }
+
+  if (info->response == NULL) {
+    dlclose(module);
+    return NULL;
+  }
+
+  /* This plugin module is OK. Add it to the list of loaded modules. */
+  if (!append_plugin(module, info)) {
+    dlclose(module);
+    return NULL;
+  }
+
+  return info;
+}
+
 /**
  * auth_client_init() - Initialise the auth client.
  *
@@ -429,29 +469,40 @@ auth_set_mechanism (auth_context_t context, const char *name)
       }
 
   /* Load the module if not found above. */
-  if (info == NULL && (info = load_client_plugin (name)) == NULL)
-    {
+  if (info == NULL) {
+    if (strcasecmp(name, "XOAUTH2") == 0) {
+      info = load_xoauth2_client_plugin(name);
+    } else {
+      info = load_client_plugin(name);
+    }
+  }
+
+  if (info == NULL) {
 #ifdef USE_PTHREADS
       pthread_mutex_unlock (&plugin_mutex);
 #endif
       return 0;
     }
 
-  /* Check the application's requirements regarding minimum SSF and
-     whether anonymous or plain text mechanisms are explicitly allowed.
-     This has to be checked here since the list of loaded plugins is
-     global and the plugin may have been acceptable in another context
-     but not in this one.  */
-  if (info->ssf < context->min_ssf
-      || mechanism_disabled (info, context, EXTERNAL)
-      || mechanism_disabled (info, context, ANONYMOUS)
-      || mechanism_disabled (info, context, PLAIN))
-    {
+  /* Check the application's requirements regarding minimum SSF */
+  if (info->ssf < context->min_ssf) {
 #ifdef USE_PTHREADS
       pthread_mutex_unlock (&plugin_mutex);
+#endif
+    return 0;
+  }
+
+  /* Don't filter out XOAUTH2 based on flags */
+  if (strcasecmp(name, "XOAUTH2") != 0) {
+    if (mechanism_disabled(info, context, EXTERNAL) ||
+        mechanism_disabled(info, context, ANONYMOUS) ||
+        mechanism_disabled(info, context, PLAIN)) {
+#ifdef USE_PTHREADS
+      pthread_mutex_unlock(&plugin_mutex);
 #endif
       return 0;
     }
+  }
 
   context->client = info;
 #ifdef USE_PTHREADS
diff --git a/auth-client.h b/auth-client.h
index 55c0554..0db9db0 100644
--- a/auth-client.h
+++ b/auth-client.h
@@ -63,6 +63,7 @@ typedef int (*auth_recode_t) (void *ctx, char **dstbuf, int *dstlen,
 #define AUTH_PLUGIN_ANONYMOUS	0x01	/* mechanism is anonymous */
 #define AUTH_PLUGIN_PLAIN	0x02	/* mechanism uses plaintext passwords */
 #define AUTH_PLUGIN_EXTERNAL	0x04	/* mechanism is EXTERNAL */
+#define AUTH_PLUGIN_XOAUTH2     0x08    /* mechanism uses XOAUTH2 */
 
 
 void auth_client_init(void);
diff --git a/base64.c b/base64.c
index ae730a4..ff2035d 100644
--- a/base64.c
+++ b/base64.c
@@ -30,6 +30,8 @@
 #include <string.h>
 #include "base64.h"
 
+#include <openssl/evp.h>
+
 /* RFC 2045 section 6.8 */
 
 static const char base64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
@@ -163,3 +165,25 @@ b64_encode (char *dst, int dstlen, const void *src, int srclen)
   return to - dst;
 }
 
+char *base64_encode_dynamic(const char *input, int length)
+{
+
+    if (!input || length <= 0) return NULL;
+
+    // Calculate output size: 4*(n/3) rounded up
+    size_t output_size = ((length + 2) / 3) * 4 + 1;
+    char *output = malloc(output_size);
+    if (!output) return NULL;
+
+    int encoded_len = EVP_EncodeBlock((unsigned char *)output,
+                                    (const unsigned char *)input,
+                                    length);
+    if (encoded_len < 0) {
+        free(output);
+        return NULL;
+    }
+
+    output[encoded_len] = '\0';
+
+    return output;
+}
diff --git a/base64.h b/base64.h
index 37fe03a..9a8410e 100644
--- a/base64.h
+++ b/base64.h
@@ -24,5 +24,5 @@
 
 int b64_decode (void *dst, int dstlen, const char *src, int srclen);
 int b64_encode (char *dst, int dstlen, const void *src, int srclen);
-
+char *base64_encode_dynamic(const char *input, int length);
 #endif
