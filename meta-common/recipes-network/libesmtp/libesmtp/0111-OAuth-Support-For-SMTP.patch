diff --git a/smtp-auth.c b/smtp-auth.c
index 76661cb..a84d3e7 100644
--- a/smtp-auth.c
+++ b/smtp-auth.c
@@ -27,6 +27,7 @@
 /* Support for the SMTP AUTH verb.
  */
 #include <stdlib.h>
+#include <stdio.h>
 #include <string.h>
 #include <strings.h>
 #include <ctype.h>
@@ -183,18 +184,28 @@ cmd_auth (siobuf_t conn, smtp_session_t session)
 
   /* Ask SASL for the initial response (if there is one). */
   response = auth_response (session->auth_context, NULL, &len);
-  if (response != NULL)
-    {
-      /* Encode the response and send it back to the server */
-      len = b64_encode (buf, sizeof buf, response, len);
-      if (len == 0)
-	sio_write (conn, " =", 2);
-      else if (len > 0)
-	{
-	  sio_write (conn, " ", 1);
-	  sio_write (conn, buf, len);
-	}
-    }
+  if (response != NULL && len > 0)
+  {
+	  char *b64 = base64_encode_dynamic(response, len);
+	  if (b64 != NULL)
+	  {
+		  sio_write (conn, " ", 1);
+		  sio_write (conn, b64, strlen(b64));
+		  free(b64);
+	  }
+	  else
+	  {
+		  sio_write (conn, " =", 2);
+	  }
+  }
+  else if (response != NULL && len == 0)
+  {
+	  sio_write (conn, " =", 2);
+  }
+  else
+  {
+	  fprintf(stderr, "cmd_auth: no initial response\n");
+  }
 
   sio_write (conn, "\r\n", 2);
   session->cmd_state = -1;
@@ -211,6 +222,21 @@ rsp_auth (siobuf_t conn, smtp_session_t session)
       session->rsp_state = S_quit;
       return;
     }
+
+  if (session->mta_status.code == 235) {
+    fprintf(stderr,"rsp_auth: XOAUTH2 authentication successful!\n");
+    session->authenticated = 1;
+
+    // For XOAUTH2, we should proceed to mail transaction, not try another AUTH mechanism
+#ifdef USE_ETRN
+    if (check_etrn (session))
+      session->rsp_state = S_etrn;
+    else
+#endif
+      session->rsp_state = initial_transaction_state (session);
+    return;
+  }
+
   if (code == 4 || code == 5)
     {
       /* If auth mechanism is too weak or encryption is required, give up.
@@ -267,31 +293,40 @@ rsp_auth (siobuf_t conn, smtp_session_t session)
 void
 cmd_auth2 (siobuf_t conn, smtp_session_t session)
 {
-  char buf[2048];
+  char *decoded_buf = NULL;
   const char *response;
   int len;
 
-  /* Decode the text from the server to get the challenge. */
-  len = b64_decode (buf, sizeof buf, session->mta_status.text, -1);
-  if (len >= 0)
-    {
-      /* Send it through SASL and get the response. */
-      response = auth_response (session->auth_context, buf, &len);
+  int decoded_len = b64_decode(NULL, 0, session->mta_status.text, -1);
+  if (decoded_len > 0)
+  {
+	  decoded_buf = malloc(decoded_len + 1);
+	  if (decoded_buf)
+	  {
+		  b64_decode(decoded_buf, decoded_len + 1, session->mta_status.text, -1);
+		  decoded_buf[decoded_len] = '\0';
+		  /* Send it through SASL and get the response. */
+		  response = auth_response (session->auth_context, decoded_buf, &len);
+		  free(decoded_buf);
+	  }
+  }
 
-      /* Encode the response and send it back to the server */
-      len = (response != NULL) ? b64_encode (buf, sizeof buf, response, len)
-			       : -1;
-    }
+  /* If base64 decode fails or memory allocation fails */
+  if (decoded_buf == NULL) {
+    sio_write (conn, "*\r\n", 3);
+    session->cmd_state = -1;
+    return;
+  }
 
-  /* Abort the AUTH command if base 64 encode/decode fails. */
-  if (len < 0)
+  /* Encode the response using dynamic base64 */
+  char *b64 = base64_encode_dynamic(response, len);
+  if (b64 != NULL) {
+    sio_write (conn, b64, strlen(b64));
+    free(b64);
+  } else {
     sio_write (conn, "*\r\n", 3);
-  else
-    {
-      if (len > 0)
-	sio_write (conn, buf, len);
-      sio_write (conn, "\r\n", 2);
-    }
+  }
+  sio_write (conn, "\r\n", 2);
   session->cmd_state = -1;
 }
 
