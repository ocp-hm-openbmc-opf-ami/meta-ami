From 6cd1e8a0c57551cdb34abd2bc068a8fd06ff91b8 Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Tue, 30 Jul 2024 14:55:20 +0800
Subject: [PATCH] Fix Array of Domain Name String

---
 src/dhcp_configuration.cpp | 2 ++
 src/ethernet_interface.cpp | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/dhcp_configuration.cpp b/src/dhcp_configuration.cpp
index 1f40d65..977ec12 100644
--- a/src/dhcp_configuration.cpp
+++ b/src/dhcp_configuration.cpp
@@ -151,6 +151,8 @@ bool Configuration::domainEnabled(bool value)
     }

     auto domain = ConfigIntf::domainEnabled(value);
+    if (value)
+        parent.get().domainName({});
     parent.get().writeConfigurationFile();
     parent.get().reloadConfigs();

diff --git a/src/ethernet_interface.cpp b/src/ethernet_interface.cpp
index 1a4389e..b5a3b8e 100644
--- a/src/ethernet_interface.cpp
+++ b/src/ethernet_interface.cpp
@@ -1967,7 +1967,7 @@ void EthernetInterface::writeConfigurationFile()
                 std::string s("");
                 for (int i = 0; i < size; i++)
                 {
-                    s += domainName().at(i);
+                    s += domainName().at(i) + " ";
                 }
                 network["Domains"].emplace_back(s);
             }
--
2.34.1
