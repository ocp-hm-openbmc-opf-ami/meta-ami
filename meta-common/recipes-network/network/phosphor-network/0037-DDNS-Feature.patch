+bool Configuration::sendNsupdateEnabled(bool value)
+{
+    if (value == ddnsIface::sendNsupdateEnabled())
+    {
+        return value;
+    }
+
+    ddnsIface::sendNsupdateEnabled(value);
+    if (!value)
+    {
+        NsupdateEnabledChanged = true;
+        toDeregister();
+        NsupdateEnabledChanged = false;
+    }
+    writeConfigurationFile();
+    return value;
+}
