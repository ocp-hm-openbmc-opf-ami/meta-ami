From ea30b6e83dab1c22158bf3df6c581a9fe4c31e40 Mon Sep 17 00:00:00 2001
From: vaibhavs <vaibhavs@ami.com>
Date: Wed, 18 Dec 2024 15:37:05 +0530
Subject: [PATCH] Fix to add expected format with firewall rules at
 iptables.rules file

---
 src/firewall_configuration.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/firewall_configuration.cpp b/src/firewall_configuration.cpp
index 9fb71e4..7ec30c2 100644
--- a/src/firewall_configuration.cpp
+++ b/src/firewall_configuration.cpp
@@ -613,7 +613,7 @@ void Configuration::writeConfigurationFile(bool isInit)
     {
         if (isInit)
         {
-            command = "ip6tables-save | grep Preload";
+            command = "ip6tables-save | grep -E '^(:|#|\\*|.*COMMIT.*|.*Preload.*)'";
             logFilePathStr = std::string(AMI_IPTABLES_DIR) + "/" + std::string(IP6TABLES_RULES);
             logFilePath = logFilePathStr.c_str();
             executeCommandAndLog(command, logFilePath);
@@ -630,7 +630,7 @@ void Configuration::writeConfigurationFile(bool isInit)
     {
         if (isInit)
         {
-            command = "iptables-save | grep Preload";
+            command = "iptables-save | grep -E '^(:|#|\\*|.*COMMIT.*|.*Preload.*)'";
             logFilePathStr = std::string(AMI_IPTABLES_DIR) + "/" + std::string(IPTABLES_RULES);
             logFilePath = logFilePathStr.c_str();
             executeCommandAndLog(command, logFilePath);
