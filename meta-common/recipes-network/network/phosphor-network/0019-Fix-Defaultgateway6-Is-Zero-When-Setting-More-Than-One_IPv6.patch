Subject: [PATCH 13/13] 
 0019-Fix-Defaultgateway6-Is-Zero-When-Setting-More-Than-One_IPv6.patch

---
 src/ethernet_interface.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ethernet_interface.cpp b/src/ethernet_interface.cpp
index 378c442..8ad4e9d 100644
--- a/src/ethernet_interface.cpp
+++ b/src/ethernet_interface.cpp
@@ -302,8 +302,8 @@ ObjectPath EthernetInterface::ip(IP::Protocol protType, std::string ipaddress,
                         stdplus::fromStr<stdplus::In6Addr>(ipgateway));
                     ip_address::isValidIPv6Addr((in6_addr*)(&gateway.value()),
                                                 ip_address::Type::IP6_ADDRESS);
+                    EthernetInterfaceIntf::defaultGateway6(ipgateway);
                 }
-                defaultGateway6(ipgateway);
                 break;
             default:
                 throw std::logic_error("Exhausted protocols");
