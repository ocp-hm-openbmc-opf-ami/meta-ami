--- a/src/util.cpp
+++ b/src/util.cpp
@@ -218,6 +218,35 @@ bool getIP6Enable(const config::Parser& config)
         .value_or(true);
 }
 
+bool getIP6StaticRtr(const config::Parser& config)
+{
+    return systemdParseLast(config, "IPv6Router", "IPv6EnableStaticRtr",
+                            config::parseBool)
+        .value_or(false);
+}
+
+std::string getIP6StaticRtrAddr(const config::Parser& config)
+{
+    if (auto str = config.map.getLastValueString("IPv6Router",
+                                                 "IPv6StaticRtrAddr");
+        str == nullptr)
+    {
+        return "";
+    }
+    else
+    {
+        return *str;
+    }
+}
+
+int getIP6StaticRtrPrefix(const config::Parser& config)
+{
+    auto val = systemdParseLast(config, "IPv6Router", "IPv6StaticRtrPrefix",
+                                config::parseInt)
+                   .value_or(0);
+    return val;
+}
+
