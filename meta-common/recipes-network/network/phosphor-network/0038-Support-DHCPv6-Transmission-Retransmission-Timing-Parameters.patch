+std::string EthernetInterface::dhcpv6DUID() const
+{
+    try
+    {
+        std::string res = "";
+        std::string filename = "/var/run/systemd/netif/links/";
+        std::string delim = "DHCP6_CLIENT_DUID=DUID-LL:";
+        int sockfd = socket(AF_INET, SOCK_DGRAM, 0);
+        if (sockfd < 0)
+        {
+            lg2::error("Failure to create socket");
+            elog<InternalFailure>();
+        }
+        struct ifreq ifr;
+        std::memset(&ifr, 0, sizeof(ifr));
+        std::strncpy(ifr.ifr_name, interfaceName().c_str(), IFNAMSIZ - 1);
+        if (ioctl(sockfd, SIOCGIFINDEX, &ifr) < 0)
+        {
+            close(sockfd);
+            lg2::error("ioctl call failed to get ifindex");
+            elog<InternalFailure>();
+        }
+        close(sockfd);
+        filename += std::to_string(ifr.ifr_ifindex);
+
+        std::ifstream infile;
+        infile.open(filename.c_str(), std::ios::in);
+        if (infile.is_open())
+        {
+            std::string line;
+            while (infile.good())
+            {
+                std::getline(infile, line);
+                size_t pos = line.find(delim);
+                if (pos == std::string::npos)
+                {
+                    line.clear();
+                    continue;
+                }
+                else
+                {
+                    res = line.substr(pos + delim.length(), std::string::npos);
+                    break;
+                }
+            }
+            infile.close();
+        }
+        return res;
+    }
+    catch (const std::exception& e)
+    {
+        lg2::error("Failed with exception : {ERROR}", "ERROR", e);
+    }
+}
