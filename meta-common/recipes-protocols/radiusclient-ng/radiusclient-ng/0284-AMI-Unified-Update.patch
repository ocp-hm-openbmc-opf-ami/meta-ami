+
+/*
+ * Function: eap_tls_init_ssl_context
+ *
+ * Purpose: Initializes and configures the OpenSSL context for TLS client
+ * authentication and Prepares BIO to read/write
+ *
+ * Returns: 0 on success, negative on failure as return value
+ *
+ */
+static int eap_tls_init_ssl_context(eap_tls_state_t* state)
+{
+    SSL_load_error_strings();
+    OpenSSL_add_ssl_algorithms();
+
+    state->ssl_ctx = SSL_CTX_new(TLS_client_method());
+    if (!state->ssl_ctx)
+    {
+        rc_log(LOG_ERR, "Failed to create SSL_CTX");
+        return -1;
+    }
+
+    if (!(SSL_CTX_set_min_proto_version(state->ssl_ctx, TLS1_2_VERSION)))
+    {
+        rc_log(LOG_ERR, "Failed to Set the Min Protocol Version");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+    if (!(SSL_CTX_set_max_proto_version(state->ssl_ctx, TLS1_2_VERSION)))
+    {
+        rc_log(LOG_ERR, "Failed to Set the Max Protocol Version");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    // Enable only secure ciphers
+    if (!(SSL_CTX_set_cipher_list(state->ssl_ctx,
+                                  "HIGH:!aNULL:!kRSA:!PSK:!SRP:!MD5:!RC4")))
+    {
+        rc_log(LOG_ERR, "Failed to Set the cipher suites");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    // Load client certificate and private key
+    if (SSL_CTX_use_certificate_file(state->ssl_ctx, RADIUS_CLIENT_CERTIFICATE,
+                                     SSL_FILETYPE_PEM) <= 0)
+    {
+        rc_log(LOG_ERR, "Failed to load client certificate");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    if (SSL_CTX_use_PrivateKey_file(state->ssl_ctx, RADIUS_CLIENT_KEY,
+                                    SSL_FILETYPE_PEM) <= 0)
+    {
+        rc_log(LOG_ERR, "Failed to load client private key");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    if (!SSL_CTX_check_private_key(state->ssl_ctx))
+    {
+        rc_log(LOG_ERR, "Private key does not match certificate");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    if (!SSL_CTX_load_verify_locations(state->ssl_ctx, RADIUS_CA_CERT, NULL))
+    {
+        rc_log(LOG_ERR, "Failed to load CA certificate");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    SSL_CTX_set_verify(state->ssl_ctx, SSL_VERIFY_PEER, NULL);
+    SSL_CTX_set_verify_depth(state->ssl_ctx, 4);
+    SSL_CTX_set_options(state->ssl_ctx, SSL_OP_NO_SSLv2 | SSL_OP_NO_SSLv3 |
+                                            SSL_OP_NO_COMPRESSION);
+
+    // Initialize SSL objects
+    state->ssl = SSL_new(state->ssl_ctx);
+    if (!state->ssl)
+    {
+        rc_log(LOG_ERR, "Failed to create SSL structure");
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    state->rbio = BIO_new(BIO_s_mem());
+    state->wbio = BIO_new(BIO_s_mem());
+    if (!state->rbio || !state->wbio)
+    {
+        rc_log(LOG_ERR, "Failed to create BIOs");
+        if (state->rbio)
+            BIO_free(state->rbio);
+        if (state->wbio)
+            BIO_free(state->wbio);
+        eap_tls_cleanup(state);
+        return -1;
+    }
+
+    SSL_set_bio(state->ssl, state->rbio, state->wbio);
+
+    return 0;
+}
+
+/*
+ * Function: cleanup_ssl
+ * Purpose: Freeing all OpenSSL resources
+ */
+void eap_tls_cleanup(eap_tls_state_t* state)
+{
+    if (state->ssl)
+    {
+        SSL_free(state->ssl);
+        state->ssl = NULL;
+    }
+    if (state->ssl_ctx)
+    {
+        SSL_CTX_free(state->ssl_ctx);
+        state->ssl_ctx = NULL;
+    }
+}
