+/*
+ * Function: rc_eaptls_extract_data
+ *
+ * Purpose: Extract the EAP-Messages from received packet sent by server and
+ * assigned to buffer and its buffer length
+ *
+ * Returns: 0 on success, negative on failure as return value
+ *
+ */
+int rc_eaptls_extract_data(eap_tls_state_t* state, VALUE_PAIR** received)
+{
+    VALUE_PAIR* vp;
+    int is_first_segment = 1;
+    size_t copy_len;
+    const unsigned char* copy_start;
+    size_t data_len;
+
+    if (!state || !*received)
+    {
+        rc_log(LOG_ERR, "Invalid parameters to rc_eaptls_extract_data");
+        return -1;
+    }
+
+    state->tls_buffer_len = 0;
+    memset(saved_state, 0, sizeof(saved_state));
+    saved_state_len = 0;
+
+    for (vp = *received; vp != NULL; vp = vp->next)
+    {
+        if (vp->attribute != PW_EAP_MESSAGE)
+        {
+            continue;
+        }
+
+        const unsigned char* data = (unsigned char*)vp->strvalue;
+        data_len = vp->lvalue;
+
+        if (is_first_segment)
+        {
+            // First segment processing
+            if (data_len < EAP_HEADERS)
+            {
+                rc_log(LOG_ERR, "First segment too small (%zu < 10)", data_len);
+                return -1;
+            }
+            copy_start = data + EAP_HEADERS;
+            copy_len = data_len - EAP_HEADERS;
+            is_first_segment = 0;
+        }
+        else
+        {
+            // Subsequent segments - copy everything
+            copy_start = data;
+            copy_len = data_len;
+        }
+
+        // Buffer overflow check
+        if (state->tls_buffer_len + copy_len > sizeof(state->tls_buffer))
+        {
+            rc_log(LOG_ERR, "TLS buffer overflow (have %zu, need %zu)",
+                   sizeof(state->tls_buffer) - state->tls_buffer_len, copy_len);
+            return -1;
+        }
+
+        // Copy the data
+        memcpy(state->tls_buffer + state->tls_buffer_len, copy_start, copy_len);
+        state->tls_buffer_len += copy_len;
+
+        rc_log(LOG_DEBUG, "Copied %zu bytes (total: %zu)", copy_len,
+               state->tls_buffer_len);
+    }
+
+    // rc_log(LOG_DEBUG, "Successfully extracted %zu bytes of TLS data",
+    // state->tls_buffer_len);
+    return (state->tls_buffer_len > 0) ? 0 : -1;
+}
+
+/*
+ * Function: rc_AckServer
+ *
+ * Purpose: rc_AckServer will sent an ACK to server with empty Data with
+ * EAP-TLS-TYPE (0x13) flag
+ *
+ * Returns: received value_pairs in received,
+ *          and 0 on success, negative on failure as return value
+ *
+ */
+int rc_AckServer(rc_handle* rh, eap_tls_state_t* state, uint32_t client_port,
+                 VALUE_PAIR** received, char* msg)
+{
+    VALUE_PAIR* send = NULL;
+    VALUE_PAIR* state_vp = NULL;
+
+    // Build EAP-Success message
+    unsigned char eap_success[6] = {
+        EAP_RESPONSE, state->eap_id++, 0x00, 0x06, // Length = 6
+        PW_EAP_TLS,
+        0x00                                       // Flags
+    };
+
+    // Add State attribute if present
+    if ((state_vp = rc_avpair_get(*received, PW_STATE, 0)))
+    {
+        if (rc_avpair_add(rh, &send, PW_STATE, state_vp->strvalue,
+                          state_vp->lvalue, 0) == NULL)
+        {
+            rc_log(LOG_ERR, "Failed to add State attribute");
+            return -1;
+        }
+    }
+
+    // Add EAP-Message attribute
+    if (rc_avpair_add(rh, &send, PW_EAP_MESSAGE, eap_success,
+                      sizeof(eap_success), 0) == NULL)
+    {
+        rc_log(LOG_ERR, "Failed to add EAP-Message attribute");
+        rc_avpair_free(send);
+        return ERROR_RC;
+    }
+
+    int result = rc_auth(rh, client_port, send, received, msg);
+    rc_avpair_free(send);
+    if (result != 0)
+    {
+        rc_log(LOG_ERR, "Failed to send ACK to server: %s", msg);
+    }
+
+    return result;
+}
+
+/*
+ * Function: HandleServerHelloFragments
+ *
+ * Purpose: rc_eaptls_extract_data will collect all TLS data from received
+ * server packet and will feed to openssl using BIO_write
+ *
+ * Returns: received value_pairs in received,
+ *          and 0 on success, negative on failure as return value
+ *
+ */
+int HandleServerHelloFragments(rc_handle* rh, eap_tls_state_t* state,
+                               VALUE_PAIR** received, uint32_t client_port,
+                               char* msg)
+{
+    int ret;
+    int handshake_status;
+
+    while (1)
+    {
+        ret = rc_eaptls_extract_data(state, received);
+        if (ret != 0)
+        {
+            rc_log(LOG_ERR, "Failed to extract EAP message");
+            return -1;
+        }
+
+        // Check for more fragments
+        int more_fragments = 1;
+        VALUE_PAIR* vp;
+        for (vp = *received; vp != NULL; vp = vp->next)
+        {
+            if (vp->attribute == PW_EAP_MESSAGE)
+            {
+                if (vp->strvalue[5] ==
+                    0x80) // When there is no more fragments Stop copying and
+                          // After that shouldn't send Ack. After collected
+                          // tls-data, process into BIO and do handshake !!
+                {
+                    more_fragments = 0;
+                    break;
+                }
+                break;
+            }
+        }
+
+        // Write TLS data to OpenSSL BIO
+        int written =
+            BIO_write(state->rbio, state->tls_buffer, state->tls_buffer_len);
+        if (written <= 0)
+        {
+            rc_log(LOG_ERR, "Failed to write TLS data to BIO");
+            return -1;
+        }
+
+        // Continue SSL handshake
+        handshake_status = SSL_connect(state->ssl);
+        if (handshake_status <= 0)
+        {
+            int ssl_err = SSL_get_error(state->ssl, handshake_status);
+            if (ssl_err != SSL_ERROR_WANT_READ &&
+                ssl_err != SSL_ERROR_WANT_WRITE)
+            {
+                rc_log(LOG_ERR, "SSL handshake failed");
+                return -1;
+            }
+        }
+
+        if (more_fragments == 0)
+        {
+            memset(state->tls_buffer, 0, sizeof(state->tls_buffer));
+            state->tls_buffer_len = 0;
+            break;
+        }
+
+        memset(state->tls_buffer, 0, sizeof(state->tls_buffer));
+        state->tls_buffer_len = 0;
+
+        // Get next packet containing TLS Data, by sending ACK to server
+        int result = rc_AckServer(rh, state, client_port, received, msg);
+        if (result != OK_RC)
+        {
+            rc_log(LOG_ERR, "Failed to get next fragment");
+            return result;
+        }
+    }
+
+    return 0;
+}
+
+/*
+ * Function: rc_eaptls_send_tlsdata
+ *
+ * Purpose: out_data will have TLS data and out_bytes will have TLS Data Length.
+ * This Data will encapsulate in Radius packet as EAP-MESSAGE and sent to server
+ *
+ * Returns: received value_pairs in received,
+ *          and 0 on success, negative on failure as return value
+ *
+ */
+int rc_eaptls_send_tlsdata(rc_handle* rh, eap_tls_state_t* state,
+                           VALUE_PAIR** received, const unsigned char* out_data,
+                           size_t out_bytes, UINT4 client_port)
+{
+    char msg[256] = {0};
+    VALUE_PAIR* state_vp;
+    VALUE_PAIR* send = NULL;
+
+    // Copy State attribute from received packet if present
+    if ((state_vp = rc_avpair_get(*received, PW_STATE, 0)))
+    {
+        if (rc_avpair_add(rh, &send, PW_STATE, state_vp->strvalue,
+                          state_vp->lvalue, 0) == NULL)
+        {
+            return -1;
+        }
+    }
+
+    // Calculate total EAP length (header + TLS data)
+    int total_eap_length = 6 + out_bytes; // EAP header (6) + TLS data
+    uint8_t eap_flags =
+        0x00; // No fragmentation needed (send all in one packet)
+
+    // Prepare EAP header
+    uint8_t eap_header[6] = {
+        EAP_RESPONSE,                   // Code
+        state->eap_id++,                // Identifier
+        (total_eap_length >> 8) & 0xFF, // Length high byte
+        total_eap_length & 0xFF,        // Length low byte
+        PW_EAP_TLS,                     // Type
+        eap_flags                       // Flags
+    };
+
+    // Fragment the EAP message across multiple RADIUS attributes
+    size_t eap_offset = 0;
+    while (eap_offset < total_eap_length)
+    {
+        size_t segment_size = (total_eap_length - eap_offset) > 253
+                                  ? 253
+                                  : (total_eap_length - eap_offset);
+
+        // Allocate buffer for this segment
+        uint8_t* segment = malloc(segment_size);
+        if (!segment)
+        {
+            rc_log(LOG_ERR, "Failed to allocate memory for EAP segment");
+            rc_avpair_free(send);
+            send = NULL;
+            return -1;
+        }
+
+        // For first segment, include EAP header
+        if (eap_offset == 0)
+        {
+            // Copy EAP header (6 bytes)
+            memcpy(segment, eap_header, 6);
+
+            // Copy first part of TLS data
+            size_t data_to_copy = segment_size - 6;
+            if (data_to_copy > 0)
+            {
+                memcpy(segment + 6, out_data, data_to_copy);
+                eap_offset += data_to_copy;
+            }
+            eap_offset += 6; // EAP header size
+        }
+        else
+        {
+            // Subsequent segments - just TLS data
+            memcpy(segment, out_data + (eap_offset - 6), segment_size);
+            eap_offset += segment_size;
+        }
+
+        // Add as EAP-Message attribute
+        if (rc_avpair_add(rh, &send, PW_EAP_MESSAGE, segment, segment_size,
+                          0) == NULL)
+        {
+            free(segment);
+            segment = NULL;
+            rc_avpair_free(send);
+            send = NULL;
+            rc_log(LOG_ERR, "Failed to add EAP-Message attribute");
+            return -1;
+        }
+        free(segment);
+    }
+
+    rc_log(LOG_DEBUG, "Sending %zu bytes of TLS data in %d fragments",
+           out_bytes, (total_eap_length + 252) / 253);
+
+    // Send the request
+    int result = rc_auth(rh, client_port, send, received, msg);
+    rc_avpair_free(send);
+    if (result != 0)
+    {
+        rc_log(LOG_ERR, "Failed to send TLS data to server: %s", msg);
+        return -1;
+    }
+
+    return 0;
+}
+
+int DoHandShakeSendTLSData(rc_handle* rh, eap_tls_state_t* state,
+                           VALUE_PAIR** received, UINT4 client_port,
+                           int ServerHello, char* msg)
+{
+    VALUE_PAIR* vp = *received;
+    int handshake_status = 0;
+
+    handshake_status = SSL_connect(state->ssl);
+    if (handshake_status <= 0)
+    {
+        int ssl_err = SSL_get_error(state->ssl, handshake_status);
+        if (ssl_err != SSL_ERROR_WANT_READ && ssl_err != SSL_ERROR_WANT_WRITE)
+        {
+            rc_log(LOG_ERR, "SSL handshake failed: %s",
+                   ERR_error_string(ERR_get_error(), NULL));
+            return -1;
+        }
+    }
+
+    char* out_data;
+    long out_bytes = BIO_get_mem_data(state->wbio, &out_data);
+    if (out_bytes > 0)
+    {
+        rc_log(LOG_DEBUG, "Sending %ld bytes of TLS data", out_bytes);
+        int result = rc_eaptls_send_tlsdata(rh, state, received, out_data,
+                                            out_bytes, client_port);
+        if (result < 0)
+        {
+            rc_log(LOG_ERR, "Failed to send TLS data");
+            return -1;
+        }
+        BIO_reset(state->wbio);
+        BIO_reset(state->rbio);
+        if (ServerHello == 1)
+        {
+            int result = HandleServerHelloFragments(rh, state, received,
+                                                    client_port, msg);
+            if (result < 0)
+            {
+                rc_log(LOG_ERR, "Server Hello phase failed");
+                return -1;
+            }
+        }
+    }
+    else
+    {
+        rc_log(LOG_ERR, "No TLS data to send");
+        return -1;
+    }
+
+    return 0;
+}
+
+/*
+ * Function: rc_auth_eaptls
+ *
+ * Purpose: As per RFC 5216 EAP-TLS Authentication Flow was constructed to
+ * Support EAP-TLS Mutual Crtificate Based Authentication
+ *
+ * Returns: received value_pairs in received, messages from the server in msg
+ *          and 0 on success, negative on failure as return value
+ *
+ */
+int rc_auth_eaptls(rc_handle* rh, UINT4 client_port, VALUE_PAIR** received,
+                   char* msg)
+{
+    eap_tls_state_t state = {0};
+    int result = ERROR_RC;
+    int IsServerHello = 1;
+
+    // Initialize SSL context
+    if (eap_tls_init_ssl_context(&state) < 0)
+    {
+        rc_log(LOG_ERR, "Failed to initialize SSL context");
+        return ERROR_RC;
+    }
+    state.eap_id = ++eapid;
+
+    // Client Hello phase & Certificate exchange
+    while (IsServerHello >= 0)
+    {
+        result = DoHandShakeSendTLSData(rh, &state, received, client_port,
+                                        IsServerHello, msg);
+        if (result < 0)
+        {
+            rc_log(LOG_ERR, "Client Hello / Certificate exchange phase failed");
+            goto cleanup;
+        }
+        IsServerHello--;
+    }
+
+    // Final ACK
+    result = rc_AckServer(rh, &state, client_port, received, msg);
+    if (result != OK_RC)
+    {
+        rc_log(LOG_ERR, "Final ACK failed");
+    }
+
+cleanup:
+    eap_tls_cleanup(&state);
+    return result;
+}
 
