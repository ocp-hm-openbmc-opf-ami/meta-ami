+    /* get more PAM information (ignore errors) */
+    pam_get_item(pamh, PAM_RUSER, (const void**)ruser);
+    pam_get_item(pamh, PAM_RHOST, (const void**)rhost);
+    pam_get_item(pamh, PAM_TTY, (const void**)tty);
+    return PAM_SUCCESS;
+}
