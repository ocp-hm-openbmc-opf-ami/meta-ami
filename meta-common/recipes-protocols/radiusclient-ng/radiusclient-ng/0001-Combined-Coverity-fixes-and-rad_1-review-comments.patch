--- a/lib/sendserver.c
+++ b/lib/sendserver.c
@@ -214,7 +214,7 @@ static void strappend(char* dest, unsigned max_size, int* pos, const char* src)
 int rc_send_server(const rc_handle* rh, SEND_DATA* data, char* msg,
                    unsigned flags)
 {
-    int sockfd;
+    int sockfd = -1;
     AUTH_HDR *auth, *recv_auth;
     char* server_name; /* Name of server to query */
     struct sockaddr_storage our_sockaddr;
