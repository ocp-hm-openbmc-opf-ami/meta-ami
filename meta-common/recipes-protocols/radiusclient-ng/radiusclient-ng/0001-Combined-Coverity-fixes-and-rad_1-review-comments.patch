                    server_name, data->svc_port);
-            close(sockfd);
-            memset(secret, '\0', sizeof(secret));
-            return ERROR_RC;
+            result = ERROR_RC;
+            goto cleanup;
         }
 
         if (attr[1] < 2)
@@ -523,9 +522,8 @@ int rc_send_server(const rc_handle* rh, SEND_DATA* data, char* msg,
                 LOG_ERR,
                 "rc_send_server: recvfrom: %s:%d: attribute length is too small",
                 server_name, data->svc_port);
-            close(sockfd);
-            memset(secret, '\0', sizeof(secret));
-            return ERROR_RC;
+            result = ERROR_RC;
+            goto cleanup;
         }
 
         if ((attr + attr[1]) > (recv_buffer + length))
@@ -534,9 +532,8 @@ int rc_send_server(const rc_handle* rh, SEND_DATA* data, char* msg,
                 LOG_ERR,
                 "rc_send_server: recvfrom: %s:%d: attribute overflows the packet",
                 server_name, data->svc_port);
-            close(sockfd);
-            memset(secret, '\0', sizeof(secret));
-            return ERROR_RC;
+            result = ERROR_RC;
+            goto cleanup;
         }
 
         attr += attr[1];
@@ -603,8 +600,18 @@ int rc_send_server(const rc_handle* rh, SEND_DATA* data, char* msg,
     }
 
 cleanup:
+
+    if (sockfd >= 0)
+    {
+        close(sockfd);
+    }
+
     if (auth_addr)
+    {
         freeaddrinfo(auth_addr);
+    }
+
+    memset(secret, '\0', sizeof(secret));
 
     return result;
 }
