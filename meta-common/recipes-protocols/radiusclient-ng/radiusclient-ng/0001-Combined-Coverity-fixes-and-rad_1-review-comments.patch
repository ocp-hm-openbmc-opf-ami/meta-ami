diff --git a/lib/log.c b/lib/log.c
index ae2b980..5f7ddab 100644
--- a/lib/log.c
+++ b/lib/log.c
@@ -34,9 +34,17 @@ void rc_log(int prio, char const *format, ...)
 	char buff[1024];
 	va_list ap;
 
-	va_start(ap,format);
-	vsnprintf(buff, sizeof(buff), format, ap);
-	va_end(ap);
+
+        if (format != NULL){
+                va_start(ap, format);
+    		vsnprintf(buff, sizeof(buff), format, ap);
+                va_end(ap);
+	}
+	else
+	{	
+    		snprintf(buff, sizeof(buff), "%s", "NULL format string");
+	}
+
 
 #ifndef _MSC_VER /* TODO: Fix me */
 	syslog(prio, "%s", buff);
diff --git a/lib/sendserver.c b/lib/sendserver.c
