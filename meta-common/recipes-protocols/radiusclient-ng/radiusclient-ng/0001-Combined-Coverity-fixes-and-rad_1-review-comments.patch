diff --git a/lib/avpair.c b/lib/avpair.c
index 3807e2e..0431f1e 100644
--- a/lib/avpair.c
+++ b/lib/avpair.c
@@ -736,8 +736,17 @@ int rc_avpair_tostr (rc_handle const *rh, VALUE_PAIR *pair, char *name, int ln,
 	    	pos = 0;
 		ptr = (unsigned char *) pair->strvalue;
 		if (pair->attribute == PW_DIGEST_ATTRIBUTES) {
-			pair->strvalue[*(ptr + 1)] = '\0';
-			ptr += 2;
+
+    			unsigned int digest_len = *(ptr + 1);
+
+    			if (digest_len >= sizeof(pair->strvalue)) {
+        			rc_log(LOG_ERR,
+               				"rc_avpair_tostr: invalid digest attribute length");
+        			return -1;
+    			}
+
+    			pair->strvalue[digest_len] = '\0';
+    			ptr += 2;
 		}
 		while (*ptr != '\0')
 		{
