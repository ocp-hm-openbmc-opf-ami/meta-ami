From 2f81fb1111002b2dcc517b2f801382eeca3a105b Mon Sep 17 00:00:00 2001
From: ramsankarr <ramsankarr@ami.com>
Date: Thu, 14 Nov 2024 17:50:51 +0530
Subject: [PATCH 38/38] ipmi_pass file validation

---
 src/pam_ipmisave/pam_ipmisave.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/pam_ipmisave/pam_ipmisave.c b/src/pam_ipmisave/pam_ipmisave.c
index 9e7d33c..c4fda0a 100644
--- a/src/pam_ipmisave/pam_ipmisave.c
+++ b/src/pam_ipmisave/pam_ipmisave.c
@@ -387,6 +387,17 @@ int update_pass_special_file(const pam_handle_t *pamh, const char *keyfilename,
 				err = 1;
 				goto done;
 			}
+
+            if((int)opwfilesize != (int)(sizeof(metapassstruct) + opwmp->hashsize\
+                        + opwmp->ivsize + opwmp->datasize + opwmp->padsize + opwmp->macsize))
+            {
+                syslog(LOG_WARNING, "failure\n");
+                free(opwfilebuff);
+                fclose(opwfile);
+                fclose(pwfile);
+                err = 1;
+                goto done;        
+            }
 			// User & password pairs are mapped as <user
 			// name>:<password>\n. Add +3 for special chars ':',
 			// '\n' and '\0'.
-- 
