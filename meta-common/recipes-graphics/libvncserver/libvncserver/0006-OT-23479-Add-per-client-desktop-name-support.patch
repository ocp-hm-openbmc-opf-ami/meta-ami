From 26b0f51d00a1429c249c36e3283111feb5009a65 Mon Sep 17 00:00:00 2001
From: Dhineshkumar M <mdhineshkumar@ami.com>
Date: Thu, 19 Feb 2026 16:40:34 +0530
Subject: [PATCH] OT-23479-Add-per-client-desktop-name

Signed-off-by: Dhineshkumar M <mdhineshkumar@ami.com>
---
 include/rfb/rfb.h            |  3 +++
 src/libvncserver/rfbserver.c | 11 ++++++++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/include/rfb/rfb.h b/include/rfb/rfb.h
index fc7db3eb..ae11911f 100644
--- a/include/rfb/rfb.h
+++ b/include/rfb/rfb.h
@@ -715,6 +715,9 @@ typedef struct _rfbClientRec {
 #endif
 #endif
     int tightEncodingSupport; /* RealVNC JPEG Support */
+
+    /** Per-client desktop name (overrides screen->desktopName if set) */
+    const char* desktopName;
 } rfbClientRec, *rfbClientPtr;
 
 /**
diff --git a/src/libvncserver/rfbserver.c b/src/libvncserver/rfbserver.c
index 0d35f595..18cacd1d 100644
--- a/src/libvncserver/rfbserver.c
+++ b/src/libvncserver/rfbserver.c
@@ -449,6 +449,7 @@ rfbNewTCPOrUDPClient(rfbScreenInfoPtr rfbScreen,
       cl->requestedDesktopSizeChange = 0;
       cl->lastDesktopSizeChangeError = 0;
       cl->tightEncodingSupport = FALSE; /* RealVNC JPEG Support */
+      cl->desktopName = NULL; /* Per-client desktop name (overrides screen->desktopName) */
 
 #ifdef LIBVNCSERVER_HAVE_LIBZ
       cl->compStreamInited = FALSE;
@@ -608,6 +609,12 @@ rfbClientConnectionGone(rfbClientPtr cl)
 
     rfbLog("Client %s gone\n",cl->host);
     free(cl->host);
+
+    /* Free per-client desktop name if allocated */
+    if (cl->desktopName != NULL) {
+        free((void*)cl->desktopName);
+        cl->desktopName = NULL;
+    }
 	
     if (cl->wsctx != NULL){
         free(cl->wsctx);
@@ -842,7 +849,9 @@ rfbProcessClientInitMessage(rfbClientPtr cl)
     u.si.format.greenMax = Swap16IfLE(u.si.format.greenMax);
     u.si.format.blueMax = Swap16IfLE(u.si.format.blueMax);
 
-    strncpy(u.buf + sz_rfbServerInitMsg, cl->screen->desktopName, 127);
+    /* Use per-client desktop name if set, otherwise fall back to screen default */
+    const char* desktopNameToUse = (cl->desktopName != NULL) ? cl->desktopName : cl->screen->desktopName;
+    strncpy(u.buf + sz_rfbServerInitMsg, desktopNameToUse, 127);
     len = strlen(u.buf + sz_rfbServerInitMsg);
     u.si.nameLength = Swap32IfLE(len);
 
-- 
2.25.1

