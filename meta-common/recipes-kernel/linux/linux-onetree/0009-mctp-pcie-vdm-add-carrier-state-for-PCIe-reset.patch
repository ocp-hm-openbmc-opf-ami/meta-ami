diff --git a/drivers/net/mctp/mctp-pcie-vdm.c b/drivers/net/mctp/mctp-pcie-vdm.c
index f557ee6..a84fefe 100644
--- a/drivers/net/mctp/mctp-pcie-vdm.c
+++ b/drivers/net/mctp/mctp-pcie-vdm.c
@@ -176,6 +176,13 @@ static netdev_tx_t mctp_pcie_vdm_start_xmit(struct sk_buff *skb,
 
 	pr_debug("%s: skb len %u\n", __func__, skb->len);
 
+	if (!netif_carrier_ok(ndev)) {
+		dev_dbg(&ndev->dev, "TX dropped: carrier off\n");
+		ndev->stats.tx_dropped++;
+		kfree_skb(skb);
+		return NETDEV_TX_OK;
+	}
+
 	if (skb) {
 		rc = mctp_pcie_vdm_xmit(ndev, skb);
 		if (rc) {
@@ -247,12 +254,18 @@ static void mctp_pcie_vdm_net_setup(struct net_device *ndev)
 
 	ndev->netdev_ops = &mctp_pcie_vdm_net_ops;
 	ndev->header_ops = &mctp_pcie_vdm_net_hdr_ops;
+
+	/* Start with carrier off; HW driver calls mctp_pcie_vdm_link_up()
+	 * once the PCIe link is established and ready for traffic.
+	 */
+	netif_carrier_off(ndev);
 }
 
-static int mctp_pcie_vdm_add_net_dev(struct net_device **dev)
+static int mctp_pcie_vdm_add_net_dev(struct net_device **dev, const char *ifname)
 {
 	struct net_device *ndev = alloc_netdev(sizeof(struct mctp_pcie_vdm_dev),
-					       "mctppci%d", NET_NAME_UNKNOWN,
+					       ifname ? ifname : "mctppci%d",
+					       NET_NAME_UNKNOWN,
 					       mctp_pcie_vdm_net_setup);
 
 	if (!ndev) {
@@ -273,11 +286,34 @@ static int mctp_pcie_vdm_add_net_dev(struct net_device **dev)
 	return rc;
 }
 
+void mctp_pcie_vdm_link_up(struct net_device *ndev)
+{
+	if (!ndev)
+		return;
+	netif_carrier_on(ndev);
+	netif_tx_wake_all_queues(ndev);
+	dev_dbg(&ndev->dev, "carrier on\n");
+}
+EXPORT_SYMBOL_GPL(mctp_pcie_vdm_link_up);
+
+void mctp_pcie_vdm_link_down(struct net_device *ndev)
+{
+	if (!ndev)
+		return;
+	netif_carrier_off(ndev);
+	netif_tx_stop_all_queues(ndev);
+	dev_dbg(&ndev->dev, "carrier off\n");
+}
+EXPORT_SYMBOL_GPL(mctp_pcie_vdm_link_down);
+
 void mctp_pcie_vdm_receive_packet(struct net_device *ndev)
 {
 	struct mctp_pcie_vdm_dev *vdm_dev;
 	u8 *packet;
 
+	if (!netif_carrier_ok(ndev))
+		return;
+
 	vdm_dev = netdev_priv(ndev);
 	packet = vdm_dev->callback_ops->recv_packet(vdm_dev->dev);
 
@@ -331,13 +367,14 @@ void mctp_pcie_vdm_receive_packet(struct net_device *ndev)
 }
 
 struct net_device *mctp_pcie_vdm_add_dev(struct device *dev,
-					 const struct mctp_pcie_vdm_ops *ops)
+					 const struct mctp_pcie_vdm_ops *ops,
+					 const char *ifname)
 {
 	struct net_device *ndev;
 	struct mctp_pcie_vdm_dev *vdm_dev;
 	int rc;
 
-	rc = mctp_pcie_vdm_add_net_dev(&ndev);
+	rc = mctp_pcie_vdm_add_net_dev(&ndev, ifname);
 	if (rc) {
 		pr_err("%s: failed to add net device\n", __func__);
 		return ERR_PTR(rc);

