From fd7647edd7660dcdf8a8b5e4809d8713f790bb6e Mon Sep 17 00:00:00 2001
From: arjuncr <arjuncr@ami.com>
Date: Mon, 26 May 2025 06:11:56 -0400
Subject: [PATCH] Work Around Fix For Peci Time Out

---
 drivers/peci-legacy/busses/peci-aspeed.c | 77 +++++++++++++++++++++++-
 drivers/peci-legacy/peci-core.c          | 55 ++++++++++++++++-
 include/linux/peci-legacy.h              |  2 +
 3 files changed, 131 insertions(+), 3 deletions(-)

diff --git a/drivers/peci-legacy/busses/peci-aspeed.c b/drivers/peci-legacy/busses/peci-aspeed.c
index 556e61094667..d765fcab3d84 100644
--- a/drivers/peci-legacy/busses/peci-aspeed.c
+++ b/drivers/peci-legacy/busses/peci-aspeed.c
@@ -115,6 +115,10 @@
 #define ASPEED_PECI_CMD_TIMEOUT_MS_DEFAULT	1000
 #define ASPEED_PECI_CMD_TIMEOUT_MS_MAX		60000
 
+#define DUMMY_CMD_WA_THRESHOLD 0xFFFF
+
+static size_t dummy_cmd_count[PECI_OFFSET_MAX];
+
 struct aspeed_peci {
 	struct peci_adapter	*adapter;
 	struct device		*dev;
@@ -295,6 +299,73 @@ static int aspeed_peci_xfer(struct peci_adapter *adapter,
 	return ret;
 }
 
+static struct peci_xfer_msg *aspeed_peci_get_dummy_command(struct peci_adapter *adapter, u8 addr)
+{
+	struct peci_xfer_msg *msg;
+
+	msg = peci_get_xfer_msg(PECI_RDPKGCFG_WRITE_LEN, PECI_RDPKGCFG_READ_LEN_BASE + 4);
+	if (!msg)
+		return NULL;
+
+	msg->addr = addr;
+	msg->tx_buf[0] = PECI_RDPKGCFG_CMD;
+	msg->tx_buf[1] = 0; /* Domain ID [7:1] | Retry bit [0] */
+	msg->tx_buf[2] = 0; /* RdPkgConfig index */
+	msg->tx_buf[3] = 0; /* LSB - Config parameter */
+	msg->tx_buf[4] = 0; /* MSB - Config parameter */
+
+	return msg;
+}
+
+static void aspeed_peci_wa_execute_dummy_cmd(struct peci_adapter *adapter, u8 addr)
+{
+	struct aspeed_peci *priv = peci_get_adapdata(adapter);
+	struct peci_xfer_msg *msg;
+
+	msg = aspeed_peci_get_dummy_command(adapter, addr);
+	if (!msg)
+		return;
+
+	/* send dummy command */
+	aspeed_peci_xfer(adapter, msg);
+	dev_dbg(priv->dev, "PECI 0x83 workaround: Dummy command sent. cc: 0x%x\n", msg->rx_buf[0]);
+
+	peci_put_xfer_msg(msg);
+}
+
+static u32 aspeed_peci_get_wa_counter(int cpu)
+{
+	return dummy_cmd_count[cpu];
+}
+
+static void aspeed_peci_set_wa_counter(int cpu, size_t count)
+{
+	dummy_cmd_count[cpu] = count;
+}
+
+static int aspeed_peci_wa_check_counter(struct peci_adapter *adapter, struct peci_xfer_msg *msg)
+{
+	struct aspeed_peci *priv = peci_get_adapdata(adapter);
+	int cpu = msg->addr - PECI_BASE_ADDR;
+
+	/* Command is counted if it's not Ping, GetTemp, or GetDIB and not a retry */
+	if (msg->tx_buf && msg->tx_buf[0] != PECI_GET_TEMP_CMD &&
+	    msg->tx_buf[0] != PECI_GET_DIB_CMD &&
+	    (msg->tx_buf[1] & PECI_DEV_RETRY_BIT) != PECI_DEV_RETRY_BIT)
+		dummy_cmd_count[cpu]++;
+
+	if (dummy_cmd_count[cpu] > DUMMY_CMD_WA_THRESHOLD) {
+		dev_dbg(priv->dev, "PECI 0x83 workaround: Counter threshold reached on CPU %d.\n",
+			cpu);
+		aspeed_peci_wa_execute_dummy_cmd(adapter, msg->addr);
+		/* Reset the counter including the current command */
+		dummy_cmd_count[cpu] = 1;
+	}
+
+	/* Send the real command */
+	return aspeed_peci_xfer(adapter, msg);
+}
+
 static irqreturn_t aspeed_peci_irq_handler(int irq, void *arg)
 {
 	struct aspeed_peci *priv = arg;
@@ -454,7 +525,11 @@ static int aspeed_peci_probe(struct platform_device *pdev)
 	priv->adapter->owner = THIS_MODULE;
 	priv->adapter->dev.of_node = of_node_get(dev_of_node(priv->dev));
 	strlcpy(priv->adapter->name, pdev->name, sizeof(priv->adapter->name));
-	priv->adapter->xfer = aspeed_peci_xfer;
+	//priv->adapter->xfer = aspeed_peci_xfer;
+	priv->adapter->xfer = aspeed_peci_wa_check_counter;
+	priv->adapter->set_wa_count = aspeed_peci_set_wa_counter;
+	priv->adapter->get_wa_count = aspeed_peci_get_wa_counter;
+
 	priv->adapter->use_dma = false;
 
 	priv->rst = devm_reset_control_get(&pdev->dev, NULL);
diff --git a/drivers/peci-legacy/peci-core.c b/drivers/peci-legacy/peci-core.c
index 2c57bc593857..f64385ac8a6f 100644
--- a/drivers/peci-legacy/peci-core.c
+++ b/drivers/peci-legacy/peci-core.c
@@ -337,16 +337,67 @@ static int __peci_xfer(struct peci_adapter *adapter, struct peci_xfer_msg *msg,
 	return ret;
 }
 
+static int peci_wa_check_counter_sync(struct peci_adapter *adapter, struct peci_xfer_msg *msg,
+				      bool do_retry, bool has_aw_fcs)
+{
+	bool previous_83[PECI_OFFSET_MAX] = { 0 };
+	int cpu = msg->addr - PECI_BASE_ADDR;
+	size_t wa_count;
+	u8 aw_fcs;
+	int ret;
+
+	ret = __peci_xfer(adapter, msg, do_retry, has_aw_fcs);
+
+	/*
+	 * If the command was retried and got 0x83 but not previously and the wa_count functions are
+	 * available, resend the command to check if we need to sync the counter. If we got
+	 * 0x83 previously, we may be in a persistent 0x83 state, so don't attempt to re-sync
+	 * the counter until it's resolved. If the wa_count functions are not available, we
+	 * can't sync the counter.
+	 */
+	if (do_retry && msg->rx_buf && msg->rx_buf[0] == PECI_DEV_CC_NEED_RETRY &&
+	    !previous_83[cpu] && adapter->get_wa_count && adapter->set_wa_count) {
+		wa_count = adapter->get_wa_count(cpu);
+		/* Clear the counter to avoid a counter rollover from the repeated command */
+		adapter->set_wa_count(cpu, 0);
+
+		msg->tx_buf[1] &= ~PECI_DEV_RETRY_BIT;
+		/* Recalculate the AW FCS if it has one */
+		if (has_aw_fcs) {
+			peci_aw_fcs(msg, 2 + msg->tx_len, &aw_fcs);
+
+			msg->tx_buf[msg->tx_len - 1] = 0x80 ^ aw_fcs;
+		}
+
+		__peci_xfer(adapter, msg, do_retry, has_aw_fcs);
+
+		if (msg->rx_buf[0] == PECI_DEV_CC_NEED_RETRY)
+			/* 0x83 repeated, so restore the count including the resent command */
+			adapter->set_wa_count(cpu, wa_count + 1);
+		else
+			dev_dbg(&adapter->dev, "0x83 issue hit on CPU %d. Counter re-synced\n",
+				cpu);
+
+		/* Restore the 0x83 cc in case it changed */
+		msg->rx_buf[0] = PECI_DEV_CC_NEED_RETRY;
+	}
+
+	/* Remember if the last return was 0x83 */
+	previous_83[cpu] = (msg->rx_buf && msg->rx_buf[0] == PECI_DEV_CC_NEED_RETRY);
+
+	return ret;
+}
+
 static int peci_xfer(struct peci_adapter *adapter, struct peci_xfer_msg *msg)
 {
-	return __peci_xfer(adapter, msg, false, false);
+	return peci_wa_check_counter_sync(adapter, msg, false, false);
 }
 
 static int peci_xfer_with_retries(struct peci_adapter *adapter,
 				  struct peci_xfer_msg *msg,
 				  bool has_aw_fcs)
 {
-	return __peci_xfer(adapter, msg, true, has_aw_fcs);
+	return peci_wa_check_counter_sync(adapter, msg, true, has_aw_fcs);
 }
 
 static int peci_scan_cmd_mask(struct peci_adapter *adapter)
diff --git a/include/linux/peci-legacy.h b/include/linux/peci-legacy.h
index d9e77c5773be..5e1c2d729bac 100644
--- a/include/linux/peci-legacy.h
+++ b/include/linux/peci-legacy.h
@@ -43,6 +43,8 @@ struct peci_adapter {
 	struct list_head	userspace_clients;
 	int			(*xfer)(struct peci_adapter *adapter,
 					struct peci_xfer_msg *msg);
+	void			(*set_wa_count)(int cpu, size_t count);
+	u32			(*get_wa_count)(int cpu);
 	u32			cmd_mask;
 	bool			use_dma;
 	u8			peci_revision;
-- 
2.34.1

