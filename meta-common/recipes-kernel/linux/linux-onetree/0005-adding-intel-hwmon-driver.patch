 drivers/hwmon/peci-cputemp.c        |  703 +++++++++++++
 drivers/hwmon/peci-dimmpower.c      |  817 +++++++++++++++
 drivers/hwmon/peci-dimmtemp.c       |  766 ++++++++++++++
