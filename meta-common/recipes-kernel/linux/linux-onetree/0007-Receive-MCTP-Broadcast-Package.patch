From b98edfeca96d31702b65df5f99740a3dd7fdc2d4 Mon Sep 17 00:00:00 2001
From: roycheng <roycheng@ami.com>
Date: Fri, 31 Oct 2025 11:40:14 +0800
Subject: [PATCH] mctp: route broadcast packets to local endpoint

Accept MCTP broadcast (dest EID 0xFF) packets and deliver them to the
local endpoint on the receiving device, reusing mctp_route_lookup_null.

The device check in mctp_route_lookup_null is preserved so broadcast
packets only match local routes on the interface they arrived on.

Signed-off-by: roycheng <roycheng@ami.com>
---
 net/mctp/route.c | 5 ++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/net/mctp/route.c b/net/mctp/route.c
index da12b5bc3fe1..a1f7c8e3b2d1 100644
--- a/net/mctp/route.c
+++ b/net/mctp/route.c
@@ -1369,6 +1369,10 @@ static int mctp_pkttype_receive(struct sk_buff *skb, struct net_device *dev,
-	if (rc && mh->dest == MCTP_ADDR_NULL && skb->pkt_type == PACKET_HOST)
+	if (rc && mh->dest == MCTP_ADDR_NULL)
 		rc = mctp_route_lookup_null(net, dev, &dst);
 
+	/* Broadcast: deliver to local endpoint on the receiving device */
+	if (rc && mctp_address_broadcast(mh->dest))
+		rc = mctp_route_lookup_null(net, dev, &dst);
+
 	if (rc)
 		goto err_drop;
 
