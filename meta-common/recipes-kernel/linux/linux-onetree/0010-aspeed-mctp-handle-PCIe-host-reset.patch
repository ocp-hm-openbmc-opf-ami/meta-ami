@@ -2122,11 +2145,31 @@ static void aspeed_mctp_reset_work(struct work_struct *work)
 						pcie.rst_dwork.work);
 	struct kobject *kobj = &priv->mctp_miscdev.this_device->kobj;
 
+	/* Re-enable tasklets that were disabled in the IRQ handler
+	 * (tasklet_disable_nosync).  We are now in process context,
+	 * so any in-flight tasklet execution has completed by the
+	 * time the workqueue runs.
+	 */
+	if (priv->pcie.tasklets_disabled) {
+		tasklet_enable(&priv->tx.tasklet);
+		tasklet_enable(&priv->rx.tasklet);
+		priv->pcie.tasklets_disabled = false;
+	}
+
 	if (priv->pcie.need_uevent) {
 		aspeed_mctp_send_pcie_uevent(kobj, false);
 		priv->pcie.need_uevent = false;
 	}
 
+	/* Clear stale endpoint routing table from the previous host
+	 * session.  The host will re-enumerate after reset and BDF
+	 * assignments may change, making old entries invalid.
+	 */
+	mutex_lock(&priv->endpoints_lock);
+	aspeed_mctp_eid_info_list_remove(&priv->endpoints);
+	priv->endpoints_count = 0;
+	mutex_unlock(&priv->endpoints_lock);
+
 	aspeed_mctp_pcie_setup(priv);
 }
 
@@ -2193,8 +2236,35 @@ static irqreturn_t aspeed_mctp_pcie_rst_irq_handler(int irq, void *arg)
 {
 	struct aspeed_mctp *priv = arg;
 
+	/* Disable MCTP interrupts to prevent rx_tasklet from dispatching
+	 * stale DMA data while we reinitialize the channels.
+	 */
+	aspeed_mctp_irq_disable(priv);
+
+#ifdef CONFIG_MCTP_TRANSPORT_PCIE_VDM
+	/* Immediately signal carrier off so the MCTP stack and mctpd
+	 * stop sending packets into the dead link.  netif_carrier_off
+	 * and netif_tx_stop_all_queues are IRQ-safe.
+	 */
+	mctp_pcie_vdm_link_down(priv->ndev);
+#endif
+
+	/* Prevent tasklets from being rescheduled.  We use the nosync
+	 * variant because we are in hardirq context and cannot sleep.
+	 * The workqueue (reset_work) calls tasklet_enable() once DMA
+	 * reinit is safe.
+	 */
+	tasklet_disable_nosync(&priv->rx.tasklet);
+	tasklet_disable_nosync(&priv->tx.tasklet);
+	priv->pcie.tasklets_disabled = true;
+
 	aspeed_mctp_channels_init(priv);
 
+	/* Mark RX as stopped so the rx_tasklet will not restart RX
+	 * when re-enabled.
+	 */
+	priv->rx.stopped = true;
+
 	priv->pcie.need_uevent = true;
 	priv->eid = 0;
 
