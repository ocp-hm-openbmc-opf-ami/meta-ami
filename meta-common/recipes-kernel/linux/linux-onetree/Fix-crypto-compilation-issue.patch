 #include <linux/init.h>
 #include <linux/list.h>
 #include <linux/kernel.h>
@@ -35,19 +35,13 @@
 #include <linux/net.h>
 #include <net/sock.h>
 
-struct aead_tfm {
-	struct crypto_aead *aead;
-	struct crypto_sync_skcipher *null_tfm;
-};
