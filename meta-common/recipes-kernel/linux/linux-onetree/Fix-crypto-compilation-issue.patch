Signed-off-by: santhoshs <santhoshs@ami.com>
---
 crypto/Kconfig      |  1 -
 crypto/algif_aead.c | 87 ++++++++-------------------------------------
 2 files changed, 15 insertions(+), 73 deletions(-)

diff --git a/crypto/Kconfig b/crypto/Kconfig
index 149b7232273a..e39369edb163 100644
--- a/crypto/Kconfig
+++ b/crypto/Kconfig
@@ -1379,7 +1379,6 @@ config CRYPTO_USER_API_AEAD
 	depends on NET
 	select CRYPTO_AEAD
 	select CRYPTO_SKCIPHER
-	select CRYPTO_NULL
 	select CRYPTO_USER_API
 	help
 	  Enable the userspace interface for AEAD cipher algorithms.
