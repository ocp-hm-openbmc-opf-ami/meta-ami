From 673816855b68b1fb5c6a8c02d9dba38b76b0bd8d Mon Sep 17 00:00:00 2001
From: arjuncr <arjuncr@ami.com>
Date: Fri, 19 Sep 2025 03:59:49 -0400
Subject: [PATCH] fix for lpc sio driver not loading

---
 drivers/soc/aspeed/Kconfig  | 2 +-
 drivers/soc/aspeed/Makefile | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/aspeed/Kconfig b/drivers/soc/aspeed/Kconfig
index a996ad2425d6..c82cb1f02a8e 100644
--- a/drivers/soc/aspeed/Kconfig
+++ b/drivers/soc/aspeed/Kconfig
@@ -37,7 +37,7 @@ config ASPEED_LPC_CTRL
 	  host LPC read/write region can be buffered.
 
 config ASPEED_LPC_SIO
-        tristate "Aspeed ast2400/2500 HOST LPC SIO support"
+        tristate "Aspeed ast2600 HOST LPC SIO support"
         depends on REGMAP && MFD_SYSCON
         help
           Provides a driver to control the LPC SIO interface on ASPEED platform
diff --git a/drivers/soc/aspeed/Makefile b/drivers/soc/aspeed/Makefile
index c8ddb33b60e6..c454b72131a4 100644
--- a/drivers/soc/aspeed/Makefile
+++ b/drivers/soc/aspeed/Makefile
@@ -28,3 +28,4 @@ obj-$(CONFIG_AST2700_RTC_OVER_ESPI)	+= ast2700-rtc-over-espi.o
 obj-$(CONFIG_ASPEED_ESPI_SLAVE)         += aspeed-espi.o
 aspeed-espi-y := aspeed-espi-slave.o aspeed-espi-oob.o
 obj-$(CONFIG_ASPEED_ESPI_MMBI)          += aspeed-espi-mmbi.o
+obj-$(CONFIG_ASPEED_LPC_SIO)          		+= aspeed-lpc-sio.o
-- 
2.34.1

