From 74d5ed5d64bee95d354292d1f5e2ce39173b62ac Mon Sep 17 00:00:00 2001
From: arjuncr <arjuncr@ami.com>
Date: Sun, 14 Sep 2025 10:22:49 -0400
Subject: [PATCH] Make file and Kconfig for espi and lpc sio

---
 drivers/soc/aspeed/Kconfig  | 23 +++++++++++++++++++++++
 drivers/soc/aspeed/Makefile |  3 +++
 2 files changed, 26 insertions(+)

diff --git a/drivers/soc/aspeed/Kconfig b/drivers/soc/aspeed/Kconfig
index ce0bfbe5608d..a996ad2425d6 100644
--- a/drivers/soc/aspeed/Kconfig
+++ b/drivers/soc/aspeed/Kconfig
@@ -10,6 +10,22 @@ config ASPEED_BMC_DEV
 config ASPEED_HOST_BMC_DEV
 	tristate "ASPEED Host BMC Device"
 
+config ASPEED_ESPI_SLAVE
+        depends on ARCH_ASPEED || COMPILE_TEST
+        depends on REGMAP_MMIO
+        tristate "Aspeed ast2500/2600 eSPI slave device driver"
+        help
+          Enable driver support for the Aspeed eSPI engine. Handles event
+          arising from firmware bootup and enable espi oob channel.
+
+config ASPEED_ESPI_MMBI
+        tristate "Aspeed ast2600 MMBI support over eSPI"
+        help
+          Enable support for MMBI support over eSPI.
+          This adds the drivers which allows efficient memory sharing
+          between Host/BIOS to BMC. This also creates protocol specific
+          device nodes and IOCTLs for interfacing with userspace applications.
+
 config ASPEED_LPC_CTRL
 	tristate "ASPEED LPC firmware cycle control"
 	select REGMAP
@@ -20,6 +36,13 @@ config ASPEED_LPC_CTRL
 	  also provides a read/write interface to a BMC ram region where the
 	  host LPC read/write region can be buffered.
 
+config ASPEED_LPC_SIO
+        tristate "Aspeed ast2400/2500 HOST LPC SIO support"
+        depends on REGMAP && MFD_SYSCON
+        help
+          Provides a driver to control the LPC SIO interface on ASPEED platform
+          through ioctl()s.
+
 config ASPEED_LPC_SNOOP
 	tristate "ASPEED LPC snoop support"
 	select REGMAP
diff --git a/drivers/soc/aspeed/Makefile b/drivers/soc/aspeed/Makefile
index c949e993d37d..c8ddb33b60e6 100644
--- a/drivers/soc/aspeed/Makefile
+++ b/drivers/soc/aspeed/Makefile
@@ -25,3 +25,6 @@ obj-$(CONFIG_ASPEED_DISP_INTF)		+= aspeed-disp-intf.o
 obj-$(CONFIG_ASPEED_PCIE_MMBI)		+= aspeed-pcie-mmbi.o
 obj-$(CONFIG_ASPEED_MBOX)		+= aspeed-mbox.o
 obj-$(CONFIG_AST2700_RTC_OVER_ESPI)	+= ast2700-rtc-over-espi.o
+obj-$(CONFIG_ASPEED_ESPI_SLAVE)         += aspeed-espi.o
+aspeed-espi-y := aspeed-espi-slave.o aspeed-espi-oob.o
+obj-$(CONFIG_ASPEED_ESPI_MMBI)          += aspeed-espi-mmbi.o
-- 
2.34.1

