+static int
+i3c_mctp_set_eid_info(struct i3c_mctp *priv, struct i3c_mctp_set_eid_info __user *userbuf)
+{
+	struct list_head list = LIST_HEAD_INIT(list);
+	struct i3c_mctp_set_eid_info set_eid;
