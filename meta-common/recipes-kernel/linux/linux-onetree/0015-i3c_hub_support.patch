+
+	dat_reg &= ~DEV_ADDR_TABLE_SIR_REJECT;
+	if (ibi_payload)
+		dat_reg |= DEV_ADDR_TABLE_IBI_WITH_DATA;
+	dat_reg |= DEV_ADDR_TABLE_IBI_PEC_EN;
