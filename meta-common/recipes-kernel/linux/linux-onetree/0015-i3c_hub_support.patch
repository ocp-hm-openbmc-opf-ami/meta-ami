+	     ++hw_dat_index) {
+		reg = readl(master->regs + DEV_ADDR_TABLE_LOC(master->datstartaddr, hw_dat_index));
+		if (first_4bits == DAT_DA_FIRST_4BITS_GET(reg))
+			return reg;
+	}
