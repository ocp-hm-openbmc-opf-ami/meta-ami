+			if (DEV_ADDR_TABLE_DYNAMIC_ADDR_GET(master->sw_dat[index].dat) ==
+			    DEV_ADDR_TABLE_DYNAMIC_ADDR_GET(mask_reg))
+				dw_i3c_master_decrement_hw_dat_index(master, index, hw_dat_index);
+		}
