+			/* Find HW DAT slot for IBI index */
+			hw_dat_index = dw_i3c_master_find_empty_hw_dat(master, true);
+			if (hw_dat_index < 0) {
+				spin_unlock(&master->hw_dat_lock);
+				return hw_dat_index;
+			}
