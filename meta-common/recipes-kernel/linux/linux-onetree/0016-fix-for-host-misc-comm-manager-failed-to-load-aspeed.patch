From fdbb76f986043810ed5fed05aa9dfa332a816b3a Mon Sep 17 00:00:00 2001
From: arjuncr <arjuncr@ami.com>
Date: Fri, 19 Sep 2025 03:50:18 -0400
Subject: [PATCH] fix for host-misc-comm-manager failed to load aspeed-lpc-mbox

---
 drivers/soc/aspeed/aspeed-lpc-mbox.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/soc/aspeed/aspeed-lpc-mbox.c b/drivers/soc/aspeed/aspeed-lpc-mbox.c
index 4b6a1693ec80..4c836d06b73b 100644
--- a/drivers/soc/aspeed/aspeed-lpc-mbox.c
+++ b/drivers/soc/aspeed/aspeed-lpc-mbox.c
@@ -342,7 +342,7 @@ static int aspeed_mbox_probe(struct platform_device *pdev)
 	}
 
 	mbox->mdev.minor = MISC_DYNAMIC_MINOR;
-	mbox->mdev.name = devm_kasprintf(dev, GFP_KERNEL, "%s%d", DEVICE_NAME, mbox->mdev_id);
+	mbox->mdev.name = DEVICE_NAME;
 	mbox->mdev.fops = &aspeed_mbox_fops;
 	mbox->mdev.parent = dev;
 	rc = misc_register(&mbox->mdev);
-- 
