From b9ac4a3aff9c10d4ee8e0634519b0b8aaf3621f4 Mon Sep 17 00:00:00 2001
From: Vijay K S <vijayks@ami.com>
Date: Wed, 19 Aug 2026 15:23:51 +0530
Subject: [PATCH] dual image fix

Upstream-Status: Inappropriate [AMI specific change]

Signed-off-by: Vijay K S <vijayks@ami.com>
---
 drivers/spi/spi-aspeed-smc.c | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/spi/spi-aspeed-smc.c b/drivers/spi/spi-aspeed-smc.c
index 407a317410b5..4fce478bb5fe 100644
--- a/drivers/spi/spi-aspeed-smc.c
+++ b/drivers/spi/spi-aspeed-smc.c
@@ -205,6 +205,13 @@ struct aspeed_spi {
 	u32			 flag;
 };
 
+static struct aspeed_spi *aspeed_spi_get_drvdata(struct device *dev)
+{
+	struct spi_controller *ctlr = dev_get_drvdata(dev);
+
+	return spi_controller_get_devdata(ctlr);
+}
+
 static inline ssize_t _access_primary_show(void __iomem *regs,
 					   struct device_attribute *attr,
 					   char *buf)
@@ -289,7 +296,7 @@ static inline ssize_t _current_boot_show(void __iomem *regs,
 static ssize_t access_primary_show(struct device *dev,
 				   struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_primary_show(aspi->regs, attr, buf);
 }
@@ -298,7 +305,7 @@ static ssize_t access_primary_store(struct device *dev,
 				    struct device_attribute *attr,
 				    const char *buf, size_t size)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_primary_store(aspi->regs, attr, buf, size);
 }
@@ -306,7 +313,7 @@ static ssize_t access_primary_store(struct device *dev,
 static ssize_t access_backup_show(struct device *dev,
 				  struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_backup_show(aspi->regs, attr, buf);
 }
@@ -315,7 +322,7 @@ static ssize_t access_backup_store(struct device *dev,
 				   struct device_attribute *attr,
 				   const char *buf, size_t size)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _access_backup_store(aspi->regs, attr, buf, size);
 }
@@ -323,7 +330,7 @@ static ssize_t access_backup_store(struct device *dev,
 static ssize_t current_boot_show(struct device *dev,
 				  struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 
 	return _current_boot_show(aspi->regs, attr, buf);
 }
@@ -386,7 +393,7 @@ static int aspeed_spi_create_abr_mode_file(int boot_mode)
 static ssize_t abr_bootmode_show(struct device *dev,
 				struct device_attribute *attr, char *buf)
 {
-	struct aspeed_spi *aspi = dev_get_drvdata(dev);
+	struct aspeed_spi *aspi = aspeed_spi_get_drvdata(dev);
 	int boot_mode = aspeed_spi_get_abr_mode(aspi);
 	return boot_mode >= 0 ? sysfs_emit(buf, "%d\n", boot_mode) :
 				sysfs_emit(buf, "error\n");
-- 
