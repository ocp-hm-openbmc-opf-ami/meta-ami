From fc473dc2bfb46f510c61f99bc4be616a2e5dc2ba Mon Sep 17 00:00:00 2001
From: arjuncr <arjuncr@ami.com>
Date: Sun, 14 Sep 2025 11:21:25 -0400
Subject: [PATCH] fix peci driver build error

---
 drivers/peci-legacy/busses/peci-aspeed.c | 11 +++++++++--
 drivers/peci-legacy/peci-dev.c           |  2 +-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/peci-legacy/busses/peci-aspeed.c b/drivers/peci-legacy/busses/peci-aspeed.c
index d765fcab3d84..ae5bfd19254b 100644
--- a/drivers/peci-legacy/busses/peci-aspeed.c
+++ b/drivers/peci-legacy/busses/peci-aspeed.c
@@ -284,7 +284,6 @@ static int aspeed_peci_xfer(struct peci_adapter *adapter,
 
 		msg->rx_buf[i] = (u8)(rx_data >> (byte_offset << 3));
 	}
-
 	print_hex_dump_debug("RX : ", DUMP_PREFIX_NONE, 16, 1,
 			     msg->rx_buf, msg->rx_len, true);
 
@@ -294,6 +293,8 @@ static int aspeed_peci_xfer(struct peci_adapter *adapter,
 	dev_dbg(priv->dev, "------------------------\n");
 
 err_irqrestore:
+	/* Reason : spin lock and unlock handled properly */
+	/* coverity[double_unlock : FALSE] */
 	spin_unlock_irqrestore(&priv->lock, flags);
 
 	return ret;
@@ -345,6 +346,11 @@ static void aspeed_peci_set_wa_counter(int cpu, size_t count)
 
 static int aspeed_peci_wa_check_counter(struct peci_adapter *adapter, struct peci_xfer_msg *msg)
 {
+	if(msg == NULL)
+	{
+	   return -EINVAL;
+	}
+
 	struct aspeed_peci *priv = peci_get_adapdata(adapter);
 	int cpu = msg->addr - PECI_BASE_ADDR;
 
@@ -361,8 +367,9 @@ static int aspeed_peci_wa_check_counter(struct peci_adapter *adapter, struct pec
 		/* Reset the counter including the current command */
 		dummy_cmd_count[cpu] = 1;
 	}
-
 	/* Send the real command */
+	/* Reason : Null checked before calling the function */
+	/* coverity[FORWARD_NULL : FALSE] */
 	return aspeed_peci_xfer(adapter, msg);
 }
 
diff --git a/drivers/peci-legacy/peci-dev.c b/drivers/peci-legacy/peci-dev.c
index cd820cc06b80..064e7d7e9e8f 100644
--- a/drivers/peci-legacy/peci-dev.c
+++ b/drivers/peci-legacy/peci-dev.c
@@ -316,7 +316,7 @@ static int __init peci_dev_init(void)
 		goto err;
 	}
 
-	peci_dev_class = class_create(THIS_MODULE, KBUILD_MODNAME);
+	peci_dev_class = class_create(KBUILD_MODNAME);
 	if (IS_ERR(peci_dev_class)) {
 		ret = PTR_ERR(peci_dev_class);
 		goto err_unreg_chrdev;
-- 
2.34.1

