From 3194fb661610a89085316674f5438e70e1e078cc Mon Sep 17 00:00:00 2001
From: Amrun Nisha R <amrunnishar@ami.com>
Date: Wed, 8 Jan 2025 15:38:07 +0530
Subject: [PATCH] Updated the SPI memory region from 256MB to 128Mb

Signed-off-by: Amrun Nisha R <amrunnishar@ami.com>
---
 arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index ef1429743074..12f7032025c9 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -291,6 +291,7 @@ &spi1 {
 	status = "okay";
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_spi1_default>;
+	reg = <0x1e630000 0xc4>, <0x30000000 0x08000000>;
 
 	flash@0 {
 		status = "okay";
@@ -320,8 +321,17 @@ &uart4 {
 &spi2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_spi2_default &pinctrl_spi2cs1_default
-				&pinctrl_spi2cs2_default &pinctrl_qspi2_default>;
+				&pinctrl_spi2cs2_default>;
 	status = "okay";
+	reg = <0x1e631000 0xc4>, <0x50000000 0x08000000>;
+
+	flash@0 {
+		status = "okay";
+		m25p,fast-read;
+		label = "spi2:0";
+		spi-rx-bus-width = <4>;
+		spi-max-frequency = <100000000>;
+	};
 	spidev@0 {
 			status = "okay";
 	};
-- 
2.34.1

