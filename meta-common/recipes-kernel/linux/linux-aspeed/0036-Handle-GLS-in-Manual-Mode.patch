From f7a0a3cdac2b939ce5623d28deec972e045e5fab Mon Sep 17 00:00:00 2001
From: Ethan Wei <kennywu@ami.com>
Date: Tue, 13 Aug 2024 19:50:31 +0800
Subject: [PATCH] Handle GLS in Manual Mode

---
 net/ncsi/ncsi-manage.c |  3 +--
 net/ncsi/ncsi-rsp.c    | 13 ++++++++++---
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/net/ncsi/ncsi-manage.c b/net/ncsi/ncsi-manage.c
index ad8f548b2c13..d392c852b11c 100644
--- a/net/ncsi/ncsi-manage.c
+++ b/net/ncsi/ncsi-manage.c
@@ -928,9 +928,8 @@ int ncsi_update_tx_channel(struct ncsi_dev_priv *ndp,
 	int ret = 0;
 
 	if (!package->multi_channel && !ndp->multi_package) {
-		netdev_warn(ndp->ndev.dev,
+		netdev_dbg(ndp->ndev.dev,
 			    "NCSI: Trying to update Tx channel in single-channel mode\n");
-				return -1;
 	}
 	nca.ndp = ndp;
 	nca.req_flags = 0;
diff --git a/net/ncsi/ncsi-rsp.c b/net/ncsi/ncsi-rsp.c
index e30727086c86..79ad4170b9aa 100644
--- a/net/ncsi/ncsi-rsp.c
+++ b/net/ncsi/ncsi-rsp.c
@@ -340,9 +340,16 @@ static int ncsi_rsp_handler_gls(struct ncsi_request *nr)
 
 	NCSI_FOR_EACH_PACKAGE(ndp, np) {
 		active_channel = ncsi_find_channel(np, np->configured_channel_ID);
-		if (np->configured_channel_ID == 0x1F || (active_channel != NULL && !ncsi_channel_has_link(active_channel))) {
-			NCSI_FOR_EACH_CHANNEL(np, channel) {
-				if (ncsi_channel_has_link(channel)) {
+		NCSI_FOR_EACH_CHANNEL(np, channel) {
+			if (ncsi_channel_has_link(channel)) {
+				if (np->preferred_channel) {
+					if (channel->id == np->preferred_channel->id) {
+						np->configured_channel_ID = channel->id;
+						ncsi_update_tx_channel(ndp, np, NULL, channel);
+						break;
+					}
+				}
+				else {
 					np->configured_channel_ID = channel->id;
 					ncsi_update_tx_channel(ndp, np, NULL, channel);
 					break;
-- 
2.34.1

