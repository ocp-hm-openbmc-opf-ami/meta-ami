From 73523faa2742e15798a7af460f58302d2b48318c Mon Sep 17 00:00:00 2001
From: Santhosh S <santhoshs@ami.com>
Date: Mon, 29 Jul 2024 18:50:42 +0530
Subject: [PATCH] Increased-rwfs-openbmc-flash-layout-64-dtsi

Signed-off-by: Santhosh S <santhoshs@ami.com>
---
 arch/arm/boot/dts/openbmc-flash-layout-64.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
index 60c80dda6b58..563c589ffc11 100644
--- a/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
+++ b/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
@@ -24,12 +24,12 @@ kernel@100000 {
 	};
 
 	rofs@a00000 {
-		reg = <0xa00000 0x2100000>; // 33MB
+		reg = <0xa00000 0x2D00000>; // 45MB
 		label = "rofs";
 	};
 
-	rwfs@2b00000 {
-		reg = <0x2b00000 0x1500000>; // 21MB
+	rwfs@3700000 {
+		reg = <0x3700000 0x900000>; // 21MB
 		label = "rwfs";
 	};
 };
-- 
2.34.1

