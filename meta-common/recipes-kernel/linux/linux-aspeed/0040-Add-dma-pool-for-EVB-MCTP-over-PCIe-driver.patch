From b78e1883520625002cd82c112d1297791b196f7c Mon Sep 17 00:00:00 2001
From: MingLunChang <minglunchang@ami.com>
Date: Fri, 9 Aug 2024 22:18:20 +0800
Subject: [PATCH] add dts

---
 arch/arm/boot/dts/aspeed-ast2600-evb.dts | 26 ++++++++++++++++++++++--
 arch/arm/boot/dts/aspeed-g6.dtsi         | 23 ++++++++++++++++++++-
 2 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
index 5c8fe383d60e..d89ab6c0dce7 100644
--- a/arch/arm/boot/dts/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
@@ -45,6 +45,18 @@ gfx_memory: framebuffer {
 			compatible = "shared-dma-pool";
 			reusable;
 		};
+
+		mctp0_reserved: mctp0_reserved@8a000000 {
+			reg = <0x8a000000 0x10000>;
+			compatible = "shared-dma-pool";
+			no-map;
+		};
+		
+		mctp1_reserved: mctp1_reserved@8a010000 {
+			reg = <0x8a010000 0x10000>;
+			compatible = "shared-dma-pool";
+			no-map;
+		};
 	};
 
 	vcc_sdhci0: regulator-vcc-sdhci0 {
@@ -205,8 +217,18 @@ &jtag1 {
         status = "okay";
 };
 
-&mctp {
-    status = "okay";
+&mctp0 {
+	aspeed,rx-packet-count = <192>;
+	aspeed,rx-ring-count = <192>;
+	memory-region = <&mctp0_reserved>;
+	status = "okay";
+};
+
+&mctp1 {
+	aspeed,rx-packet-count = <192>;
+	aspeed,rx-ring-count = <192>;
+	memory-region = <&mctp1_reserved>;
+	status = "okay";
 };
 
 &lpc_reset {
diff --git a/arch/arm/boot/dts/aspeed-g6.dtsi b/arch/arm/boot/dts/aspeed-g6.dtsi
index 7cf9bfe73c1e..8d83e10002f6 100644
--- a/arch/arm/boot/dts/aspeed-g6.dtsi
+++ b/arch/arm/boot/dts/aspeed-g6.dtsi
@@ -44,6 +44,8 @@ aliases {
 		serial4 = &uart5;
 		serial5 = &vuart1;
 		serial6 = &vuart2;
+		mctp0 = &mctp0;
+		mctp1 = &mctp1;
 		mdio0 = &mdio0;
 		mdio1 = &mdio1;
 		mdio2 = &mdio2;
@@ -454,16 +456,35 @@ pcieh: pcieh@1e6ed000 {
 				reg = <0x1e6ed000 0x100>;
 			};
 
-			mctp: mctp@1e6e8000 {
+			pcie_phy1: rc_bridge@1e6ed200 {
+				compatible = "aspeed,ast2600-pcie-phy", "syscon";
+				reg = <0x1e6ed200 0x100>;
+			};
+
+			mctp0: mctp@1e6e8000 {
 				compatible = "aspeed,ast2600-mctp";
 				reg = <0x1e6e8000 0x1000>;
 				interrupts-extended = <&gic GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
 						      <&scu_ic0 ASPEED_AST2600_SCU_IC0_PCIE_PERST_LO_TO_HI>;
+				interrupt-names = "mctp", "pcie";
 				resets = <&syscon ASPEED_RESET_DEV_MCTP>;
+				aspeed,scu = <&syscon>;
 				aspeed,pcieh = <&pcieh>;
 				status = "disabled";
 			};
 
+			mctp1: mctp@1e6f9000 {
+				compatible = "aspeed,ast2600-mctp";
+				reg = <0x1e6f9000 0x1000>;
+				interrupts-extended = <&scu_ic0 ASPEED_AST2600_SCU_IC0_PCIE_RCRST_LO_TO_HI>;
+				interrupt-names = "pcie";
+				pcie_rc;
+				resets = <&syscon ASPEED_RESET_RC_MCTP>, <&syscon ASPEED_RESET_DEV_MCTP>;
+				aspeed,scu = <&syscon>;
+				aspeed,pcieh = <&pcie_phy1>;
+				status = "disabled";
+			};
+
 			adc0: adc@1e6e9000 {
 				compatible = "aspeed,ast2600-adc0";
 				reg = <0x1e6e9000 0x100>;
