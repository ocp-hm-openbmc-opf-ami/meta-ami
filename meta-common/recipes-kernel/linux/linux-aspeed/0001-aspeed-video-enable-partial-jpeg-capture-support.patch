+		u32 val, offset;
+		u64 addr;
+
+		regmap_read(video->scu, 0xa8c, &val);
+		addr = (val & ~0xf);
+		addr <<= 4;
+
+		val = readl(video->vga_base + 0x6c);
+		offset |= (val >> 8) & 0xff;
+		offset |= (val & 0xff) << 8;
+
+		val = readl(video->vga_base + 0xac);
+		offset |= (val >> 8) & 0x00ff0000;
+		offset <<= 2;
+		addr |= offset;
+
+		aspeed_video_write(video, VE_TGS_0, _make_addr(addr));
