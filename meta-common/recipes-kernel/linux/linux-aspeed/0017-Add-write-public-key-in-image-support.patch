From 4815cec7d7ca3cc78fec52489cccff080cd01fb3 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 18 Jun 2024 20:37:36 +0530
Subject: [PATCH] Add write public key in image support

---
 arch/arm/boot/dts/openbmc-flash-layout-64.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
index 7af41361c480..60c80dda6b58 100644
--- a/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
+++ b/arch/arm/boot/dts/openbmc-flash-layout-64.dtsi
@@ -24,12 +24,12 @@ kernel@100000 {
 	};
 
 	rofs@a00000 {
-		reg = <0xa00000 0x2000000>; // 32MB
+		reg = <0xa00000 0x2100000>; // 33MB
 		label = "rofs";
 	};
 
-	rwfs@2a00000 {
-		reg = <0x2a00000 0x1600000>; // 22MB
+	rwfs@2b00000 {
+		reg = <0x2b00000 0x1500000>; // 21MB
 		label = "rwfs";
 	};
 };
