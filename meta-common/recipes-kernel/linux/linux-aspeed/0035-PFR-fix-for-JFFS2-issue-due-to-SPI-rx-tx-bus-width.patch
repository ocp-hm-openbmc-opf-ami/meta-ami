From da60ff1d1be7dab1aa0100131f0b3ff1e0a8f5be Mon Sep 17 00:00:00 2001
From: Vasanthakumar K <vasanthakumark@ami.com>
Date: Thu, 27 Jun 2024 16:17:18 +0530
Subject: [PATCH] PFR-fix-for-JFFS2-issue-due-to-SPI-rx-tx-bus-width

Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi b/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
index 78c7d559af29..ae74c23b6510 100644
--- a/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
+++ b/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
@@ -137,7 +137,8 @@ flash@0 {
 		 * SI issue caused by VT on RunBMC Fab1
 		 */
 		spi-max-frequency = <25000000>;
-		spi-rx-bus-width = <4>;
+		spi-rx-bus-width = <2>;
+		spi-tx-bus-width = <2>;
 		m25p,fast-read;
 #include "openbmc-flash-layout-intel-bhs-128MB.dtsi"
 	};
-- 
2.43.2

