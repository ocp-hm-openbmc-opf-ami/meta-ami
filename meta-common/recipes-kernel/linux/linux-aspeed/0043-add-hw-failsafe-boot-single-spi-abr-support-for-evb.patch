From 84b68e98f718cfb86e3e303515ad2ba809c85ca1 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Mon, 21 Oct 2024 20:43:34 +0530
Subject: [PATCH] add hw failsafe boot single spi abr support for evb

---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    |  5 +-
 ...flash-layout-ami-evb-128-singlespiabr.dtsi | 70 +++++++++++++++++++
 2 files changed, 72 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 66ec1229d766..061dcb338eb7 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -184,15 +184,14 @@ flash@0 {
 		label = "bmc";
 		spi-rx-bus-width = <4>;
 		spi-max-frequency = <50000000>;
-#include "openbmc-flash-layout-64.dtsi"
+#include "openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi"
 	};
 	flash@1 {
 		status = "okay";
 		m25p,fast-read;
-		label = "alt-bmc";
+		label = "fmc0:1";
 		spi-rx-bus-width = <4>;
 		spi-max-frequency = <50000000>;
-#include "openbmc-flash-layout-64-alt.dtsi"
 	};
 };
 
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi
new file mode 100644
index 000000000000..7cbe3c16e641
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+//
+// 128MB flash layout: non-redundant image with common RW partition
+//
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0xe0000>; // 896KB
+		label = "u-boot";
+	};
+
+	u-boot-env@e0000 {
+		reg = <0xe0000 0x20000>; // 128KB
+		label = "u-boot-env";
+	};
+
+	kernel@100000 {
+		reg = <0x100000 0x900000>; // 9MB
+		label = "kernel";
+	};
+
+	rofs@a00000 {
+		reg = <0xa00000 0x2000000>; // 32MB
+		label = "rofs";
+	};
+
+	rwfs@2a00000 {
+		reg = <0x2a00000 0x15f0000>; // 22MB
+		label = "rwfs";
+	};
+
+    reserved@3ff0000 {
+        reg = <0x3ff0000 0x10000>; // 64kb
+        label = "reserved";
+    };
+
+    u-boot@4000000 {
+            reg = <0x4000000 0xe0000>; // 896KB
+            label = "alt-u-boot";
+    };
+
+    u-boot-env@40e0000 {
+            reg = <0x40e0000 0x20000>; // 128KB
+            label = "alt-u-boot-env";
+    };
+
+    kernel@4100000 {
+            reg = <0x4100000 0x900000>; // 9MB
+            label = "alt-kernel";
+    };
+
+    rofs@4a00000 {
+            reg = <0x4a00000 0x2000000>; // 32MB
+            label = "alt-rofs";
+    };
+
+    rwfs@6a00000 {
+            reg = <0x6a00000 0x15f0000>; // 9MB
+            label = "alt-rwfs";
+    };
+
+    reserved@7ff0000 {
+        reg = <0x7ff0000 0x10000>; // 64kb
+        label = "alt-reserved";
+    };
+};
\ No newline at end of file
-- 
2.34.1

