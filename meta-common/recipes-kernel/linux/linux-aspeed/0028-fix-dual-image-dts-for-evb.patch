From d8608985a0c9d55ee68a54e89ce2a8625930a4a2 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 18 Jun 2024 20:50:11 +0530
Subject: [PATCH] fix-dual-image-dts-for-evb

---
 arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
index 650525867561..8d453de2c0ba 100644
--- a/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
+++ b/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
@@ -24,12 +24,12 @@ kernel@100000 {
 	};
 
 	rofs@a00000 {
-		reg = <0xa00000 0x2000000>; // 32MB
+		reg = <0xa00000 0x2100000>; // 33MB
 		label = "alt-rofs";
 	};
 
-	rwfs@6000000 {
-		reg = <0x2a00000 0x1600000>; // 22MB
+	rwfs@2b00000 {
+		reg = <0x2b00000 0x1500000>; // 21MB
 		label = "alt-rwfs";
 	};
 };
