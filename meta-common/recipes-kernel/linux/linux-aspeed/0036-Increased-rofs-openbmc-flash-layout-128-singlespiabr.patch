From 110e0f602a618c0b642760666b8ed0ce581342ce Mon Sep 17 00:00:00 2001
From: Santhosh S <santhoshs@ami.com>
Date: Mon, 29 Jul 2024 18:44:32 +0530
Subject: [PATCH] Increased-rwfs-openbmc-flash-layout-128-singlespiabr-dtsi

Signed-off-by: Santhosh S <santhoshs@ami.com>
---
 .../dts/openbmc-flash-layout-128-singlespiabr.dtsi   | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/openbmc-flash-layout-128-singlespiabr.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-128-singlespiabr.dtsi
index d03411a4880d..2157e892b468 100644
--- a/arch/arm/boot/dts/openbmc-flash-layout-128-singlespiabr.dtsi
+++ b/arch/arm/boot/dts/openbmc-flash-layout-128-singlespiabr.dtsi
@@ -24,12 +24,12 @@ kernel@100000 {
 	};
 
 	rofs@a00000 {
-		reg = <0xa00000 0x2100000>; // 33MB
+		reg = <0xa00000 0x2D00000>; // 45MB
 		label = "rofs";
 	};
 
-	rwfs@2b00000 {
-		reg = <0x2b00000 0x1500000>; // 21MB
+	rwfs@3700000 {
+		reg = <0x3700000 0x900000>; // 9MB
 		label = "rwfs";
 	};
 
@@ -49,12 +49,12 @@ kernel@4100000 {
         };
 
         rofs@4a00000 {
-                reg = <0x4a00000 0x2100000>; // 33MB
+                reg = <0x4a00000 0x2D00000>; // 45MB
                 label = "alt-rofs";
         };
 
-        rwfs@6b00000 {
-                reg = <0x6b00000 0x1500000>; // 21MB
+        rwfs@7700000 {
+                reg = <0x7700000 0x900000>; // 9MB
                 label = "alt-rwfs";
         };
 };
-- 
2.34.1

