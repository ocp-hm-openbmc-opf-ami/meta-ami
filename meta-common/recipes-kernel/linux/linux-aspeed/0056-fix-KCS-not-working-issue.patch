From 952e90c9bab4dbf947bd796061b1600d2022e207 Mon Sep 17 00:00:00 2001
From: TimLin <TimLin@ami.com>
Date: Fri, 13 Dec 2024 16:52:05 +0800
Subject: [PATCH] fix KCS not working issue

---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 3998caa2b3a5..4dfc7c914c0d 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -478,3 +478,22 @@ &kcs3 {
         aspeed,lpc-io-reg = <0xCA2>;
         status = "okay";
 };
+
+&lpc {
+    status = "okay";
+};
+
+&lpc_reset {
+        status = "okay";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_lpc_default>;
+};
+
+&lpc_sio {
+        status = "okay";
+};
+
+&lpc_snoop {
+        snoop-ports = <0x80>;
+        status = "okay";
+};
-- 
