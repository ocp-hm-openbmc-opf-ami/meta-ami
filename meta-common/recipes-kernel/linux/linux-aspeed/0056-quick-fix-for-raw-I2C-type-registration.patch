 drivers/i2c/busses/i2c-aspeed.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/i2c/busses/i2c-aspeed.c b/drivers/i2c/busses/i2c-aspeed.c
index ed01622a59f9..eb640f34fdb0 100644
