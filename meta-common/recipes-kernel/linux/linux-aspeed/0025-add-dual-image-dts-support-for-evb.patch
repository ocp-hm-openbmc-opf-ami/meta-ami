From 7c78c6d78a0a8beff3a0677265a660b5b1fd4cf1 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Wed, 31 Jul 2024 23:16:08 +0530
Subject: [PATCH] add dual image dts support for evb

---
 arch/arm/boot/dts/aspeed-ast2600-evb.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
index bdeba984fd2f..8de86991fc15 100644
--- a/arch/arm/boot/dts/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
@@ -365,6 +365,14 @@ flash@0 {
 		spi-max-frequency = <50000000>;
 #include "openbmc-flash-layout-ami-evb-64.dtsi"
 	};
+	flash@1 {
+                status = "okay";
+                m25p,fast-read;
+                label = "alt-bmc";
+                spi-rx-bus-width = <4>;
+                spi-max-frequency = <50000000>;
+#include "openbmc-flash-layout-ami-evb-64-alt.dtsi"
+        };
 };
 
 &spi1 {
