From 62073a21bb8923ea05b39a975525991dadf35ff6 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 17 Dec 2024 19:51:02 +0530
Subject: [PATCH] add dts changes for dual image support for evb

---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    |  8 ++++
 .../openbmc-flash-layout-ami-evb-64-alt.dtsi  | 40 +++++++++++++++++++
 2 files changed, 48 insertions(+)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64-alt.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 3ef9e3cff6a2..de683b5aab77 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -191,6 +191,14 @@ flash@0 {
 		spi-max-frequency = <50000000>;
 #include "openbmc-flash-layout-ami-evb-64.dtsi"
 	};
+	flash@1 {
+		status = "okay";
+		m25p,fast-read;
+		label = "alt-bmc";
+		spi-rx-bus-width = <4>;
+		spi-max-frequency = <50000000>;
+#include "openbmc-flash-layout-ami-evb-64-alt.dtsi"
+	};
 };
 
 &spi1 {
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64-alt.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64-alt.dtsi
new file mode 100644
index 000000000000..776fa1e84743
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-evb-64-alt.dtsi
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2020 Bytedance.
+ */
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0xe0000>; // 896KB
+		label = "alt-u-boot";
+	};
+
+	u-boot-env@e0000 {
+		reg = <0xe0000 0x20000>; // 128KB
+		label = "alt-u-boot-env";
+	};
+
+	kernel@100000 {
+		reg = <0x100000 0x900000>; // 9MB
+		label = "alt-kernel";
+	};
+
+	rofs@a00000 {
+		reg = <0xa00000 0x2D00000>; // 45MB
+		label = "alt-rofs";
+	};
+
+	rwfs@3700000 {
+		reg = <0x3700000 0x8f0000>; // 9MB
+		label = "alt-rwfs";
+	};
+
+    reserved@3ff0000 {
+        reg = <0x3ff0000 0x10000>; // 64kb
+        label = "alt-reserved";
+    };
+};
-- 
2.34.1

