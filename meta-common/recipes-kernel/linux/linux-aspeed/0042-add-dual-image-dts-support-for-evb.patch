From 0ca008e218ff2a531d1a5aea5207ab7c85374920 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Mon, 21 Oct 2024 20:20:04 +0530
Subject: [PATCH] add dual image dts support for evb

---
 arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts           | 8 ++++++++
 arch/arm/boot/dts/aspeed/openbmc-flash-layout-64-alt.dtsi | 7 ++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index de83c0eb1d6e..66ec1229d766 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -186,6 +186,14 @@ flash@0 {
 		spi-max-frequency = <50000000>;
 #include "openbmc-flash-layout-64.dtsi"
 	};
+	flash@1 {
+		status = "okay";
+		m25p,fast-read;
+		label = "alt-bmc";
+		spi-rx-bus-width = <4>;
+		spi-max-frequency = <50000000>;
+#include "openbmc-flash-layout-64-alt.dtsi"
+	};
 };
 
 &spi1 {
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64-alt.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64-alt.dtsi
index 650525867561..3ae2366e8ec2 100644
--- a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64-alt.dtsi
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64-alt.dtsi
@@ -29,7 +29,12 @@ rofs@a00000 {
 	};
 
 	rwfs@6000000 {
-		reg = <0x2a00000 0x1600000>; // 22MB
+		reg = <0x2a00000 0x15f0000>; // 22MB
 		label = "alt-rwfs";
 	};
+
+	reserved@3ff0000 {
+		reg = <0x3ff0000 0x10000>; // 64kb
+		label = "alt-reserved";
+	};
 };
-- 
2.34.1

