From f4a32af1063e2dc9837a808f0ad7e64cd08b12a9 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 22 Oct 2024 18:17:38 +0530
Subject: [PATCH] add hw failsafe boot single spi abr support intel

---
 .../dts/aspeed/aspeed-bmc-intel-ast2600.dts   |  5 +-
 ...c-flash-layout-ami-128mb-singlespiabr.dtsi | 69 +++++++++++++++++++
 2 files changed, 71 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-128mb-singlespiabr.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
index ea56e271b1aa..f67cde2274d2 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
@@ -161,16 +161,15 @@ flash@0 {
 		spi-tx-bus-width = <4>;
 		spi-rx-bus-width = <4>;
 		m25p,fast-read;
-#include "openbmc-flash-layout-ami-64mb.dtsi"
+#include "openbmc-flash-layout-ami-128mb-singlespiabr.dtsi"
 	};
 	flash@1 {
 		status = "okay";
-		label = "alt-bmc";
+		label = "fmc0:1";
 		spi-max-frequency = <50000000>;
 		spi-tx-bus-width = <4>;
 		spi-rx-bus-width = <4>;
 		m25p,fast-read;
-#include "openbmc-flash-layout-ami-64mb-alt.dtsi"
     };
 };
 
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-128mb-singlespiabr.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-128mb-singlespiabr.dtsi
new file mode 100644
index 000000000000..3f8f24aefa86
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-128mb-singlespiabr.dtsi
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0+
+// 128MB flash layout: non-redundant image with common RW partition
+// AMI - Base Technology team
+partitions {
+        compatible = "fixed-partitions";
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        u-boot@0 {
+            reg = <0x0 0x100000>; // 1MB
+            label = "u-boot";
+        };
+
+        fit-image-a@100000 {
+            reg = <0x100000 0x2D00000>; // 45MB
+            label = "image-a";
+        };
+
+        sofs@2E00000 {
+            reg = <0x2E00000 0x500000>; // 5MB
+            label = "sofs";
+        };
+
+        rwfs@3300000 {
+            reg = <0x3300000 0xc00000>; // 12MB
+            label = "rwfs";
+        };
+
+        u-boot-env@3f00000 {
+            reg = <0x3f00000 0xf0000>; // 960KB
+            label = "u-boot-env";
+        };
+
+        reserved@3ff0000 {
+            reg = <0x3ff0000 0x10000>; // 64kb
+            label = "reserved";
+        };
+
+        u-boot@4000000 {
+            reg = <0x4000000 0x100000>; // 1MB
+            label = "alt-u-boot";
+        };
+
+        fit-image-a@4100000 {
+            reg = <0x4100000 0x2D00000>; // 45MB
+            label = "alt-image-a";
+        };
+
+        sofs@6E00000 {
+            reg = <0x6E00000 0x500000>; // 5MB
+            label = "alt-sofs";
+        };
+
+        rwfs@7300000 {
+            reg = <0x7300000 0xc00000>; // 12MB
+            label = "alt-rwfs";
+        };
+
+        u-boot-env@7f00000 {
+            reg = <0x7f00000 0xf0000>; // 960KB
+            label = "alt-u-boot-env";
+        };
+
+        reserved@7ff0000 {
+            reg = <0x7ff0000 0x10000>; // 64kb
+            label = "alt-reserved";
+        };
+
+};
\ No newline at end of file
-- 
2.34.1

