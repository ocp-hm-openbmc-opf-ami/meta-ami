From 7d36bf17f8d43d600394d69447f998cdfcf08b85 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 22 Oct 2024 14:36:20 +0530
Subject: [PATCH] Enable Jtag0 and spidev for spi2 for cpld upgrade via
 spi/jtag interface

---
 .../boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts    | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
index f68cc26ed148..804102272a7b 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
@@ -178,6 +178,15 @@ flash3: flash@0 {
         };
 };
 
+&spi2 {
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_spi2cs1_default>;
+        status = "okay";
+
+        spidev@1 {
+            status = "okay";
+        };
+};
 
 &espi {
 	status = "okay";
@@ -1008,6 +1017,10 @@ &vhub {
 	status = "okay";
 };
 
+&jtag0 {
+	status = "okay";
+};
+
 &jtag1 {
 	status = "okay";
 };
-- 
2.34.1

