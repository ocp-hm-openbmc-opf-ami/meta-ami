From bfe3b80f7f1bb39d89c8e717aae73d1a341c4d11 Mon Sep 17 00:00:00 2001
From: Yaswanth <yaswanthsai@ami.com>
Date: Tue, 29 Oct 2024 19:47:26 +0530
Subject: [PATCH] Fix for PECI and PMBUS Errors

Signed-off-by: Yaswanth <yaswanthsai@ami.com>
---
 drivers/Makefile                 |  1 +
 drivers/hwmon/pmbus/pmbus.h      | 32 +++++++++++++++++---------------
 drivers/hwmon/pmbus/pmbus_core.c |  5 +++++
 drivers/peci-legacy/peci-dev.c   |  2 +-
 drivers/peci/Kconfig             |  1 +
 include/linux/hwmon.h            |  2 +-
 6 files changed, 26 insertions(+), 17 deletions(-)

diff --git a/drivers/Makefile b/drivers/Makefile
index 1bec7819a837..e1a0f44d5e62 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -193,6 +193,7 @@ obj-$(CONFIG_GNSS)		+= gnss/
 obj-$(CONFIG_INTERCONNECT)	+= interconnect/
 obj-$(CONFIG_COUNTER)		+= counter/
 obj-$(CONFIG_MOST)		+= most/
+obj-$(CONFIG_PECI_LEGACY)       += peci-legacy/
 obj-$(CONFIG_PECI)		+= peci/
 obj-$(CONFIG_HTE)		+= hte/
 obj-$(CONFIG_DRM_ACCEL)		+= accel/
diff --git a/drivers/hwmon/pmbus/pmbus.h b/drivers/hwmon/pmbus/pmbus.h
index a57de29223e7..dfcfabf2efa3 100644
--- a/drivers/hwmon/pmbus/pmbus.h
+++ b/drivers/hwmon/pmbus/pmbus.h
@@ -21,6 +21,8 @@ enum pmbus_regs {
 	PMBUS_ON_OFF_CONFIG		= 0x02,
 	PMBUS_CLEAR_FAULTS		= 0x03,
 	PMBUS_PHASE			= 0x04,
+	PMBUS_PAGE_PLUS_WRITE		= 0x05,
+	PMBUS_PAGE_PLUS_READ		= 0x06,
 
 	PMBUS_WRITE_PROTECT		= 0x10,
 
@@ -493,24 +495,24 @@ extern const struct regulator_ops pmbus_regulator_ops;
 		.type = REGULATOR_VOLTAGE,			\
 		.owner = THIS_MODULE,				\
 		.n_voltages = _voltages,			\
-		.uV_step = _step,				\
-		.min_uV = _min_uV,				\
+		.uV_step = _step,                               \
+		.min_uV = _min_uV,                              \
 	}
 
 #define PMBUS_REGULATOR(_name, _id)   PMBUS_REGULATOR_STEP(_name, _id, 0, 0, 0)
 
 #define PMBUS_REGULATOR_STEP_ONE(_name, _voltages, _step, _min_uV)  \
-	{							\
-		.name = (_name),				\
-		.of_match = of_match_ptr(_name),		\
-		.regulators_node = of_match_ptr("regulators"),	\
-		.ops = &pmbus_regulator_ops,			\
-		.type = REGULATOR_VOLTAGE,			\
-		.owner = THIS_MODULE,				\
-		.n_voltages = _voltages,			\
-		.uV_step = _step,				\
-		.min_uV = _min_uV,				\
-	}
+       {                                                       \
+               .name = (_name),                                \
+               .of_match = of_match_ptr(_name),                \
+               .regulators_node = of_match_ptr("regulators"),  \
+               .ops = &pmbus_regulator_ops,                    \
+               .type = REGULATOR_VOLTAGE,                      \
+               .owner = THIS_MODULE,                           \
+               .n_voltages = _voltages,                        \
+               .uV_step = _step,                               \
+               .min_uV = _min_uV,                              \
+       }
 
 #define PMBUS_REGULATOR_ONE(_name)   PMBUS_REGULATOR_STEP_ONE(_name, 0, 0, 0)
 
@@ -539,12 +541,12 @@ int pmbus_do_remove(struct i2c_client *client);
 #endif /* CONFIG_SMART_MODULE */
 const struct pmbus_driver_info *pmbus_get_driver_info(struct i2c_client
 						      *client);
+void pmbus_unlock(struct i2c_client *client);
+int pmbus_lock_interruptible(struct i2c_client *client);
 int pmbus_get_fan_rate_device(struct i2c_client *client, int page, int id,
 			      enum pmbus_fan_mode mode);
 int pmbus_get_fan_rate_cached(struct i2c_client *client, int page, int id,
 			      enum pmbus_fan_mode mode);
-int pmbus_lock_interruptible(struct i2c_client *client);
-void pmbus_unlock(struct i2c_client *client);
 int pmbus_update_fan(struct i2c_client *client, int page, int id,
 		     u8 config, u8 mask, u16 command);
 struct dentry *pmbus_get_debugfs_dir(struct i2c_client *client);
diff --git a/drivers/hwmon/pmbus/pmbus_core.c b/drivers/hwmon/pmbus/pmbus_core.c
index b0ce5ed3c29f..a482701e1dec 100644
--- a/drivers/hwmon/pmbus/pmbus_core.c
+++ b/drivers/hwmon/pmbus/pmbus_core.c
@@ -22,6 +22,11 @@
 #include <linux/of.h>
 #include <linux/thermal.h>
 #include "pmbus.h"
+#ifdef CONFIG_SMART_MODULE
+ #include "smart.h"
+#endif /* CONFIG_SMART_MODULE */
+
+#include <linux/device.h>
 
 /*
  * Number of additional attribute pointers to allocate
diff --git a/drivers/peci-legacy/peci-dev.c b/drivers/peci-legacy/peci-dev.c
index cd820cc06b80..064e7d7e9e8f 100644
--- a/drivers/peci-legacy/peci-dev.c
+++ b/drivers/peci-legacy/peci-dev.c
@@ -316,7 +316,7 @@ static int __init peci_dev_init(void)
 		goto err;
 	}
 
-	peci_dev_class = class_create(THIS_MODULE, KBUILD_MODNAME);
+	peci_dev_class = class_create(KBUILD_MODNAME);
 	if (IS_ERR(peci_dev_class)) {
 		ret = PTR_ERR(peci_dev_class);
 		goto err_unreg_chrdev;
diff --git a/drivers/peci/Kconfig b/drivers/peci/Kconfig
index 89872ad83320..3822467b872a 100644
--- a/drivers/peci/Kconfig
+++ b/drivers/peci/Kconfig
@@ -2,6 +2,7 @@
 
 menuconfig PECI
 	tristate "PECI support"
+	depends on WANT_PECI
 	help
 	  The Platform Environment Control Interface (PECI) is an interface
 	  that provides a communication channel to Intel processors and
diff --git a/include/linux/hwmon.h b/include/linux/hwmon.h
index 769cd233847b..371546c5c4d9 100644
--- a/include/linux/hwmon.h
+++ b/include/linux/hwmon.h
@@ -253,7 +253,7 @@ enum hwmon_power_attributes {
 #define HWMON_P_INPUT_LOWEST		BIT(hwmon_power_input_lowest)
 #define HWMON_P_RESET_HISTORY		BIT(hwmon_power_reset_history)
 #define HWMON_P_ACCURACY		BIT(hwmon_power_accuracy)
-#define HWMON_P_CAPABILITY		BIT(hwmon_power_cap)
+#define HWMON_P_CAPABILITY		BIT(hwmon_power_capability)
 #define HWMON_P_CAP_HYST		BIT(hwmon_power_cap_hyst)
 #define HWMON_P_CAP_MAX			BIT(hwmon_power_cap_max)
 #define HWMON_P_CAP_MIN			BIT(hwmon_power_cap_min)
-- 
