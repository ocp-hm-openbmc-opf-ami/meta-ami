From 0cafd04df1f80cb04c794b8e0950e548fb0e5546 Mon Sep 17 00:00:00 2001
From: Jason Messer <jasonm@ami.com>
Date: Tue, 10 Dec 2024 17:47:08 +0000
Subject: [PATCH] pfr bhs 128mb bmc flash layout

---
 .../boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi |  4 +-
 .../openbmc-flash-layout-ami-bhs-128MB.dtsi   | 59 +++++++++++++++++++
 2 files changed, 61 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-128MB.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
index d6e55a423c63..faf3c2925307 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
@@ -144,9 +144,9 @@ flash@0 {
 		 */
 		spi-max-frequency = <25000000>;
 		spi-rx-bus-width = <2>;
-		spi-tx-bus-width = <2>;
+		spi-tx-bus-width = <1>;
 		m25p,fast-read;
-#include "openbmc-flash-layout-ami-64mb.dtsi"
+#include "openbmc-flash-layout-ami-bhs-128MB.dtsi"
 	};
 };
 
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-128MB.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-128MB.dtsi
new file mode 100644
index 000000000000..a0b12ab55cdf
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-128MB.dtsi
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0+
+// 128MB flash layout: PFR (active + recovery + staging + extra)
+// 
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0x100000>;
+		label = "u-boot";
+	};
+
+	pfm@100000 {
+		reg = <0x100000 0x20000>;
+		label = "pfm";
+	};
+
+	u-boot-env@120000 {
+		reg = <0x120000 0x20000>;
+		label = "u-boot-env";
+	};
+
+	sofs@140000 {
+		reg = <0x140000 0x200000>;
+		label = "sofs";
+	};
+
+	rwfs@340000 {
+		reg = <0x340000 0x540000>; //5.25MB
+		label = "rwfs";
+	};
+
+	fit-image-a@880000 {
+		reg = <0x880000 0x2680000>; //38.5MB
+		label = "image-a";
+	};
+
+	rc-image@2f00000 {
+		reg = <0x2f00000 0x2500000>; //37MB
+		label = "rc-image";
+	};
+
+	image-staging@5400000 {
+		reg = <0x5400000 0x2a80000>;
+		label = "image-stg";
+	};
+
+	reserved@7e80000 {
+		reg = <0x7e80000 0x80000>;
+		label = "rsvrd";
+	};
+
+	cpld-gold@7f00000 {
+		reg = <0x7f00000 0x100000>;
+		label = "cpld-gold";
+	};
+};
-- 
2.44.0

