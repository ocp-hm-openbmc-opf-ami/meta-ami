From 4b5af2d39dab1a507d46e6df51a5b006cde5c381 Mon Sep 17 00:00:00 2001
From: Santhosh S <santhoshs@ami.com>
Date: Mon, 29 Jul 2024 18:49:11 +0530
Subject: [PATCH] Increased-rwfs-openbmc-flash-layout-64-alt-dtsi

Signed-off-by: Santhosh S <santhoshs@ami.com>
---
 arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
index 140b9c3c2440..f69db8b4b22d 100644
--- a/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
+++ b/arch/arm/boot/dts/openbmc-flash-layout-64-alt.dtsi
@@ -24,12 +24,12 @@ kernel@100000 {
 	};
 
 	rofs@a00000 {
-		reg = <0xa00000 0x2100000>; // 33MB
+		reg = <0xa00000 0x2D00000>; // 45MB
 		label = "alt-rofs";
 	};
 
-	rwfs@2b00000 {
-		reg = <0x2b00000 0x1500000>; // 21MB
+	rwfs@3700000 {
+		reg = <0x3700000 0x900000>; // 9MB
 		label = "alt-rwfs";
 	};
 };
-- 
2.34.1

