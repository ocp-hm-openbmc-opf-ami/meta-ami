From 62979b46e5c852988c3eabcaa6c45cb32d5c535a Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 22 Oct 2024 17:04:59 +0530
Subject: [PATCH] Added dts configuration for dual image support for intel
 platforms

---
 .../dts/aspeed/aspeed-bmc-intel-ast2600.dts   | 10 +++++
 .../openbmc-flash-layout-ami-64mb-alt.dtsi    | 38 +++++++++++++++++++
 2 files changed, 48 insertions(+)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb-alt.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
index f68cc26ed148..ea56e271b1aa 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-ast2600.dts
@@ -156,12 +156,22 @@ &fmc {
 	status = "okay";
 	flash@0 {
 		status = "okay";
+		label = "bmc";
 		spi-max-frequency = <50000000>;
 		spi-tx-bus-width = <4>;
 		spi-rx-bus-width = <4>;
 		m25p,fast-read;
 #include "openbmc-flash-layout-ami-64mb.dtsi"
 	};
+	flash@1 {
+		status = "okay";
+		label = "alt-bmc";
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+		m25p,fast-read;
+#include "openbmc-flash-layout-ami-64mb-alt.dtsi"
+    };
 };
 
 &spi1 {
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb-alt.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb-alt.dtsi
new file mode 100644
index 000000000000..50832eb2d50e
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb-alt.dtsi
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0+
+// 64MB flash layout: non-redundant image with common RW partition
+// AMI - Base Technology team
+partitions {
+        compatible = "fixed-partitions";
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        u-boot@0 {
+                reg = <0x0 0x100000>; // 1MB
+                label = "alt-u-boot";
+        };
+
+        fit-image-a@100000 {
+                reg = <0x100000 0x2D00000>; // 45MB
+                label = "alt-image-a";
+        };
+
+        sofs@2E00000 {
+                reg = <0x2E00000 0x500000>; // 5MB
+                label = "alt-sofs";
+        };
+
+        rwfs@3300000 {
+                reg = <0x3300000 0xc00000>; // 12MB
+                label = "alt-rwfs";
+        };
+
+        u-boot-env@3f00000 {
+                reg = <0x3f00000 0xf0000>; // 960KB
+                label = "alt-u-boot-env";
+        };
+
+        reserved@3ff0000 {
+                reg = <0x3ff0000 0x10000>; // 64kb
+                label = "alt-reserved";
+        };
+};
-- 
