From 08f1c6f23527c7fb85052ec67651c4f9e63e3f97 Mon Sep 17 00:00:00 2001
From: mickhuang <mickhuang@ami.com>
Date: Wed, 11 Dec 2024 13:49:12 +0800
Subject: [PATCH] Enable USB Port B as gadget device

- Disable EHCI and UHCI node in dts.
- Enable UDC node in dts.

Signed-off-by: mickhuang <mickhuang@ami.com>
---
 arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index 3998caa2b3a5..7bc9267d77c0 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -359,10 +359,14 @@ &fsim0 {
 };
 
 &ehci1 {
-	status = "okay";
+	status = "disabled";
 };
 
 &uhci {
+	status = "disabled";
+};
+
+&udc {
 	status = "okay";
 };
 
-- 
2.34.1

