From 2384209bbcd8cb6a5567f0d2d9462df80973976d Mon Sep 17 00:00:00 2001
From: Jason Messer <jasonm@ami.com>
Date: Tue, 10 Dec 2024 17:26:04 +0000
Subject: [PATCH] pfr bhs 256mb bmc flash layout

---
 .../boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi |  4 +-
 .../openbmc-flash-layout-ami-bhs-256MB.dtsi   | 59 +++++++++++++++++++
 2 files changed, 61 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-256MB.dtsi

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
index d6e55a423c63..0230eaa97638 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-intel-bhs.dtsi
@@ -144,9 +144,9 @@ flash@0 {
 		 */
 		spi-max-frequency = <25000000>;
 		spi-rx-bus-width = <2>;
-		spi-tx-bus-width = <2>;
+		spi-tx-bus-width = <1>;
 		m25p,fast-read;
-#include "openbmc-flash-layout-ami-64mb.dtsi"
+#include "openbmc-flash-layout-ami-bhs-256MB.dtsi"
 	};
 };
 
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-256MB.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-256MB.dtsi
new file mode 100644
index 000000000000..0f25bd17d53d
--- /dev/null
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-bhs-256MB.dtsi
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0+
+// 256MB flash layout: PFR (active + recovery + staging + extra)
+// 
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0x100000>;
+		label = "u-boot";
+	};
+
+	pfm@100000 {
+		reg = <0x100000 0x20000>;
+		label = "pfm";
+	};
+
+	u-boot-env@120000 {
+		reg = <0x120000 0x20000>;
+		label = "u-boot-env";
+	};
+
+	sofs@140000 {
+		reg = <0x140000 0x200000>;
+		label = "sofs";
+	};
+
+	rwfs@340000 {
+		reg = <0x340000 0x840000>;
+		label = "rwfs";
+	};
+
+	fit-image-a@b80000 {
+		reg = <0xb80000 0x3480000>;
+		label = "image-a";
+	};
+
+	rc-image@4a00000 {
+		reg = <0x4a00000 0x4000000>;
+		label = "rc-image";
+	};
+
+	image-staging@8a00000 {
+		reg = <0x8a00000 0x4480000>;
+		label = "image-stg";
+	};
+
+	reserved@ce80000 {
+		reg = <0xce80000 0x80000>;
+		label = "rsvrd";
+	};
+
+	cpld-gold@cf00000 {
+		reg = <0xcf00000 0x100000>;
+		label = "cpld-gold";
+	};
+};
-- 
2.44.0

