From facb41f79a70254fca577464b9a4c879d13be268 Mon Sep 17 00:00:00 2001
From: Vasanthakumar K <vasanthakumark@ami.com>
Date: Thu, 27 Jun 2024 16:48:20 +0530
Subject: [PATCH] Fix-for-JFFS2-issue-due-to-SPI-rx-tx-bus-width

Signed-off-by: Vasanthakumar K <vasanthakumark@ami.com>
---
 arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi b/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
index bf5cab5ae8bc..6e110d88890a 100644
--- a/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
+++ b/arch/arm/boot/dts/aspeed-bmc-intel-bhs.dtsi
@@ -137,7 +137,8 @@ flash@0 {
 		 * SI issue caused by VT on RunBMC Fab1
 		 */
 		spi-max-frequency = <25000000>;
-		spi-rx-bus-width = <4>;
+		spi-rx-bus-width = <2>;
+		spi-tx-bus-width = <2>;
 		m25p,fast-read;
 #include "openbmc-flash-layout-ami-64mb.dtsi"
 	};
-- 
2.43.2

