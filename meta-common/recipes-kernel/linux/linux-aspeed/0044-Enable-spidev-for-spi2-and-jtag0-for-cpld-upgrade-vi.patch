From 0b0781ba6ca7096f7c45609e8d0935e3b5aa2f1a Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 22 Oct 2024 12:06:07 +0530
Subject: [PATCH] Enable spidev for spi2 and jtag0 for cpld upgrade via
 spi/jtag interface

---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index de83c0eb1d6e..813f1a9240c5 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -120,6 +120,14 @@ ethphy3: ethernet-phy@0 {
 	};
 };
 
+&jtag0 {
+    status = "okay";
+};
+
+&jtag1 {
+    status = "okay";
+};
+
 &mac0 {
 	status = "okay";
 
@@ -202,6 +210,24 @@ flash@0 {
 	};
 };
 
+&spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_spi2_default &pinctrl_spi2cs1_default
+				&pinctrl_spi2cs2_default &pinctrl_qspi2_default>;
+	status = "okay";
+	spidev@0 {
+			status = "okay";
+	};
+
+	spidev@1 {
+			status = "okay";
+	};
+
+	spidev@2 {
+			status = "okay";
+	};
+};
+
 &uart5 {
 	// Workaround for A0
 	compatible = "snps,dw-apb-uart";
-- 
2.34.1

