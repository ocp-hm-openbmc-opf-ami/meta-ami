From e740ee4310dc124a162e2f1471a720e5fd403e07 Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Thu, 14 Nov 2024 16:12:18 +0800
Subject: [PATCH] Implement Netlink for NCSI Flow Control

---
 include/uapi/linux/ncsi.h |  2 +-
 net/ncsi/ncsi-cmd.c       |  5 +----
 net/ncsi/ncsi-netlink.c   | 17 +++++++++++++++--
 net/ncsi/ncsi-rsp.c       |  2 --
 4 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/include/uapi/linux/ncsi.h b/include/uapi/linux/ncsi.h
index a3f87c54fdb3..1771489a6cd1 100644
--- a/include/uapi/linux/ncsi.h
+++ b/include/uapi/linux/ncsi.h
@@ -128,7 +128,7 @@ enum ncsi_nl_channel_attrs {
 	NCSI_CHANNEL_ATTR_FORCED,
 	NCSI_CHANNEL_ATTR_VLAN_LIST,
 	NCSI_CHANNEL_ATTR_VLAN_ID,
-
+	NCSI_CHANNEL_ATTR_FC,
 	__NCSI_CHANNEL_ATTR_AFTER_LAST,
 	NCSI_CHANNEL_ATTR_MAX = __NCSI_CHANNEL_ATTR_AFTER_LAST - 1
 };
diff --git a/net/ncsi/ncsi-cmd.c b/net/ncsi/ncsi-cmd.c
index 92bf62500a15..ea2b296fa1fc 100644
--- a/net/ncsi/ncsi-cmd.c
+++ b/net/ncsi/ncsi-cmd.c
@@ -325,10 +325,7 @@ int ncsi_xmit_cmd(struct ncsi_cmd_arg *nca)
 	int i, ret;
 
 	/* Use OEM generic handler for Netlink request */
-	if (nca->req_flags == NCSI_REQ_FLAG_NETLINK_DRIVEN)
-		type = NCSI_PKT_CMD_OEM;
-	else
-		type = nca->type;
+	type = nca->type;
 
 	/* Search for the handler */
 	for (i = 0; i < ARRAY_SIZE(ncsi_cmd_handlers); i++) {
diff --git a/net/ncsi/ncsi-netlink.c b/net/ncsi/ncsi-netlink.c
index 48378ea779a4..053ac42eb4fa 100644
--- a/net/ncsi/ncsi-netlink.c
+++ b/net/ncsi/ncsi-netlink.c
@@ -59,13 +59,15 @@ static int ncsi_write_channel_info(struct sk_buff *skb,
 				   struct ncsi_channel *nc)
 {
 	struct ncsi_channel_vlan_filter *ncf;
-	struct ncsi_channel_mode *m;
+	struct ncsi_channel_mode *m,*fc;
 	struct nlattr *vid_nest;
 	int i;
 
 	nla_put_u32(skb, NCSI_CHANNEL_ATTR_ID, nc->id);
 	m = &nc->modes[NCSI_MODE_LINK];
 	nla_put_u32(skb, NCSI_CHANNEL_ATTR_LINK_STATE, m->data[2]);
+	fc = &nc->modes[NCSI_MODE_FC];
+	nla_put_u32(skb, NCSI_CHANNEL_ATTR_FC, fc->data[0]);
 	if (nc->state == NCSI_CHANNEL_ACTIVE)
 		nla_put_flag(skb, NCSI_CHANNEL_ATTR_ACTIVE);
 	if (nc == nc->package->preferred_channel)
@@ -462,7 +464,18 @@ static int ncsi_send_cmd_nl(struct sk_buff *msg, struct genl_info *info)
 	nca.req_flags = NCSI_REQ_FLAG_NETLINK_DRIVEN;
 	nca.info = info;
 	nca.payload = ntohs(hdr->length);
-	nca.data = data + sizeof(*hdr);
+	switch (hdr->type) {
+		case NCSI_PKT_CMD_SNFC:
+			data += 16;
+			nca.bytes[0] = *data;
+			break;
+		case NCSI_PKT_CMD_OEM:
+			nca.data = data + sizeof(*hdr);
+			break;
+		default:
+			netdev_err(ndp->ndev.dev, "NCSI: %s: %d Error %02x sending command\n", __FILE__, __LINE__, hdr->type);
+			break;
+	}
 
 	ret = ncsi_xmit_cmd(&nca);
 out_netlink:
diff --git a/net/ncsi/ncsi-rsp.c b/net/ncsi/ncsi-rsp.c
index 79ad4170b9aa..edd00bfa4371 100644
--- a/net/ncsi/ncsi-rsp.c
+++ b/net/ncsi/ncsi-rsp.c
@@ -618,8 +618,6 @@ static int ncsi_rsp_handler_snfc(struct ncsi_request *nr)
 
 	/* Check if flow control has been enabled */
 	ncm = &nc->modes[NCSI_MODE_FC];
-	if (ncm->enable)
-		return 0;
 
 	/* Update to flow control mode */
 	cmd = (struct ncsi_cmd_snfc_pkt *)skb_network_header(nr->cmd);
-- 
2.34.1


