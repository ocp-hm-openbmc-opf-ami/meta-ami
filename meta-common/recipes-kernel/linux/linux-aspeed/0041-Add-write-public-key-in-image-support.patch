From 5a8aa04110da8e0c7189762292917edc227a8e44 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Thu, 17 Oct 2024 22:47:02 +0530
Subject: [PATCH] Add write public key in image support

---
 arch/arm/boot/dts/aspeed/openbmc-flash-layout-64.dtsi      | 7 ++++++-
 .../arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb.dtsi | 4 ++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64.dtsi
index 7af41361c480..96d8b411dc37 100644
--- a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64.dtsi
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-64.dtsi
@@ -29,7 +29,12 @@ rofs@a00000 {
 	};
 
 	rwfs@2a00000 {
-		reg = <0x2a00000 0x1600000>; // 22MB
+		reg = <0x2a00000 0x15f0000>; // 22MB
 		label = "rwfs";
 	};
+
+	reserved@3ff0000 {
+		reg = <0x3ff0000 0x10000>; // 64kb
+		label = "reserved";
+	};
 };
diff --git a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb.dtsi b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb.dtsi
index 92abfca908ce..ad7bade4c74f 100644
--- a/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb.dtsi
+++ b/arch/arm/boot/dts/aspeed/openbmc-flash-layout-ami-64mb.dtsi
@@ -31,4 +31,8 @@ u-boot-env@3f00000 {
                 label = "u-boot-env";
         };
 
+        reserved@3ff0000 {
+                reg = <0x3ff0000 0x10000>; // 64kb
+                label = "reserved";
+        };
 };
-- 
2.34.1

