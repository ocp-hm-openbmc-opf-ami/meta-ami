From bab355035c4872da10514b9297c3f2fb13e76274 Mon Sep 17 00:00:00 2001
From: MingLunChang <minglunchang@ami.com>
Date: Thu, 11 Jul 2024 18:14:15 +0800
Subject: [PATCH] Fix peci for ASPEED MCTP over PCIe driver

---
 drivers/peci-legacy/busses/peci-mctp.c | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/drivers/peci-legacy/busses/peci-mctp.c b/drivers/peci-legacy/busses/peci-mctp.c
index 575d746e86e2..6371faf5662b 100644
--- a/drivers/peci-legacy/busses/peci-mctp.c
+++ b/drivers/peci-legacy/busses/peci-mctp.c
@@ -296,8 +296,7 @@ static void mctp_peci_cpu_discovery(struct peci_adapter *adapter)
 			for (domain_id = 0; domain_id < DOMAIN_OFFSET_MAX; domain_id++) {
 
 				ret = aspeed_mctp_get_eid(priv->peci_client,
-							  cpu.bdf, domain_id, node_id,
-							  &cpu.eid);
+							  cpu.bdf, domain_id, &cpu.eid);
 
 				/* No entries for specific BDF/domain_Id. */
 				if (ret)
@@ -376,21 +375,20 @@ mctp_peci_xfer(struct peci_adapter *adapter, struct peci_xfer_msg *msg)
 	return 0;
 }
 
-static void mctp_peci_on_segment_change(void *user_data)
-{
-	struct mctp_peci *priv = (struct mctp_peci *)(user_data);
+// static void mctp_peci_on_segment_change(void *user_data)
+// {
+// 	struct mctp_peci *priv = (struct mctp_peci *)(user_data);
 
-	dev_dbg(priv->dev, "Segmentation changed");
-	priv->is_discovery_done = false;
-}
+// 	dev_dbg(priv->dev, "Segmentation changed");
+// 	priv->is_discovery_done = false;
+// }
 
 static int mctp_peci_init_peci_client(struct mctp_peci *priv)
 {
 	struct device *parent = priv->dev->parent;
 	int ret;
 
-	priv->peci_client = aspeed_mctp_create_client
-		(dev_get_drvdata(parent), priv, mctp_peci_on_segment_change);
+	priv->peci_client = aspeed_mctp_create_client(dev_get_drvdata(parent));
 	if (IS_ERR(priv->peci_client))
 		return -ENOMEM;
 
