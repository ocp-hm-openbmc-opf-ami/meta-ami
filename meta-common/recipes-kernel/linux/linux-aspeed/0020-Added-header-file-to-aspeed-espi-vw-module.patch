From c53d9b0b191097a0181b11e8a868528ad9861c3e Mon Sep 17 00:00:00 2001
From: saikumaru <saikumaru@ami.com>
Date: Mon, 30 Sep 2024 15:53:48 +0530
Subject: [PATCH] Added header file to aspeed espi vw module

Signed-off-by: saikumaru <saikumaru@ami.com>
---
 drivers/gpio/gpio-aspeed-espi-vw.c        | 2 ++
 drivers/soc/aspeed/aspeed-vga-sharedmem.c | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/gpio/gpio-aspeed-espi-vw.c b/drivers/gpio/gpio-aspeed-espi-vw.c
index 418dc7266662..9433547b82de 100644
--- a/drivers/gpio/gpio-aspeed-espi-vw.c
+++ b/drivers/gpio/gpio-aspeed-espi-vw.c
@@ -9,6 +9,8 @@
 #include <linux/workqueue.h>
 #include <linux/timer.h>
 
+#include <linux/gpio/driver.h>
+
 #include <linux/mfd/syscon.h>
 #include <linux/soc/aspeed/aspeed-espi.h>
 
diff --git a/drivers/soc/aspeed/aspeed-vga-sharedmem.c b/drivers/soc/aspeed/aspeed-vga-sharedmem.c
index cd1f5431378c..3214d08783dd 100644
--- a/drivers/soc/aspeed/aspeed-vga-sharedmem.c
+++ b/drivers/soc/aspeed/aspeed-vga-sharedmem.c
@@ -45,7 +45,8 @@ static int vga_mmap(struct file *file, struct vm_area_struct *vma)
 	if (!capable(CAP_SYS_ADMIN))
 		return -EPERM;
 
-	vma->vm_flags = (vma->vm_flags & (~VM_WRITE));
+//	vma->vm_flags = (vma->vm_flags & (~VM_WRITE));
+	vm_flags_set(vma, VM_WRITE);
 	remap_pfn_range(vma, vma->vm_start, vga_sharedmem->addr >> PAGE_SHIFT,
 			vga_sharedmem->size, vma->vm_page_prot);
 	return 0;
-- 
