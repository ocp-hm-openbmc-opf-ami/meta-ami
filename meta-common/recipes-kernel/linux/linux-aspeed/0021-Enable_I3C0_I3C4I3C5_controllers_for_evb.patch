From 5742093872d8400ce9d47dfeb734220852e3b305 Mon Sep 17 00:00:00 2001
From: desmondwu <desmondwu@ami.com>
Date: Thu, 31 Oct 2024 17:39:31 +0800
Subject: [PATCH] Enable I3C0 ,I3C4,I3C5 controllers Enable I3C0 ,I3C$,I3C5
 controller for AST2600 EVB.

---
 .../boot/dts/aspeed/aspeed-ast2600-evb.dts    | 41 ++++++++++++++++---
 1 file changed, 35 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
index de83c0eb1d6e..3b4810107698 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-ast2600-evb.dts
@@ -207,19 +207,48 @@ &uart5 {
 	compatible = "snps,dw-apb-uart";
 };
 
-&i2c0 {
-	status = "okay";
+#define JESD300_SPD_I3C_MODE(bus, index, addr) \
+spd_ ## bus ## _ ## index: spd@addr,4cc5118 ## index ## 000 { \
+        reg = <0x ## addr 0x4cc 0x5118 ## index ## 000>; \
+        assigned-address = <0x ## addr>; \
+        dcr = /bits/ 8 <0xda>; \
+        bcr = /bits/ 8 <0x6>; \
+}
+
+#include <dt-bindings/i3c/i3c.h>
+
+&i3c0 { 
+        status = "okay";
+        bus-context = /bits/ 8 <I3C_BUS_CONTEXT_JESD403>;
+        /* Renesas IMX3102 multiplexer w/ thermal sensor */
+        imx3102_0: i3cmux@f,4cc31020000 {
+                reg = <0xf 0x4cc 0x31020000>;
+                assigned-address = <0xf>;
+                dcr = /bits/ 8 <0xd1>;
+                bcr = /bits/ 8 <0x6>;
+        };
+
+        JESD300_SPD_I3C_MODE(0, 0, 50);
+        JESD300_SPD_I3C_MODE(0, 1, 51);
 };
 
-&i2c1 {
-	status = "okay";
+&i3c4 {
+        initial-role = "target";
+        pid = <0x000007ec 0x05034000>;
+        dcr = /bits/ 8 <0xcc>;
+        status = "okay";
+};
+
+&i3c5 {
+        initial-role = "primary";
+        status = "okay";
 };
 
-&i2c2 {
+&i2c0 {
 	status = "okay";
 };
 
-&i2c3 {
+&i2c1 {
 	status = "okay";
 };
 
-- 
2.41.0

