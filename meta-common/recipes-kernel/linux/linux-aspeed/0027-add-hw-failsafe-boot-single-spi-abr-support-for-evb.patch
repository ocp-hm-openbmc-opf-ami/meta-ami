From f4f79d27592dbf3859f8a90b0af61d45a0e667d7 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Thu, 1 Aug 2024 11:01:30 +0530
Subject: [PATCH] add hw failsafe boot single spi abr support for evb

---
 arch/arm/boot/dts/aspeed-ast2600-evb.dts      |  5 +-
 ...flash-layout-ami-evb-128-singlespiabr.dtsi | 70 +++++++++++++++++++
 2 files changed, 72 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm/boot/dts/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi

diff --git a/arch/arm/boot/dts/aspeed-ast2600-evb.dts b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
index 8de86991fc15..15bae0284150 100644
--- a/arch/arm/boot/dts/aspeed-ast2600-evb.dts
+++ b/arch/arm/boot/dts/aspeed-ast2600-evb.dts
@@ -363,15 +363,14 @@ flash@0 {
 		label = "bmc";
 		spi-rx-bus-width = <4>;
 		spi-max-frequency = <50000000>;
-#include "openbmc-flash-layout-ami-evb-64.dtsi"
+#include "openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi"
 	};
 	flash@1 {
                 status = "okay";
                 m25p,fast-read;
-                label = "alt-bmc";
+                label = "fmc0:1";
                 spi-rx-bus-width = <4>;
                 spi-max-frequency = <50000000>;
-#include "openbmc-flash-layout-ami-evb-64-alt.dtsi"
         };
 };
 
diff --git a/arch/arm/boot/dts/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi b/arch/arm/boot/dts/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi
new file mode 100644
index 000000000000..1b49ad0d8911
--- /dev/null
+++ b/arch/arm/boot/dts/openbmc-flash-layout-ami-evb-128-singlespiabr.dtsi
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0+
+//
+// 128MB flash layout: non-redundant image with common RW partition
+//
+
+partitions {
+	compatible = "fixed-partitions";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	u-boot@0 {
+		reg = <0x0 0xe0000>; // 896KB
+		label = "u-boot";
+	};
+
+	u-boot-env@e0000 {
+		reg = <0xe0000 0x20000>; // 128KB
+		label = "u-boot-env";
+	};
+
+	kernel@100000 {
+		reg = <0x100000 0x900000>; // 9MB
+		label = "kernel";
+	};
+
+	rofs@a00000 {
+		reg = <0xa00000 0x2D00000>; // 45MB
+		label = "rofs";
+	};
+
+ 	rwfs@3700000 {
+		reg = <0x3700000 0x8f0000>; // 9MB
+		label = "rwfs";
+   };
+
+        reserved@3ff0000 {
+            reg = <0x3ff0000 0x10000>; // 64kb
+            label = "reserved";
+        };
+
+        u-boot@4000000 {
+                reg = <0x4000000 0xe0000>; // 896KB
+                label = "alt-u-boot";
+        };
+
+        u-boot-env@40e0000 {
+                reg = <0x40e0000 0x20000>; // 128KB
+                label = "alt-u-boot-env";
+        };
+
+        kernel@4100000 {
+                reg = <0x4100000 0x900000>; // 9MB
+                label = "alt-kernel";
+        };
+
+        rofs@4a00000 {
+                reg = <0x4a00000 0x2D00000>; // 45MB
+                label = "alt-rofs";
+        };
+
+        rwfs@7700000 {
+                reg = <0x7700000 0x8f0000>; // 9MB
+                label = "alt-rwfs";
+        };
+
+        reserved@7ff0000 {
+            reg = <0x7ff0000 0x10000>; // 64kb
+            label = "alt-reserved";
+        };
+};
\ No newline at end of file
-- 
2.34.1

