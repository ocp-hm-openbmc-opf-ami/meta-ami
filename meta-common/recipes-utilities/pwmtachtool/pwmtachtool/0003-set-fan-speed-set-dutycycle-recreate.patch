From: Minal Upadhye <minalsunilu@ami.com>
Date: Tue, 8 Sep 2026 12:18:14 +0000
Subject: [PATCH] set fan speed set dutycycle recreate

Recreate patch in git format-patch style
Original patch used diff format

Signed-off-by: Minal Upadhye <minalsunilu@ami.com>
Upstream-Status: Inappropriate [AMI specific change]
---
 pwmtach.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/pwmtach.c b/pwmtach.c
index edb3516..3f53e6d 100644
--- a/pwmtach.c
+++ b/pwmtach.c
@@ -88,6 +88,9 @@ static int SET_PWM_DUTYCYCLE_VALUE ( pwmtach_ioctl_data  *ppwmtach_arg )
 		printf("%s: Error write dutycycle value %d to pwm %d\n",__FUNCTION__,dutycycle_value,ppwmtach_arg->pwmnumber);
 		retval = -1;
 	}
+	/* restore to dutycycle from dutycycle_value */
+	ppwmtach_arg->dutycycle = (dutycycle_value * 100)/255; 
+	
 	(void)sigwrap_close(fd);
 
 	return retval;
@@ -113,7 +116,7 @@ static int SET_PWM_DUTYCYCLE ( pwmtach_ioctl_data  *ppwmtach_arg)
 static int GET_PWM_DUTYCYCLE ( pwmtach_ioctl_data  *ppwmtach_arg )
 {
 	int retval = 0;
-	int fd;
+    int fd, dutycycle;
 	char duty_num[5];
 
 	retval = pwmtach_directory_check();
@@ -133,7 +136,8 @@ static int GET_PWM_DUTYCYCLE ( pwmtach_ioctl_data  *ppwmtach_arg )
 		return fd;
 	}
 	read(fd, duty_num, 5);
-	ppwmtach_arg->dutycycle = atoi(duty_num);
+    dutycycle = atoi(duty_num);
+	ppwmtach_arg->dutycycle = dutycycle * 100 / 255;
 	printf("%s:dutycycle value %d to pwm %d\n",__FUNCTION__,ppwmtach_arg->dutycycle,ppwmtach_arg->pwmnumber);
 	(void)sigwrap_close(fd);
 
@@ -216,10 +220,10 @@ static int pwmtach_action(  pwmtach_ioctl_data* argp, int command )
 	switch(command)
 	{
 		case SET_DUTY_CYCLE_BY_PWM_CHANNEL:
+		case SET_DUTY_CYCLE:
 			retval = SET_PWM_DUTYCYCLE(argp);
 			break;
 		case SET_DUTY_CYCLE_VALUE_BY_PWM_CHANNEL:
-		case SET_DUTY_CYCLE:
 			retval = SET_PWM_DUTYCYCLE_VALUE(argp);
 			break;
 		case GET_TACH_VALUE_BY_TACH_CHANNEL:
