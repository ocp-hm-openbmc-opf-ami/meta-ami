From 07ab2b491220a0c6fe09cbbc7f79069e799e5a74 Mon Sep 17 00:00:00 2001
From: revathir <revathir@ami.com>
Date: Tue, 24 Feb 2026 11:09:32 +0000
Subject: [PATCH 5/5] Fix to reduce systemd-networkd-wait-online.service time

Upstream-Status: Pending
---
 src/network/wait-online/manager.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/network/wait-online/manager.c b/src/network/wait-online/manager.c
index 40a9fba0a9..74b0f7e168 100644
--- a/src/network/wait-online/manager.c
+++ b/src/network/wait-online/manager.c
@@ -41,6 +41,10 @@ static bool manager_ignore_link(Manager *m, Link *link) {
         if (!link->required_for_online)
                 return true;
 
+        /* ignore interfaces without carrier (no cable connected) */
+        if (!(link->flags & IFF_LOWER_UP))
+                return true;
+
         /* ignore interfaces we explicitly are asked to ignore */
         if (strv_fnmatch(m->ignored_interfaces, link->ifname))
                 return true;
