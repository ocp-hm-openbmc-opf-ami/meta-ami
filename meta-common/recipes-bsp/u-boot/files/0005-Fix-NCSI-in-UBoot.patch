From 3ec1e66df8522b41f2723287fed444729e4a2d97 Mon Sep 17 00:00:00 2001
From: Ethan Wei <ethanwei@ami.com>
Date: Wed, 31 Jul 2024 11:42:49 +0800
Subject: [PATCH] Fix NCSI in UBoot

Upstream-Status: Inappropriate [AMI: driver changes]

---
 drivers/net/ftgmac100.c | 16 ++++++++++++++++
 drivers/net/phy/ncsi.c  |  3 +++
 net/net.c               | 31 ++++++++++++++++++++++++-------
 3 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ftgmac100.c b/drivers/net/ftgmac100.c
index 20fe23d0b1..f9f1b1603e 100644
--- a/drivers/net/ftgmac100.c
+++ b/drivers/net/ftgmac100.c
@@ -26,6 +26,16 @@
 #include "ftgmac100.h"
 #include "aspeed_mdio.h"
 
+#include <stdio.h>
+
+#include <linux/kernel.h>
+#include <linux/list.h>
+
+#ifdef CONFIG_PHY_NCSI
+extern char ncsi_interface_list[16][16] ;
+extern unsigned int ncsi_ifindex;
+#endif
+
 /* Min frame ethernet frame size without FCS */
 #define ETH_ZLEN			60
 
@@ -721,6 +731,12 @@ static int ftgmac100_probe(struct udevice *dev)
 		}
 
 		printf("%s - NCSI detected\n", __func__);
+#ifdef CONFIG_PHY_NCSI               
+	       	memset(ncsi_interface_list[ncsi_ifindex], 0, sizeof(ncsi_interface_list[ncsi_ifindex]));
+                snprintf(ncsi_interface_list[ncsi_ifindex], sizeof(ncsi_interface_list[ncsi_ifindex]), "%s", dev->name);
+                ncsi_ifindex++;
+#endif
+
 	} else {
 		ret = ftgmac100_mdio_init(dev);
 		if (ret) {
diff --git a/drivers/net/phy/ncsi.c b/drivers/net/phy/ncsi.c
index 2496c90748..54023fb1aa 100644
--- a/drivers/net/phy/ncsi.c
+++ b/drivers/net/phy/ncsi.c
@@ -59,6 +59,9 @@ struct ncsi_channel {
 
 };
 
+char ncsi_interface_list[16][16];
+unsigned int ncsi_ifindex = 0;
+
 struct ncsi_package {
 	unsigned int		id;
 	unsigned int		n_channels;
diff --git a/net/net.c b/net/net.c
index 8449445bf6..1080b46bca 100644
--- a/net/net.c
+++ b/net/net.c
@@ -118,6 +118,13 @@
 #if defined(CONFIG_CMD_WOL)
 #include "wol.h"
 #endif
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef CONFIG_PHY_NCSI
+extern char ncsi_interface_list[16][16] ;
+extern unsigned int ncsi_ifindex ;
+#endif
 
 /** BOOTP EXTENTIONS **/
 
@@ -409,13 +416,23 @@ int net_loop(enum proto_t protocol)
 	debug_cond(DEBUG_INT_STATE, "--- net_loop Entry\n");
 
 #ifdef CONFIG_PHY_NCSI
-	if (phy_interface_is_ncsi() && protocol != NCSI && !ncsi_active()) {
-		printf("Configuring NCSI\n");
-		if (net_loop(NCSI) < 0)
-			return ret;
-		eth_init_state_only();
-		goto restart;
-	}
+       eth_set_current();
+       bool is_ncsi_interface = false;
+       for (int i = 0; i < 16 && i < ncsi_ifindex;i++) {
+               if (strncmp(ncsi_interface_list[i], eth_get_name(), sizeof(ncsi_interface_list[i])) == 0) {
+                       is_ncsi_interface = true;
+                       break;
+               }
+       }
+       if (is_ncsi_interface) {
+               if (protocol != NCSI && !ncsi_active()) {
+                       printf("Configuring NCSI\n");
+                       if (net_loop(NCSI) < 0)
+                               return ret;
+                       eth_init_state_only();
+                       goto restart;
+               }
+       }
 #endif
 
 	bootstage_mark_name(BOOTSTAGE_ID_ETH_START, "eth_start");
-- 
2.34.1

