From c59529326fae151a7162c8b0991dfd357ac59638 Mon Sep 17 00:00:00 2001
From: rupeshs <rupeshs@ami.com>
Date: Sun, 17 May 2026 16:40:48 +0530
Subject: [PATCH] mac_read_from_eeprom_dts_intel

Signed-off-by: rupeshs <rupeshs@ami.com>
---
 arch/arm/dts/ast2600-intel.dts | 39 ++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/arch/arm/dts/ast2600-intel.dts b/arch/arm/dts/ast2600-intel.dts
index dd4d3510f0..c06425e7dd 100644
--- a/arch/arm/dts/ast2600-intel.dts
+++ b/arch/arm/dts/ast2600-intel.dts
@@ -285,6 +285,45 @@
 	pinctrl-0 = <&pinctrl_i2c15_default>;
 };
 
+/* MAC EEPROM FEATURE */
+&i2c15 {
+	status = "okay";
+	multi-master;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c16_default>;
+	eeprom@52 {
+		compatible = "atmel,24c08";
+		reg = <0x52>;
+		pagesize = <16>;
+		offset_len = <1>;
+		/*
+		 * macoffsetN: specifies the byte offset inside this EEPROM where
+		 * the MAC address for a specific network interface is stored.
+		 *
+		 * Each interface has its own property named macoffset<N>, where
+		 * N maps to the interface index:
+		 *   macoffset0 -> ethaddr   (eth0)
+		 *   macoffset1 -> eth1addr  (eth1)
+		 *   macoffset2 -> eth2addr  (eth2)
+		 *   macoffset3 -> eth3addr  (eth3)
+		 *   macoffset4 -> eth4addr  (eth4)
+		 *   macoffset5 -> eth5addr  (eth5)
+		 *
+		 * Only specify properties for interfaces whose MAC address is
+		 * stored in this EEPROM. Interfaces without a macoffsetN property
+		 * are skipped automatically.
+		 *
+		 * Example: MAC for eth1addr stored at EEPROM offset 0xe1:
+		 *
+		 *   macoffset1 = <0xe1>;
+		 *
+		 * Each MAC address occupies 6 consecutive bytes at its offset.
+		 */
+		macoffset1 = <0xe1>;
+	};
+};
+
 &pcie_rc_bridge1 {
 	status = "okay";
 };
