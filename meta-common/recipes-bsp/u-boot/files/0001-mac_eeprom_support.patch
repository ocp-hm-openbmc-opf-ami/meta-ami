--- /dev/null
+++ b/oem/ami/mac_eeprom/mac_eeprom.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2022 AMI Inc
+ *               Hongwei Zhang <hongewiz@ami.com>
+ */
+
+#include <common.h>
+#include <dm.h>
+#include <environment.h>
+#include <i2c_eeprom.h>
+#include <netdev.h>
+#include <search.h>
+
+#define MAC_ADDR_LEN        6
+#define MAX_ETH_NUM         4
+#define ETH_NAME_LEN         16
+
+int eth_env_update_enetaddr_eeprom(const char *name, unsigned char *enetaddr);
+
+
+int get_mac_eeprom(const char *ethaddr_name, unsigned char *ethaddr)
+{
+    struct udevice *dev;
+    u32 mac_offset;
+    int ret, ret_check;
+    char c;
+    char eth_name[ETH_NAME_LEN];
+    u32 offset_len ;
+
+    c = *(ethaddr_name + 3);
+    if (c == 'a')
+        c = '0';
+
+    snprintf(eth_name, ETH_NAME_LEN, "macoffset%c", c);
+    debug("MAC scan: Looking for %s in EEPROM\n", eth_name);
+    for (ret = uclass_first_device_err(UCLASS_I2C_EEPROM, &dev);
+         !ret && dev;
+         ret = uclass_next_device_err(&dev)) {
+        debug("MAC scan: Device: %s\n", dev->name);
+
+        ret = dev_read_u32(dev, "offset_len", &offset_len);
+        if (ret)
+            continue;
+
+        u32 max_offset = (1u << (8 * offset_len)) - MAC_ADDR_LEN;
+
+        u32 i2c_addr = (u32)dev_read_addr(dev);
+        debug("MAC scan: I2C address of device %s: 0x%X\n", dev->name, i2c_addr);
+        if (i2c_addr < 0x08 || i2c_addr > 0x77) {
+            printf("MAC scan: Skipping device %s: I2C address 0x%X out of valid range (0x08-0x77)\n",
+                   dev->name, i2c_addr);
+            continue;
+        }
+
+        ret_check = dev_read_u32(dev, eth_name, &mac_offset);
+        if (ret_check)
+            continue;
+
+        debug("MAC scan: Offset read from EEPROM: 0x%X\n", mac_offset);
+        if (mac_offset >= 0x00 && mac_offset < max_offset) {
+            ret_check = i2c_eeprom_read(dev, mac_offset, ethaddr, MAC_ADDR_LEN);
+            if (ret_check)
+                return ret_check;
+
+            debug("MAC scan: Read MAC address from EEPROM: %pM\n", ethaddr);
+            if (!is_valid_ethaddr((const u8 *)ethaddr)) {
+                printf("MAC scan: Invalid MAC address read from EEPROM: %pM\n", ethaddr);
+                return -EINVAL;
+            }
+            printf("MAC read successful from EEPROM @ address 0x%X and MAC %pM\n", i2c_addr, ethaddr);
+            return 0;
+        } else {
+            printf("MAC scan: Invalid offset read from EEPROM: 0x%X\n", mac_offset);
+        }
+    }
+
+    return -ENODEV;
+}
+
+int eth_env_update_enetaddr_eeprom(const char *name, unsigned char *enetaddr)
+{
+    const int ETH_ADDR_LEN = 6;
+    unsigned char ethaddr_eeprom[ETH_ADDR_LEN];
+    char buf[ARP_HLEN_ASCII + 1];
+    bool match = true;
+    int ret;
+    int i;
+
+    ret = get_mac_eeprom(name, ethaddr_eeprom);
+    if (ret < 0)
+        return ret;
+
+    /* compare MAC addresses */
+    for (i = 0; i < ETH_ADDR_LEN; i++) {
+        if (ethaddr_eeprom[i] != enetaddr[i]) {
+            match = false;
+            break;
+        }
+    }
+
+    if (!match) {
+        ENTRY e, *ep;
+
+        sprintf(buf, "%pM", ethaddr_eeprom);
+        e.key  = (char *)name;
+        e.data = buf;
+        hsearch_r(e, ENTER, &ep, &env_htab, H_FORCE);
+        if (!ep) {
+            printf("MAC: Failed to force-set %s\n", name);
+            return -EPERM;
+        }
+        return 0;
+    }
+
+    return 0;
+}
