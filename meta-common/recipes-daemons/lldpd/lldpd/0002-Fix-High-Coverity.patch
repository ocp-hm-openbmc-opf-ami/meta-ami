From 92bb745f42c43b411a9ad749f039dd515e82075b Mon Sep 17 00:00:00 2001
From: nirmalkumarv <nirmalkumarv@ami.com>
Date: Mon, 20 Jul 2026 13:28:14 +0000
Subject: [PATCH] Fix-High-Coverity

---
 src/client/text_writer.c |  4 ++--
 src/lib/atom.c           |  1 +
 src/log.c                | 13 ++++++++-----
 3 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/src/client/text_writer.c b/src/client/text_writer.c
index 95990e7..8842fcd 100644
--- a/src/client/text_writer.c
+++ b/src/client/text_writer.c
@@ -36,14 +36,14 @@ struct txt_writer_private {
 static void
 txt_fprintf(struct txt_writer_private *p, const char *fmt, ...)
 {
-	va_list ap;
-
 	// Don't add a newline if we already had one.
 	while (p->lastnl && fmt[0] == '\n') {
 		fmt += 1;
 	}
 	if (fmt[0] == '\0') return;
 
+	va_list ap;
+	memset(&ap, 0, sizeof(ap));
 	va_start(ap, fmt);
 	vfprintf(p->fh, fmt, ap);
 	va_end(ap);
diff --git a/src/lib/atom.c b/src/lib/atom.c
index a3a60c4..b80797e 100644
--- a/src/lib/atom.c
+++ b/src/lib/atom.c
@@ -568,6 +568,7 @@ _lldpctl_new_atom(lldpctl_conn_t *conn, atom_t type, ...)
 	struct atom_builder *builder;
 	struct lldpctl_atom_t *atom;
 	va_list(ap);
+	memset(&ap, 0, sizeof(ap));
 	for (builder = atom_builder_list.nextb; builder; builder = builder->nextb) {
 		if (builder->type != type) continue;
 		atom = calloc(1, builder->size);
diff --git a/src/log.c b/src/log.c
index ddfc14a..c59a6d9 100644
--- a/src/log.c
+++ b/src/log.c
@@ -82,6 +82,7 @@ static void
 logit(int pri, const char *token, const char *fmt, ...)
 {
 	va_list ap;
+	memset(&ap, 0, sizeof(ap));
 
 	va_start(ap, fmt);
 	vlog(pri, token, fmt, ap);
@@ -192,12 +193,13 @@ void
 log_warn(const char *token, const char *emsg, ...)
 {
 	char *nfmt = NULL;
-	va_list ap;
 
 	/* best effort to even work in out of memory situations */
 	if (emsg == NULL)
 		logit(LOG_WARNING, "%s", strerror(errno));
 	else {
+		va_list ap;
+		memset(&ap, 0, sizeof(ap));
 		va_start(ap, emsg);
 
 		if (asprintf(&nfmt, "%s: %s", emsg, strerror(errno)) == -1) {
@@ -216,6 +218,7 @@ void
 log_warnx(const char *token, const char *emsg, ...)
 {
 	va_list ap;
+	memset(&ap, 0, sizeof(ap));
 
 	va_start(ap, emsg);
 	vlog(LOG_WARNING, token, emsg, ap);
@@ -225,9 +228,9 @@ log_warnx(const char *token, const char *emsg, ...)
 void
 log_info(const char *token, const char *emsg, ...)
 {
-	va_list ap;
-
 	if (use_syslog || debug > 0 || logh) {
+		va_list ap;
+		memset(&ap, 0, sizeof(ap));
 		va_start(ap, emsg);
 		vlog(LOG_INFO, token, emsg, ap);
 		va_end(ap);
@@ -248,9 +251,9 @@ log_debug_accept_token(const char *token)
 void
 log_debug(const char *token, const char *emsg, ...)
 {
-	va_list ap;
-
 	if ((debug > 1 && log_debug_accept_token(token)) || logh) {
+		va_list ap;
+		memset(&ap, 0, sizeof(ap));
 		va_start(ap, emsg);
 		vlog(LOG_DEBUG, token, emsg, ap);
 		va_end(ap);
-- 
2.43.0

