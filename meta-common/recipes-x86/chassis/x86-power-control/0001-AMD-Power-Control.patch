+
+#define APML_INIT_DONE_FILE "/tmp/apml_init_complete"
+#define APML_BINDED_DEVNODE "/dev/sbrmi0"
+
+int apml_check_complete(void)
+{
+    int rc;
+    struct stat buffer;
+    char cmd[CMD_BUFF_LEN];
+    if (stat(APML_BINDED_DEVNODE, &buffer) == 0)
+        sprintf(cmd, "touch %s", APML_INIT_DONE_FILE);
+    else
+        sprintf(cmd, "rm -f %s", APML_INIT_DONE_FILE);
+    rc = system(cmd);
+    if (rc < 0)
+        sd_journal_print(LOG_ERR, "Failed to set apml ready\n");
+    return rc;
+}
