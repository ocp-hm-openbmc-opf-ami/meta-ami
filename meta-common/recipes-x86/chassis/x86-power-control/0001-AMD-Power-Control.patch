+
+int apml_bind()
+{
+    int rc;
+    // bind sbtsi and sbrmi drivers
+    char cmd[CMD_BUFF_LEN];
+
+    sprintf(cmd, "/usr/bin/set-apml.sh bind");
+    rc = system(cmd);
+    if (rc < 0)
+        sd_journal_print(LOG_ERR, "Failed to run system cmd: %s \n", cmd);
+    return rc;
