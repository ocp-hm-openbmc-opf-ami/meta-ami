+static void P0ThermtripHandler(bool state)
+{
+    if (!state)
+    { // Falling edge
+        std::string ras_err_msg =
+            "P0 Thermtrip detected. BMC will issue RSMRST";
+        sd_journal_send("MESSAGE=%s", ras_err_msg.c_str(), "PRIORITY=%i",
+                        LOG_ERR, "REDFISH_MESSAGE_ID=%s",
+                        "OpenBMC.0.1.CPUError", "REDFISH_MESSAGE_ARGS=%s",
+                        ras_err_msg.c_str(), NULL);
+        RSMreset();
+    }
+
+    P0ThermtripEvent.async_wait(
+        boost::asio::posix::stream_descriptor::wait_read,
+        [state](const boost::system::error_code ec) {
+            if (ec)
