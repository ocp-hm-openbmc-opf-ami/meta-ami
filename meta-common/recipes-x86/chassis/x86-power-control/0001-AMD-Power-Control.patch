+///////////////////////////////////////////////////////////////////////////////////
+#define AST_SCU_REG_BASE 0x1E6E2000
+
+typedef struct
+{
+    int g_mem_fd;
+    void* g_last_map;
+} MMAP_HANDLE;
+
+void* InitMmap(void)
+{
+    MMAP_HANDLE* handle;
+    int g_mem_fd;
+
+    /* Open Memory Driver */
+    g_mem_fd = open("/dev/mem", O_RDWR | O_SYNC);
+    if (g_mem_fd < 0)
+    {
+        lg2::error("ERROR: Unable to open Memory Access Driver");
+        return NULL;
+    }
+
+    handle = (MMAP_HANDLE*)malloc(sizeof(MMAP_HANDLE));
+    if (handle == NULL)
+    {
+        lg2::error("ERROR: Unable to Allocate Memory for Handle");
+        close(g_mem_fd);
+        return NULL;
+    }
+
+    handle->g_mem_fd = g_mem_fd;
+    handle->g_last_map = NULL;
+
+    return (void*)handle;
+}
+
+void UnMapMemory(void* handle)
+{
+    MMAP_HANDLE* g_handle = (MMAP_HANDLE*)handle;
+    int page_size = getpagesize();
+    if (g_handle->g_last_map != NULL)
+    {
+        if (munmap(g_handle->g_last_map, page_size) == -1)
+        {
+            lg2::error("Error in unmapping");
+        }
+        g_handle->g_last_map = NULL;
+    }
+}
+
+void ExitMmap(void* handle)
+{
+    MMAP_HANDLE* g_handle = (MMAP_HANDLE*)handle;
+
+    if (g_handle->g_last_map != NULL)
+        UnMapMemory(handle);
+
+    if (g_handle->g_mem_fd >= 0)
+    {
+        close(g_handle->g_mem_fd);
+        g_handle->g_mem_fd = -1;
+    }
+
+    free(handle);
+
+    return;
+}
+
+void* MapMemory(void* handle, unsigned long addr, unsigned long* len)
+{
+    void* mapaddr;
+    unsigned long offset = 0;
+    MMAP_HANDLE* g_handle = (MMAP_HANDLE*)handle;
+    int page_size = getpagesize();
+
+    if (g_handle->g_last_map != NULL)
+        UnMapMemory(handle);
+
+    if (addr % page_size)
+        offset = (addr % page_size);
+
+    addr -= offset;
+
+    mapaddr = mmap(0, page_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                   g_handle->g_mem_fd, addr);
+
+    if (mapaddr == MAP_FAILED)
+    {
+        lg2::error("ERROR: Failed to map physical memory");
+        g_handle->g_last_map = NULL;
+        return NULL;
+    }
+    g_handle->g_last_map = mapaddr;
+
+    *len = page_size - offset;
+    return mapaddr + offset;
+}
+
+int mmap_read32(unsigned long addr, unsigned long* data)
+{
+    void *handle, *map;
+    unsigned long len;
+
+    if (addr % 4)
+    {
+        lg2::error("ERROR: Cannot access Unaligned Address");
+        return 1;
+    }
+
+    handle = InitMmap();
+    if (handle == NULL)
+    {
+        return 1;
+    }
+
+    map = MapMemory(handle, addr, &len);
+    if (map == NULL)
+    {
+        ExitMmap(handle);
+        return 1;
+    }
+
+    *data = *(unsigned long*)map;
+
+    ExitMmap(handle);
+    return 0;
+}
+
+int mmap_write32(unsigned long addr, unsigned long data)
+{
+    void *handle, *map;
+    unsigned long len;
+
+    if (addr % 4)
+    {
+        lg2::error("ERROR: Cannot access Unaligned Address");
+        return 1;
+    }
+
+    handle = InitMmap();
+    if (handle == NULL)
+    {
+        return 1;
+    }
+    map = MapMemory(handle, addr, &len);
+    if (map == NULL)
+    {
+        ExitMmap(handle);
+        return 1;
+    }
+
+    *(unsigned long*)map = data;
+
+    ExitMmap(handle);
+    return 0;
+}
+
+int ForceDisablePassThrough(void)
+{
+    unsigned long Value = 0;
+    if (!mmap_read32((AST_SCU_REG_BASE + 0x4BC), &Value))
+    {
+        Value = Value & 0xC0FFFFFF;
+        return mmap_write32((AST_SCU_REG_BASE + 0x4BC), Value);
+    }
+    return 1;
+}
+
+int DbgPassThrough(void)
+{
+    unsigned long Value = 0;
+    char sBuf[256];
+
+    if (mmap_read32((AST_SCU_REG_BASE + 0x4BC), &Value))
+    {
+        lg2::error("DbgPassThrough: mmap_read32 failed");
+        return 1;
+    }
+    sprintf(sBuf, "Reg: 0x4BC: Val: 0x%lx", Value);
+    lg2::error("DbgPassThrough: {NAME}", "NAME", std::string(sBuf));
+
+    return 0;
+}
