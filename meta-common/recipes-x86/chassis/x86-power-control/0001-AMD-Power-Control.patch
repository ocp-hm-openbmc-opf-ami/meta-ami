+static void psPowerOKRampDownTimerStart()
+{
+    lg2::info("power supply power OK RampDown timer started");
+    psPowerOKRampDownTimer.expires_after(
+        std::chrono::milliseconds(TimerMap["psPowerOKRampDownMs"]));
+    psPowerOKRampDownTimer.async_wait([](const boost::system::error_code ec) {
+        if (ec)
+        {
+            // operation_aborted is expected if timer is canceled before
+            // completion.
+            if (ec != boost::asio::error::operation_aborted)
+            {
+                lg2::error(
+                    "power supply power OK RampDown async_wait failed: {ERROR_MSG}",
+                    "ERROR_MSG", ec.message());
+            }
+            lg2::info("power supply power OK RampDown timer canceled");
+            return;
+        }
+        lg2::info("power supply power OK RampDown timer expired");
+        sendPowerControlEvent(Event::psPowerOKRampDownTimerExpired);
+    });
+}
