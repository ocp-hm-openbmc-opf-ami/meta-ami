From 0128de1bc82cf47b522b9b9c07fcb99a10e2973b Mon Sep 17 00:00:00 2001
From: krishna <krishnar@ami.com>
Date: Mon, 6 Oct 2025 19:51:22 +0530
Subject: [PATCH 12/12] added PDKHOOK call for power operation

---
 meson.build           | 4 +++-
 src/power_control.cpp | 8 ++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 6117245..290c2af 100644
--- a/meson.build
+++ b/meson.build
@@ -45,12 +45,14 @@ deps = [
   dependency('boost'),
 ]
 
+pdkhook_deps = [ declare_dependency (link_args: '-lpdkhook'),]
+
 executable(
   'power-control',
   'src/power_control.cpp',
   include_directories: include_directories('src'),
   cpp_args: cpp_args,
-  dependencies: deps,
+  dependencies: [deps, pdkhook_deps],
   install: true,
   install_dir: get_option('bindir'))
 
diff --git a/src/power_control.cpp b/src/power_control.cpp
index 951894b..1963244 100644
--- a/src/power_control.cpp
+++ b/src/power_control.cpp
@@ -28,6 +28,7 @@
 #include <nlohmann/json.hpp>
 #include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/asio/object_server.hpp>
+#include <PDKHooks.hpp>
 
 #include <chrono>
 #include <cstdint>
@@ -1510,8 +1511,11 @@ static int assertGPIOForMs(const ConfigData& config, const int durationMs)
 
 static void powerOn()
 {
+    PDK_BeforePowerOnChassis();
     assertGPIOForMs(powerOutConfig, TimerMap["PowerPulseMs"]);
+    PDK_AfterPowerOnChassis();
 }
+
 #ifdef CHASSIS_SYSTEM_RESET
 static int slotPowerOn()
 {
@@ -1591,6 +1595,7 @@ static void gracefulPowerOff()
 
 static void forcePowerOff()
 {
+    PDK_BeforePowerOffChassis();
     if (assertGPIOForMs(powerOutConfig, TimerMap["ForceOffPulseMs"]) < 0)
     {
         return;
@@ -1623,10 +1628,12 @@ static void forcePowerOff()
                     "xyz.openbmc_project.State.Host.HostState.Running"));
         }
     });
+    PDK_AfterPowerOffChassis();
 }
 
 static void reset()
 {
+    PDK_ResetChassis();
     assertGPIOForMs(resetOutConfig, TimerMap["ResetPulseMs"]);
 }
 
@@ -1988,6 +1995,7 @@ static void powerStateOn(const Event event)
             gracefulPowerOff();
             break;
         case Event::powerCycleRequest:
+	    PDK_PowerCycleChassis();
             setPowerState(PowerState::transitionToCycleOff);
             forcePowerOff();
             break;
-- 
