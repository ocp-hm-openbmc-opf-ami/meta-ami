[Unit]
Description=Monitor the status of the services
# Ensure system-guid (which populates xyz.openbmc_project.Common.UUID on
# the Settings service) has run before we declare readiness. The script
# additionally polls the ObjectMapper for the UUID interface as a
# belt-and-braces guard against ObjectMapper indexing lag.
After=system-guid.service
Wants=system-guid.service
 
[Service]
Type=oneshot
ExecStart=/usr/bin/bmc-services-ready.sh
StandardOutput=journal+console
 
[Install]
WantedBy=multi-user.target
