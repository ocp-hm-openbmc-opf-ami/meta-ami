[Unit]
Description=BMC Auto-Recovery Boot Complete Handler
Documentation=Reset recovery flags after successful boot
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/bmc-auto-recovery.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
