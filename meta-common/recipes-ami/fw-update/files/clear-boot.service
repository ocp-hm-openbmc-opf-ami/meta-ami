[Unit]
Description=Clear boot source on reboot/shutdown
After=multi-user.target
# Stop after nv-sync so clearboot runs after nv-sync's ExecStopPost
Before=shutdown.target reboot.target poweroff.target halt.target apply-onreset.service

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=yes
# Run only during an actual reboot/shutdown transaction.
ExecStop=/bin/sh -c 'systemctl list-jobs | grep -qE "shutdown\.target|reboot\.target|poweroff\.target|halt\.target" || exit 0; exec /usr/bin/clearboot.sh'
TimeoutStopSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
