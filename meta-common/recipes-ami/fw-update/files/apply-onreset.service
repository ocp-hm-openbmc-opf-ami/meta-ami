[Unit]
Description=Apply-on-reset script (run during shutdown while multi-user is still up)
# We start AFTER the services we need, so we will be stopped BEFORE them.
After=multi-user.target network-online.target bmcweb.service getty.target
Wants=network-online.target
# For belt-and-braces ordering against the final shutdown targets:
Before=shutdown.target reboot.target poweroff.target halt.target
After=nv-sync.service xyz.openbmc_project.Software.Sync.service

[Service]
Type=oneshot
# Keep the service "active" during normal operation so ExecStop runs on shutdown:
ExecStart=/usr/bin/applyonreset.sh start
RemainAfterExit=yes

# Do the real work on shutdown/reboot:
ExecStop=/usr/bin/applyonreset.sh stop

# Let it take as long as needed (or set a finite value if you prefer):
TimeoutStopSec=0
# We log inside the script; no more here.

# Redirect all output to console and journal
StandardOutput=journal+console
StandardError=journal+console


[Install]
# Make this part of the normal runtime so it's present to be stopped later:
WantedBy=multi-user.target
