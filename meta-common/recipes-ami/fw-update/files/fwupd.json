{
  "version": 1,
  "log": "/var/log/fwupd/fwupd.log",
  "imageRoot": "/tmp/images",
  "components": [
    {
      "name": "bmc",
      "imagePatterns": [ "image-bmc"],
      "pre": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/prepare-bmc.sh"
        }
      ],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-bmc.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGET@"]
        }
      ],
      "post": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/cleanup-bmc.sh"
        }
      ],
      "exec": {
        "prepost": "global",
        "parallel": true
      }
    },
    {
      "name": "compbmc",
      "imagePatterns": ["image-runtime", "image-kernel"],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-compbmc.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGET@"]
        }
      ],
      "exec": {
        "prepost": "global",
        "parallel": true
      }
    },
    {
      "name": "bios",
      "imagePatterns": ["image-bios"],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-bios.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGET@"]
        }
      ]
    },
    {
      "name": "cpld",
      "imagePatterns": ["image-cpld", "image-cpld.bin"],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-cpld.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGET@"]
        }
      ]
    },
    {
      "name": "raid",
      "imagePatterns": ["image-raid", "image-raid-fw", "image-hba", "image-megaraid"],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-raid.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGET@"]
        }
      ],
      "exec": {
        "filterByPurpose": false
      }
    },
    {
      "name": "pldm",
      "imagePatterns": ["image-pldm"],
      "flash": [
        {
          "action": "script",
          "path": "/usr/libexec/fwupd/flash-pldm.sh",
          "args": ["@DIR@", "@IMAGE@", "@TARGETS@"]
        }
      ],
      "exec": {
        "targetMode": "batched"
      }
    }
  ]
}
