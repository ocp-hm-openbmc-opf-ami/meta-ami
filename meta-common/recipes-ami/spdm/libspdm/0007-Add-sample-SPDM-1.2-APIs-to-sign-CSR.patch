+/**
+ * Construct the X509 object of root CA from given EC DSA keypair.
+ *
+ * @param[in]   ec_context      Pointer to the EC DSA context which contain the
+ *                            EC DSA key components.
+ * @param[out]  x509_root_cert  Pointer to the generated X509 object. Use
+ *                     libspdm_x509_free() function to free the resource.
+ *
+ * If ec_context is NULL, then return false.
+ * If x509_root_cert is NULL, then return false.
+ *
+ * @retval     true            The X509 object generation succeeded.
+ * @retval     false           The operation failed.
+ *
+ **/
+bool libspdm_x509_construct_root_certificate_from_ec(void *ec_context,
+                                                     uint8_t **x509_root_cert)
+{
+    bool res = false;
+    EVP_PKEY *key = NULL;
+    X509 *x509 = NULL;
+    X509_NAME *name = NULL;
+
+    if (x509_root_cert == NULL || ec_context == NULL)
+    {
+        return false;
+    }
+
+    key = NULL;
+
+    key = EVP_PKEY_new();
+    if (key == NULL)
+    {
+        return false;
+    }
+    if (!EVP_PKEY_set1_EC_KEY(key, (EC_KEY *)ec_context))
+    {
+        goto teardown;
+    }
+
+    // 1. Create a new X509 certificate
+    x509 = X509_new();
+    if (!x509)
+        goto teardown;
+
+    // 2. Set version to 3 (index 2)
+    if (!X509_set_version(x509, 2))
+        goto teardown;
+
+    // 3. Set serial number
+    ASN1_INTEGER_set(X509_get_serialNumber(x509), 1234);
+
+    // 4. Set validity period
+    X509_gmtime_adj(X509_getm_notBefore(x509), 0);
+    X509_gmtime_adj(X509_getm_notAfter(x509), 31536000L);
+
+    if (!X509_set_pubkey(x509, key))
+        goto teardown;
+
+    // 6. Set issuer and subject name
+    name = X509_get_subject_name(x509);
+    X509_NAME_add_entry_by_txt(name, "C", MBSTRING_ASC, (unsigned char *)"TW",
+                               -1, -1, 0);
+    X509_NAME_add_entry_by_txt(name, "O", MBSTRING_ASC, (unsigned char *)"AMI",
+                               -1, -1, 0);
+    X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC,
+                               (unsigned char *)"AMI sample Root CA", -1, -1, 0);
+    X509_set_issuer_name(x509,
+                         name); // Self-signed, so issuer is the same as subject
+
+    // 7. Add extensions
+    X509V3_CTX ctx;
+    X509V3_set_ctx_nodb(&ctx);
+    X509V3_set_ctx(&ctx, x509, x509, NULL, NULL, 0);
+    X509_EXTENSION *ext;
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_basic_constraints,
+                              "critical,CA:TRUE");
+    X509_add_ext(x509, ext, -1);
+    X509_EXTENSION_free(ext);
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_subject_key_identifier, "hash");
+    X509_add_ext(x509, ext, -1);
+    X509_EXTENSION_free(ext);
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_authority_key_identifier,
+                              "keyid:always,issuer");
+    X509_add_ext(x509, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    // 8. Sign the certificate with the private key
+    if (!X509_sign(x509, key, EVP_sha384()))
+        goto teardown;
+
+    *x509_root_cert = (uint8_t *)x509;
+    x509 = NULL; // Prevent free in cleanup
+    res = true;
+
+teardown:
+    if (key)
+        EVP_PKEY_free(key);
+    if (x509)
+        X509_free(x509);
+    return res;
+}
+
+/**
+ * Sign the CSR with given root CA and EC DSA keypair.
+ *
+ * @param[in]   csr               Pointer to the DER-encoded X509 certificate
+ *                              signing request.
+ * @param[in]   csr_len           Size of the X509 CSR in bytes.
+ * @param[in]   ec_context        Pointer to the EC DSA context which contain
+ *                              the EC DSA key components.
+ * @param[in]   x509_root_cert    Pointer to the X509 object of root
+ *                              certificate.
+ * @param[out]  x509_signed_cert  Pointer to the generated X509 object. Use
+ *                      libspdm_x509_free() function to free the resource.
+ *
+ * If csr is NULL, then return false.
+ * If ec_context is NULL, then return false.
+ * If root_cert is NULL, then return false.
+ *
+ * @retval     true            The signed certificate generation succeeded.
+ * @retval     false           The operation failed.
+ *
+ **/
+bool libspdm_sign_csr_from_ec(uint8_t *csr, size_t csr_len, void *ec_context,
+                              uint8_t *x509_root_cert,
+                              uint8_t **x509_signed_cert)
+{
+    bool res = false;
+    X509 *cert = NULL;
+    EVP_PKEY *req_pubkey = NULL;
+    X509 *root_ca_cert = NULL;
+    X509_REQ *csr_req = NULL;
+    EVP_PKEY *ca_pkey = NULL;
+
+    if (csr == NULL || ec_context == NULL || x509_root_cert == NULL ||
+        csr_len == 0)
+        return false;
+
+    const unsigned char *p = (const unsigned char *)csr;
+    csr_req = d2i_X509_REQ(NULL, &p, csr_len);
+    if (!csr_req)
+        goto teardown;
+
+    ca_pkey = EVP_PKEY_new();
+    if (!ca_pkey)
+        goto teardown;
+    if (!EVP_PKEY_set1_EC_KEY(ca_pkey, (EC_KEY *)ec_context))
+        goto teardown;
+
+    root_ca_cert = (X509 *)x509_root_cert;
+
+    // Create a new certificate
+    cert = X509_new();
+    if (!cert)
+        goto teardown;
+
+    // Set version of the certificate (X509v3)
+    if (!X509_set_version(cert, 2))
+        goto teardown; // 0 indexed, so 2 means v3
+
+    // Generate serial number
+    // todo: error handling
+    ASN1_INTEGER *serial = ASN1_INTEGER_new();
+    ASN1_INTEGER_set(serial, 1235); // Just an example, should be unique
+    X509_set_serialNumber(cert, serial);
+    ASN1_INTEGER_free(serial);
+
+    // Set issuer name from the CA certificate
+    // todo: error handling
+    X509_set_issuer_name(cert, X509_get_subject_name(root_ca_cert));
+
+    // Set validity period
+    // todo: error handling
+    X509_gmtime_adj(X509_getm_notBefore(cert), 0);
+    X509_gmtime_adj(X509_getm_notAfter(cert),
+                    (long)60 * 60 * 24 * 365); // Valid for 'days'
+
+    // Set subject from CSR
+    // todo: error handling
+    X509_set_subject_name(cert, X509_REQ_get_subject_name(csr_req));
+
+    // Extract public key from CSR
+    // todo: error handling
+    req_pubkey = X509_REQ_get_pubkey(csr_req);
+    X509_set_pubkey(cert, req_pubkey);
+    EVP_PKEY_free(req_pubkey);
+
+    // Add extensions
+    X509V3_CTX ctx;
+    X509V3_set_ctx_nodb(&ctx);
+    X509V3_set_ctx(&ctx, NULL, cert, NULL, NULL, 0);
+
+    X509_EXTENSION *ext;
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_basic_constraints,
+                              "critical,CA:FALSE");
+    X509_add_ext(cert, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    ext =
+        X509V3_EXT_conf_nid(NULL, &ctx, NID_key_usage,
+                            "digitalSignature,nonRepudiation,keyEncipherment");
+    X509_add_ext(cert, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_subject_key_identifier, "hash");
+    X509_add_ext(cert, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    ext = X509V3_EXT_conf_nid(
+        NULL, &ctx, NID_subject_alt_name,
+        "otherName:1.3.6.1.4.1.412.274.1;UTF8:ACME:WIDGET:1234567890");
+    X509_add_ext(cert, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    ext = X509V3_EXT_conf_nid(NULL, &ctx, NID_ext_key_usage,
+                              "critical,serverAuth,clientAuth,ocspSigning");
+    X509_add_ext(cert, ext, -1);
+    X509_EXTENSION_free(ext);
+
+    // Sign the certificate with CA's private key
+    if (!X509_sign(cert, ca_pkey, EVP_sha384()))
+        goto teardown;
+
+    *x509_signed_cert = (uint8_t *)cert;
+    cert = NULL;
+    res = true;
+
+teardown:
+    if (csr_req)
+        X509_REQ_free(csr_req);
+    if (ca_pkey)
+        EVP_PKEY_free(ca_pkey);
+    if (cert)
+        X509_free(cert);
+    return res;
+}
