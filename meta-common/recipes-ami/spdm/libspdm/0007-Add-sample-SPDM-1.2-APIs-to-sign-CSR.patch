+/**
+ * Construct DER-encoded certificate data from a X509 object.
+ *
+ * If der_cert is NULL, then return false.
+ * If x509_cert is NULL, then return false.
+ * If der_cert_size is 0, then return false.
+ *
+ * @param[in]  x509_cert          Pointer to the X509 object .
+ * @param[in]  der_cert           Pointer to the buffer of DER-encoded
+ *                               certificate data.
+ * @param[in, out] der_cert_size  On input, the buffer size of certificate data
+ *                               in bytes.
+ *                                On output, the actual size of converted
+ *                               der-encoded certificate data in bytes.
+ *
+ * @retval     true            The DER-encoded certificate written succeeded.
+ * @retval     false           The operation failed.
+ *
+ **/
+bool libspdm_x509_construct_der_certificate(uint8_t *x509_cert,
+                                            uint8_t **der_cert,
+                                            size_t *der_cert_size)
+{
+    int len = 0;
+    X509 *cert = NULL;
+    uint8_t *originalPtr;
+    if (x509_cert == NULL || der_cert == NULL || *der_cert_size == 0)
+        return false;
+    originalPtr = *der_cert;
+    cert = (X509 *)x509_cert;
+    len = i2d_X509(cert, der_cert);
+    if (len < 0)
+    {
+        LIBSPDM_DEBUG((LIBSPDM_DEBUG_ERROR,
+                       "Failed to convert certificate to DER data.\n"));
+        return false;
+    }
+    *der_cert_size = len;
+    *der_cert = originalPtr;
+    return true;
+}
