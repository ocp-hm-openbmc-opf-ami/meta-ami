{
    "A": {
        "name": "Network",
        "file": [
            "/etc/dns.d/dns.conf",
            "/etc/hostname"
        ],
        "folder": [
            "/etc/systemd/network",
            "/etc/interface"
        ],
        "service": [
            "systemd-networkd.service",
            "systemd-resolved.service",
            "xyz.openbmc_project.Network.service",
            "systemd-hostnamed.service",
            "mac-hostname.service"
        ]
    },
    "B": {
        "name": "Virtual-media",
        "file": [
            "/etc/virtual-media.json"
        ],
        "folder": [],
        "service": [
            "xyz.openbmc_project.VirtualMedia.service"
        ]
    },
    "C": {
        "name": "SMTP",
        "file": [
            "/var/lib/alert/primary_smtp_config.json",
            "/var/lib/alert/secondary_smtp_config.json"
        ],
        "folder": [],
        "service": [
            "mail-alert-manager.service"
        ]
    },
    "D": {
        "name": "NTP",
        "file": [
            "/etc/systemd/timesyncd.conf",
            "/var/lib/phosphor-settings-manager/settings/xyz/openbmc_project/time/sync_method_",
