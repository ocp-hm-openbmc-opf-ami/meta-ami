+pldm_requester_rc_t pldm_send_req(uint8_t msg_tag, mctp_eid_t eid, int mctp_fd,
+				const uint8_t *pldm_req_msg, size_t req_msg_len)
+{
+		uint8_t tag_owner = 0x0;
+		uint8_t tag_owner_and_tag = (tag_owner << 3) | (msg_tag & LIBMCTP_TAG_MASK);
+		uint8_t hdr[3] = {tag_owner_and_tag, eid, MCTP_MSG_TYPE_PLDM};
+
+		struct iovec iov[2];
+		iov[0].iov_base = hdr;
+		iov[0].iov_len = sizeof(hdr);
+		iov[1].iov_base = (uint8_t *)pldm_req_msg;
+		iov[1].iov_len = req_msg_len;
+
+		struct msghdr msg = {0};
+		msg.msg_iov = iov;
+		msg.msg_iovlen = sizeof(iov) / sizeof(iov[0]);
+
+		ssize_t rc = sendmsg(mctp_fd, &msg, 0);
+		if (rc == -1) {
+				return PLDM_REQUESTER_SEND_FAIL;
+		}
+		return PLDM_REQUESTER_SUCCESS;
+}
