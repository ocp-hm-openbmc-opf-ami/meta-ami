-    });
+    }, boost::asio::detached);
 
     ioc->run();
 
diff --git a/src/state_effecter_handler.cpp b/src/state_effecter_handler.cpp
index e946cd4..0a6fd13 100644
--- a/src/state_effecter_handler.cpp
+++ b/src/state_effecter_handler.cpp
@@ -572,12 +572,12 @@ void StateEffecterHandler::registerSetEffecter()
                                         phosphor::logging::entry("TID=%d",
                                                                  _tid));
                                 }
-                            });
+                            }, boost::asio::detached);
                     });
             };
 
             // Refresh the value on D-Bus
-            getIoContext()->post(refreshEffecterInterfaces);
+            boost::asio::post(*getIoContext(), refreshEffecterInterfaces);
         });
     setEffecterInterface->initialize();
 }
