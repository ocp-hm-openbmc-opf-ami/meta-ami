+            tempStream << std::setfill('0') << std::setw(2) << std::hex << byte
+                       << " ";
+        }
+        if (isTx)
+        {
+            lg2::info("Tx: {TX}", "TX", tempStream.str());
+        }
+        else
+        {
+            lg2::info("Rx: {RX}", "RX", tempStream.str());
+        }
+    }
+}
