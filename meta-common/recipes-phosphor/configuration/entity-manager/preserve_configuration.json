                "isOptional": true
            },
            {
                "Name": "AUTHENTICATION",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/pam.d/",
                    "/etc/nsswitch.conf",
                    "/etc/nscd.conf",
                    "/etc/group",
                    "/etc/group-",
                    "/etc/gshadow",
