[
    {
        "Exposes": [
            {
                "Name": "LicenseControl",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/license-control/license.json",
                    "/etc/license-control/token"
                ],
                "isOptional": false
            },
            {
                "Name": "KVM",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/systemd/system/start-ipkvm.socket.d/override.conf",
                    "/etc/virtual-media.json",
                    "/etc/tmpfiles.d/virtual-media.conf"
                ],
                "isOptional": true
            },
            {
                "Name": "ServiceManager",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/srvcfg-manager/srvcfg.json"
                ],
                "isOptional": false
            },
            {
                "Name": "SDR",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/var/configuration/system.json"
                ],
                "isOptional": true
            },
            {
                "Name": "SMTP",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/var/lib/alert/primary_smtp_config.json",
                    "/var/lib/alert/secondary_smtp_config.json"
                ],
                "isOptional": true
            },
            {
                "Name": "SEL",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/var/lib/phosphor-logging/errors/"
                ],
                "isOptional": true
            },
            {
                "Name": "FRU",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/fru/"
                ],
                "isOptional": true
            },
            {
                "Name": "SNMP",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/etc/snmp/snmpd.conf.d/snmpd.conf",
                    "/etc/snmp/SnmpTrapStatus",
                    "/var/lib/net-snmp/snmpd.conf",
                    "/var/lib/phosphor-snmp/",
                    "/etc/snmp/snmpd.conf",
                    "/etc/snmp/snmptrapd.conf"
                ],
                "isOptional": true
            },
            {
                "Name": "REDFISH",
                "Type": "Preserve",
                "isEnable": true,
                "filepath" : [
                    "/var/lib/redfish/"
