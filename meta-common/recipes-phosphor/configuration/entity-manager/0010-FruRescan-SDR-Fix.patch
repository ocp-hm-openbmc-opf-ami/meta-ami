From d27db40a39c6530eb889ca65dd73095a8d3ccbd1 Mon Sep 17 00:00:00 2001
From: saravananm <saravananm@ami.com>
Date: Mon, 24 Nov 2025 12:48:22 +0530
Subject: [PATCH] Fix for IPMI SDR failures

Tested and Working as expected.

Signed-off-by: saravananm <saravananm@ami.com>
---
 src/fru_device/fru_device.cpp | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/src/fru_device/fru_device.cpp b/src/fru_device/fru_device.cpp
index 7aa9214..83a5652 100644
--- a/src/fru_device/fru_device.cpp
+++ b/src/fru_device/fru_device.cpp
@@ -1397,6 +1397,22 @@ void rescanBusses(
             return;
         }
 
+	const fs::path lockPath = "/tmp/fru_scan.lock";
+        {
+            std::ofstream lockFile(lockPath);
+            if (lockFile.is_open())
+            {
+                lockFile << "fru-scan\n";
+                lockFile.close();
+            }
+            else
+            {
+                std::cerr << "Unable to create FRU scan lock file: PATH="
+                          << lockPath << " errno=" << errno << " ("
+                          << std::strerror(errno) << ")\n";
+            }
+        }
+
         auto devDir = fs::path("/dev/");
         std::vector<fs::path> i2cBuses;
 
@@ -1448,6 +1464,19 @@ void rescanBusses(
                                            objServer, systemBus);
                     }
                 }
+		std::error_code remove_file;
+                fs::remove(lockPath, remove_file);
+                if (remove_file)
+                {
+                    std::cerr
+                        << "FRU scan lock removal failed: PATH=" << lockPath
+                        << ", ERROR=" << remove_file.message() << "\n";
+                }
+                else
+                {
+                    std::cerr
+                        << "FRU scan lock removed: PATH=" << lockPath << "\n";
+                }
             });
         scan->run();
     });
