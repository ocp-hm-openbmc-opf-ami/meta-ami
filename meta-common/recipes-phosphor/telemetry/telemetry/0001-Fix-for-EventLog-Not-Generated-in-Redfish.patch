From 128a593eefb20651a78e6f81d6351dc0a91ed8e1 Mon Sep 17 00:00:00 2001
From: prasannas <prasannas@ami.com>
Date: Fri, 3 May 2024 17:24:08 +0530
Subject: [PATCH] Fix for EventLog Not Generated in Redfish

---
 src/trigger_actions.cpp | 67 ++++++++++++++++++++++++++---------------
 src/trigger_actions.hpp | 11 ++++---
 2 files changed, 48 insertions(+), 30 deletions(-)

diff --git a/src/trigger_actions.cpp b/src/trigger_actions.cpp
index 84d048f..b6329f7 100644
--- a/src/trigger_actions.cpp
+++ b/src/trigger_actions.cpp
@@ -90,16 +90,22 @@ void LogToRedfishEventLog::commit(const std::string& triggerId,
     std::string thresholdName = ::numeric::typeToString(type);
     auto direction = getDirection(value, threshold);
     auto timestampStr = timestampToString(timestamp);
+    auto severity = getRedfishMessageId();
 
-    phosphor::logging::log<phosphor::logging::level::INFO>(
-        "Logging numeric trigger action to Redfish Event Log.",
-        phosphor::logging::entry("REDFISH_MESSAGE_ID=%s",
-                                 getRedfishMessageId()),
-        phosphor::logging::entry(
-            "REDFISH_MESSAGE_ARGS=%s,%s,%s,%f,%s,%s",
-            std::string(utils::toShortEnum(thresholdName)).c_str(),
-            triggerId.c_str(), sensorName.c_str(), value, direction,
-            timestampStr.c_str()));
+    auto connection = sdbusplus::bus::new_default_system();
+    sdbusplus::message_t AddToLog = connection.new_method_call(
+        "xyz.openbmc_project.Logging", "/xyz/openbmc_project/logging",
+        "xyz.openbmc_project.Logging.Create", "Create");
+
+    std::string journalMsg(
+        "Numeric threshold '" + thresholdName + "' of trigger '" + triggerId +
+        "' is crossed on sensor " + sensorName +
+        ", recorded value: " + std::to_string(value) +
+        ", crossing direction: " + std::string(utils::toShortEnum(direction)) +
+        ", timestamp: " + timestampToString(timestamp));
+
+    AddToLog.append(journalMsg, severity, std::map<std::string, std::string>());
+    connection.call(AddToLog);
 }
 
 void fillActions(
@@ -180,15 +186,21 @@ void LogToRedfishEventLog::commit(const std::string& triggerId,
 {
     auto value = std::get<std::string>(triggerValue);
     auto timestampStr = timestampToString(timestamp);
+    auto severity = getRedfishMessageId();
 
-    phosphor::logging::log<phosphor::logging::level::INFO>(
-        "Logging discrete trigger action to Redfish Event Log.",
-        phosphor::logging::entry("REDFISH_MESSAGE_ID=%s",
-                                 getRedfishMessageId()),
-        phosphor::logging::entry("REDFISH_MESSAGE_ARGS=%s,%s,%s,%s,%s",
-                                 thresholdNameIn->get().c_str(),
-                                 triggerId.c_str(), sensorName.c_str(),
-                                 value.c_str(), timestampStr.c_str()));
+    auto connection = sdbusplus::bus::new_default_system();
+    sdbusplus::message_t AddToLog = connection.new_method_call(
+        "xyz.openbmc_project.Logging", "/xyz/openbmc_project/logging",
+        "xyz.openbmc_project.Logging.Create", "Create");
+
+    std::string journalMsg("Discrete condition '" + thresholdNameIn->get() +
+                           "' of trigger '" + triggerId +
+                           "' is crossed on sensor " + sensorName +
+                           ", recorded value: " + value +
+                           ", timestamp: " + timestampToString(timestamp));
+
+    AddToLog.append(journalMsg, severity, std::map<std::string, std::string>());
+    connection.call(AddToLog);
 }
 
 void fillActions(
@@ -249,15 +261,20 @@ void LogToRedfishEventLog::commit(const std::string& triggerId,
 {
     auto value = triggerValueToString(triggerValue);
     auto timestampStr = timestampToString(timestamp);
+    auto severity = redfish_message_ids::TriggerDiscreteOK;
+
+    auto connection = sdbusplus::bus::new_default_system();
+    sdbusplus::message_t AddToLog = connection.new_method_call(
+        "xyz.openbmc_project.Logging", "/xyz/openbmc_project/logging",
+        "xyz.openbmc_project.Logging.Create", "Create");
+
+    std::string journalMsg("Discrete condition OnChange of trigger '" +
+                           triggerId + "' is crossed on sensor " + sensorName +
+                           ", recorded value: " + value +
+                           ", timestamp: " + timestampToString(timestamp));
 
-    phosphor::logging::log<phosphor::logging::level::INFO>(
-        "Logging onChange discrete trigger action to Redfish Event Log.",
-        phosphor::logging::entry("REDFISH_MESSAGE_ID=%s",
-                                 redfish_message_ids::TriggerDiscreteOK),
-        phosphor::logging::entry("REDFISH_MESSAGE_ARGS=%s,%s,%s,%s,%s",
-                                 "OnChange", triggerId.c_str(),
-                                 sensorName.c_str(), value.c_str(),
-                                 timestampStr.c_str()));
+    AddToLog.append(journalMsg, severity, std::map<std::string, std::string>());
+    connection.call(AddToLog);
 }
 
 void fillActions(
diff --git a/src/trigger_actions.hpp b/src/trigger_actions.hpp
index 14f6294..2827f03 100644
--- a/src/trigger_actions.hpp
+++ b/src/trigger_actions.hpp
@@ -11,14 +11,15 @@ namespace action
 namespace redfish_message_ids
 {
 constexpr const char* TriggerNumericWarning =
-    "OpenBMC.0.1.TriggerNumericWarning";
+    "xyz.openbmc_project.Logging.Entry.Level.Warning";
 constexpr const char* TriggerNumericCritical =
-    "OpenBMC.0.1.TriggerNumericCritical";
-constexpr const char* TriggerDiscreteOK = "OpenBMC.0.1.TriggerDiscreteOK";
+    "xyz.openbmc_project.Logging.Entry.Level.Critical";
+constexpr const char* TriggerDiscreteOK =
+    "xyz.openbmc_project.Logging.Entry.Level.Informational";
 constexpr const char* TriggerDiscreteWarning =
-    "OpenBMC.0.1.TriggerDiscreteWarning";
+    "xyz.openbmc_project.Logging.Entry.Level.Warning";
 constexpr const char* TriggerDiscreteCritical =
-    "OpenBMC.0.1.TriggerDiscreteCritical";
+    "xyz.openbmc_project.Logging.Entry.Level.Critical";
 } // namespace redfish_message_ids
 
 namespace numeric
-- 
