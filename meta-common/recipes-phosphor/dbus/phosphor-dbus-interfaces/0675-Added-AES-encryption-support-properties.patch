From: madhankumars <madhankumars@ami.com>
Date: Thu, 30 May 2024 13:20:17 +0530
Subject: [PATCH 675/675] Added AES encryption support properties

---
 .../Network/Client.interface.yaml                | 15 +++++++++++++++
 .../Network/Client/Create.interface.yaml         | 16 ++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/yaml/xyz/openbmc_project/Network/Client.interface.yaml b/yaml/xyz/openbmc_project/Network/Client.interface.yaml
index 270877b..9f2f3a7 100644
--- a/yaml/xyz/openbmc_project/Network/Client.interface.yaml
+++ b/yaml/xyz/openbmc_project/Network/Client.interface.yaml
@@ -52,6 +52,21 @@ properties:
       errors:
           - xyz.openbmc_project.Common.Error.InvalidArgument
           - xyz.openbmc_project.Common.Error.InternalFailure
+    - name: Readonlypermission
+      type: boolean
+      description: >
+          Read-0 or write-1 permission for the particular user name this field need to be provided only for v3 other cases this should be blank
+      errors:
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+          - xyz.openbmc_project.Common.Error.InternalFailure
+    - name: Password
+      type: string
+      description: >
+          Password for the paticular specific SNMP user this field need to be provided only for v3 other cases this should be blank
+      errors:
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+          - xyz.openbmc_project.Common.Error.InternalFailure
+
 enumerations:
     - name: TransportProtocol
       description: >
diff --git a/yaml/xyz/openbmc_project/Network/Client/Create.interface.yaml b/yaml/xyz/openbmc_project/Network/Client/Create.interface.yaml
index e635340..dc3f87e 100644
--- a/yaml/xyz/openbmc_project/Network/Client/Create.interface.yaml
+++ b/yaml/xyz/openbmc_project/Network/Client/Create.interface.yaml
@@ -20,6 +20,22 @@ methods:
             type: string
             description: >
                 SNMP V3 User.
+          - name: Readonlypermission
+            type: boolean
+            description: >
+                Read-0 or write-1 permission for the particular user name this field need to be provided only for v3 other cases this should be blank.
+          - name: Password
+            type: string
+            description: >
+                Password for the paticular specific SNMP user this field need to be provided only for v3 other cases this should be blank
+          - name: Algorithm
+            type: string
+            description: >
+                The value of this property is the SNMP V3 algorithm SHA256, SHA384, SHA512. leave blank for v1,v2c
+          - name: Encryption
+            type: string
+            description: >
+                The value of this property is the SNMP V3 Encryption AES128. leave blank for v1,v2c
       errors:
           - xyz.openbmc_project.Common.Error.InvalidArgument
       returns:
