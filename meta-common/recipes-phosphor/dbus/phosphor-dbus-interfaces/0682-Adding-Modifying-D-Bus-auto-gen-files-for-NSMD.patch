+            type: uint16
+            description: >
+                Requested MinimumSecurity Version when Request Type is
+                RequestTypes.SpecifiedValue.
+      errors:
+          - xyz.openbmc_project.Common.Error.InternalFailure
+          - xyz.openbmc_project.Common.Error.InvalidArgument
