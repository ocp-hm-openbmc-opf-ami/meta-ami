diff --git a/yaml/com/nvidia/ImageCopyState.interface.yaml b/yaml/com/nvidia/ImageCopyState.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/ImageCopyState.interface.yaml
@@ -0,0 +1,48 @@
+description: >
+    Exposes the status and progress of an in-progress or completed RoT
+    firmware image copy operation from the active slot to the inactive
+    slot.
+
+properties:
+    - name: Status
+      type: enum[self.Status]
+      description: >
+          The status of the image copy operation.
+    - name: Progress
+      type: byte
+      description: >
+          The percent complete (0-100) of the image copy operation. The
+          value 101 indicates that progress reporting is not supported.
+
+enumerations:
+    - name: Status
+      description: >
+          The status of an image copy operation.
+      values:
+          - name: ImageCopyNotTriggered
+            description: >
+                No image copy operation has been triggered.
+          - name: InProgress
+            description: >
+                The image copy operation is in progress.
+          - name: Complete
+            description: >
+                The image copy operation completed successfully.
+          - name: UndefinedFailure
+            description: >
+                The image copy operation failed for an undefined reason.
+          - name: NoValidImage
+            description: >
+                The image copy operation failed because no valid image was
+                found in the active slot.
+          - name: DestinationWriteProtected
+            description: >
+                The image copy operation failed because the destination
+                slot is write protected.
+          - name: FailFlashAccess
+            description: >
+                The image copy operation failed due to a flash access
+                failure.
+          - name: FailedVerify
+            description: >
+                The image copy operation failed image verification.
