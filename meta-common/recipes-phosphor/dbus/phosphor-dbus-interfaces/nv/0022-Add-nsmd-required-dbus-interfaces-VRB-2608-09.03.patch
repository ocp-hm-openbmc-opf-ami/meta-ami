diff --git a/yaml/com/nvidia/NVLink/PortHealthMetrics.interface.yaml b/yaml/com/nvidia/NVLink/PortHealthMetrics.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/NVLink/PortHealthMetrics.interface.yaml
@@ -0,0 +1,65 @@
+description: >
+    Exposes NVLink port health metrics used to provide an early indication
+    of link degradation and the reason a link health attention was
+    triggered.
+
+properties:
+    - name: EarlyHealthIndication
+      type: enum[self.EarlyHealthIndicationValues]
+      description: >
+          An early indication of the health state of this NVLink port.
+    - name: AttentionTriggerReason
+      type: enum[self.AttentionTriggerReasonValues]
+      description: >
+          The reason the most recent link health attention was triggered.
+
+enumerations:
+    - name: EarlyHealthIndicationValues
+      description: >
+          The early health indication state of an NVLink port.
+      values:
+          - name: Unknown
+            description: >
+                The early health indication state is unknown.
+          - name: Healthy
+            description: >
+                The port is healthy.
+          - name: Attention
+            description: >
+                The port requires attention.
+    - name: AttentionTriggerReasonValues
+      description: >
+          The reason a link health attention was triggered.
+      values:
+          - name: Unknown
+            description: >
+                No attention has been triggered, or the reason is unknown.
+          - name: RawBER
+            description: >
+                Attention triggered by the raw bit error rate.
+          - name: EffectiveBER
+            description: >
+                Attention triggered by the effective bit error rate.
+          - name: SymbolBER
+            description: >
+                Attention triggered by the symbol bit error rate.
+          - name: PLRTXBandwidthLoss
+            description: >
+                Attention triggered by Physical Layer Retry (PLR) transmit
+                bandwidth loss.
+          - name: PLRRXBandwidthLoss
+            description: >
+                Attention triggered by Physical Layer Retry (PLR) receive
+                bandwidth loss.
+          - name: RecoveryBandwidthLoss
+            description: >
+                Attention triggered by link recovery bandwidth loss.
+          - name: PortTotalBandwidthLoss
+            description: >
+                Attention triggered by total port bandwidth loss.
+          - name: LinkDownCount
+            description: >
+                Attention triggered by the link down count.
+          - name: SymbolErrorCount
+            description: >
+                Attention triggered by the symbol error count.
diff --git a/yaml/com/nvidia/Software/ProtectionOptionsMode.interface.yaml b/yaml/com/nvidia/Software/ProtectionOptionsMode.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Software/ProtectionOptionsMode.interface.yaml
@@ -0,0 +1,56 @@
+description: >
+    Implement to provide host access restriction (protection) options for
+    a network adapter's firmware and configuration.
+
+properties:
+    - name: HostFirmwareUpdateRestrictionEnabled
+      type: boolean
+      description: >
+          An indication of whether host software is restricted from
+          updating the device firmware.
+    - name: HostConfigurationChangeRestrictionEnabled
+      type: boolean
+      description: >
+          An indication of whether host software is restricted from
+          changing the device configuration.
+    - name: HostTransceiverFirmwareUpdateRestrictionEnabled
+      type: boolean
+      description: >
+          An indication of whether host software is restricted from
+          updating transceiver firmware.
+    - name: HostTransceiverConfigurationChangeRestrictionEnabled
+      type: boolean
+      description: >
+          An indication of whether host software is restricted from
+          changing transceiver configuration.
+
+methods:
+    - name: SetProtectionOptions
+      description: >
+          Sets all host access restriction (protection) options in a
+          single request.
+      parameters:
+          - name: HostFirmwareUpdateRestrictionEnabled
+            type: boolean
+            description: >
+                An indication of whether host software is restricted from
+                updating the device firmware.
+          - name: HostConfigurationChangeRestrictionEnabled
+            type: boolean
+            description: >
+                An indication of whether host software is restricted from
+                changing the device configuration.
+          - name: HostTransceiverFirmwareUpdateRestrictionEnabled
+            type: boolean
+            description: >
+                An indication of whether host software is restricted from
+                updating transceiver firmware.
+          - name: HostTransceiverConfigurationChangeRestrictionEnabled
+            type: boolean
+            description: >
+                An indication of whether host software is restricted from
+                changing transceiver configuration.
+      errors:
+          - xyz.openbmc_project.Common.Error.NotAllowed
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+          - xyz.openbmc_project.Common.Error.Unavailable
