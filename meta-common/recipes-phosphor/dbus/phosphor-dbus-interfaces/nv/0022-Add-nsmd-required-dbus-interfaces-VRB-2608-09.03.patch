diff --git a/yaml/com/nvidia/AdaptiveTGPMode.interface.yaml b/yaml/com/nvidia/AdaptiveTGPMode.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/AdaptiveTGPMode.interface.yaml
@@ -0,0 +1,20 @@
+description: >
+   Implement to provide GPU AdaptiveTGPMode (Dual Part Number) details.
+
+properties:
+    - name: AdaptiveTGPModeEnabled
+      type: boolean
+      description: >
+            Adaptive TGP (Total Graphics Power) mode for this processor.
+      errors:
+          # Indicate that timeout from the device response
+          - xyz.openbmc_project.Common.Error.Timeout
+          # Indicate that this property is temporarily unable to be changed.
+          - xyz.openbmc_project.Common.Error.Unavailable
+          # Indicate a failure to apply changes to the processor.
+          - xyz.openbmc_project.Common.Device.Error.WriteFailure
+
+    - name: PendingAdaptiveTGPMode
+      type: boolean
+      description: >
+            Pending adaptive TGP (Total Graphics Power) mode for this processor.
diff --git a/yaml/com/nvidia/DeviceMode/LTXMode.interface.yaml b/yaml/com/nvidia/DeviceMode/LTXMode.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/DeviceMode/LTXMode.interface.yaml
@@ -0,0 +1,42 @@
+description: >
+    Implement to provide the switch link training extended (LTX) mode
+    current and pending state.
+
+properties:
+    - name: CurrentMode
+      type: enum[self.LinkTrainingExtendedMode]
+      description: >
+          The current link training extended mode.
+    - name: PendingMode
+      type: enum[self.LinkTrainingExtendedMode]
+      description: >
+          The pending link training extended mode requested by in-band or
+          out-of-band software.
+      errors:
+          # Indicate that timeout from the device response
+          - xyz.openbmc_project.Common.Error.Timeout
+          # Indicate that this property is temporarily unable to be changed.
+          - xyz.openbmc_project.Common.Error.Unavailable
