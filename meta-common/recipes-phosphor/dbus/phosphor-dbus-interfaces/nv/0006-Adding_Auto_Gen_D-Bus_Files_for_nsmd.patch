+      values:
+        - name: NotReceived
+          description: >
+              Report not yet received.
+        - name: Received
+          description: >
+              Report is received.
+        - name: Timeout
+          description: >
+              Timeout occured and receiving report.
+        - name: Error
+          description: >
+              Error occured and receiving report.
+        - name: Unknown
+          description: >
