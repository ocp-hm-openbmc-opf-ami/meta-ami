+
+properties:
+    - name: FMState
+      type: enum[self.FabricManagerState]
+      description: >
+            Fabric manager state.
+    - name: ReportStatus
+      type: enum[self.FabricManagerReportStatus]
+      description: >
+            Fabric manager report status.
