diff --git a/yaml/com/nvidia/DebugToken.interface.yaml b/yaml/com/nvidia/DebugToken.interface.yaml
new file mode 100644
index 0000000..927dcde
--- /dev/null
+++ b/yaml/com/nvidia/DebugToken.interface.yaml
@@ -0,0 +1,144 @@
+description: >
+  Implement to provide debug token-related functionalities for NSM devices. Any
+  object implementing the DebugToken interface must implement the
+  xyz.openbmc_project.Common.Progress interface.
+
+properties:
+  - name: TokenDeviceID
+    type: string
+    description: >
+      Token-specific device identification property of the device.
+    default: ""
+  - name: RequestFd
+    type: unixfd
+    description: >
+      File descriptor pointing to file containing the last acquired debug token
+      request data. Populated after a successful execution of the GetRequest
+      method.
+  - name: TokenStatus
+    type: struct[enum[self.TokenTypes], enum[self.TokenStatus], enum[self.AdditionalInfo], uint32]
+    description: >
+      Debug session and token installation status data. Populated after
+      a successful execution of the GetStatus method.
+  - name: ErrorCode
+    type: struct[uint16, string]
+    description: >
+      This property indicates ErrorCode and message when Debug Token command fails.
+
+methods:
+  - name: DisableTokens
+    description: >
+      Disable installed tokens.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.Unavailable
+
+  - name: GetRequest
+    description: >
+      Generate debug token request. Output data is stored in a file, the file
+      descriptor of which is stored in the RequestFd property.
+    parameters:
+      - name: TokenOpcode
+        type: enum[self.TokenOpcodes]
+        description: >
+          Token opcode the request should be generated for.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+
+  - name: GetStatus
+    description: >
+      Get debug session and token installation status. Output data is stored in
+      the TokenStatus property.
+    parameters:
+      - name: TokenType
+        type: enum[self.TokenTypes]
+        description: >
+          Type of the token to get status of.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+
+  - name: InstallToken
+    description: >
+      Install signed token.
+    parameters:
+      - name: TokenData
+        type: array[byte]
+        description: >
+          Token binary data.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+
+enumerations:
+  - name: TokenOpcodes
+    description: >
+      Identifies the token type the token request is generated for.
+    values:
+      - name: CRCS
+        description: >
+          CRCS token.
+      - name: CRDT
+        description: >
+          CRDT token.
+
+  - name: TokenTypes
+    description: >
+      Identifies the token type the status is queried for.
+    values:
+      - name: FRC
+        description: >
+          FRC token.
+      - name: CRCS
+        description: >
+          CRCS token.
+      - name: CRDT
+        description: >
+          CRDT token.
+      - name: DebugFirmware
+        description: >
+          Currently running debug firmware.
+
+  - name: TokenStatus
+    description: >
+      Token status information
+    values:
+      - name: QueryFailure
+        description: >
+          Failed to execute the query operation.
+      - name: DebugSessionActive
+        description: >
+          Debug session is active.
+      - name: NoTokenApplied
+        description: >
+          No token is applied.
+      - name: ChallengeProvided
+        description: >
+          Challenge provided, token not installed yet.
+      - name: InstallationTimeout
+        description: >
+          Timeout occurred before token was installed.
+      - name: TokenTimeout
+        description: >
+          Timeout occurred for active token.
+
+  - name: AdditionalInfo
+    description: >
+      Additional information related to the token status.
+    values:
+      - name: None
+        description: >
+          No additional information available.
+      - name: NoDebugSession
+        description: >
+          There is no debug session in progress.
+      - name: DebugSessionQueryDisallowed
+        description: >
+          Device is not allowed to query debug session.
+      - name: DebugSessionActive
+        description: >
+          Debug firmware running.
diff --git a/yaml/com/nvidia/Dump/DebugInfo.interface.yaml b/yaml/com/nvidia/Dump/DebugInfo.interface.yaml
new file mode 100644
index 0000000..adb8105
--- /dev/null
+++ b/yaml/com/nvidia/Dump/DebugInfo.interface.yaml
@@ -0,0 +1,94 @@
+description: >
+  Implement if service supports fetching device debug information from device in chunks.
+
+methods:
+  - name: GetDebugInfo
+    description: >
+      Get device debug information from device in chunks for current
+      record handle.
+    parameters:
+      - name: DebugInfoType
+        type: enum[self.DebugInformationType]
+        description: >
+          The type of debug informatio to be fetched from device.
+      - name: RecordHandle
+        type: uint64
+        description: >
+          The record handle corresponding to which the info chunk will be
+          fetched from device, example first record handle is zero.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+
+properties:
+  - name: RecordHandle
+    type: uint64
+    description: >
+      The record handle corresponding to which data is present in file descriptor Fd.
+  - name: NextRecordHandle
+    type: uint64
+    description: >
+      The next record handle corresponding to which information is to be fetched from device.
+  - name: Status
+    type: enum[self.OperationStatus]
+    description: >
+      Indicates status of the asynchronous GetDebugInfo method call.
+  - name: Fd
+    type: unixfd
+    description: >
+      File descriptor pointing to file containing the last acquired debug information
+      request data. Populated after a successful execution of the GetDebugInfo
+      method.
+
+enumerations:
+  - name: DebugInformationType
+    description: >
+      Possible types for debug information.
+    values:
+      - name: DeviceInformation
+        description: >
+          Device Information from device.
+      - name: FWRuntimeData
+        description: >
+          FW runtime data from device.
+      - name: FWSavedInfo
+        description: >
+          FW saved dump information from device.
+      - name: DeviceDump
+        description: >
+          Device dump information which include FW saved dump & Device state.
+      - name: Others
+        description: >
+          Others.
+
+  - name: OperationStatus
+    description: >
+      The status of the asynchronous method call operations
+    values:
+      - name: "InProgress"
+        description: >
+          The Operation is in progress.
+      - name: "Success"
+        description: >
+          The Operation completed successfully.
+      - name: "Timeout"
+        description: >
+          The Operation timed out.
+      - name: "InvalidArgument"
+        description: >
+          The value of one of more arguments is invalid for this
+          Operation.
+      - name: "InternalFailure"
+        description: >
+          The Operation failed internally.
+      - name: "Unavailable"
+        description: >
+          The Object on which the operation is being performed is
+          temporarily unavailable.
+      - name: "UnsupportedRequest"
+        description: >
+          The Operation is not supported for the object.
+      - name: "WriteFailure"
+        description: >
+          The Operation failed while sending write request to the device.
