diff --git a/yaml/xyz/openbmc_project/Dump/Entry/CPERDecode.interface.yaml b/yaml/xyz/openbmc_project/Dump/Entry/CPERDecode.interface.yaml
new file mode 100644
index 0000000..797a998
--- /dev/null
+++ b/yaml/xyz/openbmc_project/Dump/Entry/CPERDecode.interface.yaml
@@ -0,0 +1,50 @@
+#Example CPER Decoded Information YAML file
+# To be moved into different interfaces based on type of error
+description: Implement this to dump CPER Decoded information on the DBus
+
+properties:
+  - name: Section_Type
+    type: string
+    description: Indicates the type of section in which the error occured
+  - name: FRU_ID
+    type: string
+    description: The FRU ID indicates the unique physical device which throws an error
+  - name: Severity
+    type: string
+    description: Indicates the section severity of the error
+  - name: NV_IPSignature
+    type: string
+    description: Indicates the IP Signature of the NV CPER Type
+  - name: NV_Severity
+    type: string
+    description: Indicates the severity of the NV CPER Type
+  - name: NV_Socket_Number
+    type: string
+    description: Indicates the socket number of the NV CPER Type
+  - name: PCIE_Vendor_ID
+    type: string
+    description: Indicates the Vendor ID of the PCIE CPER Type
+  - name: PCIE_Device_ID
+    type: string
+    description: Indicates the Device ID of the PCIE CPER Type
+  - name: PCIE_Class_Code
+    type: string
+    description: Indicates the Class Code of the PCIE CPER Type
+  - name: PCIE_Function_Number
+    type: string
+    description: Indicates the Function Number of the PCIE CPER Type
+  - name: PCIE_Device_Number
+    type: string
+    description: Indicates the Device Number of the PCIE CPER Type
+  - name: PCIE_Segment_Number
+    type: string
+    description: Indicates the Segment Number of the PCIE CPER Type
+  - name: PCIE_Device_Bus_Number
+    type: string
+    description: Indicates the Device Bus Number of the PCIE CPER Type
+  - name: PCIE_Secondary_Bus_Number
+    type: string
+    description: Indicates the Secondary Bus Number of the PCIE CPER Type
+  - name: PCIE_Slot_Number
+    type: string
+    description: Indicates the Slot Number of the PCIE CPER Type
\ No newline at end of file
diff --git a/yaml/xyz/openbmc_project/Dump/Entry/FaultLog.interface.yaml b/yaml/xyz/openbmc_project/Dump/Entry/FaultLog.interface.yaml
index 08b33a8..5c8b6b8 100644
--- a/yaml/xyz/openbmc_project/Dump/Entry/FaultLog.interface.yaml
+++ b/yaml/xyz/openbmc_project/Dump/Entry/FaultLog.interface.yaml
@@ -3,7 +3,7 @@ description: >
 
 properties:
     - name: Type
-      type: enum[xyz.openbmc_project.Common.FaultLogType.FaultLogTypes]
+      type: enum[self.FaultDataType]
       description: >
           Type of fault data in the log indicated by PrimaryLogId.
       flags:
@@ -23,3 +23,17 @@ properties:
           be programatically interpreted (e.g. string parsing)
       flags:
           - const
+
+enumerations:
+    - name: FaultDataType
+      description: >
+          Type of fault data logged.
+      values:
+          - name: CPER
+            description: >
+                UEFI Common Platform Error Record
+          - name: Crashdump
+            description: >
+                Collection of processor and chipset register values typically
+                gathered for debugging purposes at the time of a crash (or
+                sometimes on-demand)
-- 
