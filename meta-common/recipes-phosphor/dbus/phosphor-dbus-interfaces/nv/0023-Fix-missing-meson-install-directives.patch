From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: karthickk <karthickk@ami.com>
Date: Wed, 13 Aug 2026 00:00:00 +0530
Subject: [PATCH] Fix missing meson install directives for nsmd required interfaces

Add sdbusplus_current_path and install directives to all generated_sources
custom_target meson.build files that were created without them.
Also install headers for the remaining interfaces directly included by NSMD.
---

diff --git a/gen/xyz/openbmc_project/PCIe/PCIeClockMode/meson.build b/gen/xyz/openbmc_project/PCIe/PCIeClockMode/meson.build
--- a/gen/xyz/openbmc_project/PCIe/PCIeClockMode/meson.build
+++ b/gen/xyz/openbmc_project/PCIe/PCIeClockMode/meson.build
@@ -27,3 +27,12 @@
         'xyz/openbmc_project/PCIe/PCIeClockMode',
     ],
+    install: should_generate_cpp,
+    install_dir: [
+        get_option('includedir') / 'xyz/openbmc_project/PCIe/PCIeClockMode',
+        get_option('includedir') / 'xyz/openbmc_project/PCIe/PCIeClockMode',
+        false,
+        get_option('includedir') / 'xyz/openbmc_project/PCIe/PCIeClockMode',
+        get_option('includedir') / 'xyz/openbmc_project/PCIe/PCIeClockMode',
+    ],
+    build_by_default: should_generate_cpp,
 )

