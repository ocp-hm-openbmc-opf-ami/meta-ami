From 5f83d8e58c67eccdfa8bfcdfe075c70df485a29c Mon Sep 17 00:00:00 2001
From: radhikad <radhikad@ami.com>
Date: Wed, 15 Jul 2026 19:38:10 +0530
Subject: [PATCH] Add nsmd dbus interface updates for SRCREV 123d8042

Changes consolidated from patches 0017-0020:
- Add com/nvidia/Reset interface with NvidiaResetTypes enum
  (DeviceFullReset, NetworkGracefulReset, ComputeGracefulReset,
  ComputeGracefulShutDown, OpticalModuleGracefulReset)
- Add gen/com/nvidia/Reset meson.build and subdir entry
- Add LPX and I2cVregUnlock to DebugToken SubTypes enum
- Add InvalidArgument, WriteFailure, ConflictingOperation,
  ResourceNotFound to Dump/Erase OperationStatus enum

Upstream-Status: Pending

Rebased onto main after patch 0013; overlapping existing definitions are
retained and missing generators are registered in the current Meson tree.

---
diff --git a/gen/com/nvidia/Reset/meson.build b/gen/com/nvidia/Reset/meson.build
new file mode 100644
--- /dev/null
+++ b/gen/com/nvidia/Reset/meson.build
@@ -0,0 +1,34 @@
+# Generated file; do not modify.
+
+sdbusplus_current_path = 'com/nvidia/Reset'
+
+generated_sources += custom_target(
+    'com/nvidia/Reset__cpp'.underscorify(),
+    input: [
+        '../../../../yaml/com/nvidia/Reset.interface.yaml',
+    ],
+    output: [
+        'common.hpp',
+        'server.hpp',
+        'server.cpp',
+        'aserver.hpp',
+        'client.hpp',
+    ],
+    depend_files: sdbusplusplus_depfiles,
+    command: [
+        sdbuspp_gen_meson_prog, '--command', 'cpp',
+        '--output', meson.current_build_dir(),
+        '--tool', sdbusplusplus_prog,
+        '--directory', meson.current_source_dir() / '../../../../yaml',
+        'com/nvidia/Reset',
+    ],
+    install: should_generate_cpp,
+    install_dir: [
+        get_option('includedir') / sdbusplus_current_path,
+        get_option('includedir') / sdbusplus_current_path,
+        false,
+        get_option('includedir') / sdbusplus_current_path,
+        get_option('includedir') / sdbusplus_current_path,
+    ],
+    build_by_default: should_generate_cpp,
+)
diff --git a/gen/com/nvidia/meson.build b/gen/com/nvidia/meson.build
--- a/gen/com/nvidia/meson.build
+++ b/gen/com/nvidia/meson.build
@@ -28,6 +28,7 @@
 subdir('PowerSmoothing')
 subdir('PowerSupply')
 subdir('Protocol')
+subdir('Reset')
 subdir('ResetCounters')
 subdir('RoT')
 subdir('SMUtilization')
diff --git a/yaml/com/nvidia/Dump/Erase.interface.yaml b/yaml/com/nvidia/Dump/Erase.interface.yaml
--- a/yaml/com/nvidia/Dump/Erase.interface.yaml
+++ b/yaml/com/nvidia/Dump/Erase.interface.yaml
@@ -84,3 +84,15 @@
       - name: "UnsupportedRequest"
         description: >
           The Operation is not supported for the object.
+      - name: "InvalidArgument"
+        description: >
+          The Operation failed due to an invalid argument.
+      - name: "WriteFailure"
+        description: >
+          The Operation failed due to a write failure.
+      - name: "ConflictingOperation"
+        description: >
+          The Operation failed due to a conflicting operation.
+      - name: "ResourceNotFound"
+        description: >
+          The Operation failed because the resource was not found.
diff --git a/yaml/com/nvidia/Reset.interface.yaml b/yaml/com/nvidia/Reset.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Reset.interface.yaml
@@ -0,0 +1,30 @@
+description: >
+    Interface for Nvidia device reset operations.
+    Advertises the type of reset this object represents.
+
+properties:
+    - name: ResetType
+      type: enum[self.NvidiaResetTypes]
+      description: >
+          The generic NSM reset target type for this reset object.
+
+enumerations:
+    - name: NvidiaResetTypes
+      description: >
+          Types of device reset operations supported.
+      values:
+          - name: DeviceFullReset
+            description: >
+                Full device reset.
+          - name: NetworkGracefulReset
+            description: >
+                Network (DPU) graceful reset.
+          - name: ComputeGracefulReset
+            description: >
+                Compute (ARM) graceful reset.
+          - name: ComputeGracefulShutDown
+            description: >
+                Compute (ARM) graceful shutdown.
+          - name: OpticalModuleGracefulReset
+            description: >
+                Optical module graceful reset.

-- 
2.34.1
