diff --git a/yaml/com/nvidia/Dot/Action.interface.yaml b/yaml/com/nvidia/Dot/Action.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Dot/Action.interface.yaml
@@ -0,0 +1,405 @@
+description: >
+  Implement to provide DOT (Device Ownership Transfer) functionalities.
+
+properties:
+  - name: DOTState
+    type: enum[self.DOTStates]
+    default: Unknown
+    description: >
+      Current DOT state of the device.
+
+methods:
+  - name: DotCAKInstall
+    description: >
+      Install DOT CAK (Code Authentication Key).
+    parameters:
+      - name: CakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          CAK key authentication scheme.
+      - name: CakEcdsaKey
+        type: string
+        description: >
+          CAK ECDSA key data.
+      - name: CakLmsKey
+        type: string
+        description: >
+          CAK LMS key data.
+      - name: LakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          LAK key authentication scheme.
+      - name: LakEcdsaKey
+        type: string
+        description: >
+          LAK ECDSA key data.
+      - name: LakLmsKey
+        type: string
+        description: >
+          LAK LMS key data.
+      - name: LockDisable
+        type: boolean
+        description: >
+          Lock disable flag (false: lock enabled, true: lock disabled).
+      - name: OwnerMinSvn
+        type: byte
+        description: >
+          Owner-defined Minimum Security Version Number used to verify
+          the owner firmware security version in the Internal Root of Trust (IRoT).
+      - name: VendorMinSvn
+        type: byte
+        description: >
+          Vendor-defined Minimum Security Version Number used to verify the vendor
+          firmware security version in the Internal Root of Trust (IRoT).
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: Bypass
+    description: >
+      Bypass DOT CAK installation. This method allows bypassing the 
+      DOT authentication requirement.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: UnlockChallenge
+    description: >
+      Request an unlock challenge from the device prior to unlock operations.
+    parameters:
+      - name: UnlockType
+        type: enum[self.UnlockType]
+        description: >
+          Unlock operation type.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: Unlock
+    description: >
+      Unlock DOT to transition from locked to volatile state or disabled to uninitialized state.
+    parameters:
+      - name: UnlockSignatureAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          Signature authentication scheme.
+      - name: ECDSASignature
+        type: string
+        description: >
+          ECDSA signature.
+      - name: LMSSignature
+        type: string
+        description: >
+          LMS signature.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: Lock
+    description: >
+      Lock DOT to transition from volatile state to locked state.
+    parameters:
+      - name: CakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          CAK key authentication scheme.
+      - name: CakEcdsaKey
+        type: string
+        description: >
+          CAK ECDSA key data.
+      - name: CakLmsKey
+        type: string
+        description: >
+          CAK LMS key data.
+      - name: LakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          LAK key authentication scheme.
+      - name: LakEcdsaKey
+        type: string
+        description: >
+          LAK ECDSA key data.
+      - name: LakLmsKey
+        type: string
+        description: >
+          LAK LMS key data.
+      - name: UnlockMethod
+        type: enum[self.UnlockMethod]
+        description: >
+          Unlock method for lock operation.
+      - name: StaticChallenge
+        type: string
+        description: >
+          Required when UnlockMethod is StaticValue
+      - name: LockSignatureAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          Signature authentication scheme.
+      - name: ECDSASignature
+        type: string
+        description: >
+          ECDSA signature.
+      - name: LMSSignature
+        type: string
+        description: >
+          LMS signature.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: GetInfo
+    description: >
+      Get DOT information including version, fuse state, and DOT blob.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: CAKRotate
+    description: >
+      Rotate the locked CAK without causing a DOT FUSE State change.
+      The command is signed by LAK (priv component). The old DOT Blob for
+      the prior CAK would still be usable as the DOT FUSE State did not alter.
+      The new dot blob will be returned to BMC upon ack DOT_CAK_ROTATE command.
+    parameters:
+      - name: CakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          CAK key authentication scheme.
+      - name: CakEcdsaKey
+        type: string
+        description: >
+          CAK ECDSA key data.
+      - name: CakLmsKey
+        type: string
+        description: >
+          CAK LMS key data.
+      - name: CAKRotateSignatureAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          Signature authentication scheme.
+      - name: ECDSASignature
+        type: string
+        description: >
+          ECDSA signature.
+      - name: LMSSignature
+        type: string
+        description: >
+          LMS signature.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: RecoverDOT
+    description: >
+      This method is used only when DOT is corrupted in device and user has backup DOT.
+      Upon sending the DOT blob device will validate and recovers the DOT by updating
+      DOT blob in the device.
+    parameters:
+      - name: DOTData
+        type: unixfd
+        description: >
+          File descriptor containing backup DOT data.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: Override
+    description: >
+      Override DOT to reset ownership state when valid DOT data can no longer be recovered.
+      Requires vendor signature signed by Nvidia vendor key. UnlockChallenge with
+      VendorUnlock type should be used prior to Override.
+    parameters:
+      - name: VendorSignatureAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          Vendor signature authentication scheme.
+      - name: ECDSASignature
+        type: string
+        description: >
+          ECDSA signature with challenge from UnlockChallenge.
+      - name: LMSSignature
+        type: string
+        description: >
+          LMS signature with challenge from UnlockChallenge.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: Disable
+    description: >
+      Disable DOT to transition from uninitialized state to disabled state.
+    parameters:
+      - name: LakKeyAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          LAK key authentication scheme.
+      - name: LakEcdsaKey
+        type: string
+        description: >
+          LAK ECDSA key data.
+      - name: LakLmsKey
+        type: string
+        description: >
+          LAK LMS key data.
+      - name: UnlockMethod
+        type: enum[self.UnlockMethod]
+        description: >
+          Unlock method for disable operation.
+      - name: StaticChallenge
+        type: string
+        description: >
+          Required when Unlock_Method is StaticValue.
+      - name: DisableSignatureAuthScheme
+        type: enum[self.KeyAuthScheme]
+        description: >
+          Signature authentication scheme.
+      - name: ECDSASignature
+        type: string
+        description: >
+          ECDSA signature.
+      - name: LMSSignature
+        type: string
+        description: >
+          LMS signature.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+enumerations:
+  - name: KeyAuthScheme
+    description: >
+      Key authentication scheme types for DOT operations.
+    values:
+      - name: Ecdsa
+        description: >
+          ECDSA-only authentication scheme.
+      - name: Hybrid
+        description: >
+          Hybrid ECDSA+LMS authentication scheme.
+
+  - name: UnlockType
+    description: >
+      Type of unlock operation for DOT unlock challenge.
+    values:
+      - name: OwnerUnlock
+        value: 1
+        description: >
+          Owner unlock type, indicates an owner calling DOT_UNLOCK.
+      - name: VendorUnlock
+        value: 2
+        description: >
+          Vendor unlock type, indicates a vendor calling DOT_OVERRIDE.
+
+  - name: UnlockMethod
+    description: >
+      Unlock method for lock operation.
+    values:
+      - name: DeviceUniqueIdentifier
+        description: >
+          Per-device unique identifier.
+      - name: RandomNonce
+        description: >
+          Randomly generated nonce.
+      - name: StaticValue
+        description: >
+          Static value provided during lock or disable.
+
+  - name: DOTStates
+    description: >
+      DOT state values for the device.
+    values:
+      - name: Uninitialized
+        description: >
+          DOT is not initialized.
+      - name: Volatile
+        description: >
+          DOT is in volatile state.
+      - name: Locked
+        description: >
+          DOT is in mutable locked state.
+      - name: Disabled
+        description: >
+          DOT is in mutable disabled state.
+      - name: Unknown
+        description: >
+          DOT state is unknown or cannot be determined.
diff --git a/yaml/com/nvidia/Dot/Blob.interface.yaml b/yaml/com/nvidia/Dot/Blob.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Dot/Blob.interface.yaml
@@ -0,0 +1,53 @@
+description: >
+  Interface for managing DOT (Device Ownership Transfer) blob storage on the BMC.
+  DOT blobs are binary data stored on BMC persistent storage and is used
+  during firmware recovery scenarios Each processor has its own blob storage
+  accessible via a unique D-Bus object path, Ex: /xyz/openbmc_project/dot_blob/CPU_0.
+  Service implementing this object path needs to make sure it's mapped to a binary
+  file for the device, which will be consumed by recovery service.
+
+methods:
+  - name: GetBlob
+    description: >
+      Retrieve the stored DOT blob from BMC persistent storage from the device. The client
+      shall use this action for redundancy checks in case of DOT `Lock`, `Disable`,
+      `CAKRotate` or `GetInfo` action and in recovery mode to recover the device with DOT data.
+    returns:
+      - name: BlobFd
+        type: unixfd
+        description: >
+          The file descriptor containing the DOT blob data.
+    errors:
+      - xyz.openbmc_project.Common.File.Error.Read
+      - xyz.openbmc_project.Common.File.Error.Open
+      - xyz.openbmc_project.Common.Error.ResourceNotFound
+
+  - name: UpdateBlob
+    description: >
+      Update the DOT blob stored on BMC persistent storage from the device.
+      The client shall use this action to update the DOT blob which was received as 
+      part of successful Lock, Disable, CAKRotate or GetInfo action. Successive firmware 
+      recovery in BMC will use the updated blob. Also empty blob with all 0s can be sent 
+      to initiate DOT override flow.
+    parameters:
+      - name: BlobFd
+        type: unixfd
+        description: >
+          The file descriptor containing the new DOT blob data.
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+          DBus object path of the async operation status object.
+          Interface com.nvidia.Async.Status at this returned object path
+          can be used to retrieve the status of the operation.
+    errors:
+      - xyz.openbmc_project.Common.Error.Unavailable
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.File.Error.Read
+      - xyz.openbmc_project.Common.File.Error.Write
+      - xyz.openbmc_project.Common.File.Error.Open
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+
+paths:
+  - namespace: /xyz/openbmc_project/dot_blob

-- 
