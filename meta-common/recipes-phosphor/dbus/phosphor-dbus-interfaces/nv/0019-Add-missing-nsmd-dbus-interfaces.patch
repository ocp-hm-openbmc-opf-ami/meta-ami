From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: karthickk <karthickk@ami.com>
Date: Wed, 13 Aug 2026 00:00:00 +0530
Subject: [PATCH] Add missing nsmd dbus interfaces

Add meson.build and YAML for interfaces required by nsmd but missing.

Upstream-Status: Pending

Rebased onto main after patch 0013; overlapping existing definitions are
retained and missing generators are registered in the current Meson tree.

---
diff --git a/gen/com/nvidia/Dot/Action/meson.build b/gen/com/nvidia/Dot/Action/meson.build
new file mode 100644
--- /dev/null
+++ b/gen/com/nvidia/Dot/Action/meson.build
@@ -0,0 +1,34 @@
+# Generated file; do not modify.
+generated_sources += custom_target(
+    'com/nvidia/Dot/Action__cpp'.underscorify(),
+    input: ['../../../../../yaml/com/nvidia/Dot/Action.interface.yaml'],
+    output: [
+        'common.hpp',
+        'server.hpp',
+        'server.cpp',
+        'aserver.hpp',
+        'client.hpp',
+    ],
+    depend_files: sdbusplusplus_depfiles,
+    command: [
+        sdbuspp_gen_meson_prog,
+        '--command',
+        'cpp',
+        '--output',
+        meson.current_build_dir(),
+        '--tool',
+        sdbusplusplus_prog,
+        '--directory',
+        meson.current_source_dir() / '../../../../../yaml',
+        'com/nvidia/Dot/Action',
+    ],
+    install: should_generate_cpp,
+    install_dir: [
+        get_option('includedir') / 'com/nvidia/Dot/Action',
+        get_option('includedir') / 'com/nvidia/Dot/Action',
+        false,
+        get_option('includedir') / 'com/nvidia/Dot/Action',
+        get_option('includedir') / 'com/nvidia/Dot/Action',
+    ],
+    build_by_default: should_generate_cpp,
+)
