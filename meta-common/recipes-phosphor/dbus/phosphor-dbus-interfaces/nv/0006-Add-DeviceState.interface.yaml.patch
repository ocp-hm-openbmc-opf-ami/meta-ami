new file mode 100644
index 00000000..0ea98459
--- /dev/null
+++ b/yaml/com/nvidia/State/DeviceState.interface.yaml
@@ -0,0 +1,118 @@
+description: >
+    Interface to query device status and retrieve error information.
+    This interface is implemented on EID-specific object paths following the
+    pattern /com/nvidia/state/device_status/<EID>, where <EID> is the
+    MCTP Endpoint ID. The status is computed on-demand when the property is
+    read. D-Bus signals are emitted when the status changes.
+
+properties:
+    - name: DeviceStatus
+      type: dict[enum[self.StatusType],struct[enum[self.DeviceHealth],array[struct[int64,enum[self.ErrorClass],dict[string,string]]]]]
+      description: >
+          Map of status types to device health and errors. The key is the StatusType
+          (Communication, PLDM, etc.), and the value is a structure containing the
+          DeviceHealth for that specific status type (Healthy or Degraded) and an
+          array of current active errors for that category.
+          Each error entry in the array is a structure containing:
+          - errorCode (int64): Implementation-defined numeric error code.
+            The meaning is determined by the combination of errorCode and
+            errorClass. Implementations provide helper functions to map 
+            (errorCode, errorClass) pairs to human-readable messages 
+            and Redfish event data.
+          - errorClass (ErrorClass): The classification or category of the error
+            (Power, Recovery, PhysicalInterface, MCTP). Used with errorCode to
+            determine the specific error condition.
+          - additionalData (dict[string,string]): Contains key-value pairs capturing
+            additional error data required to create event log entry. Common keys
+            include REDFISH_MESSAGE_ID and REDFISH_MESSAGE_ARGS.
+          
+          Example usage:
+            Reading property returns:
+            {
+              Communication: (Degraded, [
+                (0x02, MCTP, {"REDFISH_MESSAGE_ID": "ResourceEvent.1.2.ResourceErrorsDetected",
+                              "REDFISH_MESSAGE_ARGS": "GPU0, MCTP Ping Timeout"}),
+                (0x01, Power, {"REDFISH_MESSAGE_ID": "ResourceEvent.1.2.ResourcePoweredOn",
+                               "REDFISH_MESSAGE_ARGS": "GPU0"})
+              ]),
+              PLDM: (Healthy, [])
+            }
+          
+          This indicates:
+          - StatusType=Communication has Degraded health with two errors
+            - ErrorClass=MCTP: ping timeout (code 0x02)
+            - ErrorClass=Power: power on event (code 0x01)
+          - StatusType=PLDM has Healthy status with no errors
+          - StatusType defines WHICH protocol stack (Communication vs PLDM)
+          - ErrorClass defines WHAT KIND of error within that stack (MCTP vs Power)
+          - Each StatusType has independent health status and error list
+          
+          Callers should use implementation-provided helper functions to interpret
+          error codes. The (errorCode, errorClass) tuple maps to specific error
+          conditions and Redfish messages.
+          
+          Reading this property computes and returns the current status for all
+          status type categories.
+          
+          Writing to this property clears errors for specific status types. To clear
+          errors, write a dict containing only the StatusType entries you want to clear,
+          with Healthy status and empty error arrays. You can write a partial dict -
+          only the StatusTypes included in the write will be affected. Other StatusTypes
+          remain unchanged.
+          
+          Example - clearing only Communication while leaving PLDM unchanged:
+            Write: {Communication: (Healthy, [])}
+            Result: Communication errors cleared, PLDM status unaffected
+          
+          Example - clearing multiple StatusTypes:
+            Write: {Communication: (Healthy, []), PLDM: (Healthy, [])}
+            Result: Both Communication and PLDM errors cleared
+          
+          Health is per-StatusType, not overall device health. Each StatusType in the
+          dict has its own independent DeviceHealth (Healthy/Degraded) and error list.
+          When the status changes, PropertiesChanged signals are emitted automatically.
+
+enumerations:
+    - name: StatusType
+      description: >
+          Defines the protocol or communication stack category being queried.
+          This represents WHICH aspect of the device you want to check status for.
+          Different status types can have different health states and error sets
+          independently. For example, Communication might be Degraded while PLDM
+          is Healthy.
+      values:
+        - name: Communication
+          description: >
+              Basic device communication status (MCTP, power, physical presence).
+    - name: DeviceHealth
+      description: >
+          Health status of the device for a specific status type.
+      values:
+        - name: Healthy
+          description: >
+              Device is operating normally without errors.
+        - name: Degraded
+          description: >
+              Device is operational but has detected errors or issues.
+    - name: ErrorClass
+      description: >
+          Classification or category of device errors within a StatusType.
+          This represents What Kind of error occurred. Multiple error classes
+          can exist within a single StatusType. For example, querying
+          StatusType=Communication might return errors with ErrorClass=MCTP
+          (ping timeout) and ErrorClass=Power (power state change).
+          ErrorClass works together with errorCode to identify specific error
+          conditions.
+      values:
+        - name: Power
+          description: >
+              Power-related errors (e.g., power on, power off, power state changes).
+        - name: Recovery
+          description: >
+              Recovery mode errors (e.g., device in recovery, device exited recovery).
+        - name: PhysicalInterface
+          description: >
+              Physical interface errors (e.g., device present, device absent/removed).
+        - name: MCTP
+          description: >
+              MCTP protocol errors (e.g., ping timeout, UUID discovery failure, transport errors).
