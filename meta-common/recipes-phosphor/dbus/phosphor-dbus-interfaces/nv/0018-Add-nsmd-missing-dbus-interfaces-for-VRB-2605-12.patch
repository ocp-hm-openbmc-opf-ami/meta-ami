From 8de847892d99628c4c25fe1376612de11bd2fe36 Mon Sep 17 00:00:00 2001
From: radhikad <radhikad@ami.com>
Date: Mon, 29 Jun 2026 15:35:15 +0530
Subject: [PATCH 806/806] Add nsmd missing dbus interfaces for VRB-2605-12
Upstream-Status: Pending


Rebased onto main after patch 0013; overlapping existing definitions are
retained and missing generators are registered in the current Meson tree.

---
diff --git a/gen/com/nvidia/PCIe/ClearAERErrorStatus/meson.build b/gen/com/nvidia/PCIe/ClearAERErrorStatus/meson.build
new file mode 100644
--- /dev/null
+++ b/gen/com/nvidia/PCIe/ClearAERErrorStatus/meson.build
@@ -0,0 +1,37 @@
+
+sdbusplus_current_path = 'com/nvidia/PCIe/ClearAERErrorStatus'
+
+# Generated file; do not modify.
+generated_sources += custom_target(
+    'com/nvidia/PCIe/ClearAERErrorStatus__cpp'.underscorify(),
+    input: ['../../../../../yaml/com/nvidia/PCIe/ClearAERErrorStatus.interface.yaml'],
+    output: [
+        'common.hpp',
+        'server.hpp',
+        'server.cpp',
+        'aserver.hpp',
+        'client.hpp',
+    ],
+    depend_files: sdbusplusplus_depfiles,
+    command: [
+        sdbuspp_gen_meson_prog,
+        '--command',
+        'cpp',
+        '--output',
+        meson.current_build_dir(),
+        '--tool',
+        sdbusplusplus_prog,
+        '--directory',
+        meson.current_source_dir() / '../../../../../yaml',
+        'com/nvidia/PCIe/ClearAERErrorStatus',
+    ],
+    install: should_generate_cpp,
+    install_dir: [
+        get_option('includedir') / sdbusplus_current_path,
+        get_option('includedir') / sdbusplus_current_path,
+        false,
+        get_option('includedir') / sdbusplus_current_path,
+        get_option('includedir') / sdbusplus_current_path,
+    ],
+    build_by_default: should_generate_cpp,
+)
diff --git a/gen/com/nvidia/PCIe/meson.build b/gen/com/nvidia/PCIe/meson.build
--- a/gen/com/nvidia/PCIe/meson.build
+++ b/gen/com/nvidia/PCIe/meson.build
@@ -26,4 +26,4 @@
     install_dir: [inst_markdown_dir / sdbusplus_current_path],
     build_by_default: should_generate_markdown,
 )
-
+subdir('ClearAERErrorStatus')
diff --git a/yaml/com/nvidia/PCIe/AERErrorStatus.interface.yaml b/yaml/com/nvidia/PCIe/AERErrorStatus.interface.yaml
--- a/yaml/com/nvidia/PCIe/AERErrorStatus.interface.yaml
+++ b/yaml/com/nvidia/PCIe/AERErrorStatus.interface.yaml
@@ -1,5 +1,5 @@
 description: >
-   Implement to provide AER Error Status and expose method to clear it.
+   Implement to provide AER Error Status.
 
 properties:
     - name: "AERUncorrectableErrorStatus"
@@ -14,21 +14,3 @@
             Represents AER Correctable Error Status.
       flags:
           - readonly
-methods:
-    - name: ClearAERStatus
-      description: >
-        Clear AERUncorrectableErrorStatus and AERCorrectableErrorStatus to the Default value
-      returns:
-          - name: RetValue
-            type: object_path
-            description: >
-                DBus Object Path. Interfaces com.nvidia.Async.Status and
-                com.nvidia.Async.Value at this returned Object Path can be used
-                to retrieve the status and resultant value of the operation
-                respectively.
-      errors:
-        - xyz.openbmc_project.Common.Device.Error.WriteFailure
-        - xyz.openbmc_project.Common.Error.Timeout
-        - xyz.openbmc_project.Common.Error.Unavailable
-     
-         
\ No newline at end of file
diff --git a/yaml/com/nvidia/PCIe/ClearAERErrorStatus.interface.yaml b/yaml/com/nvidia/PCIe/ClearAERErrorStatus.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/PCIe/ClearAERErrorStatus.interface.yaml
@@ -0,0 +1,19 @@
+description: >
+   Implement to expose method to clear AER Error Status.
+
+methods:
+    - name: ClearAERStatus
+      description: >
+        Clear AERUncorrectableErrorStatus and AERCorrectableErrorStatus to the Default value
+      returns:
+          - name: RetValue
+            type: object_path
+            description: >
+                DBus Object Path. Interfaces com.nvidia.Async.Status and
+                com.nvidia.Async.Value at this returned Object Path can be used
+                to retrieve the status and resultant value of the operation
+                respectively.
+      errors:
+        - xyz.openbmc_project.Common.Device.Error.WriteFailure
+        - xyz.openbmc_project.Common.Error.Timeout
+        - xyz.openbmc_project.Common.Error.Unavailable

-- 
2.34.1
