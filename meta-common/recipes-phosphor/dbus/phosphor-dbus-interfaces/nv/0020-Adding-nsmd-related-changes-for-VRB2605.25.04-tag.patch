From 9f437e4036cb1ca8a05787ab600e3b52cd3d4918 Mon Sep 17 00:00:00 2001
From: karthickk <karthickk@ami.com>
Date: Thu, 13 Aug 2026 13:34:26 +0530
Subject: [PATCH 809/809] Adding nsmd related changes for VRB2605.25.04 tag


Upstream-Status: Pending

Rebased onto main after patch 0013; overlapping existing definitions are
retained and missing generators are registered in the current Meson tree.

---
diff --git a/gen/com/nvidia/Software/DOTAuthState/meson.build b/gen/com/nvidia/Software/DOTAuthState/meson.build
new file mode 100644
--- /dev/null
+++ b/gen/com/nvidia/Software/DOTAuthState/meson.build
@@ -0,0 +1,31 @@
+# Generated file; do not modify.
+
+sdbusplus_current_path = 'com/nvidia/Software/DOTAuthState'
+
+generated_sources += custom_target(
+    'com/nvidia/Software/DOTAuthState__cpp'.underscorify(),
+    input: [
+        '../../../../../yaml/com/nvidia/Software/DOTAuthState.interface.yaml',
+    ],
+    output: [
+        'common.hpp',
+        'server.hpp',
+        'server.cpp',
+        'aserver.hpp',
+        'client.hpp',
+    ],
+    depend_files: sdbusplusplus_depfiles,
+    command: [
+        sdbuspp_gen_meson_prog,
+        '--command',
+        'cpp',
+        '--output',
+        meson.current_build_dir(),
+        '--tool',
+        sdbusplusplus_prog,
+        '--directory',
+        meson.current_source_dir() / '../../../../../yaml',
+        'com/nvidia/Software/DOTAuthState',
+    ],
+)
+
diff --git a/gen/com/nvidia/Software/meson.build b/gen/com/nvidia/Software/meson.build
--- a/gen/com/nvidia/Software/meson.build
+++ b/gen/com/nvidia/Software/meson.build
@@ -14,3 +14,4 @@ generated_others += custom_target(
     ],
 )
 
+subdir('DOTAuthState')
diff --git a/yaml/com/nvidia/Software/DOTAuthState.interface.yaml b/yaml/com/nvidia/Software/DOTAuthState.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Software/DOTAuthState.interface.yaml
@@ -0,0 +1,32 @@
+description: >
+    DOT Code Authentication Key (CAK) verification state for a firmware slot.
+    This interface needs to be implemented when device supports DOT. It is
+    present on the same D-Bus object path as
+    xyz.openbmc_project.Software.Slot, which identifies the specific
+    firmware slot.
+
+properties:
+    - name: DOTAuthState
+      type: enum[self.AuthState]
+      default: Unknown
+      description: >
+        Indicates firmware image authentication status against the installed
+        DOT CAK.
+
+enumerations:
+  - name: AuthState
+    description: >
+      Result of verifying a firmware slot image against the installed DOT CAK.
+    values:
+      - name: Unknown
+        description: >
+          DOT auth state has not yet been determined or is unavailable.
+      - name: DOTNotInstalled
+        description: >
+          No DOT CAK is installed; DOT-based verification does not apply.
+      - name: AuthenticationSuccess
+        description: >
+          The firmware image verified successfully under the installed DOT CAK.
+      - name: AuthenticationFailed
+        description: >
+          The firmware image failed to verify under the installed DOT CAK.

-- 
