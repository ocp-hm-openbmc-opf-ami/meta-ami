diff --git a/yaml/com/nvidia/Network/LLDP/Modes.interface.yaml b/yaml/com/nvidia/Network/LLDP/Modes.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Network/LLDP/Modes.interface.yaml
@@ -0,0 +1,49 @@
+description: >
+    Interface for managing LLDP operating modes on a network adapter.
+    Controls the transmit and receive LLDP modes as well as DCBX mode.
+
+properties:
+    - name: TxMode
+      type: enum[self.LLDPModeType]
+      default: "Off"
+      description: >
+          LLDP transmit mode for this network adapter port.
+
+    - name: RxMode
+      type: enum[self.LLDPModeType]
+      default: "Off"
+      description: >
+          LLDP receive mode for this network adapter port.
+
+    - name: DcbxMode
+      type: enum[self.DCBXModeType]
+      default: "Disabled"
+      description: >
+          DCBX (Data Center Bridging Capability Exchange) mode.
+          Enabling DCBX requires TxMode and RxMode to both be set to All.
+
+enumerations:
+    - name: LLDPModeType
+      description: >
+          LLDP operating mode for transmit or receive direction.
+      values:
+          - name: "Off"
+            description: >
+                LLDP is disabled for this direction.
+          - name: Mandatory
+            description: >
+                Only mandatory LLDP TLVs are transmitted or processed.
+          - name: All
+            description: >
+                All LLDP TLVs including optional ones are transmitted or processed.
+
+    - name: DCBXModeType
+      description: >
+          DCBX operating mode.
+      values:
+          - name: "Disabled"
+            description: >
+                DCBX is disabled.
+          - name: "Enabled"
+            description: >
+                DCBX is enabled. Requires TxMode and RxMode to both be All.
diff --git a/yaml/com/nvidia/Network/LLDP/RawFrame.interface.yaml b/yaml/com/nvidia/Network/LLDP/RawFrame.interface.yaml
new file mode 100644
--- /dev/null
+++ b/yaml/com/nvidia/Network/LLDP/RawFrame.interface.yaml
@@ -0,0 +1,18 @@
+description: >
+    Interface representing raw LLDP frame data received or transmitted
+    on a network adapter port.
+
+properties:
+    - name: Data
+      type: array[byte]
+      description: >
+          Raw LLDP packet data. Contains the complete LLDP PDU as received
+          from or to be transmitted on the network port. Empty when no
+          LLDP frame has been captured yet.
+
+    - name: LastUpdateTimestamp
+      type: uint64
+      default: 0
+      description: >
+          Monotonic timestamp in microseconds of the last time the raw
+          frame data was updated. Zero if no frame has been received yet.
