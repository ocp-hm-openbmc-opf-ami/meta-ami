From 0b905b9d96b6e5b693f20fe23a133f9259a77331 Mon Sep 17 00:00:00 2001
From: dineshkumar <dineshkumar@ami.com>
Date: Thu, 28 Aug 2025 03:12:34 +0530
Subject: [PATCH] Add EMMC dbus properties

Signed-off-by: dineshkumar <dineshkumar@ami.com>
---
 yaml/xyz/openbmc_project/Metric/Value.interface.yaml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/yaml/xyz/openbmc_project/Metric/Value.interface.yaml b/yaml/xyz/openbmc_project/Metric/Value.interface.yaml
index 9c9d3c1..c9b5116 100644
--- a/yaml/xyz/openbmc_project/Metric/Value.interface.yaml
+++ b/yaml/xyz/openbmc_project/Metric/Value.interface.yaml
@@ -115,6 +115,16 @@ paths:
                 Reboot statistic to track number of times device rebooted
                 because of a failure.
             value: reboot/count_with_failure
+          - name: EmmcLifetime
+            description: >
+                EMMC health statistics to track Type B device lifetime
+                estimation.
+            value: emmc/lifetime
+          - name: EmmcBlocks
+            description: >
+                EMMC health statistics to track the consumption state of
+                reserved blocks.
+            value: emmc/blocks
     - name: BMC
       description: >
           The BMC metrics.
