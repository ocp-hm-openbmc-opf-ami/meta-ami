diff --git a/yaml/xyz/openbmc_project/Control/Processor/Reset.interface.yaml b/yaml/xyz/openbmc_project/Control/Processor/Reset.interface.yaml
new file mode 100644
index 0000000..b7c483d
--- /dev/null
+++ b/yaml/xyz/openbmc_project/Control/Processor/Reset.interface.yaml
@@ -0,0 +1,43 @@
+description: >
+    Implement to provide device reset support.
+methods:
+    - name: Reset
+      description: >
+        Reset the device like processor.
+      returns:
+          - name: RetValue
+            type: int32
+            description: >
+                Return value of Method 0/1 (Success/Failure).
+      errors:
+        - xyz.openbmc_project.Common.Error.InternalFailure
+        - xyz.openbmc_project.Common.Error.NotAllowed
+        - xyz.openbmc_project.Common.Error.Timeout
+        - xyz.openbmc_project.Common.Error.Unavailable
+
+properties:
+    - name: ResetType
+      type: enum[self.ResetTypes]
+      description: >
+        The type of reset for the device.
+
+enumerations:
+    - name: ResetTypes
+      description: >
+        Reset types.
+      values:
+        - name: ForceOff
+          description: >
+            Turn off the unit immediately (non-graceful shutdown).
+        - name: ForceOn
+          description: >
+            Turn on the unit immediately.
+        - name: ForceRestart
+          description: >
+            Shut down immediately and non-gracefully and restart the system.
+        - name: GracefulRestart
+          description: >
+            Shut down gracefully and restart the system.
+        - name: GracefulShutdown
+          description: >
+            Shut down gracefully and power off.
