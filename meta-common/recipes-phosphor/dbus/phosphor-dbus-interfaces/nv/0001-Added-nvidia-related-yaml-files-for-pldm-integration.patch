diff --git a/yaml/xyz/openbmc_project/Control/Processor/RemoteDebug.interface.yaml b/yaml/xyz/openbmc_project/Control/Processor/RemoteDebug.interface.yaml
new file mode 100644
index 0000000..edc5988
--- /dev/null
+++ b/yaml/xyz/openbmc_project/Control/Processor/RemoteDebug.interface.yaml
@@ -0,0 +1,121 @@
+description: >
+  Processor Remote debug control
+properties:
+    - name: JtagDebug
+      type: enum[self.DebugState]
+      description: >
+          JTAG_ENABLE, Jtag debug enable
+      flags:
+          - readonly
+
+    - name: DeviceDebug
+      type: enum[self.DebugState]
+      description: >
+          DEVICEEN, Device debug enabled
+      flags:
+          - readonly
+
+    - name: SecurePrivilegeNonInvasiveDebug
+      type: enum[self.DebugState]
+      description: >
+        SPNIDEN, Secure Privilege Non-Invasive Debug Enable
+      flags:
+          - readonly
+
+    - name: SecurePrivilegeInvasiveDebug
+      type: enum[self.DebugState]
+      description: >
+          SPIDEN, Secure Privilege Invasive Debug Enable
+      flags:
+          - readonly
+
+    - name: NonInvasiveDebug
+      type: enum[self.DebugState]
+      description: >
+          NIDEN, non-invasive debug enable
+      flags:
+          - readonly
+
+    - name: InvasiveDebug
+      type: enum[self.DebugState]
+      description: >
+          DBGEN, invasive debug enable
+      flags:
+          - readonly
+
+    - name: Timeout
+      type: uint32
+      default: 30
+      description: >
+          Set a timeout of the remote debug in minutes. It is needed to refresh the timeout to keep the remote debug enabled.
+          Note that a 30 mins of timeout would be set by default unless a new timeout is set by the BMC.
+
+methods:
+    - name: Enable
+      description: >
+          Request to enable the debug policy
+      parameters:
+        - name: DebugPolicy
+          type: array[enum[self.DebugPolicy]]
+      errors:
+        - xyz.openbmc_project.Common.Error.InvalidArgument
+        - xyz.openbmc_project.Common.Error.NotAllowed
+
+    - name: Disable
+      description: >
+          Request to disable debug interface
+      parameters:
+          - name: DebugPolicy
+            type: array[enum[self.DebugPolicy]]
+      errors:
+        - xyz.openbmc_project.Common.Error.InvalidArgument
+        - xyz.openbmc_project.Common.Error.NotAllowed
+
+enumerations:
+    - name: DebugState
+      description: >
+          Debug policy state
+      values:
+          - name: Enabled
+            description: >
+                Always enabled or toggled on
+          - name: Disabled
+            description: >
+                Disconnected but toggleable
+          - name: Offline
+            description: >
+                Offline, cannot be enabled
+          - name: Pending
+            description: >
+                State is pending update
+          - name: Unknown
+            description: >
+                State is unknown.
+
+    - name: DebugPolicy
+      description: >
+          Available Debug Policy
+      values:
+          - name: JtagDebug
+            description: >
+                JTAG_ENABLE, Jtag debug enable
+
+          - name: DeviceDebug
+            description: >
+                DEVICEEN, Device debug enabled
+
+          - name: SecurePrivilegeNonInvasiveDebug
+            description: >
+                SPNIDEN, Secure Privilege Non-Invasive Debug Enable
+
+          - name: SecurePrivilegeInvasiveDebug
+            description: >
+                SPIDEN, Secure Privilege Invasive Debug Enable
+
+          - name: NonInvasiveDebug
+            description: >
+                NIDEN, non-invasive debug enable
+
+          - name: InvasiveDebug
+            description: >
+                DBGEN, invasive debug enable
