diff --git a/yaml/com/nvidia/NVLink/MNNVLinkTopology.interface.yaml b/yaml/com/nvidia/NVLink/MNNVLinkTopology.interface.yaml
new file mode 100644
index 0000000..59e3669
--- /dev/null
+++ b/yaml/com/nvidia/NVLink/MNNVLinkTopology.interface.yaml
@@ -0,0 +1,41 @@
+description: >
+    Implement to provide system tray serial number, tray slot number,
+    tray slot index, rack serial number, node index, peer type, module ID,
+    system GUID, and IB GUID.
+properties:
+    - name: TraySerialNumber
+      type: string
+      description: >
+          Represents tray serial number in the rack mount compute node.
+    - name: TraySlotNumber
+      type: uint32
+      description: >
+          Represents tray slot number in the rack mount compute node.
+    - name: TraySlotIndex
+      type: uint32
+      description: >
+          The index within the compute slots in the rack mount compute node.
+    - name: ChassisSerialNumber
+      type: string
+      description: >
+          Represents chassis serial number in the entire rack full of trays and switches.
+    - name: HostID
+      type: uint32
+      description: >
+          The index of the node within the slot.
+    - name: PeerType
+      type: string
+      description: >
+          Platform indicated NVLink-peer type.
+    - name: ModuleID
+      type: uint32
+      description: >
+          The ID of this GPU within the node.
+    - name: SystemGUID
+      type: string
+      description: >
+          Represents System GUID.
+    - name: IBGUID
+      type: string
+      description: >
+          Represents Infiniband GUID.
diff --git a/yaml/com/nvidia/Protocol/NSM/Raw.interface.yaml b/yaml/com/nvidia/Protocol/NSM/Raw.interface.yaml
new file mode 100644
index 0000000..88d9c22
--- /dev/null
+++ b/yaml/com/nvidia/Protocol/NSM/Raw.interface.yaml
@@ -0,0 +1,43 @@
+description: >
+    This interface provides methods for sending and receiving raw NSM commands.
+
+methods:
+  - name: SendRequest
+    description: >
+        Send NSM Raw passthrough Command
+    parameters:
+      - name: DeviceType
+        type: byte
+        description: >
+            NSM device type according to the NSM base specification
+      - name: InstanceId
+        type: byte
+        description: >
+            NSM device instance id according to the NSM base specification
+      - name: IsLongRunning
+        type: boolean
+        description: >
+            If the command is long running, set this to true
+      - name: MessageType
+        type: byte
+        description: >
+            NSM message type according to the NSM base specification
+      - name: CommandCode
+        type: byte
+        description: >
+            Command code for the NSM command to be sent
+      - name: Payload
+        type: unixfd
+        description: >
+            Memory file descriptor containing the payload to be sent
+    returns:
+      - name: AsyncHandle
+        type: object_path
+        description: >
+            DBus Object Path. Interfaces com.nvidia.Async.Status and
+            com.nvidia.Async.Value at this returned Object Path can be used
+            to retrieve the status and resultant value of the operation
+            respectively.
+    errors:
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
\ No newline at end of file
diff --git a/yaml/com/nvidia/ResetCounters/ResetCounterMetrics.interface.yaml b/yaml/com/nvidia/ResetCounters/ResetCounterMetrics.interface.yaml
new file mode 100644
index 0000000..5930dbf
--- /dev/null
+++ b/yaml/com/nvidia/ResetCounters/ResetCounterMetrics.interface.yaml
@@ -0,0 +1,68 @@
+description: >
+    Implement this special interface to provide count of how many times the GPU has entered and exited specific reset states.
+
+properties:
+    - name: LastResetType
+      type: enum[self.ResetTypes]
+      description: >
+          Type of the last reset GPU enetered, e.g. PF-FLR, Conventional, Fundamental, IRoT.
+    
+    - name: PF_FLR_ResetEntryCount
+      type: double
+      default: NaN
+      description: >
+          PF-FLR reset entry count, count of how many times the GPU has entered reset state, Power Loss and Factory Programming Reset
+
+    - name: PF_FLR_ResetExitCount
+      type: double
+      default: NaN
+      description: >
+          PF-FLR reset exit count, count of how many times the GPU has exited reset state , Power Loss and Factory Programming Reset
+
+    - name: ConventionalResetEntryCount
+      type: double
+      default: NaN
+      description: >
+          Conventional, non-fundamental reset entry count, count of how many times the GPU has entered reset state
+    
+    - name: ConventionalResetExitCount
+      type: double
+      default: NaN
+      description: >
+          Conventional, non-fundamental reset exit count, count of how many times the GPU has exited reset state
+
+    - name: FundamentalResetEntryCount
+      type: double
+      default: NaN
+      description: >
+          Fundamental (PERST#) reset entry count, count of how many times the GPU has entered reset state
+    
+    - name: FundamentalResetExitCount
+      type: double
+      default: NaN
+      description: >
+          Fundamental (PERST#) reset exit count, count of how many times the GPU has exited reset state
+    
+    - name: IRoTResetExitCount
+      type: double
+      default: NaN
+      description: >
+          Internal Root of Trust (IRoT) reset exit count
+
+enumerations:
+    - name: ResetTypes
+      description: >
+        Reset types.
+      values:
+          - name: "PFFLR"
+            description: >
+              PF-FLR reset type, Power Loss and Factory Programming Reset
+          - name: "Conventional"
+            description: >
+              Conventional, non fundamental reset type
+          - name: "Fundamental"
+            description: >
+              Fundamental reset type
+          - name: "IRoTReset"
+            description: >
+              IRoT Reset Type
