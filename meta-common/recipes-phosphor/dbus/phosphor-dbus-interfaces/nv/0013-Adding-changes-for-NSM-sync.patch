+description: >
+  Implement to provide install and erase debug token functionalities for NSM
+  devices.
+
+enumerations:
+  - name: EraseType
+    description: >
+      Enum describing debug token erase types.
+    values:
+      - name: TokenType
+        description: >
+          Erase a specific token type.
+      - name: EraseAll
+        description: >
+          Erase all tokens.
+      - name: EraseAllAndRatchetCounterIncreased
+        description: >
+          Erase all tokens and increment ratchet counter.
+
+methods:
+  - name: EraseToken
+    description: >
+      Erase installed token.
+    parameters:
+      - name: EraseType
+        type: enum[self.EraseType]
+        description: >
+          Type of erase operation. Set to TokenType to erase a specific token type,
+          EraseAll to erase all tokens, or EraseAllAndRatchetCounterIncreased to
+          erase all tokens and increment the ratchet counter.
+      - name: TokenType
+        type: enum[com.nvidia.DebugToken.Common.Types]
+        description: >
+          Type of the token to erase when EraseType is TokenType. Ignored for other
+          EraseType values.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
+
+  - name: InstallToken
+    description: >
+      Install signed token.
+    parameters:
+      - name: TokenData
+        type: unixfd
+        description: >
+          Memory file descriptor containing the TLV encoded token data.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+            DBus object path of the async operation status object.
+            Interface com.nvidia.Async.Status at this returned object path
+            can be used to retrieve the status of the operation.
Index: git/yaml/com/nvidia/DebugToken/Aggregation.interface.yaml
===================================================================
--- /dev/null
+++ git/yaml/com/nvidia/DebugToken/Aggregation.interface.yaml
@@ -0,0 +1,40 @@
+description: >
+  Implement to provide aggregated debug token installation functionality across
+  multiple NSM devices. This interface enables installing debug tokens to
+  multiple devices simultaneously and returns per-device status.
+
+methods:
+  - name: InstallToken
+    description: >
+      Install signed token to multiple devices. Token file contains TLV-encoded
+      token data for all target devices. The file has two parts: a file header
+      followed by a set of tokens. Each token consists of a token header and
+      TLV-encoded (Type-Length-Value) fields. The operation returns per-device
+      installation status with error code, error message, and device name.
+      Device name is the Root of Trust name providing debug token support.
+    parameters:
+      - name: TokenData
+        type: unixfd
+        description: >
+          Memory file descriptor containing the aggregated TLV encoded token
+          data for multiple devices.
+    errors:
+      - xyz.openbmc_project.Common.Error.InternalFailure
+      - xyz.openbmc_project.Common.Error.InvalidArgument
+      - xyz.openbmc_project.Common.Error.Unavailable
+    returns:
+      - name: ObjectPath
+        type: object_path
+        description: >
+          DBus object path of the async operation status object.
+          Interface com.nvidia.Async.Status at this returned object path
+          can be used to retrieve the status of the operation.
+          Interface com.nvidia.Async.Value at this returned object path
+          provides the per-device results as an array of tuples(uint16
+          error_code, string error_message, string device_name) containing
+          error code, error message, and device name. Error codes are derived
+          from debug token error code specification.
+
+paths:
+  - namespace: /xyz/openbmc_project/debug_token
+
Index: git/yaml/com/nvidia/DebugToken/Common.interface.yaml
===================================================================
--- /dev/null
+++ git/yaml/com/nvidia/DebugToken/Common.interface.yaml
@@ -0,0 +1,204 @@
+description: >
+  Common enumerations and types for Debug Token interfaces.
+
+enumerations:
+  - name: Types
+    description: >
+      Enum describing debug token types across all device types.
+    values:
+      - name: None
+        description: >
+          No token type.
+      - name: FRC
+        description: >
+          FRC token type.
+      - name: CRCS
+        description: >
+          CRCS token type.
+      - name: CRDT
+        description: >
+          CRDT token type.
+      - name: DebugFirmwareRunning
+        description: >
+          Debug firmware running token type.
+      - name: DebugFirmwareUnlock
+        description: >
+          Enables capability to run debug/test firmware without production
+          signature on production systems. Allows scale-out deployment of
+          non-production signed firmware on large quantities of production
+          fused devices. Software supports both device's default lifecycle and
+          debug token lifecycle simultaneously.
+      - name: OTPDumpEnable
+        description: >
+          Legacy D-Bus enumeration slot that aligns with the SMA debug
+          capability token value (SMADebugCapability).
+      - name: JtagUnlock
+        description: >
+          JTAG unlock token type.
+      - name: HardwareUnlock
+        description: >
+          Hardware unlock token type.
+      - name: RuntimeDebugUnlock
+        description: >
+          Runtime debug unlock token type.
+      - name: FeatureUnlock
+        description: >
+          Feature unlock token type.
+      - name: MTDT
+        description: >
+          MTDT token type.
+      - name: CcplexArmJtagDebugCont
+        description: >
+          ARM JTAG debug control token type for TH500 flow. Enables ARM JTAG
+          unlock capabilities to maintain compatibility with existing customer
+          tools. Controls ARM JTAG debug signals and requires an additional
+          check of secure_debug_control_toggle_allowed from PSC-BCT to enable
+          debug. PSC-BCT utilizes secure_debug_control_toggle_allowed to
+          control all signals for both nv-prod and stage2 scenarios.
+      - name: NVJtagControl
+        description: >
+          NVIDIA JTAG control token type that allows Design-For-Test (DFT)
+          debug access in NVJTAG operations. Enables DFT access for internal
+          NVIDIA debugging and testing purposes.
+      - name: DiagnosticBoot
+        description: >
+          Diagnostic boot token type.
+      - name: BpmpFirmwareDebugFS
+        description: >
+          BPMP firmware DebugFS token type.
+      - name: FwDebugKnobs
+        description: >
+          Firmware debug knobs token type.
+      - name: FirewallLifting
+        description: >
+          Firewall lifting token type that allows selective removal of hardware
+          firewalls for debugging and testing purposes. Enables access to
+          normally protected system resources by lifting specific firewall
+          groups. Used for MODS testing and advanced debugging scenarios.
+      - name: Verbosity
+        description: >
+          Verbosity token type that allows runtime control of UART/UTC output
+          and verbosity levels for different firmware components. Enables
+          detailed logging and debug output from various firmware modules that
+          is normally suppressed in production to aid in debugging and system
+          analysis.
+      - name: RAS
+        description: >
+          Enable debug signing for Reliability, Availability, and
+          Serviceability (RAS) firmware component.
+      - name: SMADebugCapability
+        description: >
+          Unlock debug capabilities on SMA.
+      - name: CpldDebugCapability
+        description: >
+          Unlock debug capabilities on CPLD.
+  - name: SubTypes
+    description: >
+      Enum describing debug token subtypes across all device types and token types.
+    values:
+      - name: None
+        description: >
+          No subtype or not applicable.
+      # CPU/GPU Common subtypes
+      - name: OOBHub
+      - name: RAS
+      - name: Pcore
+      - name: PscFirmware
+      - name: MB1
+      - name: MB2
+      - name: BpmpFirmware
+      - name: BpmpIst
+      - name: BpmpDiag
+      - name: MSEQ
+      - name: C2C
+      - name: ATF
+      - name: RMM
+      - name: PscFmc
+      - name: EnableSensitiveLogging
+      # CPU CcplexArmJtagDebugCont subtypes
+      - name: Dbgen
+      - name: Niden
+      - name: Spiden
+      - name: Spniden
+      - name: JtagEnable
+      - name: DeviceenApbap
+      - name: DeviceenAxiap
+      - name: Rlpiden
