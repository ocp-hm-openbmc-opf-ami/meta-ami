Index: git/yaml/com/nvidia/DeviceConfiguration/ConfigRequester.interface.yaml
===================================================================
--- /dev/null
+++ git/yaml/com/nvidia/DeviceConfiguration/ConfigRequester.interface.yaml
@@ -0,0 +1,21 @@
+description: >
+    Optional “configuration request” notifier PDI. Implement it on the same
+    D-Bus object that exposes com.nvidia.DeviceConfiguration.ConfigUpdater when
+    the device can tell management it is ready for a configuration workflow
+    without carrying payload in the signal.
+
+    Relationship to ConfigUpdater: implementations that emit
+    DeviceConfigurationRequested should also implement
+    com.nvidia.DeviceConfiguration.ConfigUpdater on that object. Clients use this
+    signal only as a hint; they MUST use ConfigUpdater SetDeviceConfiguration /
+    GetDeviceConfiguration to exchange configuration
+    type and data. Endpoints that only expose ConfigUpdater and never need a
+    readiness broadcast do not implement this interface.
+
+signals:
+    - name: DeviceConfigurationRequested
+      description: >
+          Emitted when the implementation determines the device is ready for
+          configuration actions by a management consumer. No parameters;
+          subscribers use com.nvidia.DeviceConfiguration.ConfigUpdater to perform
+          set or get operations as appropriate.
Index: git/yaml/com/nvidia/DeviceConfiguration/ConfigUpdater.interface.yaml
===================================================================
--- /dev/null
+++ git/yaml/com/nvidia/DeviceConfiguration/ConfigUpdater.interface.yaml
@@ -0,0 +1,86 @@
+description: >
+    Configuration updater PDI for device objects whose configuration apply or
+    query cannot finish inside a single blocking D-Bus method call.
+
+    Implement com.nvidia.DeviceConfiguration.ConfigUpdater on a BMC object
+    (typically inventory-backed) when management must push or pull opaque
+    configuration blobs—such as platform-specific NSM device-configuration
+    payloads—and the path through firmware, transport, or file-descriptor I/O
+    can take noticeable time or fail after validation.
+
+methods:
+    - name: SetDeviceConfiguration
+      description: >
+          Requests that configuration identified by the type be applied using
+          the supplied payload. Completion and errors are reported through
+          com.nvidia.Async.Status at the returned object path.
+      parameters:
+          - name: ConfigurationType
+            type: enum[self.ConfigurationType]
+            description: >
+                Selector for which configuration is being applied; see
+                enumerations.ConfigurationType.
+          - name: Data
+            type: unixfd
+            description: >
+                Readable file descriptor for the configuration payload. The
+                service reads from offset zero through end-of-file. Maximum
+                acceptable length and format are defined by the implementation.
+                The caller retains the descriptor; memfd and pipe sources are
+                typical.
+      errors:
+        - xyz.openbmc_project.Common.Error.NotAllowed
+        - xyz.openbmc_project.Common.Error.Timeout
+        - xyz.openbmc_project.Common.Error.Unavailable
+        - xyz.openbmc_project.Common.Error.InvalidArgument
+      returns:
+          - name: RetValue
+            type: object_path
+            description: >
+                Object path exposing com.nvidia.Async.Status for this operation.
+
+    - name: GetDeviceConfiguration
+      description: >
+          Requests the configuration associated with the type, optionally scoped
+          by a query payload. Completion is reported through
+          com.nvidia.Async.Status at the returned path; on success,
+          com.nvidia.Async.Value carries the result (for example as a unixfd to
+          opaque bytes—encoding is implementation-defined).
+      parameters:
+          - name: ConfigurationType
+            type: enum[self.ConfigurationType]
+            description: >
+                Selector for which configuration is being queried; see
+                enumerations.ConfigurationType.
+          - name: Data
+            type: unixfd
+            description: >
+                Readable file descriptor for an optional query or selector blob.
+                Read from offset zero through end-of-file; an empty payload
+                denotes no query. Interpretation and maximum size are defined by
+                the implementation.
+      errors:
+        - xyz.openbmc_project.Common.Error.NotAllowed
+        - xyz.openbmc_project.Common.Error.Timeout
+        - xyz.openbmc_project.Common.Error.Unavailable
+        - xyz.openbmc_project.Common.Error.InvalidArgument
+      returns:
+          - name: RetValue
+            type: object_path
+            description: >
+                Object path exposing com.nvidia.Async.Status and
+                com.nvidia.Async.Value for this operation.
+
+enumerations:
+  - name: ConfigurationType
+    description: >
+        Supported device configuration types for the Get/Set Device Config
+        NSM commands.
+    values:
+      - name: NVLinkAccessRegister
+        value: 0
+        description: >
+            NVLINK TLV Configuration. Stored in volatile memory and limited
+            to 256 bytes (excluding header). Requires a port reset for any
+            affected NVLink port to take effect. Redfish mapping is not
+            available for this generic configuration type.
Index: git/yaml/com/nvidia/DeviceMode/DPUOperationMode.interface.yaml
===================================================================
--- /dev/null
+++ git/yaml/com/nvidia/DeviceMode/DPUOperationMode.interface.yaml
@@ -0,0 +1,54 @@
+description: >
+    Operational mode for BlueField DPU devices. Defines whether the device
+    operates as a full Data Processing Unit (DPU) with embedded Arm cores
+    and accelerators, or as a standard Network Interface Card (NIC).
+    This is a non-volatile setting that requires a full power cycle to
+    take effect.
+
+properties:
+    - name: CurrentMode
+      type: enum[self.OperationMode]
+      flags:
+          - readonly
+      description: >
+          The operational mode currently active on the device.
+
+    - name: PendingMode
+      type: enum[self.OperationMode]
+      description: >
+          The operational mode that will be applied after the next full
+          power cycle. When this value differs from CurrentMode, the
+          change has been accepted by the device but the required power
+          cycle has not yet occurred.
+          Only writable when IsModeConfigurable is true. Attempts to
+          write when IsModeConfigurable is false shall return NotAllowed.
+      errors:
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+          - xyz.openbmc_project.Common.Error.NotAllowed
+          - xyz.openbmc_project.Common.Error.Unavailable
+          - xyz.openbmc_project.Common.Error.InternalFailure
+
+    - name: IsModeConfigurable
+      type: boolean
+      flags:
+          - readonly
+      default: false
+      description: >
+          An indication of whether PendingMode is writable on
+          this device. Determined by the device and platform capabilities.
+
+enumerations:
+    - name: OperationMode
+      description: >
+          DPU operational mode settings.
+      values:
+          - name: DPU
+            description: >
+                Device operates in DPU mode with full data processing
+                capabilities, including embedded Arm cores, hardware
+                accelerators, and infrastructure offloads for networking,
+                storage, and security.
+          - name: NIC
+            description: >
+                Device operates in NIC mode as a standard network
+                interface card without DPU data processing features.
