From d600c8994bb4226c2cc7866b76275f8c5b21f5f1 Mon Sep 17 00:00:00 2001
From: Shamim Ali <ashamim@ami.com>
Date: Wed, 2 Oct 2024 11:41:50 +0530
Subject: [PATCH] Update enhancement for certificate errors

Signed-off-by: Shamim Ali <ashamim@ami.com>
---
 yaml/xyz/openbmc_project/Certs.errors.yaml    | 16 ++++++++++
 yaml/xyz/openbmc_project/Certs.metadata.yaml  | 32 +++++++++++++++++++
 .../Certs/Replace.interface.yaml              |  9 ++++++
 3 files changed, 57 insertions(+)

diff --git a/yaml/xyz/openbmc_project/Certs.errors.yaml b/yaml/xyz/openbmc_project/Certs.errors.yaml
index eba75ce..6784ecb 100644
--- a/yaml/xyz/openbmc_project/Certs.errors.yaml
+++ b/yaml/xyz/openbmc_project/Certs.errors.yaml
@@ -5,3 +5,19 @@
   description: Certificate already exist.
 - name: PrivateKeyNotFound
   description: Private key file is not found.
+- name: CertificateFileExpired
+  description: Certificate file is expired.
+- name: CertificateFileUntrusted
+  description: Untrusted certificate file.
+- name: PrivateKeyFileEncrypted
+  description: Private key is encrypted/failed to read the private key.
+- name: PrivateKeyCertificateFileNotMatch
+  description: Public/Private Key Certificate File Not Match.
+- name: VerifyCertificateFileFailed
+  description: ASN1 validation failed.
+- name: CertificateFileSizeExceeded
+  description:  certificate key file size (should be < 4096 bytes).
+- name: PrivateFileSizeExceeded
+  description:  private/public key file size (should be < 4096 bytes).
+- name: CertificateKeyLengthTooSmall
+  description: certificate file is less than minimum allowable size (2048) for https.
diff --git a/yaml/xyz/openbmc_project/Certs.metadata.yaml b/yaml/xyz/openbmc_project/Certs.metadata.yaml
index 12fbb4e..e14150f 100644
--- a/yaml/xyz/openbmc_project/Certs.metadata.yaml
+++ b/yaml/xyz/openbmc_project/Certs.metadata.yaml
@@ -10,3 +10,35 @@
   meta:
       - str: "REASON=%s"
         type: string
+- name: CertificateFileExpired
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: CertificateFileUntrusted
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: PrivateKeyFileEncrypted
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: PrivateKeyCertificateFileNotMatch
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: VerifyCertificateFileFailed
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: CertificateFileSizeExceeded
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: PrivateFileSizeExceeded
+  meta:
+      - str: "REASON=%s"
+        type: string
+- name: CertificateKeyLengthTooSmall
+  meta:
+      - str: "REASON=%s"
+        type: string
diff --git a/yaml/xyz/openbmc_project/Certs/Replace.interface.yaml b/yaml/xyz/openbmc_project/Certs/Replace.interface.yaml
index f37d561..d8c9648 100644
--- a/yaml/xyz/openbmc_project/Certs/Replace.interface.yaml
+++ b/yaml/xyz/openbmc_project/Certs/Replace.interface.yaml
@@ -16,3 +16,12 @@ methods:
           - xyz.openbmc_project.Certs.Error.InvalidCertificate
           - xyz.openbmc_project.Common.Error.NotAllowed
           - xyz.openbmc_project.Certs.Error.PrivateKeyNotFound
+          - xyz.openbmc_project.Certs.Error.CertificateExists
+          - xyz.openbmc_project.Certs.Error.CertificateFileExpired
+          - xyz.openbmc_project.Certs.Error.CertificateFileUntrusted
+          - xyz.openbmc_project.Certs.Error.PrivateKeyFileEncrypted
+          - xyz.openbmc_project.Certs.Error.PrivateKeyCertificateFileNotMatch
+          - xyz.openbmc_project.Certs.Error.VerifyCertificateFileFailed
+          - xyz.openbmc_project.Certs.Error.CertificateFileSizeExceeded
+          - xyz.openbmc_project.Certs.Error.PrivateFileSizeExceeded
+          - xyz.openbmc_project.Certs.Error.CertificateKeyLengthTooSmall
-- 
