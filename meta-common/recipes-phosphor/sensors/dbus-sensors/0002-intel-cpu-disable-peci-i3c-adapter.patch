From 69f0ef8554ce56431a619d8aff115f59d8b2ade7 Mon Sep 17 00:00:00 2001
From: Hariharan Rangasamy <hariharanr@ami.com>
Date: Mon, 25 May 2026 11:50:26 +0530
Subject: [PATCH] intel-cpu: disable peci-i3c adapter support

---
 src/intel-cpu/IntelCPUSensorMain.cpp | 20 +++++---------------
 1 file changed, 5 insertions(+), 15 deletions(-)

diff --git a/src/intel-cpu/IntelCPUSensorMain.cpp b/src/intel-cpu/IntelCPUSensorMain.cpp
index a9ab062..ef316fb 100644
--- a/src/intel-cpu/IntelCPUSensorMain.cpp
+++ b/src/intel-cpu/IntelCPUSensorMain.cpp
@@ -946,15 +946,8 @@ void addConfigsForOtherPeciAdapters(
         }
         if (peciAdapterName->compare("i3c") == 0)
         {
-            std::string p = peciAdapterNamePath.string();
-            auto pos = p.find("peci-");
-            std::string pecidev = p.substr(pos, 6);
-            int cpu = peci_i3c_chardev_to_cpu(pecidev.c_str());
-
-            if (int(addr) != cpu + 0x30)
-            {
-                continue;
-            }
+            // peci-i3c adapter is not supported on this platform
+            continue;
         }
 
         // WA:detectCpu uses cpuConfigs to send ping command
@@ -1158,12 +1151,9 @@ void udevAction(udev_device* dev,
 
             if (peciAdapterName.compare("i3c") == 0)
             {
-                int cpu = peci_i3c_chardev_to_cpu(pecidevName.c_str());
-
-                if (int(config.addr) != cpu + 0x30)
-                {
-                    continue;
-                }
+                // peci-i3c adapter is not supported on this platform;
+                // skip i3c udev events instead of matching by chardev
+                continue;
             }
             cpuConfigs.emplace(bus, config.addr,
                                config.name + "_" + peciAdapterName,
-- 
2.43.0

