From 5c76c41dceab552068017796db52d4e390de0811 Mon Sep 17 00:00:00 2001
From: OCP OpenBMC Team <openbmc@opencompute.org>
Date: Thu, 17 Sep 2026 00:00:00 +0000
Subject: [PATCH] meson: avoid absolute Boost library path

Meson's Boost module dependency records the resolved shared object path in
generated pkg-config metadata. Resolve boost_coroutine through the compiler
instead so libapisensor.pc contains a relocatable linker flag.

Upstream-Status: Pending
Signed-off-by: OCP OpenBMC Team <openbmc@opencompute.org>
---
 meson.build | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/meson.build b/meson.build
index 79dbe32..6f46a09 100644
--- a/meson.build
+++ b/meson.build
@@ -18,10 +18,7 @@ sdeventplus = dependency('sdeventplus')
 phosphor_logging_dep = dependency('phosphor-logging')
 libudev = dependency('libudev', required : false, include_type: 'system')
 uring = dependency('liburing', include_type: 'system')
-boost_dep = dependency(
-    'boost',
-    modules: ['coroutine'],
-)
+boost_dep = meson.get_compiler('cpp').find_library('boost_coroutine')
 
 add_project_arguments(
     '-Wno-psabi',
-- 
2.43.0