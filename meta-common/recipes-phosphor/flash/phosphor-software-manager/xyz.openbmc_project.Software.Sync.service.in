[Unit]
Description=Phosphor Sync Manager that syncs files to the alternate BMC chip
Wants=obmc-flash-bmc-prepare-for-sync.service
After=obmc-flash-bmc-prepare-for-sync.service

[Service]
ExecStart=/usr/libexec/phosphor-code-mgmt/phosphor-sync-software-manager
ExecStopPost=-/usr/bin/obmc-flash-bmc umount-static-altfs rwfs-alt
Restart=on-failure
RestartForceExitStatus=0 143

[Install]
WantedBy=multi-user.target
