[Unit]
Description=Phosphor Sync Manager that syncs files to the alternate BMC chip
ConditionPathExists=/etc/sync-enable
[Service]
ExecStart=/bin/sh -c '[ ! -f /sys/class/spi_master/spi0/device/current_boot ] || [ "$(cat /sys/class/spi_master/spi0/device/current_boot)" != "1" ] && exec /usr/bin/phosphor-sync-software-manager || exit 0'
Restart=always

[Install]
WantedBy=multi-user.target
