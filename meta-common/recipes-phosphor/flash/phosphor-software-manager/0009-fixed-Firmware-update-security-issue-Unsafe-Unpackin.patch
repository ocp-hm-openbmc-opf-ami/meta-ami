From 91f35fe8a97ed831dc89e94bca8acf9d3ce281f9 Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Tue, 15 Oct 2024 16:08:43 +0530
Subject: [PATCH] fixed Firmware update security issue - Unsafe Unpacking of
 Firmware Files

---
 xyz.openbmc_project.Software.Version.service.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xyz.openbmc_project.Software.Version.service.in b/xyz.openbmc_project.Software.Version.service.in
index 9651ee2..734f8b6 100644
--- a/xyz.openbmc_project.Software.Version.service.in
+++ b/xyz.openbmc_project.Software.Version.service.in
@@ -2,7 +2,7 @@
 Description=Phosphor Version Software Manager
 
 [Service]
-ExecStartPre=/bin/sh -c 'mkdir -p /tmp/images'
+ExecStartPre=/bin/sh -c 'mkdir -p /tmp/images; mount -t tmpfs -o nosuid,noexec tmpfs /tmp/images'
 ExecStart=/usr/bin/phosphor-version-software-manager
 Restart=always
 Type=dbus
-- 
2.34.1

