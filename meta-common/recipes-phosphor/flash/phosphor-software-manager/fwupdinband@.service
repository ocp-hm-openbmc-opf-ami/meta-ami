[Unit]
Description=Flash BMC with fwupd script : %I
Description=Latest Flash BMC with fwupd script : %I

[Service]
Type=oneshot
RemainAfterExit=no
Environment="ARGS=%I"
ExecStart=/bin/sh -c 'if [[ "$ARGS" == */tmp/image.tar* ]]; then /usr/bin/inband-fwupd.sh $ARGS ; else /bin/systemd-inhibit --what=shutdown:sleep --who=fwupd --why "Firmware Update %i" --mode=block /usr/bin/fwupd.sh $ARGS; fi'
ExecStartPost=/bin/sh -c 'if [[ "$ARGS" == */* ]] && [[ -f "/tmp/updateImage/image-bmc" ]]; then /sbin/reboot; fi'
SyslogIdentifier=fwupd
