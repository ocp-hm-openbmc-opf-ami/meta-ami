From 31749040280477c7e8d7a0409636a65b5b97b25d Mon Sep 17 00:00:00 2001
From: kirubagharanas <kirubagharanas@ami.com>
Date: Mon, 26 Aug 2024 16:04:08 +0530
Subject: [PATCH] Clear tmp and firmware inventory while cancel task

---
 activation.cpp | 31 ++++++++++++++++++-------------
 task.cpp       |  2 ++
 task.hpp       |  2 ++
 3 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/activation.cpp b/activation.cpp
index 27cce43..9046a9b 100644
--- a/activation.cpp
+++ b/activation.cpp
@@ -312,23 +312,27 @@ void Activation::onFlashWriteSuccess()
 void Activation::onFlashWriteFailure()
 {
     activation(softwareServer::Activation::Activations::Failed);
-    parent.activeUpdatesCount--;
-    auto purpose = parent.versions.find(versionId)->second->purpose();
-    if (purpose == VersionPurpose::BMC)
-    {
-        parent.performReboot = false;
-    }
-    if (!parent.activeUpdatesCount)
+    if (task->isTaskCancelled == false)
     {
-        if (activationBlocksTransition)
-            activationBlocksTransition->disableRebootGuard();
-        if(parent.performReboot)
+        parent.activeUpdatesCount--;
+        auto purpose = parent.versions.find(versionId)->second->purpose();
+        if (purpose == VersionPurpose::BMC)
         {
-            Activation::rebootBmc();
+            parent.performReboot = false;
         }
+        if (!parent.activeUpdatesCount)
+        {
+            if (activationBlocksTransition)
+                activationBlocksTransition->disableRebootGuard();
+            if(parent.performReboot)
+            {
+                Activation::rebootBmc();
+            }
+        }
+        activationProgress.reset(nullptr);
+        Activation::unsubscribeFromSystemdSignals();
     }
-    activationProgress.reset(nullptr);
-    Activation::unsubscribeFromSystemdSignals();
+
     // Delete the uploaded activation
     auto it = parent.versions.find(versionId);
     if (it != parent.versions.end())
@@ -399,6 +403,7 @@ auto Activation::requestedActivation(RequestedActivations value)
         {
           if (!task) {
             task = std::make_unique<Task>(bus, path, *this);
+	        // task->status(Task::OperationStatus::New);
           }
 
           if (task->isUpdateInMaintenenceWindow()) {
diff --git a/task.cpp b/task.cpp
index 0680c25..310ea64 100644
--- a/task.cpp
+++ b/task.cpp
@@ -63,8 +63,10 @@ Task::OperationStatus Task::status( Task::OperationStatus value)
 {
     if (value == Task::OperationStatus::Cancelled)
     {
+        isTaskCancelled=true;
         //  parent.activation(
         //                 softwareServer::Activation::Activations::Failed);
+        parent.onFlashWriteFailure();
         timer.cancel();
     }
         
diff --git a/task.hpp b/task.hpp
index 6acdf1f..465e2bb 100644
--- a/task.hpp
+++ b/task.hpp
@@ -90,6 +90,8 @@ class Task : public TaskInherit
 
     boost::asio::steady_timer timer;
 
+    bool isTaskCancelled=false;
+
 };
 } // namespace updater
 } // namespace software
-- 
