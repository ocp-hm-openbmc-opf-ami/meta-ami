+auto Manager::processPFRImage(sdbusplus::message::unix_fd image,
+                              ApplyTimeIntf::RequestedApplyTimes applyTime,
+                              std::string id, std::string objPath)
+    -> sdbusplus::async::task<>
+{
+    debug("Processing PFR image {FD}", "FD", image.fd);
+    fs::path tmpDirPath(std::string{IMG_UPLOAD_DIR});
+    tmpDirPath /= "imageXXXXXX";
+    auto tmpDir = tmpDirPath.string();
+
+    if (!mkdtemp(tmpDir.data()))
+    {
+        error("Error ({ERRNO}) occurred during mkdtemp", "ERRNO", errno);
+        processImageFailed(image, id);
+        report<SoftwareErrors::InternalFailure>(InternalFail::FAIL("mkdtemp"));
+        co_return;
+    }
+
+    std::error_code ec;
+    tmpDirPath = tmpDir;
+    softwareUtils::RemovablePath tmpDirToRemove(tmpDirPath);
+
+    std::string imgFilePath = tmpDirPath.string() + "/fw_download.bin";
+
+    if (!writeToImage(image, imgFilePath))
+    {
+        error("Error occurred during image writing");
+        processImageFailed(image, id);
+        co_return;
+    }
+
+    std::filesystem::path imgPath(imgFilePath);
+
+    if (!std::filesystem::exists(imgPath))
+    {
+        error("File path doesnot exists");
+        co_return;
+    }
+
+    if (isFwupdScriptRunning(ctx.get_bus()))
+    {
+        error("FwupdScript is Running already");
+        co_return;
+    }
+
+    std::string extVer;
+    std::string ver;
+    std::string purposeString;
+
+    std::uintmax_t fSize = std::filesystem::file_size(imgFilePath);
+
+    if (fSize == 64 * 1024 * 1024)
+    {
+        // TODO: Find out how to read version number and also set correct
+        // "purpose" string. Filling with dummy data for now.
+
+        ver = "1";
+        purposeString =
+            "xyz.openbmc_project.Software.Version.VersionPurpose.Host";
+    }
+
+    else if (fSize == 128 * 1024 * 1024)
+    {
+        if (0 != verifyBmcFullFlashImage(imgFilePath, ver, purposeString))
+        {
+            phosphor::logging::log<phosphor::logging::level::ERR>(
+                "Error verifying uploaded image");
+            std::filesystem::remove_all(imgFilePath);
+            co_return;
+        }
+    }
+
+    else if (0 != verifyImage(imgFilePath, ver, purposeString))
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(
+            "Error verifying uploaded image");
+        std::filesystem::remove_all(imgFilePath);
+        co_return;
+    }
+
+    if (ver.empty())
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(
+            "Empty version from image file");
+        co_return;
+    }
+
+    sdbusplus::xyz::openbmc_project::Software::server::Version::VersionPurpose
+        purpose = Version::VersionPurpose::Unknown;
+
+    try
+    {
+        purpose = Version::convertVersionPurposeFromString(purposeString);
+    }
+    catch (const sdbusplus::exception::InvalidEnumString& e)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(
+            "Error: Failed to convert purpose to enum."
+            " Setting to Unknown.");
+    }
+
+    if (versions.find(id) != versions.end())
+    {
+        phosphor::logging::log<phosphor::logging::level::INFO>(
+            "Software Object with the same version already exists, exiting "
+            "the update",
+            phosphor::logging::entry("VERSION_ID=%s", id.c_str()));
+        co_return;
+    }
+
+    std::filesystem::path imageDirPath(IMG_UPLOAD_DIR);
+    imageDirPath /= id;
+    auto filePath = imageDirPath.string();
+    try
+    {
+        std::filesystem::create_directory(imageDirPath);
+    }
+    catch (const std::filesystem::filesystem_error& fsErr)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(fsErr.what());
+    }
+
+    std::filesystem::path newFileName = imageDirPath / "image-runtime";
+    try
+    {
+        std::filesystem::rename(imgFilePath, newFileName);
+    }
+    catch (const std::filesystem::filesystem_error& fsErr)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(fsErr.what());
+    }
+
+    std::vector<std::string> compatibleNames;
+    auto state = itemUpdater.verifyAndCreateObjects(
+        id, objPath, ver, purpose, extVer, filePath, compatibleNames);
+
+    if (state != ActivationIntf::Activations::Ready)
+    {
+        error("Software image is invalid");
+        processImageFailed(image, id);
+        report<SoftwareErrors::ImageFailure>(
+            ImageFail::FAIL("Image is invalid"),
+            ImageFail::PATH(filePath.c_str()));
+        co_return;
+    }
+
+    if (applyTime == ApplyTimeIntf::RequestedApplyTimes::Immediate ||
+        applyTime == ApplyTimeIntf::RequestedApplyTimes::OnReset)
+    {
+        itemUpdater.requestActivation(id);
+    }
+
+    updateInProgress = false;
+    close(image);
+    co_return;
+}
