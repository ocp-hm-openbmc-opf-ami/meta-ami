+bool ItemUpdater::tryAcquireTargetLocks(
+    const std::vector<std::string>& targets, const std::string& versionId)
+{
+    auto lockTargets = targets;
+    if (lockTargets.empty())
+    {
+        lockTargets.emplace_back("__untargeted__");
+    }
+
+    for (const auto& target : lockTargets)
+    {
+        auto lockIt = targetLockOwners.find(target);
+        if (lockIt != targetLockOwners.end() && lockIt->second != versionId)
+        {
+            return false;
+        }
+    }
+
+    for (const auto& target : lockTargets)
+    {
+        targetLockOwners[target] = versionId;
+    }
+
+    return true;
+}
+
+void ItemUpdater::releaseTargetLocks(const std::vector<std::string>& targets,
+                                     const std::string& versionId)
+{
+    auto lockTargets = targets;
+    if (lockTargets.empty())
+    {
+        lockTargets.emplace_back("__untargeted__");
+    }
+
+    for (const auto& target : lockTargets)
+    {
+        auto lockIt = targetLockOwners.find(target);
+        if (lockIt != targetLockOwners.end() && lockIt->second == versionId)
+        {
+            targetLockOwners.erase(lockIt);
+        }
+    }
+}
+
+void ItemUpdater::deferVersionDelete(const std::string& versionId)
+{
+    bool exists = false;
+    for (const auto& id : deferredDeleteQueue)
+    {
+        if (id == versionId)
+        {
+            exists = true;
+            break;
+        }
+    }
+
+    if (!exists)
+    {
+        deferredDeleteQueue.emplace_back(versionId);
+    }
+}
+
+void ItemUpdater::flushDeferredDeletes()
+{
+    for (auto& versionId : deferredDeleteQueue)
+    {
+        boost::asio::post(getIOContext(), [this, versionId]() {
+            auto it = versions.find(versionId);
+            if (it != versions.end())
+            {
+                it->second->deleteObject->delete_();
+            }
+        });
+    }
+    deferredDeleteQueue.clear();
+}
+
 bool ItemUpdater::requestActivation(std::string& id)
 {
      auto activation = activations.find(id);

