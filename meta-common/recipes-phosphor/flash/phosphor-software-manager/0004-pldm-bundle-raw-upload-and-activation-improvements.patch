+    const fs::path& metadataPath, const PackageVersion& packageVersion,
+    const FirmwareDeviceIDRecord& record, const ComponentImageInfo& compInfo)
+{
+    constexpr const char* packageHeaderId =
+        "F018878CCB7D49439800A02F059ACA02";
+
+    const auto& devFlags = std::get<0>(record);
+    const auto& compSetVersion = std::get<2>(record);
+    const auto& descriptors = std::get<3>(record);
+
+    const auto compClass = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::CompClassificationPos)>(compInfo);
+    const auto compId = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::CompIdentifierPos)>(compInfo);
+    const auto compCmp = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::CompComparisonStampPos)>(compInfo);
+    const auto compOpts = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::CompOptionsPos)>(compInfo);
+    const auto reqActs = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::ReqCompActivationMethodPos)>(compInfo);
+    const auto compVer = std::get<static_cast<size_t>(
+        ComponentImageInfoPos::CompVersionPos)>(compInfo);
+
+    std::ofstream out(metadataPath, std::ios::trunc);
+    if (!out.good())
+    {
+        throw std::runtime_error("failed to write metadata: " +
+                                 metadataPath.string());
+    }
+
+    out << "{\n";
+    out << "  \"PackageHeaderInformation\": {\n";
+    out << "    \"PackageHeaderIdentifier\": \"" << packageHeaderId
+        << "\",\n";
+    out << "    \"PackageHeaderFormatVersion\": 1,\n";
+    out << "    \"PackageVersionString\": \"" << jsonEscape(packageVersion)
+        << "\",\n";
+    out << "    \"PackageReleaseDateTime\": \"" << nowIso8601()
+        << "\"\n";
+    out << "  },\n";
+
+    out << "  \"FirmwareDeviceIdentificationArea\": [\n";
+    out << "    {\n";
+    out << "      \"DeviceUpdateOptionFlags\": ["
+        << joinInts(bitsetIndices(devFlags)) << "],\n";
+    out << "      \"ComponentImageSetVersionString\": \""
+        << jsonEscape(compSetVersion) << "\",\n";
+    out << "      \"ApplicableComponents\": [0],\n";
+    out << "      \"Descriptors\": [\n";
+
+    bool first = true;
+    for (const auto& [descType, descValue] : descriptors)
+    {
+        if (!first)
+        {
+            out << ",\n";
+        }
+        first = false;
+
+        out << "        {\n";
+        out << "          \"DescriptorType\": " << descType;
+        if (std::holds_alternative<DescriptorData>(descValue))
+        {
+            out << ",\n          \"DescriptorData\": \""
+                << bytesToHex(std::get<DescriptorData>(descValue)) << "\"\n";
+        }
+        else
+        {
+            const auto& vendor = std::get<VendorDefinedDescriptorInfo>(descValue);
+            out << ",\n          \"VendorDefinedDescriptorTitleString\": \""
+                << jsonEscape(std::get<VendorDefinedDescriptorTitle>(vendor))
+                << "\",\n";
+            out << "          \"VendorDefinedDescriptorData\": \""
+                << bytesToHex(std::get<VendorDefinedDescriptorData>(vendor))
+                << "\"\n";
+        }
+        out << "        }";
+    }
+    out << "\n      ]\n";
+    out << "    }\n";
+    out << "  ],\n";
+
+    out << "  \"ComponentImageInformationArea\": [\n";
+    out << "    {\n";
+    out << "      \"ComponentClassification\": " << compClass << ",\n";
+    out << "      \"ComponentIdentifier\": " << compId << ",\n";
+    out << "      \"ComponentOptions\": [" << joinInts(bitsetIndices(compOpts))
+        << "],\n";
+    if (compOpts.test(1))
+    {
+        std::ostringstream cmp;
+        cmp << "0x" << std::uppercase << std::hex << std::setw(8)
+            << std::setfill('0') << compCmp;
+        out << "      \"ComponentComparisonStamp\": \"" << cmp.str()
+            << "\",\n";
+    }
+    out << "      \"RequestedComponentActivationMethod\": ["
+        << joinInts(bitsetIndices(reqActs)) << "],\n";
+    out << "      \"ComponentVersionString\": \"" << jsonEscape(compVer)
+        << "\"\n";
+    out << "    }\n";
+    out << "  ]\n";
+    out << "}\n";
+}
+
+void buildSingleComponentPldm(const fs::path& outputImage,
+                              const fs::path& metadataPath,
+                              const fs::path& rawImage,
+                              const std::string& pkgCreator)
+{
+    const std::string cmd =
+        shellQuote(pkgCreator) + " " + shellQuote(outputImage.string()) +
+        " " + shellQuote(metadataPath.string()) + " " +
+        shellQuote(rawImage.string());
+
+    const int rc = std::system(cmd.c_str());
+    if (rc != 0)
+    {
+        throw std::runtime_error(
+            "failed to create PLDM package for component (rc=" +
+            std::to_string(rc) + ") using " + pkgCreator);
+    }
+}
+
+void printUsage(const char* argv0)
+{
+    std::cout << "Usage: " << argv0
+              << " PLDM_IMAGE JSON_CONFIG OUTPUT_DIR [--component-format raw|pldm]"
+              << " [--pkg-creator PATH] [--debug-parser]\n"
+              << "\n"
+              << "PLDM bundle extraction tool.\n"
+              << "  --component-format raw|pldm  raw: extract payload bytes\n"
+              << "                                 pldm: build single-component PLDM package\n"
+              << "  --pkg-creator PATH           executable for PLDM package creation\n"
+              << "  --debug-parser               enable verbose parser diagnostics\n"
+              << "  fwupd.json per component:    bundleExtractFormat=raw|pldm\n";
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    if (argc == 2)
+    {
+        const std::string arg = argv[1];
+        if (arg == "-h" || arg == "--help")
+        {
+            printUsage(argv[0]);
+            return 0;
+        }
+    }
+
+    if (argc < 4)
+    {
+        printUsage(argv[0]);
+        return 2;
+    }
+
+    std::string componentFormat = "raw";
+    std::string pkgCreator = "pldm_fwup_pkg_creator.py";
+    bool parserDebug = false;
+    for (int i = 4; i < argc; ++i)
+    {
+        const std::string arg = argv[i];
+        if (arg.rfind("--component-format=", 0) == 0)
+        {
+            componentFormat = arg.substr(std::string("--component-format=").size());
+            continue;
+        }
+
+        if (arg == "--component-format")
+        {
+            if (i + 1 >= argc)
+            {
+                std::cerr << "pldm_bundle_extraction_tool: missing value for --component-format\n";
+                printUsage(argv[0]);
+                return 2;
+            }
+            componentFormat = argv[++i];
+            continue;
+        }
+
+        if (arg.rfind("--pkg-creator=", 0) == 0)
+        {
+            pkgCreator = arg.substr(std::string("--pkg-creator=").size());
+            continue;
+        }
+
+        if (arg == "--pkg-creator")
+        {
+            if (i + 1 >= argc)
+            {
+                std::cerr << "pldm_bundle_extraction_tool: missing value for --pkg-creator\n";
+                printUsage(argv[0]);
+                return 2;
+            }
+            pkgCreator = argv[++i];
+            continue;
+        }
+
+        if (arg == "--debug-parser")
+        {
+            parserDebug = true;
+            continue;
+        }
+
+        std::cerr << "pldm_bundle_extraction_tool: unknown argument: " << arg << "\n";
+        printUsage(argv[0]);
+        return 2;
+    }
+
+    if (componentFormat != "raw" && componentFormat != "pldm")
+    {
+        std::cerr << "pldm_bundle_extraction_tool: invalid --component-format: "
+                  << componentFormat << "\n";
+        printUsage(argv[0]);
+        return 2;
+    }
+
+    if (parserDebug)
+    {
+        setenv("PLDM_PARSER_DEBUG", "1", 1);
+    }
+
+    const fs::path pldmImage = argv[1];
+    const fs::path jsonPath = argv[2];
+    const fs::path outputDir = argv[3];
+
+    if (!fs::exists(pldmImage))
+    {
+        std::cerr << "pldm_bundle_extraction_tool: image not found: " << pldmImage << "\n";
+        return 1;
+    }
+    if (!fs::exists(jsonPath))
+    {
+        std::cerr << "pldm_bundle_extraction_tool: config not found: " << jsonPath << "\n";
+        return 1;
+    }
+
+    int rc = 0;
+    try
+    {
+        fs::create_directories(outputDir);
+
+        // Load and parse PLDM package
+        const std::string json = readAll(jsonPath);
+        const std::vector<Component> components =
+            parseComponentsFromFwupdJson(json);
+
+        std::vector<uint8_t> pkg;
+        {
+            std::ifstream in(pldmImage, std::ios::binary);
+            if (!in.good())
+            {
+                throw std::runtime_error("failed to open PLDM image");
+            }
+            pkg.assign(std::istreambuf_iterator<char>(in),
+                       std::istreambuf_iterator<char>());
+        }
+
+        auto parsed =
+            pldm_package_util::parsePLDMPackage(pkg.data(), pkg.size());
+        if (!parsed)
+        {
+            throw std::runtime_error("failed to parse PLDM package");
+        }
+
+        size_t extracted = 0;
+        std::set<size_t> extractedIndices;
+
+        // First pass: extract all non-PLDM components resolved via fwupd
+        // compatible-hardware mapping.
+
+        for (const auto& comp : components)
+        {
+            if (comp.name == "pldm" || comp.compatibles.empty())
+            {
+                continue;
+            }
+
+            const std::string compFormat =
+                comp.bundleExtractFormat.empty() ? componentFormat :
+                                                 comp.bundleExtractFormat;
+            if (compFormat != "raw" && compFormat != "pldm")
+            {
+                throw std::runtime_error(
+                    "invalid bundleExtractFormat for component '" +
+                    comp.name + "': " + compFormat);
+            }
+            const bool emitCompAsPldm = (compFormat == "pldm");
+
+            for (const auto& compatible : comp.compatibles)
+            {
+                const std::string safeHw = sanitize(compatible);
+                const std::string prefix = emitCompAsPldm ? "image-pldm-" : "image-";
+                const fs::path outImage = outputDir / (prefix + comp.name + "-" + safeHw);
+                const fs::path rawImage = emitCompAsPldm
+                    ? (outputDir / ("image-raw-" + comp.name + "-" + safeHw + ".bin"))
+                    : outImage;
+
+                auto match =
+                    extractByCompatible(pkg, parsed, compatible, rawImage);
+                if (!match.has_value())
+                {
+                    continue;
+                }
+
+                extractedIndices.insert(match->compIndex);
+
+                if (emitCompAsPldm)
+                {
+                    const auto& compInfo =
+                        parsed->getComponentImageInfos().at(match->compIndex);
+                    const fs::path metadataPath =
+                        outputDir / ("meta-" + comp.name + "-" + safeHw + ".json");
+                    writeSingleComponentMetadata(metadataPath, parsed->pkgVersion,
+                                                 *match->record, compInfo);
+                    buildSingleComponentPldm(outImage, metadataPath, rawImage,
+                                             pkgCreator);
+                }
+                ++extracted;
+                std::cout << "pldm_bundle_extraction_tool: extracted " << comp.name
+                          << " for " << compatible << " -> " << outImage
+                          << "\n";
+            }
+        }
+
+        // Second pass: create reduced PLDM-only output (smaller than the
+        // original combined bundle). Prefer explicit PLDM compatible match.
+        bool wrotePldm = false;
+        const fs::path pldmOut = outputDir / "image-pldm";
+
+        // If the pldm component explicitly requests "pldm" extract format with
+        // no compatibles list, copy the whole package directly (no extraction).
+        for (const auto& comp : components)
+        {
+            if (comp.name != "pldm" || !comp.compatibles.empty())
+            {
+                continue;
+            }
+            if (comp.bundleExtractFormat != "pldm")
+            {
+                continue;
+            }
+            std::ofstream out(pldmOut, std::ios::binary | std::ios::trunc);
+            if (out.good())
+            {
+                out.write(reinterpret_cast<const char*>(pkg.data()),
+                          static_cast<std::streamsize>(pkg.size()));
+                if (out.good())
+                {
+                    ++extracted;
+                    wrotePldm = true;
+                    std::cout << "pldm_bundle_extraction_tool: bundleExtractFormat=pldm:"
+                              << " copied full package as image-pldm -> " << pldmOut << "\n";
+                }
+            }
+            break;
+        }
+
+        for (const auto& comp : components)
+        {
+            if (comp.name != "pldm" || comp.compatibles.empty())
+            {
+                continue;
+            }
+
+            for (const auto& compatible : comp.compatibles)
+            {
+                auto match =
+                    extractByCompatible(pkg, parsed, compatible, pldmOut);
+                if (!match.has_value())
+                {
+                    continue;
+                }
+
+                extractedIndices.insert(match->compIndex);
+                ++extracted;
+                wrotePldm = true;
+                std::cout << "pldm_bundle_extraction_tool: extracted pldm for "
+                          << compatible << " -> " << pldmOut << "\n";
+                break;
+            }
+
+            if (wrotePldm)
+            {
+                break;
+            }
+        }
+
+        // Fallback: no compatible-string match found for the pldm component.
+        // Copy the entire PLDM package as image-pldm so pldmd receives a
+        // well-formed package it can parse (not a raw extracted payload).
+        if (!wrotePldm)
+        {
+            std::ofstream out(pldmOut, std::ios::binary | std::ios::trunc);
+            if (out.good())
+            {
+                out.write(reinterpret_cast<const char*>(pkg.data()),
+                          static_cast<std::streamsize>(pkg.size()));
+                if (out.good())
+                {
+                    ++extracted;
+                    wrotePldm = true;
+                    std::cout << "pldm_bundle_extraction_tool: copied full package"
+                              << " as image-pldm -> " << pldmOut << "\n";
+                }
+            }
+        }
+
+        std::cout << "pldm_bundle_extraction_tool: extracted=" << extracted << "\n";
+        std::cout << "pldm_bundle_extraction_tool: output dir: " << outputDir << "\n";
+    }
+    catch (const std::exception& e)
+    {
+        std::cerr << "pldm_bundle_extraction_tool: " << e.what() << "\n";
+        rc = 1;
+    }
+
+    return rc;
+}
