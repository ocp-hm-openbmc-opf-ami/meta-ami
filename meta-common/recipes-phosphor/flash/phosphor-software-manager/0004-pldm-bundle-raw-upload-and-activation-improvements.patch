+std::optional<std::string> getRawPLDMPackageVersion(const fs::path& inputPath)
+{
+    // Read package_version_string from PLDM package header.
+    // Layout (DSP0267 v1):
+    //  uuid[16], formatRev[1], hdrSize[2], releaseDateTime[13],
+    //  componentBitmapBitLength[2], pkgVersionType[1], pkgVersionLen[1],
+    //  pkgVersion[pkgVersionLen]
+    constexpr size_t fixedHdrBytes = 36;
+    constexpr size_t pkgVersionLenOffset = 35;
+
+    std::ifstream in(inputPath, std::ios::binary);
+    if (!in.good())
+    {
+        return std::nullopt;
+    }
+
+    uint8_t hdr[fixedHdrBytes] = {};
+    in.read(reinterpret_cast<char*>(hdr), sizeof(hdr));
+    if (in.gcount() < static_cast<std::streamsize>(sizeof(hdr)))
+    {
+        return std::nullopt;
+    }
+
+    const uint16_t pkgHeaderSize =
+        static_cast<uint16_t>(hdr[17]) |
+        (static_cast<uint16_t>(hdr[18]) << 8);
+    const uint8_t pkgVersionLen = hdr[pkgVersionLenOffset];
+
+    if (pkgVersionLen == 0)
+    {
+        return std::nullopt;
+    }
+
+    if (pkgHeaderSize < (fixedHdrBytes + pkgVersionLen))
+    {
+        return std::nullopt;
+    }
+
+    std::string pkgVersion(pkgVersionLen, '\0');
+    in.read(pkgVersion.data(), pkgVersionLen);
+    if (in.gcount() != static_cast<std::streamsize>(pkgVersionLen))
+    {
+        return std::nullopt;
+    }
+
+    while (!pkgVersion.empty() &&
+           (pkgVersion.back() == '\0' ||
+            std::isspace(static_cast<unsigned char>(pkgVersion.back()))))
+    {
+        pkgVersion.pop_back();
+    }
+
+    if (pkgVersion.empty())
+    {
+        return std::nullopt;
+    }
+
+    return pkgVersion;
+}
+
+bool isRawPLDMUpload(const fs::path& inputPath)
+{
+    std::error_code ec;
+    if (!fs::is_regular_file(inputPath, ec))
+    {
+        return false;
+    }
+
+    // PLDM package header UUID per DSP0267 v1 package format.
+    static constexpr uint8_t pldmPkgHeaderUuid[16] = {
+        0xF0, 0x18, 0x87, 0x8C, 0xCB, 0x7D, 0x49, 0x43,
+        0x98, 0x00, 0xA0, 0x2F, 0x05, 0x9A, 0xCA, 0x02};
+
+    std::ifstream in(inputPath, std::ios::binary);
+    if (!in.good())
+    {
+        return false;
+    }
+
+    uint8_t hdr[17] = {};
+    in.read(reinterpret_cast<char*>(hdr), sizeof(hdr));
+    if (in.gcount() < static_cast<std::streamsize>(sizeof(hdr)))
+    {
+        return false;
+    }
+
+    // Byte 16 is package header format version for UUID-identified header.
+    return std::equal(std::begin(pldmPkgHeaderUuid),
+                      std::end(pldmPkgHeaderUuid), std::begin(hdr)) &&
+           hdr[16] == 0x01;
+}
+
+bool stageRawPLDMUpload(const fs::path& srcPath, const fs::path& tmpDirPath,
+                        const std::string& machine)
+{
+    std::error_code ec;
+    const fs::path dstImage = tmpDirPath / "image-pldm";
+    fs::copy_file(srcPath, dstImage, fs::copy_options::overwrite_existing, ec);
+    if (ec)
+    {
+        error("Failed to stage raw PLDM image {SRC}: {ERROR_MSG}", "SRC",
+              srcPath.string(), "ERROR_MSG", ec.message());
+        return false;
+    }
+
+    const fs::path manifestPath = tmpDirPath / MANIFEST_FILE_NAME;
+    std::ofstream manifest(manifestPath);
+    if (!manifest.good())
+    {
+        error("Failed to create MANIFEST for raw PLDM upload at {PATH}",
+              "PATH", manifestPath.string());
+        return false;
+    }
+
+    const auto packageVersion =
+        getRawPLDMPackageVersion(srcPath).value_or(srcPath.stem().string());
+    manifest << "version=" << packageVersion << "\n";
+    manifest
+        << "purpose=xyz.openbmc_project.Software.Version.VersionPurpose.PLDM\n";
+    manifest << "MachineName=" << machine << "\n";
+    manifest << "OriginalUploadFormat=raw\n";
+    return manifest.good();
+}
