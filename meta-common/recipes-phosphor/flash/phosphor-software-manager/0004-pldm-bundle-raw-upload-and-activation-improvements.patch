+// pldm_bundle_tool.cpp
+// Extracts component images from a PLDM firmware bundle into an output
+// directory. No flash dispatch is performed.
+//
+// Usage: pldm-bundle-extraction-tool PLDM_IMAGE JSON_CONFIG OUTPUT_DIR
+//        [--component-format raw|pldm]
+//        [--pkg-creator PATH] [--debug-parser]
+
+#include "common/pldm/pldm_package_util.hpp"
+
+#include <libpldm/firmware_update.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <optional>
+#include <regex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <ctime>
+#include <iomanip>
+#include <sstream>
+#include <cstdlib>
+#include <vector>
+
+using namespace pldm::fw_update;
+namespace fs = std::filesystem;
+
+namespace
+{
+
+struct Component
+{
+    std::string name;
+    std::vector<std::string> compatibles;
+    std::string bundleExtractFormat;
+};
+
+struct ExtractMatch
+{
+    size_t compIndex;
+    const FirmwareDeviceIDRecord* record;
+};
+
+std::string readAll(const fs::path& path)
+{
+    std::ifstream in(path);
+    if (!in.good())
+    {
+        throw std::runtime_error("failed to open: " + path.string());
+    }
+    return std::string((std::istreambuf_iterator<char>(in)),
+                       std::istreambuf_iterator<char>());
+}
+
+std::optional<std::string> extractFirst(const std::string& src,
+                                        const std::regex& pattern)
+{
+    std::smatch m;
+    if (std::regex_search(src, m, pattern) && m.size() > 1)
+    {
+        return m[1].str();
+    }
+    return std::nullopt;
+}
+
+std::string normalizeFormat(std::string fmt)
+{
+    std::transform(fmt.begin(), fmt.end(), fmt.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return fmt;
+}
+
+std::vector<Component> parseComponentsFromFwupdJson(const std::string& json)
+{
+    std::vector<Component> out;
+
+    const auto componentsPos = json.find("\"components\"");
+    if (componentsPos == std::string::npos)
+    {
+        return out;
+    }
+
+    const auto arrStart = json.find('[', componentsPos);
+    if (arrStart == std::string::npos)
+    {
+        return out;
+    }
+
+    size_t i = arrStart + 1;
+    int depth = 0;
+    size_t objStart = std::string::npos;
+
+    for (; i < json.size(); ++i)
+    {
+        const char c = json[i];
+        if (c == '{')
+        {
+            if (depth == 0)
+            {
+                objStart = i;
+            }
+            ++depth;
+        }
+        else if (c == '}')
+        {
+            --depth;
+            if (depth == 0 && objStart != std::string::npos)
+            {
+                const auto obj = json.substr(objStart, i - objStart + 1);
+
+                Component comp;
+                auto name = extractFirst(
+                    obj,
+                    std::regex("\\\"name\\\"\\s*:\\s*\\\"([^\\\"]+)\\\""));
+                if (!name.has_value())
+                {
+                    objStart = std::string::npos;
+                    continue;
+                }
+                comp.name = name.value();
+
+                auto hwBlock = extractFirst(
+                    obj, std::regex(
+                             "\\\"CompatibleHardware\\\"\\s*:\\s*\\[(.*?)\\]",
+                             std::regex::ECMAScript));
+                if (hwBlock.has_value())
+                {
+                    const std::regex item("\\\"([^\\\"]+)\\\"");
+                    for (auto it = std::sregex_iterator(hwBlock->begin(),
+                                                        hwBlock->end(), item);
+                         it != std::sregex_iterator(); ++it)
+                    {
+                        comp.compatibles.emplace_back((*it)[1].str());
+                    }
+                }
+
+                auto fmt = extractFirst(
+                    obj,
+                    std::regex("\\\"bundleExtractFormat\\\"\\s*:\\s*\\\"([^\\\"]+)\\\""));
+                if (fmt.has_value())
+                {
+                    comp.bundleExtractFormat = normalizeFormat(fmt.value());
+                }
+
+                out.emplace_back(std::move(comp));
+                objStart = std::string::npos;
+            }
+        }
+        else if (c == ']' && depth == 0)
+        {
+            break;
+        }
+    }
+
+    return out;
+}
+
+bool matchesCompatible(const FirmwareDeviceIDRecord& record,
+                       const std::string& compatible)
+{
+    const auto& desc = std::get<3>(record);
+    if (desc.empty() || !desc.contains(PLDM_FWUP_VENDOR_DEFINED))
+    {
+        return false;
+    }
+
+    const auto& vendorDesc = desc.at(PLDM_FWUP_VENDOR_DEFINED);
+    if (!std::holds_alternative<VendorDefinedDescriptorInfo>(vendorDesc))
+    {
+        return false;
+    }
+
+    const auto& vendor = std::get<VendorDefinedDescriptorInfo>(vendorDesc);
+    return std::get<VendorDefinedDescriptorTitle>(vendor) == compatible;
+}
+
+bool extractByIndex(const std::vector<uint8_t>& pkg,
+                    const ComponentImageInfos& comps, size_t compIndex,
+                    const fs::path& outPath)
+{
+    if (compIndex >= comps.size())
+    {
+        return false;
+    }
+
+    const auto& c = comps[compIndex];
+    const size_t offset = static_cast<size_t>(
+        std::get<static_cast<size_t>(ComponentImageInfoPos::CompLocationOffsetPos)>(c));
+    const size_t size = static_cast<size_t>(
+        std::get<static_cast<size_t>(ComponentImageInfoPos::CompSizePos)>(c));
+
+    if (offset + size > pkg.size())
+    {
+        return false;
+    }
+
+    std::ofstream out(outPath, std::ios::binary | std::ios::trunc);
+    if (!out.good())
+    {
+        return false;
+    }
+
+    out.write(reinterpret_cast<const char*>(pkg.data() + offset),
+              static_cast<std::streamsize>(size));
+    return out.good();
+}
+
+std::optional<ExtractMatch> extractByCompatible(
+    const std::vector<uint8_t>& pkg,
+    const std::shared_ptr<PackageParser>& parsed,
+    const std::string& compatible, const fs::path& outPath)
+{
+    const auto& records = parsed->getFwDeviceIDRecords();
+    const auto& comps = parsed->getComponentImageInfos();
+
+    for (const auto& record : records)
+    {
+        if (!matchesCompatible(record, compatible))
+        {
+            continue;
+        }
+
+        const auto& applicable = std::get<1>(record);
+        if (applicable.empty())
+        {
+            continue;
+        }
+
+        const size_t compIndex = applicable[0];
+        if (!extractByIndex(pkg, comps, compIndex, outPath))
+        {
+            continue;
+        }
+
+        return ExtractMatch{compIndex, &record};
+    }
+
+    return std::nullopt;
+}
+
+std::string sanitize(const std::string& s)
+{
+    return std::regex_replace(s, std::regex("[^A-Za-z0-9._-]"), "_");
+}
+
+std::string jsonEscape(const std::string& s)
+{
+    std::string out;
+    out.reserve(s.size());
+    for (const char ch : s)
+    {
+        switch (ch)
+        {
+            case '\\':
+                out += "\\\\";
+                break;
+            case '"':
+                out += "\\\"";
+                break;
+            case '\n':
+                out += "\\n";
+                break;
+            case '\r':
+                out += "\\r";
+                break;
+            case '\t':
+                out += "\\t";
+                break;
+            default:
+                out += ch;
+                break;
+        }
+    }
+    return out;
+}
+
+std::string bytesToHex(const std::vector<uint8_t>& data)
+{
+    std::ostringstream oss;
+    oss << std::uppercase << std::hex << std::setfill('0');
+    for (const auto b : data)
+    {
+        oss << std::setw(2) << static_cast<unsigned>(b);
+    }
+    return oss.str();
+}
+
+template <size_t N>
+std::vector<int> bitsetIndices(const std::bitset<N>& bits)
+{
+    std::vector<int> out;
+    for (size_t i = 0; i < N; ++i)
+    {
+        if (bits.test(i))
+        {
+            out.emplace_back(static_cast<int>(i));
+        }
+    }
+    return out;
+}
+
+std::string joinInts(const std::vector<int>& values)
+{
+    std::ostringstream oss;
+    for (size_t i = 0; i < values.size(); ++i)
+    {
+        if (i != 0)
+        {
+            oss << ", ";
+        }
+        oss << values[i];
+    }
+    return oss.str();
+}
+
+std::string shellQuote(const std::string& s)
+{
+    std::string out = "'";
+    for (const char ch : s)
+    {
+        if (ch == '\'')
+        {
+            out += "'\\''";
+        }
+        else
+        {
+            out += ch;
+        }
+    }
+    out += "'";
+    return out;
+}
+
+std::string nowIso8601()
+{
+    const auto now = std::chrono::system_clock::now();
+    const std::time_t tt = std::chrono::system_clock::to_time_t(now);
+    std::tm tm{};
+    gmtime_r(&tt, &tm);
+    char buf[32]{};
+    std::strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%S", &tm);
+    return std::string(buf);
+}
+
