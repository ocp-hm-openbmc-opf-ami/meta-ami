From 5d51793b3686dafe7fc666748db0af5f5d1be485 Mon Sep 17 00:00:00 2001
From: Govardhan <govardhanc@ami.com>
Date: Wed, 1 Apr 2026 13:13:26 +0530
Subject: [PATCH] Timer Support for manager reset operation

---
 bmc_state_manager.cpp      | 15 ++++++++++++++-
 bmc_state_manager.hpp      | 24 ++++++++++++++++++++++++
 bmc_state_manager_main.cpp | 11 +++++++++--
 3 files changed, 47 insertions(+), 3 deletions(-)

diff --git a/bmc_state_manager.cpp b/bmc_state_manager.cpp
index e6b52dd6..12b3bf3e 100644
--- a/bmc_state_manager.cpp
+++ b/bmc_state_manager.cpp
@@ -244,7 +244,20 @@ BMC::Transition BMC::requestedBMCTransition(Transition value)
     }
 #endif // CHECK_FWUPDATE_BEFORE_DO_TRANSITION
 
-    executeTransition(value);
+    uint16_t timeOutValue = timeOut();
+
+    info("timeout value""{TIMEOUT}","TIMEOUT", timeOutValue);
+    if (timeOutValue == 0)
+    {
+        executeTransition(value);
+    }
+    else
+    {
+        auto interval = std::chrono::seconds(timeOutValue); // start gTimer
+        gTimer->restart(interval);
+        return server::BMC::requestedBMCTransition(value);
+    }
+
     return server::BMC::requestedBMCTransition(value);
 }
 
diff --git a/bmc_state_manager.hpp b/bmc_state_manager.hpp
index 8c2d498f..0ad481fd 100644
--- a/bmc_state_manager.hpp
+++ b/bmc_state_manager.hpp
@@ -7,6 +7,13 @@
 #include <sys/sysinfo.h>
 
 #include <sdbusplus/bus.hpp>
+#include <sdeventplus/event.hpp>
+#include <sdeventplus/utility/timer.hpp>
+#include <sdbusplus/bus/match.hpp>
+
+#include<iostream>
+
+#include <boost/asio.hpp>
 
 #include <cassert>
 #include <chrono>
@@ -22,6 +29,8 @@ using BMCInherit = sdbusplus::server::object_t<
     sdbusplus::server::xyz::openbmc_project::state::BMC>;
 namespace sdbusRule = sdbusplus::bus::match::rules;
 
+using Timer = sdeventplus::utility::Timer<sdeventplus::ClockId::RealTime>;
+
 /** @class BMC
  *  @brief OpenBMC BMC state management implementation.
  *  @details A concrete implementation for xyz.openbmc_project.State.BMC
@@ -74,6 +83,18 @@ class BMC : public BMCInherit
         updateLastRebootTime();
 
         this->emit_object_added();
+
+	std::cerr << "bmc constructor called 1" << "\n";
+        auto timerCB = [&](Timer&) {
+
+                Transition value = sdbusplus::xyz::openbmc_project::State::server::BMC::requestedBMCTransition();
+                timeOut(0);
+                executeTransition(value);
+                };
+
+        gTimer = std::make_unique<
+                sdeventplus::utility::Timer<sdeventplus::ClockId::RealTime>>(
+                bus.get_event(), std::move(timerCB));
     };
 
     /** @brief Set value of BMCTransition **/
@@ -135,6 +156,9 @@ class BMC : public BMCInherit
     /** @brief Used to subscribe to timesync **/
     std::unique_ptr<sdbusplus::bus::match_t> timeSyncSignal;
 
+    /** Timer for Bmc reset operation */
+    std::shared_ptr<Timer> gTimer;
+
     /**
      * @brief discover the last reboot cause of the bmc
      **/
diff --git a/bmc_state_manager_main.cpp b/bmc_state_manager_main.cpp
index 2b34ea85..be0f4d10 100644
--- a/bmc_state_manager_main.cpp
+++ b/bmc_state_manager_main.cpp
@@ -17,6 +17,12 @@ int main()
     std::string objPathInst =
         sdbusplus::message::object_path(objPath) / BMCName;
 
+    // Get a default event loop
+    sdeventplus::Event event = sdeventplus::Event::get_default();
+
+    // Attach the bus to sd_event to service user requests
+    bus.attach_event(event.get(), SD_EVENT_PRIORITY_NORMAL);
+
     // Add sdbusplus ObjectManager.
     sdbusplus::server::manager_t objManager(bus, objPath);
 
@@ -24,11 +30,12 @@ int main()
 
     bus.request_name(BMCState::interface);
 
-    while (true)
+    event.loop();
+    /*while (true)
     {
         bus.process_discard();
         bus.wait();
-    }
+    }*/
 
     exit(EXIT_SUCCESS);
 }
-- 
