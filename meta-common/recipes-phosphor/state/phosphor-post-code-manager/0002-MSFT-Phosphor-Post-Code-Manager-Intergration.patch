From 46f2079fa6a73da918fc618a0d9334c749a274db Mon Sep 17 00:00:00 2001
From: SonaN <sonan@ami.com>
Date: Wed, 21 May 2025 12:28:57 +0530
Subject: [PATCH] MSFT Phosphor-Post-Code-Manager Intergration

Signed-off-by: SonaN <sonan@ami.com>
---
 inc/post_code.hpp | 2 +-
 meson.options     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/inc/post_code.hpp b/inc/post_code.hpp
index f146008..105f5cd 100644
--- a/inc/post_code.hpp
+++ b/inc/post_code.hpp
@@ -38,7 +38,7 @@ const static constexpr char* CurrentBootCycleIndexName =
 const static constexpr char* PostCodePath =
     "/xyz/openbmc_project/state/boot/raw";
 const static constexpr char* PostCodeListPathPrefix =
-    "/var/lib/phosphor-post-code-manager/host";
+    "/var/log/phosphor-post-code-manager/host";
 const static constexpr char* HostStatePathPrefix =
     "/xyz/openbmc_project/state/host";
 
diff --git a/meson.options b/meson.options
index 763b30f..20a4ef2 100644
--- a/meson.options
+++ b/meson.options
@@ -1,4 +1,4 @@
 option('max-boot-cycle-count', type:'integer', min:1, max: 100, description: 'Maximum boot cycles for which the post codes should be persisted', value:100)
 option('bios-post-code-log', type:'feature',description:'bios post code log',value:'disabled')
-option('max-post-code-size-per-cycle', type:'integer', min:64, max: 1024, description: 'Maximum post code file size per cycle', value:512)
+option('max-post-code-size-per-cycle', type:'integer', min:64, max: 8192, description: 'Maximum post code file size per cycle', value:6144)
 option('postcode-display-path', type:'string', description:'The sys path for postcode display on debug card')
