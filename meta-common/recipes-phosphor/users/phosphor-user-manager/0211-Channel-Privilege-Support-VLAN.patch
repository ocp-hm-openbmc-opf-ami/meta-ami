From b235f64bf09f8fd9dfeb7f36a4b3676bf3c873bb Mon Sep 17 00:00:00 2001
From: Vijaysankar R <vijaysankarr@ami.com>
Date: Fri, 21 Nov 2025 12:40:56 +0530
Subject: [PATCH 211/211] Channel-Privilege-Support-VLAN

---
 user_mgr.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/user_mgr.cpp b/user_mgr.cpp
index 41b6518..b3074d6 100644
--- a/user_mgr.cpp
+++ b/user_mgr.cpp
@@ -2061,12 +2061,19 @@ uint8_t UserMgr::getChannelFromIP(const std::string& targetIp)
             continue;
 
         std::string ifaceName(ifa->ifa_name);
+        /* Extract base interface name (strip VLAN suffix) e.g., eth1.1 -> eth1 */
+        std::string baseIface = ifaceName;
+        size_t dotPos = baseIface.find('.');
+        if (dotPos != std::string::npos)
+        {
+            baseIface = baseIface.substr(0, dotPos);
+        }
 
         bool found = false;
         std::optional<uint8_t> channel;
         for (const auto& [ch, name] : channelMap)
         {
-            if (name == ifaceName)
+            if (name == baseIface)
             {
                 channel = ch;
                 found = true;
