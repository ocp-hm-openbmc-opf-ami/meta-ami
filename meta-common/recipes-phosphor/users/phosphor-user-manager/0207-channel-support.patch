+void UserMgr::throwForInvalidUserChannelAccess(
+    const std::vector<uint8_t>& channelAccess, std::string userName)
+{
+    std::vector<uint8_t> availableChannels = getAvailableChannelIds();
+    if (channelAccess.size() != availableChannels.size())
+    {
+        lg2::error(
+            "Channel count mismatch: expected '{EXPECTED}', got '{ACTUAL}'",
+            "EXPECTED", availableChannels.size(), "ACTUAL",
+            channelAccess.size());
+
+        elog<InvalidArgument>(
+            Argument::ARGUMENT_NAME("ChannelCountMismatch"),
+            Argument::ARGUMENT_VALUE(
+                std::to_string(channelAccess.size()).c_str()));
+    }
+    for (auto access : channelAccess)
+    {
+        if (access != 0 && access != 1)
+        {
+            lg2::error("Invalid channel access bit '{ACCESS}'", "ACCESS",
+                       access);
+
+            elog<InvalidArgument>(
+                Argument::ARGUMENT_NAME("ChannelAccess"),
+                Argument::ARGUMENT_VALUE(std::to_string(access).c_str()));
+        }
+    }
+
+    if (isDefaultUser(userName))
+    {
+        lg2::error("Access denied to modify user '{USER_NAME}'", "USER_NAME",
+                   userName);
+        elog<NotAllowed>(
+            Reason("Property update is not allowed for default user"));
     }
 }
 
