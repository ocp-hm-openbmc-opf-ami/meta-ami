+uint8_t UserMgr::getChannelFromIP(const std::string& targetIp)
+{
+    std::map<uint8_t, std::string> channelMap = getChannelInterfaceMap();
+    std::map<std::string, InterfaceInfo> interfaceMap;
+
+    struct ifaddrs* ifaddr;
+    if (getifaddrs(&ifaddr) == -1)
+    {
+        lg2::error(
+            "Failed to retrieve interface list using getifaddrs: {ERROR}",
+            "ERROR", strerror(errno));
+        return std::numeric_limits<uint8_t>::max();
+    }
+
+    for (struct ifaddrs* ifa = ifaddr; ifa != nullptr; ifa = ifa->ifa_next)
+    {
+        if (!ifa->ifa_addr)
+            continue;
+
+        std::string ifaceName(ifa->ifa_name);
+
+        bool found = false;
+        std::optional<uint8_t> channel;
+        for (const auto& [ch, name] : channelMap)
+        {
+            if (name == ifaceName)
+            {
+                channel = ch;
+                found = true;
+                break;
+            }
+        }
+
+        if (!found)
+            continue;
+
+        char ipStr[INET6_ADDRSTRLEN] = {};
+        void* addr = nullptr;
+
+        if (ifa->ifa_addr->sa_family == AF_INET)
+        {
+            addr = &((struct sockaddr_in*)ifa->ifa_addr)->sin_addr;
+            inet_ntop(AF_INET, addr, ipStr, sizeof(ipStr));
+            if (targetIp == ipStr)
+            {
+                freeifaddrs(ifaddr);
+                return static_cast<int>(channel.value());
+            }
+        }
+        else if (ifa->ifa_addr->sa_family == AF_INET6)
+        {
+            addr = &((struct sockaddr_in6*)ifa->ifa_addr)->sin6_addr;
+            inet_ntop(AF_INET6, addr, ipStr, sizeof(ipStr));
+            if (targetIp == ipStr)
+            {
+                freeifaddrs(ifaddr);
+                return static_cast<int>(channel.value());
+            }
+        }
+    }
+
+    freeifaddrs(ifaddr);
+    return std::numeric_limits<uint8_t>::max();
+}
