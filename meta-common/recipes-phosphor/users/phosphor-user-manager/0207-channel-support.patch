+std::map<uint8_t, std::string> UserMgr::getChannelInterfaceMap()
+{
+    constexpr auto ChannelConfigPath =
+        "/usr/share/ipmi-providers/channel_config.json";
+    std::map<uint8_t, std::string> availableChannelsMap;
+    auto dataOpt = readJsonFile(ChannelConfigPath);
+
+    if (!dataOpt)
+    {
+        return availableChannelsMap;
+    }
+
+    const auto& data = *dataOpt;
+    if (data.empty())
+    {
+        lg2::error("Channel config is empty");
+        return availableChannelsMap;
+    }
+
+    for (const auto& [key, value] : data.items())
+    {
+        if (!value.contains("channel_info"))
+        {
+            continue;
+        }
+
+        const auto& chInfo = value["channel_info"];
+        if (chInfo.contains("medium_type") &&
+            chInfo["medium_type"] == "lan-802.3")
+        {
+            try
+            {
+                availableChannelsMap[static_cast<uint8_t>(std::stoi(key))] =
+                    value.value("name", "Unknown");
+            }
+            catch (const std::exception& e)
+            {
+                lg2::error("Invalid channel key: {KEY} - {ERROR}", "KEY", key,
+                           "ERROR", e.what());
+            }
+        }
+    }
+    return availableChannelsMap;
+}
