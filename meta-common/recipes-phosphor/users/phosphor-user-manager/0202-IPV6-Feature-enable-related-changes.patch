+++ b/phosphor-ldap-config/ldap_config.cpp
@@ -512,6 +512,12 @@ std::string Config::ldapServerURI(std::string value)
     std::string val;
     try
     {
+        std::string ipAddress = getIPAddressFromURI(value);
+        if((ipAddress.length() >= MIN_IPV6_LEN) && (isIPv6(ipAddress)))
+        {
+            std::string scheme = getSchemeFromURI(value);
+            value = constructLDAPURL(scheme,ipAddress);
