diff --git a/phosphor-ldap-config/utils.cpp b/phosphor-ldap-config/utils.cpp
index f6efdd9..370e2e1 100644
--- a/phosphor-ldap-config/utils.cpp
+++ b/phosphor-ldap-config/utils.cpp
@@ -3,7 +3,6 @@
 #include <arpa/inet.h>
 #include <ldap.h>
 #include <netdb.h>
-
 #include <boost/algorithm/string.hpp>
 
 #include <cstring>
@@ -14,6 +13,54 @@ namespace phosphor
 namespace ldap
 {
 
+
+bool isIPv6(const std::string& ip) {
+    struct addrinfo hints, *res = nullptr;
+    bool is_ipv6 = false;
+    std::memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+
+    int result = getaddrinfo(ip.c_str(), nullptr, &hints, &res);
+    if (result != 0) {
+        return is_ipv6;
+    }
+
+    is_ipv6 = (res->ai_family == AF_INET6);
+    freeaddrinfo(res);
+    return is_ipv6;
+}
+
+
+std::string getIPAddressFromURI(const std::string& url) {
+    constexpr std::string_view ipv4Ipv6Delimiter = "://";
+    size_t pos = url.find(ipv4Ipv6Delimiter);
+    if (pos != std::string::npos) {
+        return url.substr(pos + ipv4Ipv6Delimiter.length());
+    }
+    return "";
+}
+
+std::string constructLDAPURL(const std::string& scheme, const std::string& ip) {
+    constexpr std::string_view ipv6StartPoint = "[";
+    constexpr std::string_view ipv6EndPoint = "]";
+    if (isIPv6(ip)) {
+        return scheme + ipv6StartPoint.data() + ip + ipv6EndPoint.data();
+    } else {
+        return scheme + ip;
+    }
+}
+
+std::string getSchemeFromURI(const std::string& url) {
+    constexpr std::string_view ipv4Ipv6Delimiter = "://";
+    constexpr uint16_t schemeStartPosition = 0;
+    constexpr uint16_t schemeDelimiterLength = 3;
+    size_t pos = url.find(ipv4Ipv6Delimiter);
+    if (pos != std::string::npos) {
+        return url.substr(schemeStartPosition, pos + schemeDelimiterLength);
+    }
+    return "";
+}
+
 bool isValidLDAPURI(const std::string& uri, const char* scheme)
 {
     // Return false if the user tries to configure port 0
@@ -26,7 +73,7 @@ bool isValidLDAPURI(const std::string& uri, const char* scheme)
     {
         return false;
     }
-
+    
     LDAPURLDesc* ludpp = nullptr;
     int res = LDAP_URL_ERR_BADURL;
     res = ldap_url_parse(uri.c_str(), &ludpp);
@@ -36,9 +83,9 @@ bool isValidLDAPURI(const std::string& uri, const char* scheme)
     };
     std::unique_ptr<LDAPURLDesc, decltype(ludppCleanupFunc)> ludppPtr(
         ludpp, ludppCleanupFunc);
-
     if (res != LDAP_URL_SUCCESS)
     {
+
         return false;
     }
     if (std::strcmp(scheme, ludppPtr->lud_scheme) != 0)
