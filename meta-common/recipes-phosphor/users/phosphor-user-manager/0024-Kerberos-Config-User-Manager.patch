+++ b/phosphor-kerberos-config/kerberos_config.cpp
@@ -0,0 +1,90 @@
+
+/* ****************************************************************
+ *
+ * Filename : kerberos_config.cpp
+ *
+ * @brief Implementation of Kerberos Config Manager
+ *
+ * Author: Krishna Raj krishnar@ami.com
+ *
+ *****************************************************************/
+
+#include <boost/asio/io_context.hpp>
+#include <kerberos_config.hpp>
+#include <sdbusplus/asio/connection.hpp>
+
+#include <fstream>
+#include <iostream>
+
+/** @brief Implementation to append ip and hostname of Kerberos
+ *  server to /etc/hosts.
+ *
+ *  @param[in] ip - ip of kerberos server
+ *  @param[in] hostname - Hostname of kerberos server
+ *
+ *  @return rsp[bool] - success or failure
+ */
+
+bool updateHostsFile(const std::string& ip, const std::string& hostname)
+{
+    const std::string hostsFilePath = "/etc/hosts";
+    std::ifstream hostsFile(hostsFilePath);
+    std::string line;
+
+    // Check if the IP already exists
+    bool ipExists = false;
+    while (std::getline(hostsFile, line))
+    {
+        if (line.find(ip) == 0)
+        { // Check if line starts with the IP
+            std::cout << "IP address already exists: " << ip << std::endl;
+            ipExists = true;
+            break; // Exit the loop if found
+        }
+    }
+    hostsFile.close(); // Close the input file
+
+    // If the IP does not exist, append the new entry
+    if (!ipExists)
+    {
+        std::ofstream appendFile(hostsFilePath, std::ios_base::app);
+        if (appendFile.is_open())
+        {
+            appendFile << ip << " " << hostname << std::endl;
+            std::cout << "Entry appended: " << ip << " " << hostname
+                      << std::endl;
+        }
+        else
+        {
+            std::cerr << "Failed to open file: " << hostsFilePath << std::endl;
+            return false;
+        }
+        appendFile.close(); // Close the output file
+    }
+    return true;
+}
+
+int main()
+{
+    // setup connection to dbus
+    boost::asio::io_context io;
+    auto conn = std::make_shared<sdbusplus::asio::connection>(io);
+
+    // object server
+    conn->request_name("xyz.openbmc_project.Kerberos.Config");
+    auto server = sdbusplus::asio::object_server(conn);
+
+    std::shared_ptr<sdbusplus::asio::dbus_interface> iface =
+        server.add_interface(kerberosMgrObj, kerberosDbusNmae);
+
+    iface->register_method("UpdateHosts",
+                           [](std::string ip, std::string hostName) {
+                               bool response = updateHostsFile(ip, hostName);
+                               return response;
+                           });
+
+    iface->initialize();
+    io.run();
+
+    return 0;
+}
diff --git a/phosphor-kerberos-config/kerberos_config.hpp b/phosphor-kerberos-config/kerberos_config.hpp
