+#include <map>
+
+static constexpr const char* kerberosMgrObj =
+    "/xyz/openbmc_project/kerberos/config";
+static constexpr const char* kerberosDbusNmae =
+    "xyz.openbmc_project.Kerberos.Config";
+static constexpr const char* interface = "xyz.openbmc_project.Kerberos.Config";
diff --git a/phosphor-kerberos-config/meson.build b/phosphor-kerberos-config/meson.build
