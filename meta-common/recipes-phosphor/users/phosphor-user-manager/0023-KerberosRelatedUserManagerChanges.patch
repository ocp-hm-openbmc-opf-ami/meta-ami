+
+bool Config::enableKerberos(bool value)
+{
+	ConfigIface::enableKerberos(value);
+	if (enabled())
+        {
+            //writeConfig();
+            parent.startOrStopService(nslcdService, enabled());
+        }
+        // save the object.
+        serialize();
+    return value;
+}
+
+std::string Config::saslMech(std::string value)
+{
+    std::string val;
+    try
+    {
+        if (value == saslMech())
+        {
+            return value;
+        }
+
+        if (value.empty())
+        {
+            lg2::error("'{SASLMECH}' is not a valid saslMech", "SASLMECH",
+                       value);
+            elog<InvalidArgument>(Argument::ARGUMENT_NAME("saslMech"),
+                                  Argument::ARGUMENT_VALUE(value.c_str()));
+        }
+
+        val = ConfigIface::saslMech(value);
+        if (enabled())
+        {
+            writeConfig();
+            parent.startOrStopService(nslcdService, enabled());
+        }
+        // save the object.
+        serialize();
+    }
+    catch (const InternalFailure& e)
+    {
+        throw;
+    }
+    catch (const InvalidArgument& e)
+    {
+        throw;
+    }
+    catch (const std::exception& e)
+    {
+        lg2::error("Exception: {ERR}", "ERR", e);
+        elog<InternalFailure>();
+    }
+    return val;
+}
+
