+void setupTimer(boost::asio::io_context& io)
+{
+    int tfd = timerfd_create(CLOCK_MONOTONIC, 0);
+    if (tfd == -1)
+    {
+        std::cerr << "Failed to create timerfd: " << strerror(errno)
+                  << std::endl;
+        return;
+    }
+
+    itimerspec timerSpec{};
+    timerSpec.it_value.tv_sec = 1;
+    timerSpec.it_interval.tv_sec = 1;
+
+    if (timerfd_settime(tfd, 0, &timerSpec, nullptr) == -1)
+    {
+        std::cerr << "Failed to set timer: " << strerror(errno) << std::endl;
+        close(tfd);
+        return;
+    }
+
+    auto timerStream =
+        std::make_shared<boost::asio::posix::stream_descriptor>(io, tfd);
+    auto buffer = std::make_shared<uint64_t>(0);
+
+    // Create a shared_ptr to the handler function to avoid circular reference
+    // issues
+    auto handler = std::make_shared<std::function<void()>>();
+
+    *handler = [timerStream, buffer, handler]() {
+        timerStream->async_read_some(
+            boost::asio::buffer(buffer.get(), sizeof(uint64_t)),
+            [timerStream, buffer, handler](const boost::system::error_code& ec,
+                                           std::size_t /*bytes_transferred*/) {
+                if (!ec)
+                {
+                    onTimerTick(*buffer);
+                    (*handler)(); // Re-arm the handler
+                }
+                else
+                {
+                    std::cerr
+                        << "Timer read error: " << ec.message() << std::endl;
+                }
+            });
+    };
+
+    (*handler)(); // Start the first async read
+}
+
+bool compareStringWithBytes(const std::string& str,
+                            const unsigned char val[otpFixedLen])
+{
+    // Ensure the string has at least 8 characters
+    if (str.size() < otpFixedLen)
+    {
+        return false;
+    }
+
+    for (size_t i = 0; i < otpFixedLen; ++i)
+    {
+        if (static_cast<unsigned char>(str[i]) != val[i])
+        {
+            return false;
+        }
+    }
+
+    return true;
+}
