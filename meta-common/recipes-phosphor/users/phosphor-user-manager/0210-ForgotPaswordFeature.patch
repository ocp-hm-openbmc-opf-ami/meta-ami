+void generateRandomNumber(unsigned char* randomNumber, int len)
+{
+    const size_t BUF_SIZE = 10240;
+    unsigned char buf[BUF_SIZE] = {0};
+    std::ifstream rand_file("/dev/random", std::ios::in | std::ios::binary);
+    if (!rand_file)
+    {
+        log<level::ERR>("Failed to open /dev/random");
+        return;
+    }
+
+    // Read BUF_SIZE bytes from /dev/random
+    rand_file.read(reinterpret_cast<char*>(buf), BUF_SIZE);
+    if (!rand_file)
+    {
+        log<level::ERR>("Failed to read enough bytes from /dev/random");
+        return;
+    }
+
+    rand_file.close();
+    RAND_seed(buf, BUF_SIZE);
+    if (RAND_bytes(randomNumber, len) < 1)
+    {
+        return;
+    }
+    return;
+}
