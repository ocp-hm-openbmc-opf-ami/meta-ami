+void onTimerTick([[maybe_unused]] uint64_t expirations)
+{
+    for (auto& [username, otpEntry] : userOTPs)
+    {
+        if (otpEntry.timervalue > 0)
+        {
+            otpEntry.timervalue--;
+            if (otpEntry.timervalue == 0)
+                memset(otpEntry.OTP, 0, sizeof(otpEntry.OTP));
+        }
+    }
+}
