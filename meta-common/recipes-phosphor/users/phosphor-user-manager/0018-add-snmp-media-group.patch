From b6a74b5eda3a7aca529d9b14ed5e0e39cfb2951f Mon Sep 17 00:00:00 2001
From: ramsankarr <ramsankarr@ami.com>
Date: Tue, 10 Sep 2024 10:46:11 +0530
Subject: [PATCH 198/198] add snmp media group

---
 meson.build   |  5 +++++
 meson.options |  2 ++
 user_mgr.cpp  | 19 +++++++++++++++++--
 3 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 8ef85e0..a0415b5 100644
--- a/meson.build
+++ b/meson.build
@@ -13,6 +13,11 @@ if get_option('root_user_mgmt').allowed()
     add_project_arguments('-DENABLE_ROOT_USER_MGMT', language:'cpp')
 endif
 
+if get_option('oem-privilege').enabled()
+    add_project_arguments('-DFEATURE_OEM_PRIV', language:'cpp')
+endif
+add_project_arguments('-DFEATURE_SNMP_TRAPV3', language:'cpp')
+
 conf_data = configuration_data()
 
 conf_data.set_quoted('USER_MANAGER_BUSNAME', 'xyz.openbmc_project.User.Manager',
diff --git a/meson.options b/meson.options
index b68ef14..d369def 100644
--- a/meson.options
+++ b/meson.options
@@ -1,2 +1,4 @@
 option('tests', type: 'feature', description: 'Build tests', value: 'enabled')
 option('root_user_mgmt', type: 'feature', description: 'Enable management of the root user', value: 'enabled')
+# OEM Privilege support
+option('oem-privilege', type: 'feature', value: 'disabled', description: 'oem-privilege is disabled by default; offer a way to enable it')
diff --git a/user_mgr.cpp b/user_mgr.cpp
index 932c64a..9f47b96 100644
--- a/user_mgr.cpp
+++ b/user_mgr.cpp
@@ -137,8 +137,23 @@ namespace
 {
 
 // The hardcoded groups in OpenBMC projects
-constexpr std::array<const char*, 4> predefinedGroups = {
-    "redfish", "ipmi", "ssh", "hostconsole"};
+#if defined FEATURE_OEM_PRIV && defined FEATURE_SNMP_TRAPV3
+constexpr std::array<const char*, 8> predefinedGroups = {
+    "web",         "redfish",           "ipmi",  "ssh",
+    "hostconsole", "redfish-hostiface", "media", "snmp"};
+#elif defined FEATURE_OEM_PRIV
+constexpr std::array<const char*, 7> predefinedGroups = {
+    "web",         "redfish",           "ipmi", "ssh",
+    "hostconsole", "redfish-hostiface", "media"};
+#elif defined FEATURE_SNMP_TRAPV3
+constexpr std::array<const char*, 7> predefinedGroups = {
+    "web",         "redfish",           "ipmi", "ssh",
+    "hostconsole", "redfish-hostiface", "snmp"};
+
+#else
+constexpr std::array<const char*, 6> predefinedGroups = {
+    "web", "redfish", "ipmi", "ssh", "hostconsole", "redfish-hostiface"};
+#endif
 
 // These prefixes are for Dynamic Redfish authorization. See
 // https://github.com/openbmc/docs/blob/master/designs/redfish-authorization.md
-- 
2.25.1

