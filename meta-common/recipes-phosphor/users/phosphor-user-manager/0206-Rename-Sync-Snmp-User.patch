+bool objectExists(sdbusplus::bus::bus& bus, const std::string& service,
+                  const std::string& objectPath)
+{
+    try
+    {
+        auto method = bus.new_method_call(service.c_str(), objectPath.c_str(),
+                                          "org.freedesktop.DBus.Introspectable",
+                                          "Introspect");
+
+        auto reply = bus.call(method);
+        std::string xml;
+        reply.read(xml);
+
+        return !xml.empty(); /* Object exists if introspection data is returned
+                              */
+    }
+    catch (const sdbusplus::exception::SdBusError& e)
+    {
+        lg2::debug("objectExists failed for path {PATH}: {ERROR}", "PATH",
+                   objectPath, "ERROR", e.what());
+        return false;
+    }
+}
+
+void UserMgr::renameSnmpUser(const std::string& userName,
+                             const std::string& newUserName)
+{
+    constexpr const char* snmpBasePath =
+        "/xyz/openbmc_project/snmp/UserManager/";
+    std::string objPathOld = std::string(snmpBasePath) + userName;
+    constexpr const char* service = "xyz.openbmc_project.Snmp.Conf";
+    constexpr const char* propertyInterface =
+        "xyz.openbmc_project.Snmp.UserManager";
+    constexpr const char* createInterface =
+        "xyz.openbmc_project.Snmp.UserManager.Create";
+    constexpr const char* managerObjPath =
+        "/xyz/openbmc_project/snmp/UserManager";
+    constexpr const char* userServiceName = "xyz.openbmc_project.User.Manager";
+    constexpr const char* userInterface = "xyz.openbmc_project.User.Attributes";
+    constexpr const char* SnmpPropertyName = "SNMPAccessEnableStatus";
+    constexpr const char* userObjPath = "/xyz/openbmc_project/user/";
+    std::string newuserObjPath = std::string(userObjPath) + newUserName;
+
+    if (!objectExists(bus, service, objPathOld))
+    {
+        lg2::info("SNMP user '{USER}' does not exist, skipping rename.", "USER",
+                  userName);
+        return;
+    }
+
+    std::map<std::string, std::variant<std::string>> propertyMap;
+
+    try
+    {
+        const std::vector<std::string> propertyNames = {
+            "Algorithm", "Encryption", "Password", "ReadWritePermission",
+            "UserName"};
+
+        for (const auto& property : propertyNames)
+        {
+            auto method =
+                bus.new_method_call(service, objPathOld.c_str(),
+                                    "org.freedesktop.DBus.Properties", "Get");
+            method.append(propertyInterface, property);
+            auto reply = bus.call(method);
+            std::variant<std::string> value;
+            reply.read(value);
+            propertyMap[property] = value;
+        }
+
+        /* Delete old SNMP user object */
+        auto deleteCall =
+            bus.new_method_call(service, objPathOld.c_str(),
+                                "xyz.openbmc_project.Object.Delete", "Delete");
+        auto reply = bus.call(deleteCall);
+        if (reply.is_method_error())
+        {
+            lg2::error("Failed to delete SNMP user object at {OBJPATH}: {ERR}",
+                       "OBJPATH", objPathOld, "ERR",
+                       reply.get_error()->message);
+            return;
+        }
+
+        /*Set SNMPAccessEnableStatus to true before creating a snmp user*/
+        systemBus->async_method_call(
+            [newUserName](const boost::system::error_code& ec) {
+                if (ec)
+                {
+                    lg2::error(
+                        "Failed to set SNMPAccessEnableStatus for '{USER}': {ERROR}",
+                        "USER", newUserName, "ERROR", ec.message());
+                    elog<InternalFailure>();
+                    return;
+                }
+
+                lg2::info("SNMPAccessEnableStatus set for user '{USER}'",
+                          "USER", newUserName);
+            },
+            userServiceName, newuserObjPath, "org.freedesktop.DBus.Properties",
+            "Set", userInterface, SnmpPropertyName, std::variant<bool>{true});
+
+        /* Create new SNMP user object */
+        std::string password = std::get<std::string>(propertyMap["Password"]);
+        std::string encryption =
+            std::get<std::string>(propertyMap["Encryption"]);
+        std::string algorithm = std::get<std::string>(propertyMap["Algorithm"]);
+        std::string rwPermission =
+            std::get<std::string>(propertyMap["ReadWritePermission"]);
+
+        systemBus->async_method_call(
+            [newUserName](const boost::system::error_code& ec) {
+                if (ec)
+                {
+                    lg2::error("SNMP user creation failed: {ERROR}", "ERROR",
+                               ec.message());
+                    elog<InternalFailure>();
+                    return;
+                }
+                lg2::info("SNMP user '{USER}' successfully created.", "USER",
+                          newUserName);
+            },
+            service, managerObjPath, createInterface, "Client", newUserName,
+            password, encryption, algorithm, rwPermission);
+    }
+    catch (const InternalFailure& e)
+    {
+        lg2::error("Rename '{USERNAME}' to '{NEWUSERNAME}' failed", "USERNAME",
+                   userName, "NEWUSERNAME", newUserName);
+        elog<InternalFailure>();
+    }
+    catch (const std::exception& e)
+    {
+        lg2::error("SNMP user rename failed with exception: '{EXCEPTION}'",
+                   "EXCEPTION", e.what());
+        elog<InternalFailure>();
+    }
+}
