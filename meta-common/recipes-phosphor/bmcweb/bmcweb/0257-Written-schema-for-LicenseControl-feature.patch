+{
+    "$id": "http://redfish.dmtf.org/schemas/v1/AmiLicenseControl.json",
+    "$ref": "#/definitions/AmiLicenseControl",
+    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema-v1.json",
+    "copyright": "Copyright American Megatrends, Inc. (AMI).",
+    "definitions": {
+        "AmiLicenseControl": {
+            "additionalProperties": false,
+            "description": "This is the schema definition for the License Control in License.",
+            "longDescription": "This resource shall be used to represent License Control in License.",
+            "patternProperties": {
+                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
+                    "description": "This property shall specify a valid odata or Redfish property.",
+                    "type": [
+                        "array",
+                        "boolean",
+                        "integer",
+                        "number",
+                        "null",
+                        "object",
+                        "string"
+                    ]
+                }
+            },
+            "properties": {
+                "@odata.id": {
+                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/id"
+                },
+                "@odata.type": {
+                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/type"
+                },
+                "Id": {
+                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
+                    "readonly": true
+                },
+                "Name": {
+                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
+                    "readonly": true
+                },
+                "Oem": {
+                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Oem",
+                    "description": "The OEM extension property.",
+                    "longDescription": "This property shall contain the OEM extensions.  All values for properties that this object contains shall conform to the Redfish Specification-described requirements."
+                }
+            },
+            "required": [
+                "@odata.id",
+                "@odata.type",
+                "Id",
+                "Name"
+            ],
+            "type": "object"
+        },
+        "Oem": {
+            "additionalProperties": false,
+            "patternProperties": {
+                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
+                    "description": "This property shall specify a valid odata or Redfish property.",
+                    "type": [
+                        "array",
+                        "boolean",
+                        "integer",
+                        "number",
+                        "null",
+                        "object",
+                        "string"
+                    ]
+                }
+            },
+            "properties": {
+                "AlertMessage": {
+                    "description": "The property indicates the Alert Message.",
+                    "longDescription": "The property containing information about the remaining days until the license expires. Triggered once the current validity days is less than or equal to UserAlertCount days.",
+                    "readonly": true,
+                    "type": "string"
+                },
+                "GlobalLicenseValidity": {
+                    "description": "The property indicates the Global License Validity.",
+                    "longDescription": "The property indicates the overall validity period of the system's license.",
+                    "readonly": true,
+                    "type": "integer"
+                },
+                "LicenseKey": {
+                    "description": "The property indicates the License Key.",
+                    "longDescription": "The property indicates the current license validity date for each service.",
+                    "readonly": true,
+                    "type": "string"
+                },
+                "ServicesUpCountDays": {
+                    "description": "The property indicates the count of services up days.",
+                    "longDescription": "The property indicates the cumulative uptime of licensable services since the last license key update.",
+                    "readonly": true,
+                    "type": "integer"
+                },
+                "UserAlertCount": {
+                    "description": "The property indicates the Alert day count.",
+                    "longDescription": "The property indicates the number of days to activate an alert message indicating the remaining days of service validity.",
+                    "readonly": false,
+                    "type": "integer"
+                }
+            },
+            "type": "object"
+        }
+    },
+    "owningEntity": "Ami",
+    "title": "#AmiLicenseControl.v1_0_0.AmiLicenseControl"
+}
