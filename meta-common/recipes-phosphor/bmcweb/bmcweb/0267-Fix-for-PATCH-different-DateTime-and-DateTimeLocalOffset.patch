From ab079215fe5ebf98b52287f8dd16ef507596015d Mon Sep 17 00:00:00 2001
From: AishwaryaM <aishwaryam@ami.com>
Date: Tue, 7 May 2024 08:05:15 -0400
Subject: [PATCH 267/267] Fix for  PATCH different DateTime and
 DateTimeLocalOffset should not return 204

Signed-off-by: AishwaryaM <aishwaryam@ami.com>
---
 redfish-core/lib/managers.hpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/redfish-core/lib/managers.hpp b/redfish-core/lib/managers.hpp
index eae57cef..78e61bc1 100644
--- a/redfish-core/lib/managers.hpp
+++ b/redfish-core/lib/managers.hpp
@@ -2607,6 +2607,25 @@ inline void requestRoutesManager(App& app)
                                                    "DateTime");
                 return;
             }
+            if(datetime && timeZone)
+	        {
+		        std::regex offset_regex(R"((\+)(\d{2}:\d{2}))");
+		        std::smatch match;
+		        std::string offset_value;
+
+		        if(std::regex_search(*datetime,match,offset_regex))
+		        {
+			        offset_value = match[2];
+		        }
+		        std::string timeZone_offset = *timeZone;
+		        timeZone_offset.erase(0,1);
+		       if(offset_value != timeZone_offset)
+		       {
+			
+                    messages::propertyValueConflict(asyncResp->res, "datetime","timeZone");
+                    return;
+		        }
+            }
             setDateTime(asyncResp, std::move(*datetime));
         }
         if (locationIndicatorActive)
-- 
