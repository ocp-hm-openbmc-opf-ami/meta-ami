From f3798503d235ecf89b2144321c5b2e29f0d89e7b Mon Sep 17 00:00:00 2001
From: bharathbharathia <bharathbharathia@ami.com>
Date: Thu, 14 Nov 2024 18:42:16 +0530
Subject: [PATCH 270/270] UpdateService should block HttpPushUriTargets When remove anyone of the SPI

Signed-off-by: bharathbharathia <bharathbharathia@ami.com>
---
 redfish-core/lib/update_service.hpp | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/redfish-core/lib/update_service.hpp b/redfish-core/lib/update_service.hpp
index 68ccc788..b4d27fe7 100644
--- a/redfish-core/lib/update_service.hpp
+++ b/redfish-core/lib/update_service.hpp
@@ -1685,7 +1685,8 @@ inline void handleUpdateServicePatch(
                         }
 
                         bool swInvObjFound = false;
-                        for (const std::string& path : swInvPaths)
+			 size_t uriCount  = 0;
+			 for (const std::string& path : swInvPaths)
                         {
                             std::size_t idPos = path.rfind("/");
                             if ((idPos == std::string::npos) ||
@@ -1697,11 +1698,19 @@ inline void handleUpdateServicePatch(
                             }
                             std::string swId = path.substr(idPos + 1);
 
-                            if (swId == uriTargets[0])
-                            {
-                                swInvObjFound = true;
-                                break;
-                            }
+			    for (const std::string& target : uriTargets)
+		            {
+			       if (swId == target)
+			       {
+		                  uriCount++;
+				  if(uriCount == uriTargets.size())
+				  {
+				     swInvObjFound = true;
+                                     break;
+				  }
+                               }
+			    }
+
                         }
                         if (!swInvObjFound)
                         {
