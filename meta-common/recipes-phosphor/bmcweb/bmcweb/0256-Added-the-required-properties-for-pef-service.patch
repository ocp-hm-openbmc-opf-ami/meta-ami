Subject: [PATCH 256/256] Added the required properties of pef service
 instances along with schema

Signed-off-by: AishwaryaM <aishwaryam@ami.com>
---
 redfish-core/lib/pef_service.hpp              |  5 ++
 static/redfish/v1/$metadata/index.xml         |  6 +-
 .../v1/JsonSchemas/PefEntry/PefEntry.json     | 83 +++++++++++++++++++
 static/redfish/v1/schema/PefEntry_v1.xml      | 79 ++++++++++++++++++
 static/redfish/v1/schema/PefService_v1.xml    |  7 ++
 5 files changed, 179 insertions(+), 1 deletion(-)
 create mode 100644 static/redfish/v1/JsonSchemas/PefEntry/PefEntry.json
 create mode 100644 static/redfish/v1/schema/PefEntry_v1.xml

diff --git a/redfish-core/lib/pef_service.hpp b/redfish-core/lib/pef_service.hpp
index 98a84de2..f9bbfb64 100644
--- a/redfish-core/lib/pef_service.hpp
+++ b/redfish-core/lib/pef_service.hpp
@@ -377,6 +377,11 @@ inline void requestRoutesPefService(App& app)
         {
             return;
         }
+	asyncResp->res.jsonValue = {
+            {"@odata.type", "#PefEntry.v1_0_0.PefEntry"},
+            {"@odata.id", "/redfish/v1/PefService/"+entryId},
+            {"Id", entryId},
+            {"Name", "Pef Service Entry"}};
         getEventSeverity(asyncResp, entryId);
     });
 
