From 50e13bfbbca19e5c3a32ec35bf883535539e550c Mon Sep 17 00:00:00 2001
From: AishwaryaM <aishwaryam@ami.com>
Date: Mon, 16 Dec 2024 02:06:20 -0500
Subject: [PATCH 260/260] updating HttpPushUriTarget PFR

Signed-off-by: AishwaryaM <aishwaryam@ami.com>
---
 redfish-core/lib/update_service.hpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/redfish-core/lib/update_service.hpp b/redfish-core/lib/update_service.hpp
index 91e4fa51..6f7b8761 100644
--- a/redfish-core/lib/update_service.hpp
+++ b/redfish-core/lib/update_service.hpp
@@ -182,7 +182,7 @@ inline void activateImage(const std::string& objPath,
                         BMCWEB_LOG_DEBUG("Image target matched with object {}",
                                          invObjPath);
                         crow::connections::systemBus->async_method_call(
-                            [invObjPath,
+                            [invObjPath,objPath,
                              service](const boost::system::error_code ec2,
                                       const std::variant<std::string> value) {
                                 if (ec2)
@@ -205,7 +205,7 @@ inline void activateImage(const std::string& objPath,
                                 }
                                 BMCWEB_LOG_DEBUG(
                                     "Setting RequestedActivation value as {} for {} {}",
-                                    reqActivation, service, invObjPath);
+                                    reqActivation, service, objPath);
                                 crow::connections::systemBus->async_method_call(
                                     [](const boost::system::error_code ec3) {
                                         if (ec3)
@@ -216,7 +216,7 @@ inline void activateImage(const std::string& objPath,
                                         }
                                         return;
                                     },
-                                    service, invObjPath,
+                                    service, objPath,
                                     "org.freedesktop.DBus.Properties", "Set",
                                     activationIntf, reqActivationPropName,
                                     std::variant<std::string>(reqActivation));
