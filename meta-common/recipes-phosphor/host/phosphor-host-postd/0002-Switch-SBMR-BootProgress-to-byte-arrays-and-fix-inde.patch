From f5779ca509c7e09a9974121ef3c7d94579dbab7f Mon Sep 17 00:00:00 2001
From: dineshsv <dineshsv@ami.com>
Date: Fri, 13 Feb 2026 04:36:02 -0500
Subject: [PATCH] Switch SBMR BootProgress to byte arrays and fix index-based
 tuple access.

Signed-off-by: dineshsv <dineshsv@ami.com>
---
 sbmrbootprogress/sbmr_boot_progress.hpp | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/sbmrbootprogress/sbmr_boot_progress.hpp b/sbmrbootprogress/sbmr_boot_progress.hpp
index 3902b80..96e82f5 100644
--- a/sbmrbootprogress/sbmr_boot_progress.hpp
+++ b/sbmrbootprogress/sbmr_boot_progress.hpp
@@ -58,7 +58,7 @@ auto conn = std::make_shared<sdbusplus::asio::connection>(io);
 
 constexpr auto dbusOrgPropertyInterface =
     "org.freedesktop.DBus.Properties";
-using PrimaryCode_t = uint64_t;
+using PrimaryCode_t = std::vector<uint8_t>;
 using SecondaryCode_t = std::vector<uint8_t>;
 using BootProgress_t = std::tuple<PrimaryCode_t, SecondaryCode_t>;
 using Json = nlohmann::json;
@@ -107,9 +107,8 @@ void SbmrBootProgress::updateBootProgressProperties(
 {
 
     auto logEvent = 0;
-    auto bootProgressRecord =
-        std::get<std::vector<uint8_t>>(sbmrBootProgressCode);
 
+    const auto& bootProgressRecord = std::get<0>(sbmrBootProgressCode);
     if (bootProgressRecord.empty() ||
         bootProgressRecord.size() != sbmrBootProgressSize)
     {
-- 
