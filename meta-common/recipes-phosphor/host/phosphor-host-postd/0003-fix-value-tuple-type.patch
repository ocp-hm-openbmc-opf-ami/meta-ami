From b2b622c05b8f012b562a0a101cc8b98db8bd5334 Mon Sep 17 00:00:00 2001
From: Manoj Ashok <amanoj@ami.com>
Date: Fri, 30 Jan 2026 17:05:35 +0530
Subject: [PATCH] Fix tuple type mismatch in value() function calls

After the SBMR patch, the code is uint64_t but the Raw interface expects
a tuple of two std::vector<uint8_t> objects. Convert the code values to
vectors before passing to the value() function.

Upstream-Status: Pending
Signed-off-by: Build System <build@openbmc.org>
Signed-off-by: Manoj Ashok <amanoj@ami.com>
---
 main.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/main.cpp b/main.cpp
index da4d3d5..069bd71 100644
--- a/main.cpp
+++ b/main.cpp
@@ -165,8 +165,13 @@ void PostCodeEventHandler(PostReporter* reporter, sdeventplus::source::IO& s,
         // HACK: Always send property changed signal even for the same code
         // since we are single threaded, external users will never see the
         // first value.
-        reporter->value(std::make_tuple(~code, secondary_code), true);
-        reporter->value(std::make_tuple(code, secondary_code));
+        // Convert code to vector form for the tuple
+        std::vector<uint8_t> code_vec{static_cast<uint8_t>(code & 0xff),
+                                      static_cast<uint8_t>(code >> 8)};
+        std::vector<uint8_t> code_inv_vec{static_cast<uint8_t>((~code) & 0xff),
+                                          static_cast<uint8_t>((~code) >> 8)};
+        reporter->value(std::make_tuple(code_inv_vec, secondary_code), true);
+        reporter->value(std::make_tuple(code_vec, secondary_code));
 	postcode_t post_code{code, secondary_code};
 #ifdef REPORT_SBMR
 	SbmrBootProgress sbmr;
-- 
