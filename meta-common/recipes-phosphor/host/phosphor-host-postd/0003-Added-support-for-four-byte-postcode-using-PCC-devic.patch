+/*
+ * ASPEED PCC (Post Code Capture) handler.
+ *
+ * The PCC device (/dev/aspeed-lpc-pcc0) streams all LPC POST code traffic
+ * as 4-byte records.  Each record encodes one byte of a 32-bit POST code:
+ *
+ *   [0] data byte
+ *   [1] 0x70        (tag)
+ *   [2] 0x80-0x83   (phase: 0x80=LSB, 0x81=byte1, 0x82=byte2, 0x83=MSB)
+ *   [3] 0x00        (end marker)
+ *
+ * Four consecutive valid records with phases 0x80 → 0x81 → 0x82 → 0x83
+ * are assembled into a single 32-bit little-endian POST code.
+ *
+ * Strict sequential phase ordering is enforced: if any phase arrives out
+ * of order the partial postcode is dropped and the state machine resets.
+ * This ensures only correctly framed postcodes are published, matching
+ * the driver output 1:1.
+ */
+
+void AspeedPccHandler(PostReporter* reporter,
+                      sdeventplus::source::IO& eventSource, int postFd,
+                      uint32_t)
+{
+    static uint32_t currentPostcode = 0;
+    static uint8_t phaseMask = 0;
+
+    uint8_t pccBuffer[blockSize];
+    ssize_t bytesRead = 0;
+
+    /*
+     * Read a bounded amount of data per EPOLLIN callback.
+     *
+     * The ASPEED PCC device streams ALL LPC bus traffic continuously
+     * (including idle zero-fill), so read() may never return EAGAIN.
+     * Cap reads at maxRawPccSize bytes per callback to prevent OOM.
+     * If more data remains, EPOLLIN will fire again on the next
+     * event-loop iteration.
+     */
+    size_t totalReadThisCallback = 0;
+
+    while (totalReadThisCallback < maxRawPccSize &&
+           (bytesRead = read(postFd, pccBuffer, sizeof(pccBuffer))) > 0)
+    {
+        if (verbose)
+        {
+            fprintf(stderr, "Read %zd bytes from PCC device\n", bytesRead);
+        }
+
+        rawPccPostcodes.insert(rawPccPostcodes.end(), pccBuffer,
+                               pccBuffer + bytesRead);
+        totalReadThisCallback += bytesRead;
+    }
+
+    if (bytesRead < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+    {
+        eventSource.get_event().exit(1);
+        return;
+    }
+
+    if (rawPccPostcodes.size() > maxRawPccSize)
+    {
+        size_t excess = rawPccPostcodes.size() - maxRawPccSize;
+        excess = (excess + 3) & ~static_cast<size_t>(3);
+        if (excess > rawPccPostcodes.size())
+        {
+            excess = rawPccPostcodes.size();
+        }
+        rawPccPostcodes.erase(rawPccPostcodes.begin(),
+                              rawPccPostcodes.begin() + excess);
+        currentPostcode = 0;
+        phaseMask = 0;
+        if (verbose)
+        {
+            fprintf(stderr,
+                    "PCC buffer overflow: discarded %zu bytes, state reset\n",
+                    excess);
+        }
+    }
+
+    if (rawPccPostcodes.size() < 4)
+    {
+        return;
+    }
+
+    static constexpr size_t maxHexaPostCodes = 2048;
+    static bool sawZeroFillSinceLastPostcode = true;
+
+    size_t offset = 0;
+    const size_t bufferSize = rawPccPostcodes.size();
+
+    while (offset + 3 < bufferSize)
+    {
+        uint8_t dataByte = rawPccPostcodes[offset + 0];
+        uint8_t tagByte = rawPccPostcodes[offset + 1];
+        uint8_t phaseByte = rawPccPostcodes[offset + 2];
+        uint8_t endByte = rawPccPostcodes[offset + 3];
+
+        /* Validate PCC frame; resync on any framing error */
+        if (tagByte != 0x70 || endByte != 0x00 || phaseByte < 0x80 ||
+            phaseByte > 0x83)
+        {
+            /* Skip zero-fill quickly (PCC device sends lots of idle
+             * zero-fill between real POST codes). */
+            if (dataByte == 0x00 && tagByte == 0x00 && phaseByte == 0x00 &&
+                endByte == 0x00)
+            {
+                offset += 4;
+                sawZeroFillSinceLastPostcode = true;
+            }
+            else
+            {
+                offset += 1;
+            }
+            currentPostcode = 0;
+            phaseMask = 0;
+            continue;
+        }
+
+        /*
+         * A new 0x80 while holding partial state means the previous
+         * sequence was lost; drop it and start fresh.
+         */
+        if (phaseByte == 0x80 && phaseMask != 0)
+        {
+            if (verbose)
+            {
+                fprintf(stderr,
+                        "Dropping incomplete postcode (mask=0x%02X, "
+                        "code=0x%08X) on new phase 0x80\n",
+                        phaseMask, currentPostcode);
+            }
+            currentPostcode = 0;
+            phaseMask = 0;
+        }
+
+        switch (phaseByte)
+        {
+            case 0x80:
+                currentPostcode = static_cast<uint32_t>(dataByte);
+                phaseMask = 0x01;
+                break;
+
+            case 0x81:
+                if (phaseMask != 0x01)
+                {
+                    if (verbose)
+                    {
+                        fprintf(stderr,
+                                "Phase 0x81 out of order (mask=0x%02X) "
+                                "- resetting\n",
+                                phaseMask);
+                    }
+                    currentPostcode = 0;
+                    phaseMask = 0;
+                    break;
+                }
+                currentPostcode |= static_cast<uint32_t>(dataByte) << 8;
+                phaseMask = 0x03;
+                break;
+
+            case 0x82:
+                if (phaseMask != 0x03)
+                {
+                    if (verbose)
+                    {
+                        fprintf(stderr,
+                                "Phase 0x82 out of order (mask=0x%02X) "
+                                "- resetting\n",
+                                phaseMask);
+                    }
+                    currentPostcode = 0;
+                    phaseMask = 0;
+                    break;
+                }
+                currentPostcode |= static_cast<uint32_t>(dataByte) << 16;
+                phaseMask = 0x07;
+                break;
+
+            case 0x83:
+                if (phaseMask != 0x07)
+                {
+                    if (verbose)
+                    {
+                        fprintf(stderr,
+                                "Phase 0x83 out of order (mask=0x%02X) "
+                                "- resetting\n",
+                                phaseMask);
+                    }
+                    currentPostcode = 0;
+                    phaseMask = 0;
+                    break;
+                }
+                currentPostcode |= static_cast<uint32_t>(dataByte) << 24;
+                phaseMask = 0x0F;
+                break;
+
+            default:
+                break;
+        }
+
+        /* Emit only when all 4 phases arrived in strict order */
+        if (phaseMask == 0x0F)
+        {
+            if (sawZeroFillSinceLastPostcode)
+            {
+                hexaPostCodes.clear();
+                sawZeroFillSinceLastPostcode = false;
+                if (verbose)
+                {
+                    fprintf(stderr,
+                            "New boot detected - cleared hexaPostCodes\n");
+                }
+            }
+
+            if (hexaPostCodes.size() < maxHexaPostCodes)
+            {
+                char formatted[32];
+                snprintf(formatted, sizeof(formatted), "0x%08X",
+                         currentPostcode);
+                hexaPostCodes.emplace_back(formatted);
+                if (verbose)
+                {
+                    fprintf(stderr, "Complete postcode: %s\n", formatted);
+                }
+            }
+            currentPostcode = 0;
+            phaseMask = 0;
+        }
+
+        offset += 4;
+    }
+
+    if (offset > 0)
+    {
+        rawPccPostcodes.erase(rawPccPostcodes.begin(),
+                              rawPccPostcodes.begin() + offset);
+    }
+
+    if (!hexaPostCodes.empty())
+    {
+        reporter->hexaPostCodes(hexaPostCodes);
+    }
+
+    rateLimit(*reporter, eventSource);
+}
+
