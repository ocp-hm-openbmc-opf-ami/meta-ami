+
+const char* detectPostcodeDevice()
+{
+    static const char* const devices[] = {
+        "/dev/aspeed-lpc-snoop0",
+        "/dev/aspeed-lpc-pcc0",
+    };
+
+    struct stat st;
+
+    for (const auto& dev : devices)
+    {
+        if (stat(dev, &st) == 0)
+        {
+            if (verbose)
+            {
+                fprintf(stderr, "Detected POST code device: %s\n", dev);
+            }
+            return dev;
+        }
+    }
+
+    fprintf(stderr, "Error: No supported POST code device found\n");
+    return nullptr;
+}
