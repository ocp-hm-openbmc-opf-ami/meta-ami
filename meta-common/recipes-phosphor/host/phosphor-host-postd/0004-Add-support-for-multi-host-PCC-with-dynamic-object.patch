 #else
-        "d:r:b:"
+        "d:r:b:i:"
 #endif
         "v";
 
@@ -649,6 +653,18 @@ int main(int argc, char* argv[])
                 }
                 break;
             }
+	    case 'i':
+            {
+                int argVal = std::stoi(optarg);
+                if (argVal < 0)
