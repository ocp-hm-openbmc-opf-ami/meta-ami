From 6f8192951594a04b33c462d928744241ff28d68b Mon Sep 17 00:00:00 2001
From: nirmalkumar <nirmalkumarv@ami.com>
Date: Wed, 16 Jul 2025 16:53:33 +0530
Subject: [PATCH] Coverity-Fix-Medium

---
 callouts/callout_test.cpp | 10 +++++++++-
 log_manager.cpp           | 12 ++++++++----
 log_manager_main.cpp      | 19 +++++++++++++++++--
 logging_test.cpp          | 10 +++++++++-
 4 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/callouts/callout_test.cpp b/callouts/callout_test.cpp
index 9088243..403f84b 100644
--- a/callouts/callout_test.cpp
+++ b/callouts/callout_test.cpp
@@ -25,7 +25,15 @@ int main(int argc, char** argv)
     }
     catch (const TestCallout& e)
     {
-        commit(e.name());
+        try
+        {
+            commit(e.name());
+        }
+        catch (const std::exception& e)
+        {
+            std::cerr << "Standard exception caught: " << e.what() << std::endl;
+            return -1;
+        }
     }
 
     return 0;
diff --git a/log_manager.cpp b/log_manager.cpp
index dcdca02..dce965d 100644
--- a/log_manager.cpp
+++ b/log_manager.cpp
@@ -550,16 +550,20 @@ void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
         // TODO: Currently, `quiesceOnError` and `Pels` are supported for
         // default logging events. Support for different types of logs can be
         // added in the future.
-        if (isQuiesceOnErrorEnabled() && (errLvl < Entry::sevLowerLimit) &&
-            isCalloutPresent(*e))
+        auto it = entries.find(std::make_pair(logType, entryId));
+        if (it != entries.end() && it->second &&
+            isQuiesceOnErrorEnabled() && (errLvl < Entry::sevLowerLimit) &&
+            isCalloutPresent(*(it->second)))
         {
             quiesceOnError(entryId);
         }
 
         // Add entry before calling the extensions so that they have access to
         // it
-        doExtensionLogCreate(
-            *(entries.find(std::make_pair(logType, entryId))->second), ffdc);
+        if (it != entries.end() && it->second)
+        {
+            doExtensionLogCreate(*(it->second), ffdc);
+        }
     }
 
     // Note: No need to close the file descriptors in the FFDC.
diff --git a/log_manager_main.cpp b/log_manager_main.cpp
index 62c03bb..5daa462 100644
--- a/log_manager_main.cpp
+++ b/log_manager_main.cpp
@@ -38,7 +38,14 @@ int main(int /*argc*/, char* /*argv*/[])
     std::filesystem::create_directories(ERRLOG_PERSIST_PATH_RAID);
 
     // Recreate error d-bus objects from persisted errors.
-    iMgr.restore();
+    try
+    {
+        iMgr.restore();
+    }
+    catch (const std::exception& e)
+    {
+        error("Standard exception caught: {ERROR}", "ERROR", e);
+    }
 
     for (auto& startup : phosphor::logging::Extensions::getStartupFunctions())
     {
@@ -53,7 +60,15 @@ int main(int /*argc*/, char* /*argv*/[])
         }
     }
 
-    bus.request_name(BUSNAME_LOGGING);
+    try
+    {
+        bus.request_name(BUSNAME_LOGGING);
+    }
+    catch (const std::exception& e)
+    {
+        error("Standard exception caught: {ERROR}", "ERROR", e);
+        return -1;
+    }
 
     return event.loop();
 }
diff --git a/logging_test.cpp b/logging_test.cpp
index 87d1da9..642b0cd 100644
--- a/logging_test.cpp
+++ b/logging_test.cpp
@@ -249,7 +249,15 @@ int main(int argc, char* argv[])
         switch (arg)
         {
             case 'c':
-                commitError(optarg);
+                try
+                {
+                    commitError(optarg);
+                }
+                catch (const std::exception& e)
+                {
+                    std::cerr << "commitError function threw an exception: " << e.what() << std::endl;
+                    return -1;
+                }
                 return 0;
             case 'h':
             case '?':
-- 
