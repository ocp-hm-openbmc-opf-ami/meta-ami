From 7e32d6d8d76eaa81a5cdacc7c0de8cccb392ff18 Mon Sep 17 00:00:00 2001
From: shamim ali <ashamim@ami.com>
Date: Wed, 23 Jul 2025 08:07:58 -0400
Subject: [PATCH] handle sel full event

Signed-off-by: shamim ali <ashamim@ami.com>
---
 log_manager.cpp | 59 ++++++++++++++++++++++++++++++++++++++++++++++++-
 log_manager.hpp |  5 +++++
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/log_manager.cpp b/log_manager.cpp
index dcdca02..7b100be 100644
--- a/log_manager.cpp
+++ b/log_manager.cpp
@@ -389,6 +389,31 @@ inline void Manager::enforceCappingLimit(LogType logType, Entry::Level errLvl)
     }
 }
 
+inline void Manager::updateEntryCount()
+{
+    auto methodCall = busLog.new_method_call(
+            "xyz.openbmc_project.Settings",
+            "/xyz/openbmc_project/logging/settings",
+            "org.freedesktop.DBus.Properties", "Set");
+
+    LogType logType = LogType::IPMI;
+    uint16_t ipmiEntryCount = realErrorsMap[logType].size() + infoErrorsMap[logType].size();
+
+    std::variant<uint16_t> value = ipmiEntryCount;
+    methodCall.append(
+        "xyz.openbmc_project.Logging.Settings", "ipmiEntryCount",
+           value);
+    try
+    {
+        busLog.call(methodCall);
+    }
+    catch (const sdbusplus::exception_t& e)
+    {
+        lg2::error("Failed to update ipmiEntryCount : {ERROR}", "ERROR", e);
+    }
+}
+
+
 void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
                           std::vector<std::string> additionalData,
                           const FFDCEntries& ffdc)
@@ -436,6 +461,7 @@ void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
             lg2::info("SEL is disabled");
             return;
         }
+
         if (!Extensions::disableDefaultLogCaps())
         {
             std::string currentPolicy = getSelPolicy();
@@ -453,7 +479,24 @@ void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
                 }
                 else
                 {
-                    if (infoErrorsMap[logType].size() >= ERROR_INFO_CAP)
+		    //Adding ipmi full event if info_error filled before max limit (error + info_error).
+		    if((infoErrorsMap[logType].size() == ERROR_INFO_CAP )&&
+				(infoErrorsMap[logType].size() + realErrorsMap[logType].size() == ERROR_CAP + ERROR_INFO_CAP - 1 ))
+		    {
+			std::string fullEvent = "System_Event_Log";
+                        auto it = std::find_if(additionalData.begin(), additionalData.end(), 
+				  [&fullEvent](const std::string& str){
+					return str.find(fullEvent) != std::string::npos;});
+			if (it != additionalData.end())
+			{
+			    errLvl = Entry::Level::Critical;
+			}
+			else
+			{
+			    return;
+			}
+		    }
+		    else if (infoErrorsMap[logType].size() >= ERROR_INFO_CAP)
                     {
                         lg2::info(
                             "Linear SEL: Information Error Capacity limit "
@@ -499,6 +542,7 @@ void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
         objPath = std::string(OBJ_ENTRY_SEL) + "/" + std::to_string(entryId);
         entryPath = getEntrySerializePath(entryId, ERRLOG_PERSIST_PATH_SEL);
 	updateLastEntryId(static_cast<uint16_t>(entryId));
+	updateEntryCount();
     }
     else
     {
@@ -564,6 +608,10 @@ void Manager::createEntry(std::string errMsg, Entry::Level errLvl,
 
     // Note: No need to close the file descriptors in the FFDC.
     updateEntryLimits(logType);
+    if (logType == LogType::IPMI)
+    {
+	updateEntryCount();
+    }
 }
 
 bool Manager::isQuiesceOnErrorEnabled()
@@ -890,6 +938,14 @@ void Manager::erase(LogType logType, uint32_t entryId)
     }
 
     updateEntryLimits(logType);
+    if(logType == LogType::IPMI)
+    {
+	if(entryId)
+	{
+	   updateLastEntryId(--entryId);
+	}
+        updateEntryCount();
+    }
 }
 
 void Manager::restore()
@@ -980,6 +1036,7 @@ void Manager::restore()
                         entries.emplace(std::make_pair(logType, idNum), std::move(e));
                         entryIdCounterMap[logType] = idNum;
                         updateLastEntryId(idNum);
+			updateEntryCount();
                     }
                     else
                     {
diff --git a/log_manager.hpp b/log_manager.hpp
index 28ae34a..e0d432c 100644
--- a/log_manager.hpp
+++ b/log_manager.hpp
@@ -280,6 +280,9 @@ class Manager : public details::ServerObject<details::ManagerIface>
 
     /** @brief verifying the capping limits **/
     inline void enforceCappingLimit(LogType logType, Entry::Level errLvl);
+
+    /** update total number of entries count **/
+    inline void updateEntryCount();
   private:
     /*
      * @fn _commit()
@@ -388,6 +391,8 @@ class Manager : public details::ServerObject<details::ManagerIface>
     {"ipmi", false},
     {"raid", false}};
 
+    /** @brief counter for ipmi entries */
+    uint8_t ipmiEntryCount = 0;
 };
 
 } // namespace internal
-- 
