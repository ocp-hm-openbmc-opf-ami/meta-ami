+#include <PDKHooks.hpp>
 #include <phosphor-logging/elog.hpp>
 #include <phosphor-logging/log.hpp>
 #include <sdbusplus/exception.hpp>
@@ -311,6 +312,7 @@ void Watchdog::timeOutHandler()
 
         try
         {
+            PDK_WatchdogAction();
             sdbusplus::message::message method;
