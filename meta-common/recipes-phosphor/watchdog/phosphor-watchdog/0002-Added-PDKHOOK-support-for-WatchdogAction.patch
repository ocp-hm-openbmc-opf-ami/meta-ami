Subject: [PATCH 2/2] Added PDKHOOK support for WatchdogAction

---
 src/meson.build  | 4 +++-
 src/watchdog.cpp | 2 ++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/meson.build b/src/meson.build
index ccef9ca..b46afcb 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -15,12 +15,14 @@ watchdog_deps = [
   dependency('stdplus'),
 ]
 
+pdkhook_deps = [ declare_dependency (link_args: '-lpdkhook'),]
+
 watchdog_lib = static_library(
   'watchdog',
   'watchdog.cpp',
   implicit_include_directories: false,
   include_directories: watchdog_headers,
-  dependencies: watchdog_deps)
+  dependencies: [watchdog_deps, pdkhook_deps],)
 
 watchdog_dep = declare_dependency(
   dependencies: watchdog_deps,
diff --git a/src/watchdog.cpp b/src/watchdog.cpp
index f921aaa..e66d739 100644
--- a/src/watchdog.cpp
+++ b/src/watchdog.cpp
@@ -2,6 +2,7 @@
 
