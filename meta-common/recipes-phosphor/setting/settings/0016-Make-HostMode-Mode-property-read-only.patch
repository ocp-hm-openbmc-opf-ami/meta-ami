From 0c2d7d5393b1bea4601e90f779e22342ce13b611 Mon Sep 17 00:00:00 2001
From: mickhuang <mickhuang@ami.com>
Date: Mon, 4 May 2026 20:49:39 +0800
Subject: [PATCH] Make HostMode Mode property read-only and sync with
 CurrentMode

Signed-off-by: mickhuang <mickhuang@ami.com>
---
 include/defaults.hpp  |   4 +-
 include/interface.hpp | 116 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 118 insertions(+), 2 deletions(-)

diff --git a/include/defaults.hpp b/include/defaults.hpp
index 716c370..33088f5 100644
--- a/include/defaults.hpp
+++ b/include/defaults.hpp
@@ -464,8 +464,8 @@ setting->addProperty("RetryIntervalMS", static_cast<uint8_t>(20));
                                      "/xyz/openbmc_project/control/HostMode",
                                      "xyz.openbmc_project.Control.HostMode");
 
-    setting->addProperty("CurrentMode", static_cast<uint16_t>(0));
-    setting->addProperty("Mode", static_cast<uint16_t>(0));
+    setting->addPropertyLinked("CurrentMode", static_cast<uint16_t>(0), "Mode");
+    setting->addPropertyReadOnly("Mode", static_cast<uint16_t>(0));
 
     for (SettingsInterface &s : settings)
     {
diff --git a/include/interface.hpp b/include/interface.hpp
index 2f3e67e..7fffd4e 100644
--- a/include/interface.hpp
+++ b/include/interface.hpp
@@ -212,6 +212,122 @@ struct SettingsInterface
                 return 1;
             });
     }
+    // Read-only property (no setter callback).
+    // Uses a passthrough getter so that set_property() can update the value
+    // internally (e.g. when synced from a linked writable property).
+    template <typename T>
+    void addPropertyReadOnly(const std::string &name, T value)
+    {
+        std::ifstream current(std::string(prefix) + *path);
+        if (current.good())
+        {
+            nlohmann::json data =
+                nlohmann::json::parse(current, nullptr, false);
+            if (data.is_discarded())
+            {
+                std::cerr << "Persisted data at " << *path << " corrupted\n";
+            }
+            else
+            {
+                auto find = data.find(name);
+                if (find != data.end())
+                {
+                    auto val = getOptional<T>(*find);
+                    if (!val)
+                    {
+                        std::cerr << "Persisted data at " << *path
+                                  << " corrupted, type changed for " << name
+                                  << "\n";
+                    }
+                    else
+                    {
+                        value = *val;
+                    }
+                }
+            }
+        }
+
+        interface->register_property_r(
+            name, value,
+            sdbusplus::vtable::property_::emits_change,
+            [](const auto &v) { return v; });
+    }
+    // Writable property that also keeps a linked read-only property in sync.
+    // When this property is set, the linked property is updated to the same
+    // value via set_property() and both values are persisted together so they
+    // remain consistent across reboots.
+    template <typename T>
+    void addPropertyLinked(const std::string &name, T value,
+                           const std::string &linkedName)
+    {
+        std::ifstream current(std::string(prefix) + *path);
+        if (current.good())
+        {
+            nlohmann::json data =
+                nlohmann::json::parse(current, nullptr, false);
+            if (data.is_discarded())
+            {
+                std::cerr << "Persisted data at " << *path << " corrupted\n";
+            }
+            else
+            {
+                auto find = data.find(name);
+                if (find != data.end())
+                {
+                    auto val = getOptional<T>(*find);
+                    if (!val)
+                    {
+                        std::cerr << "Persisted data at " << *path
+                                  << " corrupted, type changed for " << name
+                                  << "\n";
+                    }
+                    else
+                    {
+                        value = *val;
+                    }
+                }
+            }
+        }
+
+        interface->register_property(
+            name, value,
+            [path = std::shared_ptr<std::string>(path), name,
+             iface = interface, linkedName](const T &req, T &old) {
+                nlohmann::json data;
+
+                { // context is here for raii to close the file
+                    std::ifstream current(std::string(prefix) + *path);
+                    if (current.good())
+                    {
+                        data = nlohmann::json::parse(current, nullptr, false);
+                        if (data.is_discarded())
+                        {
+                            std::cerr << "Persisted data at " << *path
+                                      << " corrupted\n";
+                            throw std::runtime_error("Persisting Error");
+                        }
+                    }
+                }
+
+                data[name] = req;
+                data[linkedName] = req;
+                std::filesystem::create_directories(
+                    std::filesystem::path(std::string(prefix) + *path)
+                        .parent_path());
+                std::ofstream output(std::string(prefix) + *path);
+                if (!output.good())
+                {
+                    std::cerr << "Cannot write data at " << *path << "\n";
+                    throw std::runtime_error("Persisting Error");
+                }
+                output << data;
+
+                old = req;
+                iface->set_property(linkedName, req);
+
+                return 1;
+            });
+    }
     void initialize()
     {
         interface->initialize();
-- 
