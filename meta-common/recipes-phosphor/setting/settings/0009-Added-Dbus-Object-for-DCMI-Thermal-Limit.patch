From: saravananm <saravananm@ami.com>
Date: Wed, 20 Nov 2024 15:52:08 +0530
Subject: [PATCH] Added Dbus Object for DCMI Thermal Limit "

Tested:
Verified, Working as expected.

Signed-off-by: saravananm <saravananm@ami.com>
---
 include/defaults.hpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/include/defaults.hpp b/include/defaults.hpp
index df11a94..916d15b 100644
--- a/include/defaults.hpp
+++ b/include/defaults.hpp
@@ -407,6 +407,14 @@ inline void loadSettings(sdbusplus::asio::object_server &objectServer,
     setting->addProperty("lastMajorErr", static_cast<uint8_t>(0));
     setting->addProperty("lastMinorErr", static_cast<uint8_t>(0));
 
+    setting = &settings.emplace_back(
+        objectServer, "/xyz/openbmc_project/control/thermal_limit",
+        "xyz.openbmc_project.Control.ThermalLimit");
+
+    setting->addProperty("ExceptionAction", "");
+    setting->addProperty("TemparatureLimit", static_cast<uint8_t>(0));
+    setting->addProperty("ExceptionTime", static_cast<uint16_t>(0));
+
     for (SettingsInterface &s : settings)
     {
         s.initialize();
