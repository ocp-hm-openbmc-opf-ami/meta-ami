[{
    "blob": "/flash/tarball",
    "handler": {
        "type": "file",
        "path": "/tmp/image.tar"
    },
    "actions": {
        "preparation": {
            "type": "systemd",
            "unit": "preparefwupdinband.service"
        },
        "verification": {
            "type": "systemd",
            "unit": "phosphor-ipmi-flash-bmc-verify.target"
        },
        "update": {
            "type": "systemd",
            "unit": "fwupd@-tmp-image.tar.service"
        }
    }
}]
