diff --git a/include/i2cBusfault_monitor.hpp b/include/i2cBusfault_monitor.hpp
new file mode 100644
index 0000000..15b07d0
--- /dev/null
+++ b/include/i2cBusfault_monitor.hpp
@@ -0,0 +1,164 @@
+#ifdef SEL_I2C_BUSFAULT
+
+#pragma once
+
+#include <sel_logger.hpp>
+#include <string>
+#include <string_view>
+#include <variant>
+#include <poll.h>
+#include <time.h>
+#include <systemd/sd-journal.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sstream>
+#include <bitset>
+
+/*calculation for get the i2c bus number from base address */
+#define I2C_BUS_NUM(x) (((x - I2CBASE_ADD) / 0x80) - 1)
+
+constexpr const uint8_t ADDRESS_LEN = 8;
+constexpr const uint8_t I2C_ARBITRATION = 0x03;
+constexpr const uint8_t I2C_ABNORMAL = 0x05;
+constexpr const uint8_t I2C_SCL_TIMEOUT = 0x06;
+constexpr const uint8_t I2C_SDA_TIMEOUT = 0x0E;
+constexpr const char *i2c_pattern = "received master error interrupt";
+
+constexpr const uint32_t I2CBASE_ADD = 0x14c0f000;
+constexpr const char *I2CBASE_ADD_PATTERN = "14c0";
+
+std::shared_ptr<sdbusplus::asio::connection> connn;
+sd_journal *journal_contex;
+
+inline static void
+sendEventLog(std::shared_ptr<sdbusplus::asio::connection> conn,
+             const std::string faultReason,
+             uint8_t busNum)
+{
+  std::string eventMessage =
+      "I2c Busfault due to " + faultReason + "On I2C-" + std::to_string(busNum);
+
+  sdbusplus::message_t newLogEntry = conn->new_method_call(
+      "xyz.openbmc_project.Logging", "/xyz/openbmc_project/logging",
+      "xyz.openbmc_project.Logging.Create", "Create");
+  const std::string logLevel =
+      "xyz.openbmc_project.Logging.Entry.Level.Error";
+  const std::string msg = "Message:";
+  newLogEntry.append(std::move(eventMessage), std::move(logLevel),
+                     std::map<std::string, std::string>(
+                         {{std::move(msg), std::move(faultReason)}}));
+  conn->call(newLogEntry);
+}
+
+int intt_Journal(std::shared_ptr<sdbusplus::asio::connection> &conn)
+{
+  connn = conn;
+  return 0;
+}
+uint32_t hex_to_byte(const std::string &hex)
+{
+  unsigned int output;
+  std::stringstream ss;
+  ss << std::hex << hex;
+  ss >> output;
+  return output;
+}
+void monitor_log(void)
+{
+  const void *data;
+  uint8_t BusNum = 0;
+  size_t len;
+  int ret = 0;
+
+  ret = sd_journal_open(&journal_contex, SD_JOURNAL_LOCAL_ONLY);
+  if (ret < 0)
+  {
+    std::cerr << "Failed to open journal:" << strerror(-ret) << std::endl;
+  }
+  while (sd_journal_next(journal_contex) > 0)
+  {
+    ret = sd_journal_get_data(journal_contex, "MESSAGE", &data, &len);
+    if (ret < 0)
+    {
+      std::cerr << "Failed to read message field: " << strerror(-ret) << std::endl;
+      continue;
+    }
+  }
+  for (;;)
+  {
+    ret = sd_journal_next(journal_contex);
+    if (ret < 0)
+    {
+      std::cerr << "Failed to iterate to next entry" << strerror(-ret) << std::endl;
+      break;
+    }
+    if (ret == 0)
+    {
+      ret = sd_journal_wait(journal_contex, (uint64_t)-1);
+      if (ret < 0)
+      {
+        std::cerr << "Failed to wait for changes:" << strerror(-ret) << std::endl;
+        break;
+      }
+      continue;
+    }
+    ret = sd_journal_get_data(journal_contex, "MESSAGE", &data, &len);
+    if (ret < 0)
+    {
+      std::cerr << "Failed to read message field:" << strerror(-ret) << std::endl;
+      continue;
+    }
+    std::string pattern = (char *)data;
+
+    if (pattern.find(i2c_pattern) != std::string::npos)
+    {
+      int busadd_pos = pattern.find(I2CBASE_ADD_PATTERN);
+      std::string busBase_Add = pattern.substr(busadd_pos, ADDRESS_LEN);
+
+      if (busBase_Add.length() == ADDRESS_LEN)
+      {
+        uint32_t baseAdd = hex_to_byte(busBase_Add);
+        BusNum = I2C_BUS_NUM(baseAdd);
+      }
+      int value_pos = pattern.find("0x");
+      std::string value = pattern.substr(value_pos + 2, 10);
+
+      if (value.length() == ADDRESS_LEN)
+      {
+        uint32_t regvalue = hex_to_byte(value);
+        std::bitset<32> faultbits(regvalue);
+
+        if (faultbits.any())
+        {
+          if (faultbits.test(I2C_ABNORMAL) == true)
+          {
+            std::cerr << "I2c Abnormal start/stop on I2C-" << BusNum << std::endl;
+            sendEventLog(connn, " I2c Abnormal start/stop ", BusNum);
+          }
+          if (faultbits.test(I2C_ARBITRATION) == true)
+          {
+            std::cerr << "Arbitration Loss on I2C-" << BusNum << std::endl;
+            sendEventLog(connn, " Arbitration Loss", BusNum);
+          }
+          if (faultbits.test(I2C_SCL_TIMEOUT) == true)
+          {
+            std::cerr << "SCL line Timeout on I2C-" << BusNum << std::endl;
+            sendEventLog(connn, " SCL TIMEOUT", BusNum);
+          }
+          if (faultbits.test(I2C_SDA_TIMEOUT) == true)
+          {
+            std::cerr << "SDA line Timeout on I2C-" << BusNum << std::endl;
+            sendEventLog(connn, " SDA TIMEOUT", BusNum);
+          }
+          faultbits.reset();
+        }
+      }
+      else
+      {
+        std::cerr << "Data length is invalid" << std::endl;
+      }
+    }
+  }
+  sd_journal_close(journal_contex);
+}
+#endif
