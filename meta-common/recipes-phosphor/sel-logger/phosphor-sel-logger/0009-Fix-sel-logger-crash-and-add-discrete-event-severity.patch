From fa735df69a51b9c71103c4bc9197d8e818a73c71 Mon Sep 17 00:00:00 2001
From: shamim ali <ashamim@ami.com>
Date: Wed, 23 Jul 2025 09:08:27 -0400
Subject: [PATCH] Fix sel-logger crash and add discrete event severity

Signed-off-by: shamim ali <ashamim@ami.com>
---
 include/sel_logger.hpp |  2 ++
 src/sel_logger.cpp     | 38 +++++++++++++++++++++++++++++++++++---
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/include/sel_logger.hpp b/include/sel_logger.hpp
index 5259169..5c02b9d 100644
--- a/include/sel_logger.hpp
+++ b/include/sel_logger.hpp
@@ -49,6 +49,8 @@ constexpr const char* warningLevel =
     "xyz.openbmc_project.Logging.Entry.Level.Warning";
 constexpr const char* errorLevel =
     "xyz.openbmc_project.Logging.Entry.Level.Critical";
+constexpr const char* naLevel =
+    "xyz.openbmc_project.Logging.Entry.Level.NotApplicable";
 
 enum class eventReading : uint8_t
 {
diff --git a/src/sel_logger.cpp b/src/sel_logger.cpp
index 7d8c924..2e1f958 100644
--- a/src/sel_logger.cpp
+++ b/src/sel_logger.cpp
@@ -479,6 +479,23 @@ static uint16_t selAddSystemRecord(
         severity = informationalLevel;
     }
 
+    auto addData = additionalData.value();
+    uint8_t eventType = 0x6f;
+    auto itr = addData.find("EVENT_TYPE");
+    if (itr != addData.end())
+    {
+        eventType = static_cast<uint8_t>(std::stoi(addData["EVENT_TYPE"]));
+        eventType &= 0x7F; // skipping 8th bit to retrive eventReadingTypeCode.
+        if (eventType != 0x01)
+        {
+            severity = naLevel;
+        }
+    }
+    else
+    {
+        severity = naLevel;
+    }
+
     sdbusplus::message_t AddToLog = conn->new_method_call(
         "xyz.openbmc_project.Logging", "/xyz/openbmc_project/logging",
         "xyz.openbmc_project.Logging.Create", "Create");
@@ -519,8 +536,15 @@ static uint16_t selAddSystemRecord(
         return response;
     };
 
-    AddToLog.append(journalMsg, severity, initialize());
-    conn->call(AddToLog);
+    try
+    {
+        AddToLog.append(journalMsg, severity, initialize());
+        conn->call(AddToLog);
+    }
+    catch (const sdbusplus::exception_t& e)
+    {
+        std::cerr << "Failed adding this event: " << e.what() << "\n";
+    }
 #else
     recordId = getNewRecordId();
     if (recordId != 0)
@@ -584,7 +608,15 @@ static uint16_t selAddOemRecord(
              {"RECORD_TYPE", std::to_string(recordType)},
              {"EVENT_DIR", std::to_string(0)},
              {"SENSOR_DATA", selDataStr}}));
-    conn->call(AddToLog);
+    try
+    {
+        conn->call(AddToLog);
+    }
+    catch (const sdbusplus::exception_t& e)
+    {
+        std::cerr << "Failed adding this event: " << e.what() << "\n";
+    }
+
     return 0;
 #else
     unsigned int recordId = getNewRecordId();
-- 
2.34.1

From 58f1b7588499d5625a7d1668d299a0eb665ca836 Mon Sep 17 00:00:00 2001
