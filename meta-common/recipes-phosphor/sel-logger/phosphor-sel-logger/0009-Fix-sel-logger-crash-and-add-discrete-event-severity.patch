+	    {
+		std::cerr << "Failed adding PEF event: " << e.what() << "\n";
+	    }
         }
 #else
         selAddSystemRecord(
diff --git a/src/sel_logger.cpp b/src/sel_logger.cpp
index 2e1f958..3a25000 100644
