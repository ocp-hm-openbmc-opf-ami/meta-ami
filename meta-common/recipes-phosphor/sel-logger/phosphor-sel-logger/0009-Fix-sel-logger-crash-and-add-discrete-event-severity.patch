+	catch (const sdbusplus::exception_t& e)
+	{
+            std::cerr << "Failed to update OS Critical Stop sensor " << e.what() << "\n";
+	}
     }
 
     doPefTask(conn, path, assert, recordId, selData, message, sensorType);
