From dd48232b5dab034cb291a3a6ef4f2cd00ad1e30a Mon Sep 17 00:00:00 2001
From: Nikhila Dande <nikhilad@ami.com>
Date: Tue, 7 Jul 2026 18:16:53 +0000
Subject: [PATCH] Adding phosphor-power debug

Signed-off-by: Nikhila Dande <nikhilad@ami.com>
---
 phosphor-power-supply/power_supply.cpp | 14 +++++++--
 phosphor-power-supply/psu_manager.cpp  | 19 +++++++++----
 phosphor-power-supply/util.cpp         |  6 +++-
 pmbus.cpp                              | 39 +++++++++++++++++---------
 4 files changed, 56 insertions(+), 22 deletions(-)

diff --git a/phosphor-power-supply/power_supply.cpp b/phosphor-power-supply/power_supply.cpp
index f3aa2f7..261b93a 100644
--- a/phosphor-power-supply/power_supply.cpp
+++ b/phosphor-power-supply/power_supply.cpp
@@ -20,6 +20,8 @@
 
 namespace phosphor::power::psu
 {
+static constexpr bool debug = false;
+
 // Amount of time in milliseconds to delay between power supply going from
 // missing to present before running the bind command(s).
 constexpr auto bindDelay = 1000;
@@ -176,8 +178,11 @@ void PowerSupply::updatePresence()
     {
         // Relying on property change or interface added to retry.
         // Log an informational trace to the journal.
-        lg2::info("D-Bus property {INVENTORY_PATH} access failure exception",
-                  "INVENTORY_PATH", inventoryPath);
+        if (debug)
+        {
+            lg2::info("D-Bus property {INVENTORY_PATH} access failure exception",
+                      "INVENTORY_PATH", inventoryPath);
+        }
     }
 }
 
@@ -198,7 +203,10 @@ void PowerSupply::updatePresenceGPIO()
     }
     catch (const std::exception& e)
     {
-        lg2::error("presenceGPIO read fail: {ERROR}", "ERROR", e);
+        if (debug)
+        {
+            lg2::error("presenceGPIO read fail: {ERROR}", "ERROR", e);
+        }
         throw;
     }
 
diff --git a/phosphor-power-supply/psu_manager.cpp b/phosphor-power-supply/psu_manager.cpp
index 6519f78..6d97e8b 100644
--- a/phosphor-power-supply/psu_manager.cpp
+++ b/phosphor-power-supply/psu_manager.cpp
@@ -26,6 +26,8 @@
 
 namespace phosphor::power::manager
 {
+static constexpr bool debug = false;
+
 constexpr auto managerBusName = "xyz.openbmc_project.Power.PSUMonitor";
 constexpr auto objectManagerObjPath =
     "/xyz/openbmc_project/power/power_supplies";
@@ -327,9 +329,13 @@ void PSUManager::initialize()
     createPsuProperty();
 #endif
 
-    lg2::info(
-        "initialize: power on: {POWER_ON}, power fault occurring: {POWER_FAULT_OCCURRING}",
-        "POWER_ON", powerOn, "POWER_FAULT_OCCURRING", powerFaultOccurring);
+    if (debug)
+    {
+        lg2::info(
+            "initialize: power on: {POWER_ON}, power fault occurring: {POWER_FAULT_OCCURRING}",
+            "POWER_ON", powerOn, "POWER_FAULT_OCCURRING",
+            powerFaultOccurring);
+    }
 }
 
 void PSUManager::getPSUConfiguration()
@@ -678,8 +684,11 @@ void PSUManager::setPowerSupplyError(const std::string& psuErrorString)
     }
     catch (const std::exception& e)
     {
-        lg2::info("Failed calling setPowerSupplyError due to error {ERROR}",
-                  "ERROR", e);
+        if (debug)
+        {
+            lg2::info("Failed calling setPowerSupplyError due to error {ERROR}",
+                      "ERROR", e);
+        }
     }
 }
 
diff --git a/phosphor-power-supply/util.cpp b/phosphor-power-supply/util.cpp
index 35c35ca..a3fbba6 100644
--- a/phosphor-power-supply/util.cpp
+++ b/phosphor-power-supply/util.cpp
@@ -4,6 +4,7 @@
 
 namespace phosphor::power::psu
 {
+static constexpr bool debug = false;
 
 const UtilBase& getUtils()
 {
@@ -68,7 +69,10 @@ int GPIOInterface::read()
     }
     catch (const std::exception& e)
     {
-        lg2::error("Failed to request GPIO line: {MSG}", "MSG", e);
+        if (debug)
+        {
+            lg2::error("Failed to request GPIO line: {MSG}", "MSG", e);
+        }
         throw;
     }
 
diff --git a/pmbus.cpp b/pmbus.cpp
index 4d2a7a9..1b33f87 100644
--- a/pmbus.cpp
+++ b/pmbus.cpp
@@ -28,6 +28,7 @@ namespace phosphor
 {
 namespace pmbus
 {
+static constexpr bool debug = false;
 
 using namespace phosphor::logging;
 using namespace sdbusplus::xyz::openbmc_project::Common::Error;
@@ -171,9 +172,12 @@ bool PMBus::readBit(const std::string& name, Type type)
     {
         auto rc = errno;
 
-        lg2::error(
-            "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
-            "ERRNO", rc, "FILENAME", path);
+        if (debug)
+        {
+            lg2::error(
+                "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
+                "ERRNO", rc, "FILENAME", path);
+        }
 
         using metadata = xyz::openbmc_project::Common::Device::ReadFailure;
 
@@ -211,7 +215,7 @@ uint64_t PMBus::read(const std::string& name, Type type, bool errTrace)
     {
         auto rc = errno;
 
-        if (errTrace)
+        if (errTrace && debug)
         {
             lg2::error(
                 "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
@@ -253,9 +257,12 @@ std::string PMBus::readString(const std::string& name, Type type)
     catch (const std::exception& e)
     {
         auto rc = errno;
-        lg2::error(
-            "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
-            "ERRNO", rc, "FILENAME", path);
+        if (debug)
+        {
+            lg2::error(
+                "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
+                "ERRNO", rc, "FILENAME", path);
+        }
 
         using metadata = xyz::openbmc_project::Common::Device::ReadFailure;
 
@@ -293,9 +300,12 @@ std::vector<uint8_t> PMBus::readBinary(const std::string& name, Type type,
             else if (ferror(file.get()))
             {
                 auto rc = errno;
-                lg2::error(
-                    "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
-                    "ERRNO", rc, "FILENAME", path);
+                if (debug)
+                {
+                    lg2::error(
+                        "Failed to read sysfs file errno={ERRNO} FILENAME={FILENAME}",
+                        "ERRNO", rc, "FILENAME", path);
+                }
                 using metadata =
                     xyz::openbmc_project::Common::Device::ReadFailure;
 
@@ -401,9 +411,12 @@ void PMBus::findHwmonDir()
     // and let accesses fail later
     if (hwmonDir.empty())
     {
-        lg2::info("Unable to find hwmon directory in device base path "
-                  "DEVICE_PATH={DEVICE_PATH}",
-                  "DEVICE_PATH", basePath);
+        if (debug)
+        {
+            lg2::info("Unable to find hwmon directory in device base path "
+                      "DEVICE_PATH={DEVICE_PATH}",
+                      "DEVICE_PATH", basePath);
+        }
     }
 }
 
-- 
2.43.0

