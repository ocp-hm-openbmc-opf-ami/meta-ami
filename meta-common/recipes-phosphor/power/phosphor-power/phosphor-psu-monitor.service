[Unit]
Description=Phosphor Power Supply Monitor
After=xyz.openbmc_project.psusensor.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=/bin/sleep 15
ExecStartPre=/usr/bin/psu-detction.sh /usr/share/phosphor-power/psu.json
ExecStart=phosphor-psu-monitor

[Install]
WantedBy=multi-user.target

