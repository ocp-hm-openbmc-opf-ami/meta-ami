 void PSUManager::analyze()
 {
+#ifdef SOLUM_PSU
+
+    for (auto& monitor : psuMonitors)
+    {
+        if (monitor.pmbusInterface)
+        {
+            bool psuAccessible = false;
+            uint64_t in1_input = 0;
+
+            // First check if I2C base device path exists.
+            auto i2cDevicePath =
+                monitor.pmbusInterface->getPath(phosphor::pmbus::Type::Base);
+
+            namespace fs = std::filesystem;
+            bool deviceExists = false;
+
+            try
+            {
+                deviceExists = fs::exists(i2cDevicePath);
+            }
+            catch (const std::exception& e)
+            {
+                deviceExists = false;
+            }
+
+            if (deviceExists && !monitor.isConnected)
+            {
+                try
+                {
+                    char pmbusAddrBuf[5];
+                    snprintf(pmbusAddrBuf, sizeof(pmbusAddrBuf), "%04x",
+                             (unsigned int)monitor.address);
+                    std::string addrStrPmbus(pmbusAddrBuf);
+
+                    monitor.pmbusInterface =
+                        phosphor::pmbus::createPMBus(monitor.bus, addrStrPmbus);
+
+                    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+                }
+                catch (const std::exception& e)
+                {}
+            }
+
+            try
+            {
+                in1_input = monitor.pmbusInterface->read(
+                    "in1_input", phosphor::pmbus::Type::Hwmon, false);
+                psuAccessible = true;
+            }
+            catch (const std::exception& e)
+            {
+                psuAccessible = false;
+
+                if (deviceExists && !monitor.isConnected)
+                {
+                    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+                    try
+                    {
+                        in1_input = monitor.pmbusInterface->read(
+                            "in1_input", phosphor::pmbus::Type::Hwmon, false);
+                        psuAccessible = true;
+                    }
+                    catch (const std::exception& e2)
+                    {
+                        psuAccessible = false;
+                    }
+                }
+            }
+
+            std::string psuPath =
+                "/xyz/openbmc_project/power/power_supplies/" + monitor.name;
+
+            if (psuAccessible && !monitor.isConnected)
+            {
+                try
+                {
+                    if (objServer)
+                    {
+                        auto iface = objServer->add_interface(
+                            psuPath, "xyz.openbmc_project.PsuStatus");
+
+                        std::string psuStatus =
+                            (in1_input > 0) ? "Enabled" : "StandbyOffline";
+                        iface->register_property("PSUStatus", psuStatus);
+
+                        monitor.firmwareVersion =
+                            monitor.pmbusInterface->readString(
+                                "mfr_revision",
+                                phosphor::pmbus::Type::HwmonDeviceDebug);
+
+                        monitor.serialNumber =
+                            monitor.pmbusInterface->readString(
+                                "mfr_serial",
+                                phosphor::pmbus::Type::HwmonDeviceDebug);
+
+                        monitor.sparePartNumber =
+                            monitor.pmbusInterface->readString(
+                                "mfr_model",
+                                phosphor::pmbus::Type::HwmonDeviceDebug);
+
+                        try
+                        {
+                            auto powerStr = monitor.pmbusInterface->readString(
+                                "power2_rated_max",
+                                phosphor::pmbus::Type::Hwmon);
+                            uint64_t powerMicrowatts = std::stoull(powerStr);
+                            monitor.powerCapacityWatts =
+                                powerMicrowatts / 1000000;
+                        }
+                        catch (const std::exception& e)
+                        {}
+
+                        uint8_t inputRanges = 0;
+                        double actVoltage =
+                            static_cast<double>(in1_input) / 1000.0;
+                        if (actVoltage >= 200.0)
+                        {
+                            inputRanges = 220;
+                        }
+                        else if (actVoltage >= 100.0 && actVoltage < 200.0)
+                        {
+                            inputRanges = 110;
+                        }
+                        else
+                        {
+                            inputRanges = 0;
+                        }
+
+                        iface->register_property("InputRanges", inputRanges);
+                        iface->register_property("PowerCapacityWatts",
+                                                 monitor.powerCapacityWatts);
+                        iface->register_property("FirmwareVersion",
+                                                 monitor.firmwareVersion);
+                        iface->register_property(
+                            "InputNominalVoltageType",
+                            monitor.inputNominalVoltageType);
+                        iface->register_property("PowerSupplyType",
+                                                 monitor.powerSupplyType);
+                        iface->register_property("SparePartNumber",
+                                                 monitor.sparePartNumber);
+                        iface->register_property("SerialNumber",
+                                                 monitor.serialNumber);
+                        iface->register_property("PlugType", monitor.plugType);
+                        iface->register_property("EfficiencyRatings",
+                                                 monitor.efficiencyRatings);
+                        iface->register_property("OutputRails",
+                                                 monitor.outputRails);
+                        /*Dummy value used, it will deploy on properties it
+                         * won't create any impact on H/W */
+                        iface->register_property("AllocatedWatts",
+                                                 static_cast<uint64_t>(800));
+                        iface->register_property("RequestedWatts",
+                                                 static_cast<uint64_t>(400));
+
+                        iface->initialize();
+
+                        psuInterfaceMap[monitor.name] = iface;
+                        monitor.isConnected = true;
+                    }
+                }
+                catch (const std::exception& e)
+                {}
+            }
+            else if (!psuAccessible && monitor.isConnected)
+            {
+                try
+                {
+                    auto it = psuInterfaceMap.find(monitor.name);
+                    if (it != psuInterfaceMap.end())
+                    {
+                        if (objServer)
+                        {
+                            objServer->remove_interface(it->second);
+                        }
+                        psuInterfaceMap.erase(it);
+                        monitor.isConnected = false;
+                    }
+                }
+                catch (const std::exception& e)
+                {}
+            }
+            else if (psuAccessible && monitor.isConnected)
+            {
+                auto it = psuInterfaceMap.find(monitor.name);
+                if (it != psuInterfaceMap.end())
+                {
+                    try
+                    {
+                        std::string psuStatus =
+                            (in1_input > 0) ? "Enabled" : "StandbyOffline";
+                        it->second->set_property("PSUStatus", psuStatus);
+
+                        uint8_t inputRanges = 0;
+                        double actVoltage =
+                            static_cast<double>(in1_input) / 1000.0;
+                        if (actVoltage >= 200.0)
+                        {
+                            inputRanges = 220;
+                        }
+                        else if (actVoltage >= 100.0 && actVoltage < 200.0)
+                        {
+                            inputRanges = 110;
+                        }
+                        else
+                        {
+                            inputRanges = 0;
+                        }
+                        it->second->set_property("InputRanges", inputRanges);
+
+                        if (monitor.firmwareVersion == "Unknown" ||
+                            monitor.firmwareVersion.empty())
+                        {
+                            monitor.firmwareVersion =
+                                monitor.pmbusInterface->readString(
+                                    "mfr_revision",
+                                    phosphor::pmbus::Type::HwmonDeviceDebug);
+                            it->second->set_property("FirmwareVersion",
+                                                     monitor.firmwareVersion);
+                        }
+
+                        if (monitor.serialNumber == "Unknown" ||
+                            monitor.serialNumber.empty())
+                        {
+                            monitor.serialNumber =
+                                monitor.pmbusInterface->readString(
+                                    "mfr_serial",
+                                    phosphor::pmbus::Type::HwmonDeviceDebug);
+                            it->second->set_property("SerialNumber",
+                                                     monitor.serialNumber);
+                        }
+
+                        if (monitor.sparePartNumber == "Unknown" ||
+                            monitor.sparePartNumber.empty())
+                        {
+                            monitor.sparePartNumber =
+                                monitor.pmbusInterface->readString(
+                                    "mfr_model",
+                                    phosphor::pmbus::Type::HwmonDeviceDebug);
+                            it->second->set_property("SparePartNumber",
+                                                     monitor.sparePartNumber);
+                        }
+                    }
+                    catch (const std::exception& e)
+                    {}
+                }
+            }
+        }
+    }
+
+    io.poll();
+#endif
     auto syncHistoryRequired =
         std::any_of(psus.begin(), psus.end(), [](const auto& psu) {
             return psu->isSyncHistoryRequired();
