From 55ee20477eadc2acd908676b8bcdee0492bcc3a4 Mon Sep 17 00:00:00 2001
From: henryliu <henryliu@ami.com>
Date: Thu, 16 Apr 2026 14:17:37 +0800
Subject: [PATCH] Add boundary checks for offset update

---
 src/bej_decoder_core.c     | 25 ++++++++++++++++++++++---
 src/bej_dictionary.c       | 12 ++++++++++++
 src/bej_encoder_metadata.c | 23 ++++++++++++++++++-----
 3 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/src/bej_decoder_core.c b/src/bej_decoder_core.c
index 4043f5c..b87f04b 100644
--- a/src/bej_decoder_core.c
+++ b/src/bej_decoder_core.c
@@ -176,7 +176,7 @@ static int bejGetDictionaryAndProperty(
 
     int ret =
         bejDictGetProperty(*dictionary, dictPropOffset, sequenceNumber, prop);
-    if (ret == bejErrorUnknownProperty || schemaType == bejAnnotation)
+    if (ret == bejErrorUnknownProperty)
     {
         if (schemaType == bejAnnotation)
         {
@@ -383,11 +383,17 @@ static int bejHandleBejSet(struct BejHandleTypeFuncParam* params)
     {
         // Since this set is an annotated type, we need to advance the
         // annotation dictionary for decoding the next segment.
-        params->state.annoDictPropOffset = prop->childPointerOffset;
+        if (prop->childPointerOffset)
+        {
+            params->state.annoDictPropOffset = prop->childPointerOffset;
+        }
     }
     else
     {
-        params->state.mainDictPropOffset = prop->childPointerOffset;
+        if (prop->childPointerOffset)
+        {
+            params->state.mainDictPropOffset = prop->childPointerOffset;
+        }
     }
     return 0;
 }
@@ -785,6 +791,19 @@ static int bejDecode(const uint8_t* schemaDictionary,
 
     while (params.state.encodedStreamOffset < streamLen)
     {
+        // If we already consumed at least one tuple and the section stack is
+        // empty, root should already be closed. Any remaining bytes are
+        // trailing data and should not be decoded as extra tuples.
+        if (params.state.encodedStreamOffset > 0 &&
+            params.stackCallback->stackEmpty(params.stackDataPtr))
+        {
+            fprintf(stderr,
+                    "Trailing bytes detected after root section closes. "
+                    "offset=%u streamLen=%u remaining=%u\n",
+                    params.state.encodedStreamOffset, streamLen,
+                    streamLen - params.state.encodedStreamOffset);
+            break;
+        }
         // Go to the next encoded segment in the encoded stream.
         params.state.encodedSubStream =
             enStream + params.state.encodedStreamOffset;
diff --git a/src/bej_dictionary.c b/src/bej_dictionary.c
index c0481b3..f9dc73e 100644
--- a/src/bej_dictionary.c
+++ b/src/bej_dictionary.c
@@ -111,6 +111,18 @@ const char* bejDictGetPropertyName(const uint8_t* dictionary,
     {
         return "";
     }
+    // Boundary check: ensure nameOffset + nameLength stays within the
+    // dictionary buffer
+    const struct BejDictionaryHeader* header =
+        (const struct BejDictionaryHeader*)dictionary;
+    if ((uint32_t)nameOffset + nameLength > header->dictionarySize)
+    {
+        fprintf(stderr,
+                "[bejDictGetPropertyName] nameOffset=%u nameLength=%u exceeds "
+                "dictionarySize=%u — would read out of bounds\n",
+                nameOffset, nameLength, header->dictionarySize);
+        return "";
+    }
     return (const char*)(dictionary + nameOffset);
 }
 
diff --git a/src/bej_encoder_metadata.c b/src/bej_encoder_metadata.c
index 76f78c3..e4c08be 100644
--- a/src/bej_encoder_metadata.c
+++ b/src/bej_encoder_metadata.c
@@ -157,11 +157,24 @@ static int bejFindSeqNumAndChildDictOffset(
                                        node->name, &property, NULL);
     if (ret != 0)
     {
-        fprintf(stderr,
-                "Failed to find dictionary entry for name %s. Search started "
-                "at offset: %u. ret: %d\n",
-                node->name, dictStartingOffset, ret);
-        return ret;
+        // If the property is not found at the scoped offset, retry from the
+        // beginning of the dictionary — mirroring the decoder's fallback in
+        // bejGetDictionaryAndProperty().
+        uint16_t rootOffset = isAnnotation
+                                  ? bejDictGetFirstAnnotatedPropertyOffset()
+                                  : bejDictGetPropertyHeadOffset();
+        fprintf(
+            stderr,
+            "Property '%s' not found at offset= %u, retrying from dict root offset= %u\n",
+            node->name, dictStartingOffset, rootOffset);
+        ret = bejDictGetPropertyByName(dictionary, rootOffset, node->name,
+                                       &property, NULL);
+        if (ret != 0)
+        {
+            fprintf(stderr, "Failed to find dictionary entry for '%s'.\n",
+                    node->name);
+            return ret;
+        }
     }
 
     if (nodeDictionary != NULL)
-- 
2.34.1

