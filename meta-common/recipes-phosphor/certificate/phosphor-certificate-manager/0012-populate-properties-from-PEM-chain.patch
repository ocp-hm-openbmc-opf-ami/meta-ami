From 91fe429fe9a120a84a7e08a5ee5fb01c4e3edf3c Mon Sep 17 00:00:00 2001
From: Minal Upadhye <minalsunilu@ami.com>
Date: Wed, 10 Sep 2025 08:20:06 -0400
Subject: [PATCH 2/2] populate properties from PEM chain

Signed-off-by: Minal Upadhye <minalsunilu@ami.com>
---
 certificate.cpp   |  5 +++++
 certificate.hpp   |  2 ++
 certs_manager.cpp | 12 ++++++++++++
 3 files changed, 19 insertions(+)

diff --git a/certificate.cpp b/certificate.cpp
index e08159a..e62e62b 100644
--- a/certificate.cpp
+++ b/certificate.cpp
@@ -456,6 +456,11 @@ void Certificate::populateProperties()
     populateProperties(*cert);
 }
 
+void Certificate::populateCertProperties(X509& cert)
+{
+    populateProperties(cert);
+}
+
 std::string Certificate::getCertId() const
 {
     return certId;
diff --git a/certificate.hpp b/certificate.hpp
index 58605d2..e3a45af 100644
--- a/certificate.hpp
+++ b/certificate.hpp
@@ -227,6 +227,8 @@ class Certificate : public internal::CertificateInterface
 
     std::string getCertificate();
 
+    void populateCertProperties(X509& cert);
+
   private:
     /**
      * @brief Populate certificate properties by parsing given certificate
diff --git a/certs_manager.cpp b/certs_manager.cpp
index 7cbaa83..cbb1e69 100644
--- a/certs_manager.cpp
+++ b/certs_manager.cpp
@@ -537,6 +537,18 @@ void Manager::replaceCertificate(Certificate* const certificate,
             }
         }
         installChain_Cert(filePath);
+
+        using phosphor::certs::Certificate;
+        try
+        {
+            auto cert = loadCert(filePath);
+            certificate->populateCertProperties(*cert);
+        }
+        catch (const std::exception& e)
+        {
+            lg2::error("Failed to parse PEM chain leaf cert, ERR:{ERR}", "ERR",
+                       e.what());
+        }
     }
 }
 
