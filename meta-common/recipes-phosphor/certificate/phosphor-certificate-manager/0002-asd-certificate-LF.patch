From c0f76a3fad93d4fab47739305ccf611cd7c9cde5 Mon Sep 17 00:00:00 2001
From: Minal Upadhye <minalsunilu@ami.com>
Date: Mon, 23 Feb 2026 18:09:53 +0530
Subject: [PATCH 4/4] asd-certificate LF

Signed-off-by: Minal Upadhye <minalsunilu@ami.com>
---
 dist/busconfig/phosphor-asd-cert-config.conf |  8 ++++++++
 dist/env/asd                                 | 12 ++++++++++++
 dist/meson.build                             |  9 +++++++++
 meson.options                                |  5 +++++
 4 files changed, 34 insertions(+)
 create mode 100644 dist/busconfig/phosphor-asd-cert-config.conf
 create mode 100644 dist/env/asd

diff --git a/dist/busconfig/phosphor-asd-cert-config.conf b/dist/busconfig/phosphor-asd-cert-config.conf
new file mode 100644
index 0000000..0f0878b
--- /dev/null
+++ b/dist/busconfig/phosphor-asd-cert-config.conf
@@ -0,0 +1,8 @@
+<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <policy user="root">
+    <allow own="xyz.openbmc_project.Certs.Manager.Server.Asd"/>
+    <allow send_destination="xyz.openbmc_project.Certs.Manager.Server.Asd"/>
+  </policy>
+</busconfig>
diff --git a/dist/env/asd b/dist/env/asd
new file mode 100644
index 0000000..19b6dff
--- /dev/null
+++ b/dist/env/asd
@@ -0,0 +1,12 @@
+#D-Bus object path
+#example: /xyz/openbmc_project/certs/server/asd
+ENDPOINT=asd
+
+#Path for the certificate file
+CERTPATH=/etc/ssl/certs/asd/server.pem
+
+#Units to restart
+UNIT=bmcweb.service
+
+#Type of the service client/server
+TYPE=server
diff --git a/dist/meson.build b/dist/meson.build
index 4cae050..283443a 100644
--- a/dist/meson.build
+++ b/dist/meson.build
@@ -34,6 +34,15 @@ if get_option('config-authority').allowed()
     ]
 endif
 
+if not get_option('config-asd').disabled()
+    busconfig += 'busconfig/phosphor-asd-cert-config.conf'
+    certs += 'env/asd'
+    systemd_alias += [[
+        '../phosphor-certificate-manager@.service',
+        'multi-user.target.wants/phosphor-certificate-manager@asd.service'
+    ]]
+endif
+
 install_data(service_files, install_dir: systemd_system_unit_dir)
 
 install_data(busconfig, install_dir: busconfig_dir)
diff --git a/meson.options b/meson.options
index 35752e6..53fbdb7 100644
--- a/meson.options
+++ b/meson.options
@@ -25,6 +25,11 @@ option(
     description: 'Install authority cert configs',
 )
 
+option('config-asd',
+    type: 'feature',
+    description: 'Install asd cert configs',
+)
+
 option(
     'authorities-list-name',
     type: 'string',
-- 
2.34.1

