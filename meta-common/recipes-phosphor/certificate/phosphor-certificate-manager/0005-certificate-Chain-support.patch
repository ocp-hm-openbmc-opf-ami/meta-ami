+void Manager::installChain_Cert(const std::string filePath)
+{
+    std::string tmp_cert;
+    fs::path sourceFile(filePath);
+    if (!fs::exists(sourceFile))
+    {
+        lg2::error("File is Missing, FILE:{FILE}", "FILE", filePath);
+        elog<InternalFailure>();
+    }
+    std::vector<std::string> httpsChain = splitCertificates(sourceFile);
+    if (httpsChain.size() > 5)
+    {
+        elog<NotAllowed>(NotAllowedReason("Certificates limit reached"));
+    }
+    lg2::info("Starts Https chain list install");
+    for (std::string& c : httpsChain)
+    {
+        tmp_cert.append(c);
+    }
+    for (const auto& cert : installedCerts)
+    {
+        cert->setCertificate(tmp_cert);
+        break;
+    }
+    fs::path httpsChainStore(certInstallPath);
+    fs::path httpsChainListFile =
+        httpsChainStore / defaultHttpsChainListFileName;
+    // Atomically install all the certificates
+    fs::path tempPath = Certificate::generateUniqueFilePath(httpsChainStore);
+    fs::create_directory(tempPath);
+    // Copies the Https list
+    Certificate::copyCertificate(sourceFile,
+                                 tempPath / defaultHttpsChainListFileName);
+    X509StorePtr x509Store = getX509Store(sourceFile);
+
+    for (const auto& httpsSingle : httpsChain)
+    {
+        std::string tmp = httpsSingle;
+        internal::X509Ptr cert = parseCert(httpsSingle);
+        validateCertificateAgainstStore(*x509Store, *cert);
+        validateCertificateStartDate(*cert);
+        validateCertificateKeyLength(*cert);
+        validateCertificateInSSLContext(*cert);
+    }
+    for (const fs::path& f : fs::directory_iterator(tempPath))
+    {
+        fs::path path = certInstallPath;
+        fs::copy(tempPath / f.filename(), path.parent_path());
+    }
+}
 
