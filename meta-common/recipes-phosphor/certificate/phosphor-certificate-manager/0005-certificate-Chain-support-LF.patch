@@ -431,15 +493,41 @@ void Manager::deleteCertificate(const Certificate* const certificate)
 void Manager::replaceCertificate(Certificate* const certificate,
                                  const std::string& filePath)
 {
-    if (isCertificateUnique(filePath, certificate))
+    CertsTypes CertType;
+    for (const auto& cert : installedCerts)
     {
-        certificate->install(filePath, false);
-        storageUpdate();
-        reloadOrReset(unitToRestart);
+        CertType = cert->getCertificateType();
     }
-    else
+    auto contypestr =
+        sdbusplus::common::xyz::openbmc_project::certs::convertForMessage(
+            CertType);
+
+    syslog(LOG_INFO, "Get cert %s \r\n", std::string(contypestr).c_str());
+
+    if (contypestr == "xyz.openbmc_project.Certs.Certificate.Type.PEM")
     {
-        elog<NotAllowed>(NotAllowedReason("Certificate already exist"));
+        if (isCertificateUnique(filePath, certificate))
+        {
+            certificate->install(filePath, false);
+            storageUpdate();
+            reloadOrReset(unitToRestart);
+        }
+        else
+        {
+            elog<NotAllowed>(NotAllowedReason("Certificate already exist"));
+        }
+    }
+    else if (contypestr == "xyz.openbmc_project.Certs.Certificate.Type.PEMchain")
+    {
+        fs::path chainFile = fs::path(certInstallPath).parent_path();
+        chainFile = chainFile / defaultHttpsChainListFileName;
+        if (fs::exists(chainFile))
+        {
+            elog<NotAllowed>(
+                NotAllowedReason("Certificate Chain already exist"));
+            return;
+        }
+        installChain_Cert(filePath);
     }
 }
 
@@ -1272,6 +1360,50 @@ void Manager::createCertificates()
             report<InvalidCertificate>(InvalidCertificateReason(
                 "Existing certificate file is corrupted"));
         }
+
+        fs::path chainFile = fs::path(certInstallPath).parent_path();
+        chainFile = chainFile / defaultHttpsChainListFileName;
+        if (!fs::exists(chainFile))
+        {
+            return;
+        }
+        std::vector<std::string> https = splitCertificates(chainFile.string());
+
+        /*Certificate lenght should be more than one, after that only it will
+         * consider as chain*/
+        if (https.size() > 1)
+        {
+            std::string cert_buff;
+            installedCerts[0]->setCertificateType(
+                sdbusplus::server::xyz::openbmc_project::certs::Certificate::
+                    Type::PEM);
+            /*Read the data from chain certificate update in DBUS property*/
+            std::ifstream inputCertFileStream;
+            inputCertFileStream.exceptions(
+                std::ifstream::failbit | std::ifstream::badbit |
+                std::ifstream::eofbit);
+            try
+            {
+                std::string buf;
+                inputCertFileStream.open(chainFile);
+                while (std::getline(inputCertFileStream, buf))
+                {
+                    cert_buff.append(buf);
+                }
+                inputCertFileStream.close();
+            }
+            catch (const std::exception& e)
+            {
+                lg2::error("Fail to read chain certificate");
+            }
+            installedCerts[0]->setCertificate(cert_buff);
+        }
+        else
+        {
+            installedCerts[0]->setCertificateType(
+                sdbusplus::server::xyz::openbmc_project::certs::Certificate::
+                    Type::PEMchain);
+        }
     }
 }
 
