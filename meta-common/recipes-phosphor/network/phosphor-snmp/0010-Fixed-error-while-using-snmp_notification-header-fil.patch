From bf0a551a6fa79d9b4575b3b380a1537989435aa0 Mon Sep 17 00:00:00 2001
From: vamsikrishnak <vamsikrishnak@ami.com>
Date: Fri, 31 May 2024 17:37:58 +0530
Subject: [PATCH] Fixed error while using snmp_notification header file

Signed-off-by: vamsikrishnak <vamsikrishnak@ami.com>
---
 snmp_notification.hpp | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/snmp_notification.hpp b/snmp_notification.hpp
index 32a48ad..59e8c49 100644
--- a/snmp_notification.hpp
+++ b/snmp_notification.hpp
@@ -51,8 +51,8 @@ using Type = u_char;
 
 using Value = std::variant<uint32_t, uint64_t, int32_t, std::string>;
 // Generic snmp trap ID
-oid SNMPTrapOID[] = {1, 3, 6, 1, 6, 3, 1, 1, 4, 1, 0};
-oid sysuptimeOID[] = {1, 3, 6, 1, 2, 1, 1, 3, 0};
+constexpr oid SNMPTrapOID[] = {1, 3, 6, 1, 6, 3, 1, 1, 4, 1, 0};
+constexpr oid sysuptimeOID[] = {1, 3, 6, 1, 2, 1, 1, 3, 0};
 
 using Object = std::tuple<OID, OID_LEN, Type, Value>;
 
@@ -65,25 +65,25 @@ template <typename T>
 u_char getASNType() = delete;
 
 template <>
-u_char getASNType<uint32_t>()
+inline u_char getASNType<uint32_t>()
 {
     return ASN_UNSIGNED;
 }
 
 template <>
-u_char getASNType<uint64_t>()
+inline u_char getASNType<uint64_t>()
 {
     return ASN_OPAQUE_U64;
 }
 
 template <>
-u_char getASNType<int32_t>()
+inline u_char getASNType<int32_t>()
 {
     return ASN_INTEGER;
 }
 
 template <>
-u_char getASNType<std::string>()
+inline u_char getASNType<std::string>()
 {
     return ASN_OCTET_STR;
 }
