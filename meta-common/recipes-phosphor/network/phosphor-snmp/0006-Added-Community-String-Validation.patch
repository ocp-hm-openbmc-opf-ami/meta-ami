diff --git a/snmp_util.cpp b/snmp_util.cpp
index 6f70410..14a03eb 100644
--- a/snmp_util.cpp
+++ b/snmp_util.cpp
@@ -192,6 +192,39 @@ std::vector<struct mgrProperty> getManagers()
     }
     return managers;
 }
+
+std::vector<struct commStrMgrProperty> getCommStrManagers(const std::string& value)
+{
+    std::vector<struct commStrMgrProperty> matchedManagers;
+    auto& bus = getBus();
+    auto objTree = phosphor::getManagedObjects(bus, busCommunityStr, rootCommunityStr);
+
+    for (const auto& objIter : objTree)
+    {   
+        try
+        {
+           auto& intfMap = objIter.second;
+           auto& commStrProps = intfMap.at(clientCommunityStrIntf);
+
+           struct commStrMgrProperty mgrProps;
+           mgrProps.profile = std::get<std::string>(commStrProps.at("CommunityProfile"));
+           mgrProps.string = std::get<std::string>(commStrProps.at("CommunityString"));
+           mgrProps.permission = std::get<std::string>(commStrProps.at("ReadWritePermission"));
+
+           if (mgrProps.string == value)
+           {
+                matchedManagers.push_back(mgrProps);
+           }
+        }
+        catch (const std::exception& e)  
+        {
+            lg2::error("Failed to read community string properties: {ERROR}", "ERROR", e); 
+        }    
+    }   
+    return matchedManagers;
+}
+
+
