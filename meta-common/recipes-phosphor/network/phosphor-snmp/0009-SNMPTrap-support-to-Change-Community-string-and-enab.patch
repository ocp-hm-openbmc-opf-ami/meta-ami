+    
+    std::ifstream snmpTrapStatusFileStream(snmpTrapStatusFilePath, std::ios::in);
+    if (!snmpTrapStatusFileStream.is_open()) {
         lg2::error("Failed to open /etc/snmp/SnmpTrapStatus file");
         return;
     }
-    file >> std::boolalpha >> snmpTrapStatus;
-    file.close();
+    snmpTrapStatusFileStream >> std::boolalpha >> snmpTrapStatus;
+    snmpTrapStatusFileStream.close();
 
     if(snmpTrapStatus == false)
     {
@@ -79,6 +125,21 @@ void Notification::sendTrap()
         return;
     }
 
+    std::ifstream snmpTrapCommStrFileStream(snmpTrapCommStrFilePath);
+    if (snmpTrapCommStrFileStream.is_open()) {
+        getline(snmpTrapCommStrFileStream, commStr);
+        snmpTrapCommStrFileStream.close();
+    }
+ 
+    if(commStr != "")
+    {
+        comm = commStr.c_str();
+    }
+    else
