 1 file changed, 71 insertions(+), 6 deletions(-)

diff --git a/snmp_notification.cpp b/snmp_notification.cpp
index 079b0af..05acb5c 100644
--- a/snmp_notification.cpp
+++ b/snmp_notification.cpp
@@ -6,6 +6,8 @@
 #include <fstream>
 #include <phosphor-logging/elog-errors.hpp>
 #include <phosphor-logging/lg2.hpp>
+#include <map>
+#include <iostream>  
 
 namespace phosphor
 {
@@ -14,6 +16,10 @@ namespace network
 namespace snmp
 {
 
+std::string snmpConfFilePath = "/etc/snmp/snmp.conf";
+std::string snmpTrapCommStrFilePath = "/etc/snmp/snmpTrapCommStr";
+std::string snmpTrapStatusFilePath = "/etc/snmp/SnmpTrapStatus";
+
 using namespace phosphor::logging;
 using namespace sdbusplus::xyz::openbmc_project::Common::Error;
 
@@ -58,20 +64,60 @@ bool Notification::addPDUVar(netsnmp_pdu& pdu, const OID& objID,
     return (varList == nullptr ? false : true);
 }
 
+std::map<std::string, bool> getSNMPDisableStatus() {
+
+    std::map<std::string, bool> disableStatus = {{"v1", false}, {"v2c", false}, {"v3",false}};
+    std::string line;
+    std::string key, value;
+
+    std::ifstream snmpConfFileStream(snmpConfFilePath);
+
+    if (!snmpConfFileStream.is_open()) {
+        return disableStatus;
+    }
+
+    while (std::getline(snmpConfFileStream, line)) {
+        std::istringstream lineStream(line);
+
+        if (lineStream >> key >> value) {
+
+            if (key == "disableSNMPv1"){
+                key = "v1";
+            }
+            else if (key == "disableSNMPv2c"){
+                key = "v2c";
+            }
+            else if (key == "disableSNMPv3"){
+                key = "v3";
+            }
+
+            if (key == "v1" || key == "v2c" || key == "v3") {
+                bool disable = (value == "1" || value == "true" || value == "yes");
+                disableStatus[key] = disable;
+            }
+        }
+    }
+
+    snmpConfFileStream.close();
+    return disableStatus;
+}
+
 void Notification::sendTrap()
 {
-    constexpr auto comm = "public";
+    const char* comm = {};
     netsnmp_session session{};
     snmp_sess_init(&session);
-
