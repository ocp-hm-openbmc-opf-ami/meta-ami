From 5c6149b42223b10654303b1bf0b30f81392b0679 Mon Sep 17 00:00:00 2001
From: ramsankarr <ramsankarr@ami.com>
Date: Tue, 23 Dec 2025 15:12:25 +0530
Subject: [PATCH 75/75] ReducedTrapSentTimeOnFailureState

---
 snmp.hpp              | 4 ++--
 snmp_notification.cpp | 9 +++++----
 snmp_notification.hpp | 2 +-
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/snmp.hpp b/snmp.hpp
index 2479c24..d2f4d11 100644
--- a/snmp.hpp
+++ b/snmp.hpp
@@ -15,10 +15,10 @@ namespace snmp
  */
 
 template <typename T, typename... ArgTypes>
-void sendTrap(ArgTypes&&... tArgs)
+bool sendTrap(ArgTypes&&... tArgs)
 {
     T obj(std::forward<ArgTypes>(tArgs)...);
-    obj.sendTrap();
+    return obj.sendTrap();
 }
 
 } // namespace snmp
diff --git a/snmp_notification.cpp b/snmp_notification.cpp
index 0bf5efa..0aa565c 100644
--- a/snmp_notification.cpp
+++ b/snmp_notification.cpp
@@ -125,7 +125,7 @@ namespace phosphor
 		return {password, encryption, algorithm, timeAfterRead};
 	    }
 
-            void Notification::sendTrap()
+            bool Notification::sendTrap()
             {
                 bool trapsent = false;
                 netsnmp_session session{};
@@ -137,14 +137,14 @@ namespace phosphor
                 std::ifstream snmpTrapStatusFileStream(snmpTrapStatusFilePath.data(), std::ios::in);
                 if (!snmpTrapStatusFileStream.is_open()) {    
                     lg2::error("Failed to open /etc/snmp/SnmpTrapStatus file");
-                    return;
+                    return trapsent;
                 }
                 snmpTrapStatusFileStream >> std::boolalpha >> snmpTrapStatus;
                 snmpTrapStatusFileStream.close();
                 if(snmpTrapStatus == false)
                 {
                     lg2::error("SNMPTrap is not enabled");
-                    return;
+                    return trapsent;
                 }
 
                 std::ifstream snmpTrapCommStrFileStream(snmpTrapCommStrFilePath.data());
@@ -445,8 +445,9 @@ namespace phosphor
                 if (trapsent == false)
                 {
                     lg2::error("Failed to send the snmp trap for all managers.");
-                    elog<InternalFailure>();
+                    return trapsent;
                 }
+                return trapsent;
             }
 
         } // namespace snmp
diff --git a/snmp_notification.hpp b/snmp_notification.hpp
index 0feac0b..1ee1328 100644
--- a/snmp_notification.hpp
+++ b/snmp_notification.hpp
@@ -109,7 +109,7 @@ class Notification
     /** @brief Send the snmp trap to the configured
      *          manager.
      */
-    void sendTrap();
+    bool sendTrap();
 
   protected:
     /** @brief Add the variable in the snmp pdu object.
