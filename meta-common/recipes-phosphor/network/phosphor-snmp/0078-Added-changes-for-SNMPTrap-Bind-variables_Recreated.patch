+             OID id = {1, 3, 6, 1, 4, 1, 49871, 1, 0, 1, 7};
+             u_char type = getASNType<decltype(OBMCEventStatus)>();
+
+             objectList.emplace_back(id, idLen, type, OBMCEventStatus);
