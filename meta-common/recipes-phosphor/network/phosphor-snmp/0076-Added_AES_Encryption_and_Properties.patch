+
+	if((std::find(supported_algorithm.begin(),supported_algorithm.end(),value) == supported_algorithm.end()) || (version() != "v3"))
+	{
+		lg2::error("Algorithm Type not supported");
+		elog<InvalidArgument>(Argument::ARGUMENT_NAME("algorithm"),
