+std::string Client::password(std::string Password)
+{
+        if (Password == Ifaces::password())
+        {
+                return Password;
+        }
+        
+        if(version() != "v3")
+        {
+                lg2::error("password not supported");
+                elog<InvalidArgument>(Argument::ARGUMENT_NAME("password"),
+                                Argument::ARGUMENT_VALUE(Password.c_str()));
+        }
+
+	auto password = Ifaces::password(Password);
+        serialize(id, *this, parent.dbusPersistentLocation);
+        return password;
+}
+
+bool Client::readonlypermission(bool permissionbyte)
+{
+        if (permissionbyte == Ifaces::readonlypermission())
+        {
+                return permissionbyte;
+        }
+
+        if(version() != "v3")
+        {
+                lg2::error("readonlypermission not supported");
+                elog<InvalidArgument>(Argument::ARGUMENT_NAME("readonlypermission"),
+                                Argument::ARGUMENT_VALUE("Version was not supported"));
+        }
+
+        auto readonlypermission = Ifaces::readonlypermission(permissionbyte);
+        serialize(id, *this, parent.dbusPersistentLocation);
+        return readonlypermission;
+}
+
