From 4018a68b163da383999c2ead59e50cceb6216d60 Mon Sep 17 00:00:00 2001
From: Nikhila D <nikhilad@ami.com>
Date: Mon, 3 Nov 2025 14:52:40 +0530
Subject: [PATCH] Add-CallbackHandler-support-for-arbel-GpioMonitor

---
 gpioMon.cpp     | 12 ++++++++++++
 gpioMon.hpp     |  9 +++++++--
 gpioMonMain.cpp | 11 ++++++++++-
 meson.build     |  1 +
 4 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/gpioMon.cpp b/gpioMon.cpp
index d270862..5dcb59e 100644
--- a/gpioMon.cpp
+++ b/gpioMon.cpp
@@ -94,6 +94,12 @@ void GpioMonitor::gpioEventHandler()
         {
             targetsToStart = risingFind->second;
         }
+        auto it = callbackHook.find(hook);
+        if (it != callbackHook.end())
+        {
+            // Call the hook function with desired parameters
+            it->second(gpioPinName, rising);
+        }
     }
     else
     {
@@ -102,6 +108,12 @@ void GpioMonitor::gpioEventHandler()
         {
             targetsToStart = fallingFind->second;
         }
+        auto it = callbackHook.find(hook);
+        if (it != callbackHook.end())
+        {
+            // Call the hook function with desired parameters
+            it->second(gpioPinName, falling);
+        }
     }
 
     /* Execute the multi targets if it is defined. */
diff --git a/gpioMon.hpp b/gpioMon.hpp
index 150e845..5167181 100644
--- a/gpioMon.hpp
+++ b/gpioMon.hpp
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <gpioCallbackHandler.hpp>
+
 #include <gpiod.h>
 
 #include <boost/asio/io_context.hpp>
@@ -53,10 +55,10 @@ class GpioMonitor
                 std::map<std::string, std::vector<std::string>> target,
                 const std::map<std::string, std::vector<std::string>>& targets,
                 const std::string& lineMsg, bool continueRun,
-                const std::string& pinName) :
+                const std::string& pinName, std::string hook) :
         gpioLine(line), gpioConfig(config), gpioEventDescriptor(io),
         target(target), targets(targets), gpioLineMsg(lineMsg),
-        continueAfterEvent(continueRun), maskTimer(io), gpioPinName(pinName)
+        continueAfterEvent(continueRun), maskTimer(io), gpioPinName(pinName), hook(hook)
     {
         initializeEvent();
         requestGPIOEvents();
@@ -90,6 +92,9 @@ class GpioMonitor
     /** @brief GPIO pin description */
     std::string gpioPinName;
 
+    /** @brief callbacHook name*/
+    std::string hook;
+
     /** @brief Handle the GPIO level during Initialization */
     void initializeEvent();
 
diff --git a/gpioMonMain.cpp b/gpioMonMain.cpp
index e6840d6..a95a138 100644
--- a/gpioMonMain.cpp
+++ b/gpioMonMain.cpp
@@ -149,6 +149,9 @@ int main(int argc, char** argv)
         uint16_t maskInterval;
         std::string pinName = "";
 
+        /* CallbackHook name */
+        std::string hook;
+
         /* GPIO line configuration, default to monitor both edge */
         struct gpiod_line_request_config config{
             "gpio_monitor", GPIOD_LINE_REQUEST_EVENT_BOTH_EDGES, 0};
@@ -253,9 +256,15 @@ int main(int argc, char** argv)
             intf->initialize();
         }
 
+        /*Parse callbackHook name.*/
+        if (obj.find("CallbackFunction") != obj.end())
+        {
+            hook = obj["CallbackFunction"];
+        }
+
         /* Create a monitor object and let it do all the rest */
         gpios.push_back(std::make_unique<phosphor::gpio::GpioMonitor>(
-            line, config, io, target, targets, lineMsg, flag, pinName));
+            line, config, io, target, targets, lineMsg, flag, pinName, hook));
     }
     sd_notify(0, "READY=1");
     io.run();
diff --git a/meson.build b/meson.build
index 8c1183f..1770321 100644
--- a/meson.build
+++ b/meson.build
@@ -130,6 +130,7 @@ executable(
    'phosphor-multi-gpio-monitor',
    'gpioMonMain.cpp',
    'gpioMon.cpp',
+   'gpioCallbackHandler.cpp',
    dependencies: [
         cli11_dep,
         libgpiod,
-- 
2.34.1

