From 909b1e1627eaec5254b0dca5b497d7a6bbb34218 Mon Sep 17 00:00:00 2001
From: franklinsamuvelg <franklinsamuvelg@ami.com>
Date: Tue, 13 Oct 2026 12:36:35 +0530
Subject: [PATCH] Combined Coverity fixes for google-authenticator

Upstream-Status: Inappropriate [Coverity-specific fix]

---
 src/pam_google_authenticator.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/src/pam_google_authenticator.c b/src/pam_google_authenticator.c
index e3928f9..0891fbb 100644
--- a/src/pam_google_authenticator.c
+++ b/src/pam_google_authenticator.c
@@ -97,14 +97,17 @@ static void log_message(int priority, pam_handle_t *pamh,
   char *service = NULL;
   if (pamh)
   {
-    int retval = pam_get_item(pamh, PAM_SERVICE, (void *)&service);
-    if (retval != PAM_SUCCESS)
-    {
-	    return;
-    }
+  	int retval = pam_get_item(pamh, PAM_SERVICE, (void *)&service);
+    	if (retval != PAM_SUCCESS)
+    	{
+        	return;
+    	}
+  }
+
+  if (service == NULL)
+  {
+    return;
   }
-  if (!service)
-    service = "";
 
   char logname[80];
   snprintf(logname, sizeof(logname), "%s(" MODULE_NAME ")", service);
