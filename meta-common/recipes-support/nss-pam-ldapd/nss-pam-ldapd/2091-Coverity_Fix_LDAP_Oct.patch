From 0bbde56fdf005b485c70bf57e47a2c630158e833 Mon Sep 17 00:00:00 2001
From: franklinsamuvelg <franklinsamuvelg@ami.com>
Date: Thu, 8 Oct 2026 10:45:09 +0530
Subject: [PATCH 2091/2091] Coverity_Fix_LDAP_Oct

Upstream-Status: Inappropriate [Coverity fix]

---
 nslcd/cfg.c    | 4 ++--
 nslcd/common.c | 2 ++
 nslcd/log.c    | 5 +++--
 nslcd/myldap.c | 5 +++--
 4 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/nslcd/cfg.c b/nslcd/cfg.c
index 14c62e5..a5c8a45 100644
--- a/nslcd/cfg.c
+++ b/nslcd/cfg.c
@@ -695,7 +695,7 @@ static void handle_base(const char *filename, int lnr,
   if (strcasecmp(value, "\"\"") == 0)
   {
     free(value);
-    value = "";
+    value = xstrdup("");
   }
   /* find the spot in the list of bases */
   for (i = 0; i < NSS_LDAP_CONFIG_MAX_BASES; i++)
@@ -1446,7 +1446,7 @@ static void cfg_read(const char *filename, struct ldap_config *cfg)
         else if (strncasecmp(token, "dnsldaps:", 9) == 0)
         {
 #ifdef HAVE_LDAP_DOMAIN2HOSTLIST
-          add_uris_from_dns(filename, lnr, cfg, strdup(token + 9), 1);
+          add_uris_from_dns(filename, lnr, cfg, token + 9, 1);
 #else /* not HAVE_LDAP_DOMAIN2HOSTLIST */
           log_log(LOG_ERR, "%s:%d: value %s not supported on platform",
                   filename, lnr, token);
diff --git a/nslcd/common.c b/nslcd/common.c
index 60be777..2f2d7d3 100644
--- a/nslcd/common.c
+++ b/nslcd/common.c
@@ -49,6 +49,8 @@ int mysnprintf(char *buffer, size_t buflen, const char *format, ...)
 {
   int res;
   va_list ap;
+  if ((buffer == NULL) || (buflen == 0))
+	return 1;
   /* do snprintf */
   va_start(ap, format);
   res = vsnprintf(buffer, buflen, format, ap);
diff --git a/nslcd/log.c b/nslcd/log.c
index 56426f8..9f9982b 100644
--- a/nslcd/log.c
+++ b/nslcd/log.c
@@ -201,7 +201,7 @@ void log_setrequest(const char *format, ...)
 {
   va_list ap;
 #ifndef TLS
-  char *requestid;
+  char *requestid = NULL;
   pthread_once(&tls_init_once, tls_init_keys);
   requestid = pthread_getspecific(requestid_key);
 #endif /* no TLS */
@@ -233,7 +233,8 @@ void log_log(int pri, const char *format, ...)
   char buffer[512];
   va_list ap;
 #ifndef TLS
-  char *sessionid, *requestid;
+  char *sessionid = NULL;
+  char *requestid = NULL;
   pthread_once(&tls_init_once, tls_init_keys);
   sessionid = pthread_getspecific(sessionid_key);
   requestid = pthread_getspecific(requestid_key);
diff --git a/nslcd/myldap.c b/nslcd/myldap.c
index e28f5c3..5eb1e42 100644
--- a/nslcd/myldap.c
+++ b/nslcd/myldap.c
@@ -164,6 +164,7 @@ static void myldap_err(int pri, LDAP *ld, int rc, const char *format, ...)
   char *msg_ldap = NULL;
   char *msg_diag = NULL;
   char *msg_errno = NULL;
+  int saved_errno = errno;
   va_list ap;
   /* make the message */
   va_start(ap, format);
@@ -180,8 +181,8 @@ static void myldap_err(int pri, LDAP *ld, int rc, const char *format, ...)
       ldap_get_option(ld, LDAP_OPT_DIAGNOSTIC_MESSAGE, &msg_diag);
 #endif /* LDAP_OPT_DIAGNOSTIC_MESSAGE */
   }
-  if (errno != 0)
-    msg_errno = strerror(errno);
+  if (saved_errno != 0)
+    msg_errno = strerror(saved_errno);
   /* log the message */
   log_log(pri, "%s%s%s%s%s%s%s", message,
           (msg_ldap == NULL) ? "" : ": ", (msg_ldap == NULL) ? "" : msg_ldap,
-- 
2.43.0

