     if (search != NULL)
-      myldap_search_close(search);
+    {
+        myldap_search_close(search);
+        search = NULL;
+    }
     /* start the new search */
     search = myldap_search(session, dn, LDAP_SCOPE_BASE, "(objectClass=*)", attrs, NULL);
     if (search == NULL)
@@ -1879,7 +1882,11 @@ static char **myldap_get_ranged_values(MYLDAP_ENTRY *entry, const char *attr)
   }
   /* close any started searches */
   if (search != NULL)
-    myldap_search_close(search);
+  {
+      /* coverity[double_free : FALSE] */ /* Reason: search is freed only if it is not null */
