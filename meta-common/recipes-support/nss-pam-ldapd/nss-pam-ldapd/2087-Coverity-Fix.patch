diff --git a/common/expr.c b/common/expr.c
index ce10f67..9f3479b 100644
--- a/common/expr.c
+++ b/common/expr.c
@@ -308,6 +308,10 @@ MUST_USE static const char *parse_expression(
           return NULL;
         j = strlen(buffer);
         break;
+        /* coverity[unterminated_case : FALSE] */
+        /* Intentional fallthrough: escaped characters like '\\' are consumed,
+           then processed as normal text through the default case to avoid code
+           duplication. No break is needed*/
       case '\\': /* escaped character, unescape */
         (*ptr)++;
         FALLTHROUGH; /* no break needed here */
diff --git a/nslcd/attmap.c b/nslcd/attmap.c
