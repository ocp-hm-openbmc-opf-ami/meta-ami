@@ -1004,6 +1013,7 @@ static void handle_validnames(const char *filename, int lnr,
   char *value;
   int i, l;
   int flags = REG_EXTENDED | REG_NOSUB;
+  char* errbuf = NULL;
   /* the rest of the line should be a regular expression */
   value = get_linedup(filename, lnr, keyword, &line);
   if (cfg->validnames_str != NULL)
@@ -1017,6 +1027,7 @@ static void handle_validnames(const char *filename, int lnr,
   {
     log_log(LOG_ERR, "%s:%d: regular expression incorrectly delimited",
             filename, lnr);
+    free(value);
     exit(EXIT_FAILURE);
   }
   l = strlen(value);
@@ -1030,6 +1041,7 @@ static void handle_validnames(const char *filename, int lnr,
