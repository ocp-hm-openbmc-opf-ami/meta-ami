+      search = NULL;
+  }
   /* return the contents of the set as a list */
   if (set == NULL)
     return NULL;
@@ -2214,24 +2221,24 @@ int myldap_has_objectclass(MYLDAP_ENTRY *entry, const char *objectclass)
 const char ***myldap_get_deref_values(MYLDAP_ENTRY *entry,
                 const char *derefattr, const char *getattr)
 {
-  LDAPControl **entryctrls;
-  LDAPDerefRes *deref, *d;
-  LDAPDerefVal *a;
-  int i, pass;
-  int rc;
-  int found;
-  int counts[2];
-  size_t sizes[2], size;
-  char *buffer = NULL;
-  char ***results = NULL;
-  rc = ldap_get_entry_controls(entry->search->session->ld, entry->search->msg,
-                                &entryctrls);
-  if (rc != LDAP_SUCCESS)
-  {
-    myldap_err(LOG_WARNING, entry->search->session->ld, rc,
-               "ldap_get_entry_controls() failed");
-    return NULL;
-  }
+    LDAPControl** entryctrls = NULL;
+    LDAPDerefRes *deref, *d;
+    LDAPDerefVal* a;
+    int i, pass;
+    int rc;
+    int found;
+    int counts[2];
+    size_t sizes[2], size;
+    char* buffer = NULL;
+    char*** results = NULL;
+    rc = ldap_get_entry_controls(entry->search->session->ld, entry->search->msg,
+                                 &entryctrls);
+    if (rc != LDAP_SUCCESS)
+    {
+        myldap_err(LOG_WARNING, entry->search->session->ld, rc,
+                   "ldap_get_entry_controls() failed");
+        return NULL;
+    }
   if (entryctrls == NULL)
     return NULL;
   /* see if we can find a deref control */
diff --git a/nslcd/passwd.c b/nslcd/passwd.c
index 59b21d0..04ba48b 100644
--- a/nslcd/passwd.c
+++ b/nslcd/passwd.c
@@ -333,7 +333,10 @@ char *dn2uid(MYLDAP_SESSION *session, const char *dn, char *buf, size_t buflen)
   pthread_mutex_lock(&dn2uid_cache_mutex);
   /* try to get the entry from the cache here again because it could have
