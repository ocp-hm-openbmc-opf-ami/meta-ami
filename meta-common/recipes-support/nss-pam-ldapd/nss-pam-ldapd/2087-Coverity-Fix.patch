--- a/nslcd/attmap.c
+++ b/nslcd/attmap.c
@@ -304,6 +304,8 @@ SET *attmap_add_attributes(SET *set, const char *attr)
   if (attr[0] != '\"')
     set_add(set, attr);
   else
-    expr_vars(attr, set);
+  {
+      set = expr_vars(attr, set);
+  }
   return set;
 }
