diff --git a/pam/pam.c b/pam/pam.c
index a3a18f8..ee020f6 100644
--- a/pam/pam.c
+++ b/pam/pam.c
@@ -236,9 +236,27 @@ static int init(pam_handle_t *pamh, struct pld_cfg *cfg, struct pld_ctx **ctx,
     return rc;
   }
   /* get more PAM information (ignore errors) */
-  pam_get_item(pamh, PAM_RUSER, (PAM_ITEM_CONST void **)ruser);
-  pam_get_item(pamh, PAM_RHOST, (PAM_ITEM_CONST void **)rhost);
-  pam_get_item(pamh, PAM_TTY, (PAM_ITEM_CONST void **)tty);
+  rc = pam_get_item(pamh, PAM_RUSER, (PAM_ITEM_CONST void**)ruser);
+  if (rc != PAM_SUCCESS)
+  {
+      pam_syslog(pamh, LOG_ERR, "failed to get remote user: %s",
+                 pam_strerror(pamh, rc));
+      return rc;
+  }
+  rc = pam_get_item(pamh, PAM_RHOST, (PAM_ITEM_CONST void**)rhost);
+  if (rc != PAM_SUCCESS)
+  {
+      pam_syslog(pamh, LOG_ERR, "failed to get host: %s",
+                 pam_strerror(pamh, rc));
+      return rc;
+  }
+  rc = pam_get_item(pamh, PAM_TTY, (PAM_ITEM_CONST void**)tty);
+  if (rc != PAM_SUCCESS)
+  {
+      pam_syslog(pamh, LOG_ERR, "failed to get tty: %s",
+                 pam_strerror(pamh, rc));
+      return rc;
+  }
   return PAM_SUCCESS;
 }
 
