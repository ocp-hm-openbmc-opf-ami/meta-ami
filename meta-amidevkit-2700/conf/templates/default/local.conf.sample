MACHINE ??= "devkit2700"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_rpm"
SANITY_TESTED_DISTROS:append ?= " *"
IMAGE_FEATURES:remove = "debug-tweaks"
EXTRA_IMAGE_FEATURES += "allow-empty-password allow-root-login post-install-logging"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
		STOPTASKS,${TMPDIR},1G,100K \
		STOPTASKS,${DL_DIR},1G,100K \
		STOPTASKS,${SSTATE_DIR},1G,100K \
		STOPTASKS,/tmp,100M,1K \
		HALT,${TMPDIR},100M,1K \
		HALT,${DL_DIR},100M,1K \
		HALT,${SSTATE_DIR},100M,1K \
		HALT,/tmp,10M,1K"
CONF_VERSION = "2"
INHERIT += "extrausers"
EXTRA_USERS_PARAMS = " \
	usermod -p '\$1\$UGMqyqdG\$FZiylVFmRRfl9Z0Ue8G7e/' root; \
	"
TZ = '/etc/localtime'
BAD_RECOMMENDATIONS += "phosphor-settings-manager"
FULL_OPTIMIZATION = "-Os -pipe ${DEBUG_LEVELFLAG}"
ERROR_QA:remove = " patch-fuzz patch-status license-checksum buildpaths "
WARN_QA:remove = " patch-fuzz patch-status license-checksum buildpaths "
IMAGE_INSTALL:remove = " google-authenticator-libpam web-two-factor-authentication"
NON_PFR_UPDATE_FEATURES:append = " image-sign"
EXTRA_IMAGE_FEATURES:append = " onetree-network-bonding-support"
require conf/machine/include/${MACHINE}-layout.inc