Subject: [PATCH] Configure AST2700 DevKit power and expansion interfaces

Retain the EVB power GPIOs and ADC pin selections. TACH5-7 share GPIO1
B5-B7 with POWER_OUT, RESET_OUT and PS_PWROK, so do not expose those
tachometer channels. Use the primary I2C8 pin group for the DevKit ADT7490
at its existing address 0x2e, without moving the IPMB controllers.
Select PWM2 and TACH2 so all four existing DevKit fan connectors have
their pins muxed. Keep I2C5-7 disabled for the W3/W5/W7 power inputs.

Upstream-Status: Inappropriate [DevKit hardware configuration]

--- a/dts-evb-ast2700/ast2700-evb.dts
+++ b/dts-evb-ast2700/ast2700-evb.dts
@@ -171,14 +171,14 @@
 	status = "okay";
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
-		     &pinctrl_pwm3_default
+		     &pinctrl_pwm2_default &pinctrl_pwm3_default
 		     &pinctrl_pwm4_default &pinctrl_pwm5_default
 		     &pinctrl_pwm6_default &pinctrl_pwm7_default
 		     &pinctrl_pwm8_default
 		     &pinctrl_tach0_default &pinctrl_tach1_default
-		     &pinctrl_tach3_default
+		     &pinctrl_tach2_default &pinctrl_tach3_default
 		     &pinctrl_tach4_default
 		     &pinctrl_tach11_default
 		     &pinctrl_tach12_default &pinctrl_tach13_default
 		     &pinctrl_tach14_default &pinctrl_tach15_default>;
 	fan-0 {
@@ -196,15 +196,6 @@
 	fan-4 {
 		tach-ch = /bits/ 8 <0x4>;
 	};
-	fan-5 {
-		tach-ch = /bits/ 8 <0x5>;
-	};
-	fan-6 {
-		tach-ch = /bits/ 8 <0x6>;
-	};
-	fan-7 {
-		tach-ch = /bits/ 8 <0x7>;
-	};
 	fan-8 {
 		tach-ch = /bits/ 8 <0x8>;
 	};
@@ -1220,6 +1211,13 @@
 &i2c8 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c8_default>;
 	status = "okay";
+
+	temp@2e {
+		compatible = "adi,adt7490";
+		reg = <0x2e>;
+	};
 };
 
 &i2c11 {
 	status = "disabled";
